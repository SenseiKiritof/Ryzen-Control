    def refresh(self, st):
        self.loading = True
        prof = st.get("profile")
        shown = st.get("profile_lines", {})
        for key, title, sub in MODES:
            row, chk, regen = self.rows[key]
            if regen:
                exists = key in shown
                regen.set_visible(exists)
                row.set_subtitle(sub if exists else sub + " — profilo non ancora creato: spunta per crearlo")
                if key in self.tables:
                    row.remove(self.tables.pop(key))
                if exists:   # ListBoxRow esplicita: così `row.remove` la ritrova al prossimo refresh
                    self.tables[key] = Gtk.ListBoxRow(child=profile_table(shown[key], st), activatable=False, selectable=False)
                    row.add_row(self.tables[key])
                    row.set_expanded(True)
        current = prof if prof in PRESETS else ("custom" if prof else "default")
        self.rows[current][1].set_active(True)
        self.autostart.set_active(bool(st.get("autostart")))
        self.unlock.set_active(bool(st.get("unlock")))
        self.trust.set_active(bool(st.get("trusted")))
        self.loading = False

    def on_mode(self, chk, key):
        if self.loading or not chk.get_active():
            return
        if key == "default":
            self.win.run([["default"]], lambda _: self.win.toast("Valori di fabbrica applicati"))
        elif key == "custom":
            self.win.toast("Imposta i valori nelle pagine CPU, Curve e Ventole e usa \"Applica ora\"")
        elif key in self.win.status.get("profile_lines", {}):
            self.win.run([["apply", key], ["use", key]], lambda _: self.win.toast("Profilo '%s' applicato" % key))
        else:
            def ask(res):
                def go(ok):
                    if ok:
                        self.win.run([["preset", key], ["apply", key], ["use", key]], lambda _: self.win.toast("Profilo '%s' creato e applicato" % key))
                    else:
                        self.win.reload()
                self.win.confirm("Creare il profilo '%s'?" % key, "Valori di fabbrica → profilo (verde = più conservativo, rosso = più spinto):",
                                 "Crea e applica", go, extra=profile_view(res["lines"], self.win.status))
            bg(lambda: self.win.h.call("preset", key, "show"), ask, lambda m: (self.win.toast(m), self.win.reload()))

    def calibrate(self, mode):
        """Prima la stima (`autotune estimate`), poi una scelta semplice: automatica con i default di ryzenctl, o i parametri a mano."""
        def ask(est):
            p = est["params"]
            target = "Tctl obiettivo %d °C, " % p["target"] if "target" in p else ""   # Boost: nessun obiettivo termico
            if est.get("co_reuse"):   # ricerca del limite già fatta: solo passata finale col margine di questa modalità
                auto = "Limite di CO (Curve Optimizer) già misurato il %s: riusato (ripeti la ricerca da \"Scegli i valori…\"), %s — %smargine %d, %d s per test." % (
                    est["co_reuse"], mins(est["parallel_total_s"]), target, p["margin"], p["step"])
            else:
                auto = "tutti i core insieme, %s — %sCO (Curve Optimizer) fino a %d con margine %d, %d s per test." % (
                    mins(est["parallel_total_s"]), target, p["colimit"], p["margin"], p["step"])
            fans = Adw.ComboRow(title="Ventole", model=Gtk.StringList.new(list(FAN_LEVELS)), selected=p.get("fans", 0),
                                subtitle="Anche in automatico: quanto la modalità tocca le ventole (solo i canali riconosciuti come ventola)")
            lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
            lb.append(fans)
            d = Adw.AlertDialog(heading="Calibrare la modalità %s?" % mode.capitalize(),
                                body="Automatica (consigliata): %s\n\n%s\n\n%s" % (auto, AT_WARNING, CO_TIP), extra_child=lb)
            d.add_response("cancel", "Annulla")
            d.add_response("custom", "Scegli i valori…")
            d.add_response("auto", "Automatica (consigliata)")
            d.set_response_appearance("auto", Adw.ResponseAppearance.SUGGESTED)
            def resp(_d, r):
                if r == "auto":
                    AutotuneDialog(self.win, mode).start(dict(p, parallel=1, fans=fans.get_selected()))
                elif r == "custom":
                    self.calibrate_params(mode, dict(est, params=dict(p, fans=fans.get_selected())))
            d.connect("response", resp)
            d.present(self.win)
        bg(lambda: self.win.h.call("autotune", "estimate", mode), ask, self.win.toast)

    def calibrate_params(self, mode, est):
        """Parametri (range da AT_PARAMS, default da ryzenctl) con stima che segue le modifiche → autotune start → avanzamento."""
        group = Adw.PreferencesGroup()
        spins = {}
        for key, title, unit, (lo, hi) in AT_PARAMS:
            if key not in est["params"]:   # es. Boost non ha `target`
                continue
            r = Adw.SpinRow.new_with_range(lo, hi, 1)
            r.set_title(title + (" (%s)" % unit if unit else ""))
            r.set_value(est["params"][key])
            spins[key] = r
            group.add(r)
        parallel = Adw.SwitchRow(title="Test di tutti i core insieme (veloce, consigliato)", active=bool(est["params"].get("parallel", 1)))
        group.add(parallel)
        fans = Adw.ComboRow(title="Ventole", model=Gtk.StringList.new(list(FAN_LEVELS)), selected=est["params"].get("fans", 0))
        group.add(fans)
        repeat = Adw.SwitchRow(title="Ripeti la ricerca del limite CO", active=False, sensitive=bool(est.get("co_reuse")))
        group.add(repeat)
        estimate = label("", ["heading"], margin_top=6)
        params = lambda: dict(((k, int(r.get_value())) for k, r in spins.items()), parallel=int(parallel.get_active()),
                              reuse=int(not repeat.get_active()), fans=fans.get_selected())
        def show_est(e):
            estimate.set_text("Durata stimata: %s" % mins(e["total_s"]))
            parallel.set_subtitle(AT_PARALLEL_SUB % mins(e["sequential_total_s"]))
            repeat.set_subtitle("Spenta: riusa la misura del %s; accesa: misura di nuovo il limite (più lunga)" % e["co_reuse"] if e.get("co_reuse")
                                else ("ricerca completa" if repeat.get_active() else "nessuna misura precedente utilizzabile"))
        pending = {"timer": 0, "seq": 0}
        def refresh_est():
            pending["timer"] = 0
            pending["seq"] += 1
            seq = pending["seq"]
            def got(e):
                if seq == pending["seq"]:   # solo l'ultima stima richiesta
                    show_est(e)
            argv = ["autotune", "estimate", mode] + ["%s=%d" % kv for kv in params().items()]
            bg(lambda: self.win.h.call(*argv), got, self.win.toast)
            return False
        def changed(*_):   # debounce: una stima dopo 400 ms di quiete
            if pending["timer"]:
                GLib.source_remove(pending["timer"])
            pending["timer"] = GLib.timeout_add(400, refresh_est)
        for r in spins.values():
            r.connect("notify::value", changed)
        parallel.connect("notify::active", changed)
        repeat.connect("notify::active", changed)
        show_est(est)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.append(group)
        box.append(estimate)
        d = Adw.AlertDialog(heading="Parametri della calibrazione %s" % mode.capitalize(), body=AT_WARNING, extra_child=box)
        d.spins, d.parallel, d.repeat, d.estimate = spins, parallel, repeat, estimate   # raggiungibili dalle prove pilotate
        d.add_response("cancel", "Annulla")
        d.add_response("start", "Avvia")
        d.set_response_appearance("start", Adw.ResponseAppearance.DESTRUCTIVE)
        def resp(_d, r):
            if pending["timer"]:
                GLib.source_remove(pending["timer"])
                pending["timer"] = 0
            if r == "start":
                AutotuneDialog(self.win, mode).start(params())
        d.connect("response", resp)
        d.present(self.win)

    def regen(self, key):
        def ask(res):
            def go(ok):
                if ok:
                    cmds = [["preset", key]] + ([["apply", key]] if self.win.status.get("profile") == key else [])
                    self.win.run(cmds, lambda _: self.win.toast("Profilo '%s' rigenerato" % key))
            self.win.confirm("Rigenerare '%s' dai valori di fabbrica?" % key, "Il profilo attuale viene sostituito da questi valori (verde = più conservativo, rosso = più spinto):",
                             "Rigenera", go, destructive=True, extra=profile_view(res["lines"], self.win.status))
        bg(lambda: self.win.h.call("preset", key, "show"), ask, self.win.toast)

    def on_autostart(self, row, _):
        if not self.loading:
            self.win.run([["autostart", "on" if row.get_active() else "off"]])

    def on_login(self, row, _):
        """Autostart XDG dell'utente (~/.config/autostart): nessun privilegio, solo la finestra al login."""
        try:
            if row.get_active():
                os.makedirs(os.path.dirname(LOGIN_DESKTOP), exist_ok=True)
                with open(LOGIN_DESKTOP, "w") as f:
                    f.write("[Desktop Entry]\nType=Application\nName=Ryzen Control\nExec=ryzen-control\nIcon=%s\n"
                            "Terminal=false\nX-GNOME-Autostart-enabled=true\n" % APP_ID)
            elif os.path.exists(LOGIN_DESKTOP):
                os.remove(LOGIN_DESKTOP)
        except OSError as e:
            self.win.toast(str(e))

    def on_unlock(self, row, _):
        if self.loading:
            return
        if not row.get_active():
            self.win.run([["unlock", "off"]], lambda res: self.win.toast(str(res[0])))
            return
        def go(ok):
            if ok:
                self.win.run([["unlock", "on"]], lambda res: self.win.toast(str(res[0])))
            else:
                self.win.reload()   # riporta l'interruttore allo stato reale
        self.win.confirm("Oltre i valori di fabbrica?", UNLOCK_WARNING, "Sblocca", go, destructive=True)

    def on_trust(self, row, _):
        if self.loading:
            return
        if not row.get_active():
            self.win.run([["trust", "off"]], lambda res: self.win.toast("Password di nuovo richiesta a ogni avvio"))
            return
        def go(ok):
            if ok:
                self.win.run([["trust", "on"]], lambda res: self.win.toast("Fatto: dal prossimo avvio nessuna password per %s" % res[0]["user"]))
            else:
                self.win.reload()   # riporta l'interruttore allo stato reale
        self.win.confirm("Non chiedere più la password?", TRUST_WARNING, "Ricorda", go)

    def hwtest(self):
        self.hw_btn.set_sensitive(False)
        self.hw_spin.start()
        def done(res):
            self.hw_spin.stop()
            self.hw_btn.set_sensitive(True)
            self.win.info("Verifica hardware: " + res.get("esito", "?"), "\n".join("%s: %s" % kv for kv in res.items()))
            self.win.reload()
        def fail(msg):
            self.hw_spin.stop()
            self.hw_btn.set_sensitive(True)
            self.win.toast(msg)
        bg(lambda: self.win.h.call("hwtest"), done, fail)


class CpuPage(Page):
    NAME, TITLE, ICON = "cpu", "CPU", "preferences-system-symbolic"

    def __init__(self, win):
        super().__init__(win, CPU_HELP)
        self.params = {}
        self.read_power = None
        for key, title, unit in CPU_PARAMS:
            p = self.params[key] = Param(title, unit, tooltip=PARAM_HELP[key])
            self.body.append(p)
        row = Gtk.Box(spacing=12)
        row.append(label("Energia", ["heading"], width_chars=9))
        self.power = Gtk.DropDown(model=Gtk.StringList.new(list(POWER)), valign=Gtk.Align.CENTER)
        row.append(self.power)
        row.append(label("profilo energetico di sistema (power-profiles-daemon / EPP)", ["dim-label"]))
        self.body.append(row)
        self.nocaps = label("Baseline di questo boot assente: nessuna scrittura CPU possibile (ryzenctl.service non l'ha catturata, vedi `ryzenctl status`).",
                            ["warning"], wrap=True, visible=False)
        self.body.append(self.nocaps)
        self.buttons()

    def refresh(self, st):
        caps = st.get("caps")
        self.nocaps.set_visible(not caps)
        self.bar.set_sensitive(bool(caps))
        if not caps:
            return
        values = dict(st["limits"])
        values["fmax"] = st["fmax"]
        base = st.get("baseline") or {}
        for key, _, _ in CPU_PARAMS:
            p, v = self.params[key], values.get(key)
            p.set_visible(v is not None and key in caps)
            if p.get_visible():
                p.setup(caps[key][0], caps[key][1], int(round(v)), base.get(key))
        self.read_power = st.get("power")
        self.power.set_sensitive(self.read_power in POWER)
        if self.read_power in POWER:
            self.power.set_selected(POWER.index(self.read_power))

    def reset(self):
        for p in self.params.values():
            p.reset()
        if self.read_power in POWER:
            self.power.set_selected(POWER.index(self.read_power))

    def lines(self, only_changed):
        out = ["%s %d" % (key, p.value()) for key, p in self.params.items() if p.get_visible() and (not only_changed or p.changed())]
        pw = POWER[self.power.get_selected()]
        if self.power.get_sensitive() and (not only_changed or pw != self.read_power):
            out.append("power " + pw)
        return out


class CurvePage(Page):
    NAME, TITLE, ICON = "curve", "Curve", "view-list-symbolic"

    def __init__(self, win):
        super().__init__(win, CO_HELP)
        self.loading = False
        self.all = Param("Tutti", "", tooltip=CO_TIP)
        self.all.adj.connect("value-changed", self.on_all)
        self.body.append(self.all)
        self.body.append(Gtk.Separator())
        self.cores = [Param("Core %d" % c, "", info=True, tooltip=PARAM_HELP["co"]) for c in range(8)]
        for p in self.cores:
            self.body.append(p)
        self.buttons()

    def refresh(self, st):
        caps = st.get("caps")
        self.bar.set_sensitive(bool(caps))
        self.set_sensitive(bool(caps))
        if not caps:
            return
        self.loading = True
        lo, hi = caps["co"]
        base = (st.get("baseline") or {}).get("co")
        for c, p in enumerate(self.cores):
            p.setup(lo, hi, st["co"][c], base[c] if base else None)
        self.all.setup(lo, hi, st["co"][0])
        self.loading = False

    def telemetry(self, t):
        for c, p in enumerate(self.cores):
            d = t["cores"][c] if c < len(t["cores"]) else {}
            parts = [("%.2f GHz" % (d["mhz"] / 1000.0)).replace(".", ",") if d.get("mhz") is not None else "n/d"]
            if d.get("temp") is not None:
                parts.append("%g °C" % d["temp"])
            if d.get("volt") is not None:
                parts.append(volts(d["volt"]))
            p.info.set_text(" · ".join(parts))

    def on_all(self, adj):
        if not self.loading:
            for p in self.cores:
                p.adj.set_value(adj.get_value())

    def reset(self):
        for p in self.cores:
            p.reset()

    def lines(self, only_changed):
        if only_changed:
            return ["co %d %d" % (c, p.value()) for c, p in enumerate(self.cores) if p.changed()]
        return ["co " + " ".join(str(p.value()) for p in self.cores)]


class FansPage(Page):
    NAME, TITLE, ICON = "fans", "Ventole", "weather-windy-symbolic"

    def __init__(self, win):
        super().__init__(win, "Le ventole restano gestite dalla SmartFan del BIOS: qui si cambiano solo i tempi di salita/discesa e i punti "
                              "curva dei canali riconosciuti come ventola. Pompe e canali non controllabili sono protetti.")
        self.chans = {}     # n -> (up, down, editor, info) dei canali "ventola"
        self.pumps = {}     # n -> (switch velocità fissa, Param %, info) dei canali "pompa"
        self.cards = []
        self.missing = card()
        self.missing.append(label("Ventole non disponibili", ["heading"]))
        self.missing_text = label("", ["dim-label"], wrap=True)
        self.missing.append(self.missing_text)
        self.missing.append(button("Abilita (carica il modulo nct6775)", lambda: self.win.run([["fan", "enable"]], self.enabled), "suggested-action"))
        self.body.append(self.missing)
        self.spin = Gtk.Spinner(valign=Gtk.Align.CENTER)
        self.detect_btn = button("Rileva ruoli", self.autodetect)
        self.buttons(self.spin, self.detect_btn)

    def refresh(self, st):
        self.step_range = st.get("caps", {}).get("fan_step_ms") if st.get("caps") else None
        if st.get("fans"):
            self.show(st["fans"])
        else:
            self.show_missing(st.get("fans_error", "stato ventole non disponibile"))

    def show_missing(self, msg):
        self.missing_text.set_text(msg + "\n\n" + FAN_MISSING_HELP)
        self.missing.set_visible(True)
        self.bar.set_sensitive(False)
        self.clear()

    def enabled(self, res):
        r = res[0] or {}
        self.win.toast("Riavvio necessario: aggiunto acpi_enforce_resources=lax alla riga del kernel" if r.get("riavvio_necessario")
                       else "Chip %s disponibile" % r.get("chip", "?"))

    def clear(self):
        for c in self.cards:
            self.body.remove(c)
        self.cards, self.chans, self.pumps = [], {}, {}

    def show(self, fs):
        self.missing.set_visible(False)
        self.bar.set_sensitive(True)
        self.clear()
        for c in fs["canali"]:
            n, role, why = c["canale"], c.get("role", "sconosciuto"), c.get("why", "")
            box = card()
            head = Gtk.Box(spacing=12)
            name = Gtk.Entry(text=c.get("name") or "", placeholder_text="Canale %d" % n, width_chars=14, valign=Gtk.Align.CENTER)
            name.connect("activate", lambda e, n=n: self.win.run([["fan", "name", str(n)] + e.get_text().split()]))
            head.append(label("%d" % n, ["title-3"]))
            head.append(name)
            chip = label(role, ["chip", ROLE_CSS.get(role, "dim-label")], valign=Gtk.Align.CENTER)
            head.append(chip)
            head.append(label("%d giri/min · pwm %d (%d %%) · modo %d%s" % (c["rpm"], c["pwm"], pwm_pct(c["pwm"]), c["modo"],
                                                                          " · %d giri al 100 %%" % c["rpm_max"] if c.get("rpm_max") else ""), ["numeric"], hexpand=True))
            head.append(button("Identifica", lambda n=n: self.identify(n)))
            for target in ("pompa", "sconosciuto"):
                if role != target:
                    head.append(button("Segna " + target, lambda n=n, t=target: self.win.run([["fan", "role", str(n), t]])))
            box.append(head)
            box.append(label(why or "ruolo non rilevato: usa \"Rileva ruoli\" (nome: Invio per salvare)", ["dim-label", "caption"]))
            if role == "ventola" and self.step_range:
                up = Param("Salita", "s", digits=1, step=0.5, tooltip="Tempo fra un passo PWM e il successivo quando la temperatura sale: alto = la ventola ignora i picchi brevi")
                down = Param("Discesa", "s", digits=1, step=0.5, tooltip="Tempo fra un passo PWM e il successivo quando la temperatura scende")
                up.setup(self.step_range[0] / 1000.0, self.step_range[1] / 1000.0, c["step_up_ms"] / 1000.0)
                down.setup(self.step_range[0] / 1000.0, self.step_range[1] / 1000.0, c["step_down_ms"] / 1000.0)
                editor = CurveEditor(curve_points(c["curva"]), len(c["curva"]), c.get("rpm_max"))
                for prm in (up, down):
                    prm.adj.connect("value-changed", lambda *_, u=up, d=down, e=editor: e.set_reaction(u.value(), d.value()))
                editor.set_reaction(up.value(), down.value())
                for w in (up, down, editor):
                    box.append(w)
                self.chans[n] = (up, down, editor, c)
            elif role == "pompa":
                kind, pct = pump_mode(c)
                box.append(label("Di norma la pompa va lasciata al BIOS (consigliato). Se a pieno carico sale al 100 % e ronza, si può limitarla: "
                                 "«Tetto massimo» mantiene la curva del BIOS tagliando i punti sopra il tetto, «Velocità fissa» la tiene costante. "
                                 "Mai sotto il 50 %: il flusso non basta.", ["dim-label", "caption"], wrap=True))
                mode = Adw.ComboRow(title="Pompa", model=Gtk.StringList.new(list(PUMP_MODES)), selected=PUMP_KINDS.index(kind))
                lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
                lb.append(mode)
                box.append(lb)
                speed = Param("Pompa", "%", info=bool(c.get("rpm_max")), tooltip="Tetto o velocità fissa della pompa (50–100 %)")
                speed.setup(50, 100, pct if pct is not None else 100)   # range 50–100 % (ryzenctl rifiuta il resto)
                speed.set_sensitive(kind != "auto")
                mode.connect("notify::selected", lambda r, _, sp=speed: sp.set_sensitive(r.get_selected() != 0))
                if c.get("rpm_max"):   # ponytail: stima lineare giri = rpm_max × %
                    show_rpm = lambda *_, sp=speed, rm=c["rpm_max"]: sp.info.set_text("≈ %d giri" % (rm * sp.adj.get_value() / 100.0))
                    speed.adj.connect("value-changed", show_rpm)
                    show_rpm()
                box.append(speed)
                self.pumps[n] = (mode, speed, c)
            self.body.append(box)
            self.cards.append(box)

    def identify(self, n):
        self.win.toast("Canale %d al 100 %% per 5 secondi…" % n)
        bg(lambda: self.win.h.call("fan", "identify", str(n)),
           lambda r: self.win.toast("Canale %d: %d giri/min al 100 %%" % (n, r["rpm_al_100"])), self.win.toast)

    def autodetect(self):
        def go(ok):
            if not ok:
                return
            self.detect_btn.set_sensitive(False)
            self.spin.start()
            def done(res):
                self.spin.stop()
                self.detect_btn.set_sensitive(True)
                self.win.info("Ruoli rilevati", "\n".join("canale %s: %s (%s)" % (n, r["ruolo"], r["perché"]) for n, r in res.items()))
                self.win.reload()
            def fail(msg):
                self.spin.stop()
                self.detect_btn.set_sensitive(True)
                self.win.toast(msg)
            bg(lambda: self.win.h.call("fan", "autodetect"), done, fail)
        self.win.confirm("Rilevare i ruoli dei canali?", AUTODETECT_WARNING, "Avvia", go)

    def reset(self):
        for up, down, editor, c in self.chans.values():
            up.reset()
            down.reset()
            editor.reset()
        for mode, speed, c in self.pumps.values():
            mode.set_selected(PUMP_KINDS.index(pump_mode(c)[0]))
            speed.reset()

    def lines(self, only_changed):
        out = []
        for n, (up, down, editor, c) in sorted(self.chans.items()):
            ms = (int(round(up.value() * 1000)), int(round(down.value() * 1000)))
            if not only_changed or ms != (c["step_up_ms"], c["step_down_ms"]):
                out.append("fan %d step %d %d" % (n, ms[0], ms[1]))
            pts = editor.points()
            if not only_changed or pts != editor.read:
                out.append("fan %d curve %s" % (n, " ".join("%d:%d" % pt for pt in pts)))
        for n, (mode, speed, c) in sorted(self.pumps.items()):
            kind = PUMP_KINDS[mode.get_selected()]
            if only_changed and kind == pump_mode(c)[0] and (kind == "auto" or not speed.changed()):
                continue
            out.append("fan %d pump %s" % (n, {"auto": "auto", "max": "max %d" % speed.value(), "fixed": "%d" % speed.value()}[kind]))
        return out


