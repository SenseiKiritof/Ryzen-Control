class HelperError(Exception):
    pass


class Helper:
    """A single `ryzenctl serve` process; serialised calls. `call` blocks: use it through `bg`."""

    def __init__(self, mock):
        env = dict(os.environ)
        if mock:
            os.makedirs(MOCK_DIR, exist_ok=True)
            env["RYZENCTL_ROOT"] = MOCK_DIR
            subprocess.run([RYZENCTL, "boot"], env=env, check=False, stdout=subprocess.DEVNULL)   # the baseline of the fake "boot"
            cmd = [RYZENCTL, "serve"]
        else:
            cmd = ["pkexec", RYZENCTL, "serve"]
        self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=env, text=True, bufsize=1)
        self.lock = threading.Lock()
        self.pending = collections.deque()      # pending requests, in order: serve answers in order
        threading.Thread(target=self._reader, daemon=True).start()

    def _reader(self):
        for line in self.p.stdout:
            with self.lock:
                ev, slot = self.pending.popleft()
            slot["line"] = line
            ev.set()
        with self.lock:                          # process gone: wake up whoever is waiting
            while self.pending:
                ev, slot = self.pending.popleft()
                ev.set()

    def call(self, *argv):
        """Writes right away and waits for its own answer: this way `autotune abort` leaves while a
        long step is still running (serve interrupts it)."""
        ev, slot = threading.Event(), {}
        with self.lock:
            self.pending.append((ev, slot))
            try:
                self.p.stdin.write(json.dumps(list(argv)) + "\n")
                self.p.stdin.flush()
            except (OSError, ValueError):
                self.pending.remove((ev, slot))
                slot["line"] = ""
                ev.set()
        ev.wait()
        line = slot.get("line", "")
        if not line:
            raise HelperError(_("ryzenctl serve is not responding (pkexec denied or process terminated): restart the application"))
        r = json.loads(line)
        if not r.get("ok"):
            raise HelperError(r.get("error", _("unknown error")))
        return r.get("data")

    def close(self):
        try:
            self.p.stdin.close()
            self.p.wait(timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            self.p.kill()


def bg(work, done, fail):
    """work() in a thread; done(result) or fail(message) in the main loop. Never block the UI."""
    def run():
        try:
            out = work()
        except Exception as e:  # HelperError or bug: shown to the user, never lost
            GLib.idle_add(fail, str(e))
            return
        GLib.idle_add(done, out)
    threading.Thread(target=run, daemon=True).start()


def ui_load():
    """Per-user GUI preferences (UI_FILE); a missing or corrupt file gives the defaults (empty dict)."""
    try:
        with open(UI_FILE) as f:
            prefs = json.load(f)
    except (OSError, ValueError):
        prefs = None
    return prefs if isinstance(prefs, dict) else {}


def ui_save(prefs):
    """Temporary file + rename: an interrupted write never leaves half a file."""
    os.makedirs(os.path.dirname(UI_FILE), exist_ok=True)
    with open(UI_FILE + ".tmp", "w") as f:
        json.dump(prefs, f)
    os.replace(UI_FILE + ".tmp", UI_FILE)


def fmt(v, unit=""):
    return _("n/a") if v is None else ("%g%s" if isinstance(v, (int, float)) else "%s%s") % (v, unit)


def num(v, digits):
    """Decimal number with the locale's separator, like GTK's Scale and SpinButton: '1,245' under it_IT, '1.245' under en_US."""
    return locale.format_string("%.*f", (digits, v))


def mins(seconds):
    """Readable duration from the estimate in seconds: '~18 min' (rounded up), '0 min', 'n/a'."""
    if seconds is None:
        return _("n/a")
    m = -(-int(seconds) // 60)
    return _("~%d min") % m if m else _("0 min")


def volts(v, unit=" V"):
    """Readable voltage with the locale's decimal separator: '1,245 V'; 'n/a' if missing."""
    return _("n/a") if v is None else num(v, 3) + unit


def mhz(v):
    """Readable frequency with a space as thousands separator: '5 175 MHz'; 'n/a' if missing."""
    return _("n/a") if v is None else "{:,} MHz".format(int(v)).replace(",", " ")


def at_tested(st, c, level):
    """Was core c really tested at CO level `level`? In parallel the samples also report the cores
    already out of the test, parked at their last stable CO: those must be ignored."""
    u = st.get("unstable", {}).get(str(c))
    if u:
        return level >= u["value"]
    r = st.get("results", {}).get(str(c))
    return r is not None and level >= r


def at_sample(st, c, level=None):
    """(level, V, MHz) measured on core c: at the level closest to `level`, or the deepest one if None."""
    best = None
    for lvl, smp in st.get("samples", {}).items():
        smp, v = smp or {}, int(lvl)   # None: no per-core PM table layout on this CPU
        vs, ms = smp.get("volt") or [], smp.get("mhz") or []
        volt = vs[c] if c < len(vs) else None
        if v == 0 or volt is None or not at_tested(st, c, v):
            continue
        key = abs(v - level) if level is not None else v
        if best is None or key < best[0]:
            best = (key, v, volt, ms[c] if c < len(ms) else None)
    return best[1:] if best else None


def button(label, cb, css=None):
    b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
    if css:
        b.add_css_class(css)
    b.connect("clicked", lambda *_a: cb())
