class HelperError(Exception):
    pass


class Helper:
    """Un solo processo `ryzenctl serve`; chiamate serializzate. `call` blocca: usarla via `bg`."""

    def __init__(self, mock):
        env = dict(os.environ)
        if mock:
            root = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "ryzen-control-mock")
            os.makedirs(root, exist_ok=True)
            env["RYZENCTL_ROOT"] = root
            subprocess.run([RYZENCTL, "boot"], env=env, check=False, stdout=subprocess.DEVNULL)   # la baseline del "boot" finto
            cmd = [RYZENCTL, "serve"]
        else:
            cmd = ["pkexec", RYZENCTL, "serve"]
        self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=env, text=True, bufsize=1)
        self.lock = threading.Lock()
        self.pending = collections.deque()      # richieste in attesa, nell'ordine: serve risponde in ordine
        threading.Thread(target=self._reader, daemon=True).start()

    def _reader(self):
        for line in self.p.stdout:
            with self.lock:
                ev, slot = self.pending.popleft()
            slot["line"] = line
            ev.set()
        with self.lock:                          # processo finito: sveglia chi aspetta
            while self.pending:
                ev, slot = self.pending.popleft()
                ev.set()

    def call(self, *argv):
        """Scrive subito e aspetta la risposta propria: così `autotune abort` parte mentre un
        passo lungo è ancora in corso (serve lo interrompe)."""
        ev, slot = threading.Event(), {}
        with self.lock:
            self.pending.append((ev, slot))
            try:
                self.p.stdin.write(json.dumps(list(argv)) + "\n")
                self.p.stdin.flush()
            except (OSError, ValueError):
                self.pending.remove((ev, slot))
                slot["line"] = ""
                ev.set()
        ev.wait()
        line = slot.get("line", "")
        if not line:
            raise HelperError("ryzenctl serve non risponde (pkexec negato o processo terminato): riavvia l'applicazione")
        r = json.loads(line)
        if not r.get("ok"):
            raise HelperError(r.get("error", "errore sconosciuto"))
        return r.get("data")

    def close(self):
        try:
            self.p.stdin.close()
            self.p.wait(timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            self.p.kill()


def bg(work, done, fail):
    """work() in un thread; done(risultato) o fail(messaggio) nel main loop. Mai bloccare la UI."""
    def run():
        try:
            out = work()
        except Exception as e:  # HelperError o bug: mostrato all'utente, mai perso
            GLib.idle_add(fail, str(e))
            return
        GLib.idle_add(done, out)
    threading.Thread(target=run, daemon=True).start()


def fmt(v, unit=""):
    return "n/d" if v is None else ("%g%s" if isinstance(v, (int, float)) else "%s%s") % (v, unit)


def mins(seconds):
    """Durata leggibile dalla stima in secondi: '~18 min' (arrotondata per eccesso), '0 min', 'n/d'."""
    if seconds is None:
        return "n/d"
    m = -(-int(seconds) // 60)
    return "~%d min" % m if m else "0 min"


def volts(v, unit=" V"):
    """Tensione leggibile con la virgola decimale: '1,245 V'; 'n/d' se assente."""
    return "n/d" if v is None else ("%.3f" % v).replace(".", ",") + unit


def at_tested(st, c, level):
    """Il core c è stato davvero provato al livello di CO `level`? In parallelo i campioni riportano
    anche i core già usciti dalla prova, fermi al loro ultimo CO stabile: vanno ignorati."""
    u = st.get("unstable", {}).get(str(c))
    if u:
        return level >= u["value"]
    r = st.get("results", {}).get(str(c))
    return r is not None and level >= r


def at_sample(st, c, level=None):
    """(livello, V) misurati sul core c: al livello più vicino a `level`, o al più profondo se None."""
    best = None
    for lvl, smp in st.get("samples", {}).items():
        v = int(lvl)
        volt = (smp.get("volt") or [None] * 8)[c] if c < len(smp.get("volt") or []) else None
        if v == 0 or volt is None or not at_tested(st, c, v):
            continue
        key = abs(v - level) if level is not None else v
        if best is None or key < best[0]:
            best = (key, v, volt)
    return (best[1], best[2]) if best else None


def at_slope(st):
    """mV per passo di CO misurati su questa CPU: media su core e livelli di (V0 − Vlivello)/|livello|;
    None con meno di due livelli campionati."""
    ref = (st.get("samples", {}).get("0") or {}).get("volt") or []
    vals, levels = [], set()
    for lvl, smp in st.get("samples", {}).items():
        v = int(lvl)
        if v == 0:
            continue
        for c, volt in enumerate(smp.get("volt") or []):
            if volt is not None and c < len(ref) and ref[c] is not None and at_tested(st, c, v):
                vals.append((ref[c] - volt) / abs(v) * 1000)
                levels.add(v)
    return sum(vals) / len(vals) if len(levels) >= 2 and vals else None


def button(label, cb, css=None):
    b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
    if css:
        b.add_css_class(css)
    b.connect("clicked", lambda *_: cb())
    return b


def label(text="", css=(), xalign=0.0, **kw):
    lab = Gtk.Label(label=text, xalign=xalign, **kw)
    for c in css:
        lab.add_css_class(c)
    return lab


def card(orientation=Gtk.Orientation.VERTICAL, spacing=6):
    return Gtk.Box(orientation=orientation, spacing=spacing, css_classes=["card", "tile"])


def diff_label(base, new, unit="", lower_is_better=True):
    """Etichetta 'fabbrica → nuovo Δ': verde se più conservativo della baseline, rosso se più spinto, grigio se uguale."""
    def num(v):
        if isinstance(v, str) and v in POWER:
            return POWER.index(v)
        return v if isinstance(v, (int, float)) else None
    u = (" " + unit) if unit else ""
    if base is None or base == new:
        return label(fmt(new, u), ["numeric", "dim-label"])
    b, n = num(base), num(new)
    text, css = "%s → %s" % (fmt(base), fmt(new, u)), "accent"
    if b is not None and n is not None:
        d = n - b
        if unit in ("W", "A") and b:
            text += "  %+.0f %%" % (d * 100.0 / b)
        elif isinstance(base, (int, float)):
            text += "  %+g" % d
        css = "success" if (d < 0) == lower_is_better else "error"
    lab = label("", ["numeric", css])
    lab.set_markup("<b>%s</b>" % GLib.markup_escape_text(text))
    return lab


def values_of(lines):
    """Righe di profilo → {ppt, tdc, edc, fmax, tjmax, power, co: [8], fan: {n: {step: (su, giù), curve: str}}}."""
    v = {"fan": {}}
    for t in (l.split() for l in lines):
        try:
            if t[0] == "co":
                if len(t) == 9:
                    v["co"] = [int(x) for x in t[1:]]
                elif len(t) == 3:
                    co = v.setdefault("co", [None] * 8)
                    for c in (range(8) if t[1] == "all" else [int(t[1])]):
                        co[c] = int(t[2])
            elif t[0] == "fan" and len(t) >= 4:
                f = v["fan"].setdefault(int(t[1]), {})
                if t[2] == "step":
                    f["step"] = (int(t[3]), int(t[4]))
                elif t[2] == "curve":
                    f["curve"] = " ".join(t[3:])
            elif t[0] == "power":
                v["power"] = t[1]
            elif len(t) == 2:
                v[t[0]] = int(t[1])
        except (ValueError, IndexError):
            pass   # riga non riconosciuta: la valida ryzenctl, qui si mostra solo
    return v


def profile_table(lines, st):
    """Tabella 'parametro · fabbrica → profilo' colorata (baseline da status, ventole da fan status)."""
    v, base = values_of(lines), st.get("baseline") or {}
    fans = {c["canale"]: c for c in (st.get("fans") or {}).get("canali", [])}
    rows = [(title, diff_label(base.get(key), v[key], unit)) for key, title, unit in CPU_PARAMS if key in v]
    if "power" in v:
        rows.append(("Energia", diff_label(base.get("power"), v["power"])))
    if "co" in v:
        chips, bco = Gtk.Box(spacing=4), base.get("co") or [None] * 8
        for c in range(8):
            if v["co"][c] is not None:
                chip = diff_label(bco[c], v["co"][c])
                chip.set_text("%+d" % v["co"][c])
                chip.set_tooltip_text("core %d: fabbrica %s" % (c, fmt(bco[c])))
                chip.add_css_class("chip")
                chips.append(chip)
        rows.append(("CO (Curve Optimizer) per core", chips, CO_TIP))
    for n, f in sorted(v["fan"].items()):
        cur = fans.get(n, {})
        if "step" in f:
            tol = (st.get("caps") or {}).get("fan_step_tol_ms", 0)   # il chip arrotonda (es. 5000 → 5200)
            for name, cur_v, new_v in (("salita", cur.get("step_up_ms"), f["step"][0]), ("discesa", cur.get("step_down_ms"), f["step"][1])):
                same = cur_v is not None and abs(cur_v - new_v) <= tol
                rows.append(("Ventola %d %s" % (n, name), diff_label(new_v if same else cur_v, new_v, "ms", lower_is_better=False)))
        if "curve" in f:
            rows.append(("Ventola %d curva" % n, diff_label(" ".join(cur["curva"]) if cur.get("curva") else None, f["curve"])))
    grid = Gtk.Grid(column_spacing=18, row_spacing=4, margin_top=6, margin_bottom=6, margin_start=12, margin_end=12)
    for i, row in enumerate(rows):
        grid.attach(label(row[0], ["dim-label"], tooltip_text=row[2] if len(row) > 2 else None), 0, i, 1, 1)
        grid.attach(row[1], 1, i, 1, 1)
    if not rows:
        grid.attach(label("profilo vuoto", ["dim-label"]), 0, 0, 1, 1)
    return grid


def profile_view(lines, st):
    """Tabella colorata + righe grezze in un expander (per i dialoghi)."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    box.append(profile_table(lines, st))
    box.append(Gtk.Expander(label="Righe del profilo", child=label("\n".join(lines), ["numeric", "dim-label"], selectable=True, margin_top=6)))
    return box


class Param(Gtk.Box):
    """Riga parametro: etichetta, info, Scale con marks, SpinButton (stessa Adjustment), 'attuale → nuovo'."""

    def __init__(self, title, unit, info=False, tooltip=None):
        super().__init__(spacing=12, tooltip_text=tooltip)
        self.unit, self.read = unit, None
        self.adj = Gtk.Adjustment(lower=0, upper=1, step_increment=1, page_increment=5)
        self.append(label(title, ["heading"], width_chars=9))
        self.info = label("", ["dim-label", "numeric"], width_chars=26, visible=info)
        self.append(self.info)
        self.scale = Gtk.Scale(adjustment=self.adj, hexpand=True, draw_value=True, digits=0, value_pos=Gtk.PositionType.TOP)
        self.append(self.scale)
        self.append(Gtk.SpinButton(adjustment=self.adj, digits=0, valign=Gtk.Align.CENTER))
        self.delta = label("", ["numeric"], xalign=1.0, width_chars=15)
        self.append(self.delta)
        self.adj.connect("value-changed", self.show_delta)

    def setup(self, lo, hi, read, base=None):
        self.read = read
        self.adj.set_lower(lo)
        self.adj.set_upper(hi)
        self.scale.clear_marks()
        self.scale.add_mark(lo, Gtk.PositionType.BOTTOM, "%d" % lo)
        self.scale.add_mark(hi, Gtk.PositionType.BOTTOM, "%d" % hi)
        if base is not None and lo < base < hi:
            self.scale.add_mark(base, Gtk.PositionType.BOTTOM, "fabbrica %d" % base)
        self.reset()

    def value(self):
        return int(round(self.adj.get_value()))

    def changed(self):
        return self.read is not None and self.value() != self.read

    def reset(self):
        if self.read is not None:
            self.adj.set_value(self.read)
        self.show_delta()

    def show_delta(self, *_):
        if self.read is None:
            return
        if self.changed():
            self.delta.set_markup("<span alpha='60%%'>%d</span> → <b>%d</b> %s" % (self.read, self.value(), self.unit))
            self.delta.add_css_class("accent")
        else:
            self.delta.set_markup("<span alpha='60%%'>%d %s</span>" % (self.read, self.unit))
            self.delta.remove_css_class("accent")


class Page(Gtk.Box):
    """Contenuto scorrevole + barra pulsanti fissa in fondo."""

    def __init__(self, win, help_text=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.win = win
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=12, margin_bottom=12,
                            margin_start=12, margin_end=12)
        if help_text:
            self.body.append(label(help_text, ["dim-label"], wrap=True))
        self.append(Gtk.ScrolledWindow(child=self.body, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER))
        self.bar = Gtk.Box(spacing=12, halign=Gtk.Align.END, css_classes=["toolbar"])
        self.append(self.bar)

    def buttons(self, *extra):
        for b in extra:
            self.bar.append(b)
        self.bar.append(button("Ripristina valori letti", self.reset))
        self.bar.append(button("Salva nel profilo…", lambda: self.win.save_profile(self.lines(False))))
        self.bar.append(button("Applica ora", lambda: self.win.apply_lines(self.lines(True)), "suggested-action"))

    def telemetry(self, t):
        pass


