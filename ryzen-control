        self.power = label("", ["dim-label"], xalign=1.0)
        bottom.append(self.power)
        self.append(bottom)

    def refresh(self, st):
        pass   # il monitor vive di `telemetry`

    def telemetry(self, t):
        value, sub, _ = self.tiles["tctl"]
        value.set_text(fmt(t["tctl"], " °C"))
        sub.set_text("Tccd " + fmt(t["tccd"], " °C") + " · Tjmax " + fmt(t["tjmax"], " °C"))
        for key, unit in (("ppt", "W"), ("tdc", "A")):
            value, sub, bar = self.tiles[key]
            v, lim = t[key], t[key + "_limit"]
            value.set_text(fmt(v, " " + unit))
            sub.set_text("limite " + fmt(lim, " " + unit))
            if v is not None and lim:
                bar.set_max_value(lim)
                bar.set_value(min(v, lim))
        value, sub, _ = self.tiles["fmax"]
        value.set_text(fmt(t["fmax"], " MHz"))
        sub.set_text("EDC limite " + fmt(t["edc_limit"], " A"))
        if t["tctl"] is not None:
            self.hist.append((t["tctl"], t["ppt"]))
            self.ppt_limit = t["ppt_limit"]
            self.graph.queue_draw()
        for c, labs in enumerate(self.cores):
            d = t["cores"][c] if c < len(t["cores"]) else {}
            labs[0].set_text(fmt(d.get("mhz")))
            labs[1].set_text(fmt(d.get("temp")))
            labs[2].set_text(volts(d.get("volt"), ""))
            labs[3].set_text("%+d" % d["co"] if d.get("co") is not None else "n/d")
        for f in t["fans"]:
            lab = self.fan_labels.get(f["canale"])
            if lab is None:
                lab = self.fan_labels[f["canale"]] = label("", ["numeric"])
                self.fans.append(lab)
            pwm = f.get("pwm")
            if pwm is None:   # telemetry non porta il pwm: ultimo `fan status` (aggiornato a ogni ricarica)
                pwm = next((c["pwm"] for c in (self.win.status.get("fans") or {}).get("canali", []) if c["canale"] == f["canale"]), None)
            lab.set_text("%s (%s) · %d giri/min%s" % (f.get("name") or "Canale %d" % f["canale"], f.get("role", "sconosciuto"), f["rpm"],
                                                      " · pwm %d (%d %%)" % (pwm, pwm_pct(pwm)) if pwm is not None else ""))
        if not self.fan_labels:
            self.fans.append(label("Nessuna ventola rilevata", ["dim-label"]))
            self.fan_labels[0] = None
        self.power.set_text("Profilo energetico: " + (t["power"] or "n/d"))

    def draw(self, area, cr, w, h):
        lo, hi, plim = 30, 95, self.ppt_limit or 1
        y_t = lambda t: h - 14 - (min(max(t, lo), hi) - lo) / (hi - lo) * (h - 18)
        y_p = lambda p: h - 14 - min(max(p, 0), plim) / plim * (h - 18)
        col = area.get_color()
        cr.set_source_rgba(col.red, col.green, col.blue, 0.35)
        cr.set_line_width(1)
        cr.set_font_size(10)
        for t in (40, 60, 80, 95):
            cr.move_to(0, y_t(t))
            cr.line_to(w, y_t(t))
            cr.stroke()
            cr.move_to(4, y_t(t) - 2)
            cr.show_text("%d" % t)
            cr.move_to(w - 30, y_t(t) - 2)
            cr.show_text("%d" % round(plim * (t - lo) / (hi - lo)))
        n = self.hist.maxlen
        for idx, rgb in ((0, (0.21, 0.52, 0.89)), (1, (0.90, 0.45, 0.13))):
            pts = [(w * (n - len(self.hist) + i) / (n - 1), v[idx]) for i, v in enumerate(self.hist) if v[idx] is not None]
            if len(pts) < 2:
                continue
            cr.set_source_rgb(*rgb)
            cr.set_line_width(2)
            for i, (x, v) in enumerate(pts):
                (cr.move_to if i == 0 else cr.line_to)(x, y_t(v) if idx == 0 else y_p(v))
            cr.stroke()


class AutotuneDialog(Adw.Window):
    """Avanzamento della calibrazione: un `autotune step` alla volta finché phase == done.
    Finestra separata e ridimensionabile (Adw.Dialog ha dimensioni fisse e la tabella è alta)."""

    def __init__(self, win, mode):
        super().__init__(title="Calibrazione %s" % mode.capitalize(), transient_for=win, modal=True, destroy_with_parent=True,
                         default_width=max(640, int(win.get_width() * 0.9)), default_height=max(560, int(win.get_height() * 0.9)))
        self.win, self.mode = win, mode
        self.running = self.aborting = False
        self.closable = False
        self.connect("close-request", self.on_close_request)
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        self.header = label("", ["dim-label"], wrap=True)
        self.reuse = label("", ["dim-label"], wrap=True, visible=False)
        # altezze costanti: ogni cambio di altezza sposta la tabella e il compositore lascia frammenti
        self.phase = label("Avvio…", ["title-3"], hexpand=True, ellipsize=Pango.EllipsizeMode.END, single_line_mode=True)
        self.eta = label(" ", ["numeric"], xalign=1.0)
        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        top.append(self.phase)
        top.append(self.eta)
        self.progress = Gtk.ProgressBar(show_text=True)
        self.note = label("", ["warning"], wrap=True, visible=False)
        for w in (self.header, self.reuse, top, self.progress, self.note, label("CO (Curve Optimizer) per core", ["heading"], tooltip_text=CO_TIP)):
            body.append(w)
        grid = Gtk.Grid(column_spacing=14, row_spacing=4, hexpand=True)
        heads = (("Core", None), ("Fabbrica", "CO di fabbrica; sotto, la tensione di riferimento misurata all'avvio con lo stesso carico"),
                 ("In prova", "Livello di CO in prova sul core; sotto, l'ultima tensione misurata a pieno carico e la differenza dal riferimento"),
                 ("Ultimo stabile", None), ("Instabile a", None),
                 ("Definitivo", "limite misurato + margine della modalità + 3 per ogni passata finale fallita"))
        for col, (h, tip) in enumerate(heads):
            grid.attach(label(h, ["heading"], tooltip_text=tip), col, 0, 1, 1)
        self.cells = []
        for c in range(8):
            cell = {"core": label("%d" % c, ["numeric"], valign=Gtk.Align.START)}
            boxes = []
            for key in ("fab", "prova"):   # due righe: CO sopra, tensione sotto; larghezza fissa = niente riflussi
                cell[key] = (label("—", ["numeric"], width_chars=4 if key == "fab" else 8),
                             label(" ", ["numeric", "caption"], width_chars=9 if key == "fab" else 22))
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                box.append(cell[key][0])
                box.append(cell[key][1])
                boxes.append(box)
            for key, wc in (("stable", 6), ("unstable", 16), ("final", 6)):
                cell[key] = label("—", ["numeric"], valign=Gtk.Align.START, width_chars=wc)
            for col, w in enumerate([cell["core"]] + boxes + [cell["stable"], cell["unstable"], cell["final"]]):
                w.set_hexpand(col > 0)          # le colonne dati si dividono la larghezza disponibile
                grid.attach(w, col, c + 1, 1, 1)
            self.cells.append(cell)
        body.append(grid)
        body.append(label("Un passo di CO (Curve Optimizer) vale circa 3–5 mV di tensione in meno a parità di frequenza; "
                          "qui vedi la tensione reale misurata a pieno carico per ogni livello.", ["dim-label", "caption"], wrap=True))
        self.slope = label("", ["numeric"], visible=False)
        body.append(self.slope)
        self.failures = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)   # passate finali fallite, una riga ciascuna
        body.append(self.failures)
        self.fmax = label("", ["numeric"], wrap=True)
        body.append(self.fmax)
        self.result = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        body.append(self.result)
        bar = Gtk.Box(spacing=12, halign=Gtk.Align.END, css_classes=["toolbar"])
        self.abort_btn = button("Interrompi", self.abort, "destructive-action")
        self.close_btn = button("Chiudi", self.discard)                        # errore: niente da salvare
        self.discard_btn = button("Annulla", self.discard, "destructive-action")
        self.save_btn = button("Salva", lambda: self.save(False))
        self.save_apply_btn = button("Salva e applica", lambda: self.save(True), "suggested-action")
        for b in (self.close_btn, self.discard_btn, self.save_btn, self.save_apply_btn):
            b.set_visible(False)
        self.save_btn.set_tooltip_text("Scrive il profilo %s senza attivarlo: si applica dalla pagina Modalità" % mode)
        self.save_apply_btn.set_tooltip_text("Scrive il profilo %s, lo applica subito e lo seleziona" % mode)
        for b in (self.abort_btn, self.close_btn, self.discard_btn, self.save_btn, self.save_apply_btn):
            bar.append(b)
        # a finestra larga il contenuto resta centrato e leggibile (max 1100 px), la griglia si allarga
        clamp = Adw.Clamp(child=body, maximum_size=1100, tightening_threshold=800)
        tv = Adw.ToolbarView(content=Gtk.ScrolledWindow(child=clamp, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER))
        tv.add_top_bar(Adw.HeaderBar())
        tv.add_bottom_bar(bar)
        self.set_content(tv)
        self.present()

    def on_close_request(self, *_):
        if not self.closable:
            self.win.toast("Calibrazione in corso: usa \"Interrompi\"")
            return True     # blocca la chiusura
        return False

    def start(self, params):
        argv = ["autotune", "start", self.mode] + ["%s=%d" % kv for kv in params.items()]
        bg(lambda: self.win.h.call(*argv), self.got, self.fail)

    def loop(self):
        if self.running or self.aborting:
            return
        self.running = True
        bg(lambda: self.win.h.call("autotune", "step"), self.got, self.fail)

    def got(self, st):
        self.running = False
        self.show(st)
        if st.get("phase") == "done":
            self.done(st)
        else:
            self.loop()

    def fail(self, msg):
        self.running = False
        self.phase.set_text("Errore: " + msg)
        self.abort_btn.set_visible(False)
        self.close_btn.set_visible(True)
        setattr(self, "closable", True)

    def show(self, st):
        ph, p = st.get("phase"), st.get("params", {})
        if st.get("resumed_after_crash"):
            self.note.set_text("Il sistema si è riavviato durante un test: quel passo è stato marcato instabile. Se il CO finale era già "
                               "applicato, la combinazione è instabile e la passata finale viene ripetuta con +3 su tutti i core.")
            self.note.set_visible(True)
        if st.get("co_reused"):   # ricerca saltata: tabella già popolata, la fase CO conta come completata nella barra
            self.reuse.set_text("Limite CO riusato dalla misura del %s. %s" % (st["co_reused"], crash_story(st)))
            self.reuse.set_visible(True)
        eta = st.get("eta") or {}
        if eta:
            self.header.set_text("Avviata alle %s · stimati %s in totale" % (st.get("started", "")[-5:], mins(eta.get("total_s"))))
            self.eta.set_text("Tempo rimanente stimato: %s" % mins(eta.get("remaining_s")))
        if ph == "co" and st.get("parallel"):
            levels = max(1, (-(p.get("colimit") or -5)) // 5)      # livelli di 5 (CO_STEP), come at_estimate in ryzenctl
            self.phase.set_text("Livello CO %d: provo tutti i core insieme (ancora in prova: %d core)…" % (st["value"], len(st.get("active_cores", []))))
            frac = AT_PHASES["co"] * max(0, (-st["value"]) // 5 - 1) / levels
        elif ph == "co":
            self.phase.set_text("Core %d: provo CO %d…" % (st["core"], st["value"]))
            frac = (st["core"] + min(1.0, st["value"] / p["colimit"] if p.get("colimit") else 0)) / 8
        elif ph == "final":
            self.phase.set_text("Passata finale su tutti i core a CO %s (tentativo %d/3)" % (self.co_span(self.final_values(st)), st.get("final_tries", 0) + 1))
            frac = AT_PHASES["co"] + (AT_PHASES["final"] - AT_PHASES["co"]) * min(1.0, st.get("final_tries", 0) / 3)
        elif ph == "fmax":
            f, tests = st["fmax"].get("current"), st["fmax"].get("tests", [])
            last = tests[-1] if tests else None
            self.phase.set_text("FMax %d MHz: picco Tctl %.1f °C > %d → provo %s MHz…" % (last[0], last[1], p["target"], f) if last
                                else "FMax %s MHz: misuro il picco Tctl…" % f)
            first = tests[0][0] if tests else f
            frac = AT_PHASES["final"] + (AT_PHASES["fmax"] - AT_PHASES["final"]) * ((first - f) / max(1, first - 4000) if f else 0)
        elif ph == "bench":                       # Boost: un solo passo, prestazioni a fabbrica e in boost
            self.phase.set_text("Misuro le prestazioni a fabbrica e in boost (MT e ST)…" + self.load_text(st))
            frac = (AT_PHASES["final"] + AT_PHASES["bench"]) / 2
        elif ph in ("ppt", "fmax_knee"):          # Auto: ginocchio prestazioni/watt
            k = st.get("knee", {}).get("ppt" if ph == "ppt" else "fmax", {})
            tests, cur = k.get("tests", []), k.get("current")
            unit = "W" if ph == "ppt" else "MHz"
            if tests:
                last = tests[-1]
                self.phase.set_text("%s %s %s: %.0f op/s a %.0f W → provo %s %s…%s" % (
                    "PPT" if ph == "ppt" else "FMax", last[0], unit, last[1], last[2], cur, unit, self.load_text(st)))
            else:
                self.phase.set_text("%s %s %s: misuro prestazioni e potenza…%s" % ("PPT" if ph == "ppt" else "FMax", cur, unit, self.load_text(st)))
            lo, hi = (AT_PHASES["final"], AT_PHASES["ppt"]) if ph == "ppt" else (AT_PHASES["ppt"], AT_PHASES["fmax_knee"])
            frac = lo + (hi - lo) * min(1.0, len(tests) / 6.0)
        else:
            self.phase.set_text("Calibrazione completata" if not st.get("error") else "Calibrazione terminata: " + st["error"])
            frac = 1.0
        self.progress.set_fraction(max(0.0, min(1.0, frac)))
        self.queue_draw()                   # ridisegno completo: niente frammenti del fotogramma precedente
        res, uns, fin = st.get("results", {}), st.get("unstable", {}), st.get("final")
        base_co = (self.win.status.get("baseline") or {}).get("co") or [None] * 8
        ref = (st.get("samples", {}).get("0") or {}).get("volt") or [None] * 8
        ref_mhz = (st.get("samples", {}).get("0") or {}).get("mhz") or [None] * 8
        active = st.get("active_cores", []) if st.get("parallel") else [st.get("core")]
        for c, cell in enumerate(self.cells):
            fab_sub = volts(ref[c]) + (" · " + mhz(ref_mhz[c]) if ref_mhz[c] is not None else "") if ref[c] is not None else None
            self.two_lines(cell["fab"], "%d" % base_co[c] if base_co[c] is not None else "—", fab_sub)
            smp = at_sample(st, c)                      # misura più profonda disponibile per questo core
            cur = st["value"] if ph == "co" and c in active else (smp[0] if smp else None)
            sub, css = None, None
            if smp:
                dmv = round((smp[1] - ref[c]) * 1000) if ref[c] is not None else None
                sub = (("" if smp[0] == cur else "a %d: " % smp[0]) + volts(smp[1]) + (" · " + mhz(smp[2]) if smp[2] is not None else "")
                       + ("" if dmv is None else " · %+d mV" % dmv))
                css = "success" if dmv is not None and dmv < 0 else None
            self.two_lines(cell["prova"], "%d" % cur if cur is not None else "—", sub, css)
            for lab, text, cls in ((cell["stable"], "%d" % res[str(c)] if str(c) in res else None, "success"),
                                   (cell["unstable"], "%d (%s)" % (uns[str(c)]["value"], uns[str(c)]["why"]) if str(c) in uns else None, "error"),
                                   (cell["final"], "%d" % fin[c] if fin else None, "success")):
                lab.set_markup("<b>%s</b>" % text if text and lab is cell["final"] else (text or "—"))
                (lab.add_css_class if text else lab.remove_css_class)(cls)
        fails = st.get("final_failures") or []
        while self.failures.get_first_child():
            self.failures.remove(self.failures.get_first_child())
        for f in fails:
            self.failures.append(label("Passata finale fallita a CO %s (%s): +3 su tutti i core e nuovo tentativo" % (self.co_span(f.get("values") or [0]), f.get("why", "?")),
                                       ["warning"], wrap=True))
        slope = st.get("mv_per_step")          # mediana delle pendenze per livello, calcolata da ryzenctl
        self.slope.set_visible(slope is not None)
        if slope is not None:
            self.slope.set_text("Misurato su questa CPU: ≈ %s mV per passo di CO" % ("%.1f" % slope).rstrip("0").rstrip(".").replace(".", ","))
        tests = st.get("fmax", {}).get("tests", [])
        text = "Test FMax:\n" + "\n".join("%s → picco Tctl %s °C" % (mhz(t[0]), ("%.1f" % t[1]).replace(".", ",")) for t in tests) if tests else ""
        knee = st.get("knee")
        if knee:
            for key, unit in (("ppt", "W"), ("fmax", "MHz")):
                if knee[key]["tests"]:
                    text += ("\n" if text else "") + "Sweep %s:\n" % key.upper() + "\n".join(
                        "%s %s → %.0f op/s, %.0f W" % (t[0], unit, t[1], t[2]) for t in knee[key]["tests"])
        self.fmax.set_text(text)

    @staticmethod
    def final_values(st):
        """CO della passata finale: limite misurato + margine (calcolato da ryzenctl: modalità, passate fallite, crash)."""
        m = st.get("final_margin", st.get("params", {}).get("margin", 0) + 3 * st.get("final_tries", 0))
        return [min(0, st.get("results", {}).get(str(c), 0) + m) for c in range(8)]

    @staticmethod
    def co_span(vals):
        return "%d" % vals[0] if min(vals) == max(vals) else "%d … %d" % (min(vals), max(vals))

    @staticmethod
    def load_method(st):
        """Metodo stress-ng scelto da ryzenctl come più pesante su questa CPU (Auto: knee.method, Boost: method)."""
        return (st.get("knee") or {}).get("method") or st.get("method")

    def load_text(self, st):
        m = self.load_method(st)
        return " (carico: %s)" % m if m else ""

    @staticmethod
    def two_lines(pair, main, sub=None, sub_css=None):
        pair[0].set_text(main)
        pair[1].set_text(sub or "")
        if not sub:
            pair[1].set_text(" ")          # resta allocata: l'altezza della riga non cambia
        pair[1].remove_css_class("success")
        if sub_css:
            pair[1].add_css_class(sub_css)

    def done(self, st):
        if st.get("error"):
            self.result.append(label(st["error"], ["warning"], wrap=True))
        tries = st.get("final_tries", 0)
        crashed = any(u.get("why") == "crash" for u in (st.get("unstable") or {}).values())
        if (tries or crashed) and st.get("final"):
            why = []
            if tries:
                why.append("la passata combinata è fallita %d volt%s" % (tries, "a" if tries == 1 else "e"))
            if crashed:
                why.append("la ricerca si è chiusa con un blocco del sistema (+3)")
            self.result.append(label("Il margine finale è +%d perché %s" % (st.get("final_margin", 0), " e ".join(why)), ["warning"], wrap=True))
        if st.get("final"):   # per core: CO fabbrica → definitivo e ΔV misurata (campione al livello definitivo o al più vicino)
            base_co = (self.win.status.get("baseline") or {}).get("co") or [None] * 8
            ref = (st.get("samples", {}).get("0") or {}).get("volt") or [None] * 8
            grid = Gtk.Grid(column_spacing=18, row_spacing=4)
            for col, h in enumerate(("Core", "CO fabbrica → definitivo", "ΔV misurata")):
                grid.attach(label(h, ["heading"], tooltip_text=CO_TIP if col == 1 else None), col, 0, 1, 1)
            for c in range(8):
                grid.attach(label("%d" % c, ["numeric"]), 0, c + 1, 1, 1)
                grid.attach(diff_label(base_co[c], st["final"][c]), 1, c + 1, 1, 1)
                smp = at_sample(st, c, st["final"][c])
                if smp and ref[c] is not None:
                    dmv = round((smp[1] - ref[c]) * 1000)
                    lab = label("%+d mV (%s → %s%s a CO %d)" % (dmv, volts(ref[c]), volts(smp[1]), ", " + mhz(smp[2]) if smp[2] is not None else "", smp[0]),
                                ["numeric", "success" if dmv < 0 else "dim-label"])
                else:
                    lab = label("n/d", ["numeric", "dim-label"])
                grid.attach(lab, 2, c + 1, 1, 1)
            self.result.append(label("CO (Curve Optimizer) per core: fabbrica → definitivo, con la tensione misurata", ["heading"], tooltip_text=CO_TIP))
            self.result.append(grid)
        bench = st.get("bench")
        if bench and bench.get("gain_mt_pct") is not None:
            pct = lambda v: ("%+.1f %%" % v).replace(".", ",") if v is not None else "n/d"
            ops = lambda d: ("%.0f" % (d or {}).get("mt", [0])[0])
            g = bench["gain_mt_pct"]
            self.result.append(label("Guadagno misurato: multi-thread %s (%s → %s op/s), single-thread %s" % (
                pct(g), ops(bench.get("fabbrica")), ops(bench.get("boost")), pct(bench.get("gain_st_pct"))),
                ["numeric", "success" if g > 0 else ("error" if g < 0 else "dim-label")], wrap=True))
        if st.get("profile_lines"):
            self.result.append(label("Profilo %s: fabbrica → calibrato" % self.mode, ["heading"]))
            self.result.append(profile_view(st["profile_lines"], self.win.status))
        if st.get("fmax", {}).get("chosen") and not st.get("profile_lines"):
            self.result.append(label("FMax scelta: %d MHz" % st["fmax"]["chosen"], ["numeric"]))
        knee = st.get("knee")
        if knee and knee["ppt"].get("chosen"):
            self.result.append(label("Ginocchio prestazioni/watt: PPT %d W, FMax %d MHz (perdita massima %d %%)" % (
                knee["ppt"]["chosen"], knee["fmax"]["chosen"] or 0, st.get("params", {}).get("loss", 0)), ["numeric"], wrap=True))
        method = self.load_method(st)
        if method:
            self.result.append(label("Carico di prova: %s — quello che consuma di più su questa CPU" % method, ["dim-label"], wrap=True))
        # ponytail: "sotto il limite" = oltre il 5 % in meno; i W della PM table oscillano di qualche unità intorno al limite
        below = [t for t in (knee or {}).get("ppt", {}).get("tests", []) if len(t) >= 3 and t[2] < t[0] * 0.95]
        if len(below) > 1:
            self.result.append(label("Il carico di prova non ha raggiunto il limite di potenza impostato: il ginocchio vale per carichi di questa intensità",
                                     ["warning"], wrap=True))
        self.abort_btn.set_visible(False)
        if st.get("profile_lines"):
            self.phase.set_text("Calibrazione completata: annullare, salvare o salvare e applicare?")
            for b in (self.discard_btn, self.save_btn, self.save_apply_btn):
                b.set_visible(True)
        else:
            self.phase.set_text("Calibrazione terminata senza un profilo da salvare")
            self.close_btn.set_visible(True)
        # la scelta è obbligatoria: la finestra si chiude solo dopo (lo stato resta su disco e viene riproposto)

    def choose(self, argv, msg):
        for b in (self.close_btn, self.discard_btn, self.save_btn, self.save_apply_btn):
            b.set_sensitive(False)
        self.win.run([argv], lambda _: (self.win.toast(msg), setattr(self, "closable", True), self.close()))

    def discard(self):
        self.choose(["autotune", "abort"], "Calibrazione annullata, CPU a baseline")

    def save(self, apply):
        self.choose(["autotune", "save"] + (["apply"] if apply else []),
                    "Profilo %s salvato e applicato" % self.mode if apply else "Profilo %s salvato (non applicato)" % self.mode)

    def abort(self):
        self.aborting = True
        self.abort_btn.set_sensitive(False)
        self.phase.set_text("Interrompo…")
        self.win.run([["autotune", "abort"]], lambda _: (self.win.toast("Calibrazione annullata, CPU a baseline"), setattr(self, "closable", True), self.close()))


class ModesPage(Gtk.ScrolledWindow):
