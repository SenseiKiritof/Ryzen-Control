def label(text="", css=(), xalign=0.0, **kw):
    lab = Gtk.Label(label=text, xalign=xalign, **kw)
    for c in css:
        lab.add_css_class(c)
    return lab


def card(orientation=Gtk.Orientation.VERTICAL, spacing=6):
    return Gtk.Box(orientation=orientation, spacing=spacing, css_classes=["card", "tile"])


def pwm_pct(pwm):
    """pwm 0–255 → whole percentage (classic rounding): 77 → 30, 51 → 20, 255 → 100."""
    return int(pwm * 100 / 255.0 + 0.5)


def pct_pwm(pct):
    """percentage → pwm 0–255: 20 → 51, 100 → 255."""
    return int(pct * 255 / 100.0 + 0.5)


def curve_points(tokens):
    """['60:51', '75:255'] (or the string) → [(60, 51), (75, 255)]; invalid tokens ignored (ryzenctl validates them)."""
    out = []
    for tok in (tokens.split() if isinstance(tokens, str) else tokens):
        try:
            t, pwm = tok.split(":")
            out.append((int(t), int(pwm)))
        except ValueError:
            pass
    return out


def crash_story(st):
    """Sentence for the user after a lockup: at which CO it happened and where it resumes from ('' if no crash)."""
    span = AutotuneDialog.co_span
    crashed = [u["value"] for u in (st.get("unstable") or {}).values() if u.get("why") == "crash"]
    fails = [f for f in (st.get("final_failures") or []) if f.get("why") == "crash"]
    if not crashed and not fails:
        return ""
    where = _("at CO %s") % span(crashed) if crashed else _("in the final pass at CO %s") % span(fails[-1]["values"])
    nxt = AutotuneDialog.final_values(st)
    if st.get("phase") == "done":
        return _("The system locked up %s.") % where
    return _("The system locked up %s: that level is recorded as unstable and the calibration restarts from the final pass at CO %s (margin +%d).") % (
        where, span(nxt), st.get("final_margin", 0))


def curve_label(base_txt, new_txt):
    """Profile curve under the stock one: two curves with an arrow in between were unreadable.
    Baseline = the first line: profile_table aligns the row's label with it, not with the middle of the box."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.BASELINE_FILL, baseline_child=0)
    if base_txt is None or base_txt == new_txt:
        box.append(label(new_txt or "—", ["numeric", "dim-label"], wrap=True))
        return box
    box.append(label(_("stock: ") + base_txt, ["numeric", "dim-label", "caption"], wrap=True))
    lab = label("", ["numeric", "accent"], wrap=True)
    lab.set_markup("<b>%s</b>" % GLib.markup_escape_text(new_txt))
    box.append(lab)
    return box


def pump_mode(c):
    """Pump state from the `fan status` channel: ("auto"|"max"|"fixed", pct)."""
    if c.get("modo") == 1 and c.get("pwm") is not None:
        return "fixed", pwm_pct(c["pwm"])
    if c.get("pump_max"):
        return "max", c["pump_max"]
    return "auto", None


def pump_text(v):
    """Text of a pump: from a channel (dict) or from a profile value ("auto" | ("max", pct) | pct)."""
    if isinstance(v, dict):
        kind, pct = pump_mode(v)
        v = "auto" if kind == "auto" else ("max", pct) if kind == "max" else pct
    if v == "auto":
        return _("auto")
    return _("cap %d %%") % v[1] if isinstance(v, tuple) else _("fixed %d %%") % v


def curve_text(tokens, rpm_max=None):
    """Readable curve: '60 °C → 20 % (≈ 400 rpm) · 75 °C → 100 % (≈ 2000 rpm)'; without rpm_max only °C → %."""
    pts = curve_points(tokens)
    # ponytail: linear rpm estimate = rpm_max × % (like CurveEditor); rpm_max is measured by "Identify"
    rpm = lambda pct: _(" (≈ %d rpm)") % (rpm_max * pct / 100.0) if rpm_max else ""
    return " · ".join("%d °C → %d %%%s" % (t, pwm_pct(pwm), rpm(pwm_pct(pwm))) for t, pwm in pts) if pts else None


def diff_label(base, new, unit="", lower_is_better=True):
    """'stock → new Δ' label: green if more conservative than the baseline, red if more aggressive, grey if equal."""
    def num_of(v):
        if isinstance(v, str) and v in POWER:
            return POWER.index(v)
        return v if isinstance(v, (int, float)) else None
    u = (" " + unit) if unit else ""
    if base is None or base == new:
        return label(fmt(new, u), ["numeric", "dim-label"], wrap=isinstance(new, str))   # long curves wrap
    b, n = num_of(base), num_of(new)
    text, css = "%s → %s" % (fmt(base), fmt(new, u)), "accent"
    if b is not None and n is not None:
        d = n - b
        if unit in ("W", "A") and b:
            text += "  %+.0f %%" % (d * 100.0 / b)
        elif isinstance(base, (int, float)):
            text += "  %+g" % d
        css = "success" if (d < 0) == lower_is_better else "error"
    lab = label("", ["numeric", css], wrap=isinstance(new, str))
    lab.set_markup("<b>%s</b>" % GLib.markup_escape_text(text))
    return lab


def values_of(lines):
    """Profile lines → {ppt, tdc, edc, fmax, tjmax, power, co: [8], fan: {n: {step: (up, down), curve: str}}}."""
    v = {"fan": {}}
    for t in (l.split() for l in lines):
        try:
            if t[0] == "co":
                if len(t) == 9:
                    v["co"] = [int(x) for x in t[1:]]
                elif len(t) == 3:
                    co = v.setdefault("co", [None] * 8)
                    for c in (range(8) if t[1] == "all" else [int(t[1])]):
                        co[c] = int(t[2])
            elif t[0] == "fan" and len(t) >= 4:
                f = v["fan"].setdefault(int(t[1]), {})
                if t[2] == "step":
                    f["step"] = (int(t[3]), int(t[4]))
                elif t[2] == "curve":
                    f["curve"] = " ".join(t[3:])
                elif t[2] == "pump":   # auto | max <pct> | <pct>
                    f["pump"] = "auto" if t[3] == "auto" else ("max", int(t[4])) if t[3] == "max" else int(t[3])
            elif t[0] == "power":
                v["power"] = t[1]
            elif len(t) == 2:
                v[t[0]] = int(t[1])
        except (ValueError, IndexError):
            pass   # unrecognised line: ryzenctl validates it, here it is only shown
    return v


def profile_table(lines, st):
    """Coloured 'parameter · stock → profile' table: CPU values from the status baseline, fan values
    from the baseline's fan lines (BIOS settings captured at boot), rpm estimates from fan status."""
    v, base = values_of(lines), st.get("baseline") or {}
    fans = {c["canale"]: c for c in (st.get("fans") or {}).get("canali", [])}
    stock_fans = values_of(st.get("baseline_lines") or [])["fan"]
    rows = [(title, diff_label(base.get(key), v[key], unit)) for key, title, unit in CPU_PARAMS if key in v]
    if "power" in v:
        rows.append((_("Power mode"), diff_label(base.get("power"), v["power"])))
    n_flow = len(rows)   # the rows after these (CO, fans) go one per line in the grid, in order
    if "co" in v:
        chips, bco = Gtk.Box(spacing=4), base.get("co") or [None] * 8
        for c in range(8):
            if v["co"][c] is not None:
                chip = diff_label(bco[c], v["co"][c])
                chip.set_text("%+d" % v["co"][c])
                chip.set_tooltip_text(_("core %d: stock %s") % (c, fmt(bco[c])))
                chip.add_css_class("chip")
                chips.append(chip)
        rows.append((_("CO (Curve Optimizer) per core"), chips, CO_TIP))
    step_cells = Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL)   # one width for every rise/fall: "fall" in one column
    for n, f in sorted(v["fan"].items()):
        cur, stock = fans.get(n, {}), stock_fans.get(n, {})   # no stock value (fan roles assigned after boot): no comparison
        if "step" in f:
            tol = (st.get("caps") or {}).get("fan_step_tol_ms", 0)   # the chip rounds (e.g. 5000 → 5200)
            sec = lambda ms: None if ms is None else round(ms / 1000.0, 1)   # the chip works in ms, the user reads seconds
            stock_step = stock.get("step", (None, None))
            steps = Gtk.Box(spacing=18)   # rise and fall of a channel on its own line (in the FlowBox they mixed channels)
            for name, base_v, new_v in ((_("rise"), stock_step[0], f["step"][0]), (_("fall"), stock_step[1], f["step"][1])):
                same = base_v is not None and abs(base_v - new_v) <= tol
                cell = Gtk.Box(spacing=6)
                cell.append(label(name, ["dim-label"]))
                cell.append(diff_label(sec(new_v if same else base_v), sec(new_v), "s", lower_is_better=False))
                step_cells.add_widget(cell)
                steps.append(cell)
            rows.append((_("Fan %d") % n, steps))
        if "curve" in f:
            rm = cur.get("rpm_max")
            rows.append((_("Fan %d curve") % n, curve_label(curve_text(stock["curve"], rm) if stock.get("curve") else None, curve_text(f["curve"], rm))))
        if "pump" in f:   # stock and profile state as text: "auto" | "cap 70 %" | "fixed 65 %"
            rows.append((_("Pump %d") % n, diff_label(pump_text(stock["pump"]) if "pump" in stock else None, pump_text(f["pump"]))))
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin_top=6, margin_bottom=6, margin_start=12, margin_end=12)
    # short CPU values (limits, FMax, Tjmax, power mode) side by side, wrapping when space runs out
    flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, column_spacing=18, row_spacing=4, homogeneous=False,
                       min_children_per_line=1, max_children_per_line=6, halign=Gtk.Align.START,
                       css_classes=["profile-table"])   # no left padding: labels in line with the grid's
    wide = Gtk.Grid(column_spacing=18, row_spacing=4)
    for i, row in enumerate(rows):
        head = label(row[0], ["dim-label"], tooltip_text=row[2] if len(row) > 2 else None, valign=Gtk.Align.BASELINE_FILL)
        if i >= n_flow:      # CO chips and fan channels: full row, labels in one column
            wide.attach(head, 0, i - n_flow, 1, 1)
            wide.attach(row[1], 1, i - n_flow, 1, 1)
        else:
            cell = Gtk.Box(spacing=6)
            cell.append(head)
            cell.append(row[1])
            flow.append(cell)
    for child in (flow, wide):
        if child.get_first_child():
            box.append(child)
    if not rows:
        box.append(label(_("empty profile"), ["dim-label"]))
    return box


