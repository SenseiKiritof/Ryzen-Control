def label(text="", css=(), xalign=0.0, **kw):
    lab = Gtk.Label(label=text, xalign=xalign, **kw)
    for c in css:
        lab.add_css_class(c)
    return lab


def card(orientation=Gtk.Orientation.VERTICAL, spacing=6):
    return Gtk.Box(orientation=orientation, spacing=spacing, css_classes=["card", "tile"])


def pwm_pct(pwm):
    """pwm 0–255 → percentuale intera (arrotondamento classico): 77 → 30, 51 → 20, 255 → 100."""
    return int(pwm * 100 / 255.0 + 0.5)


def pct_pwm(pct):
    """percentuale → pwm 0–255: 20 → 51, 100 → 255."""
    return int(pct * 255 / 100.0 + 0.5)


def curve_points(tokens):
    """['60:51', '75:255'] (o la stringa) → [(60, 51), (75, 255)]; token non validi ignorati (li valida ryzenctl)."""
    out = []
    for tok in (tokens.split() if isinstance(tokens, str) else tokens):
        try:
            t, pwm = tok.split(":")
            out.append((int(t), int(pwm)))
        except ValueError:
            pass
    return out


def crash_story(st):
    """Frase per l'utente dopo un blocco: a quale CO è successo e da dove riparte ('' se nessun crash)."""
    span = AutotuneDialog.co_span
    crashed = [u["value"] for u in (st.get("unstable") or {}).values() if u.get("why") == "crash"]
    fails = [f for f in (st.get("final_failures") or []) if f.get("why") == "crash"]
    if not crashed and not fails:
        return ""
    where = "a CO %s" % span(crashed) if crashed else "nella passata finale a CO %s" % span(fails[-1]["values"])
    nxt = AutotuneDialog.final_values(st)
    if st.get("phase") == "done":
        return "Il sistema si è bloccato %s." % where
    return "Il sistema si è bloccato %s: quel livello è registrato come instabile e si riparte dalla passata finale a CO %s (margine +%d)." % (
        where, span(nxt), st.get("final_margin", 0))


def curve_label(base_txt, new_txt):
    """Curva del profilo sotto quella di fabbrica: due curve con una freccia in mezzo erano illeggibili."""
    if base_txt is None or base_txt == new_txt:
        return label(new_txt or "—", ["numeric", "dim-label"], wrap=True)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    box.append(label("fabbrica: " + base_txt, ["numeric", "dim-label", "caption"], wrap=True))
    lab = label("", ["numeric", "accent"], wrap=True)
    lab.set_markup("<b>%s</b>" % GLib.markup_escape_text(new_txt))
    box.append(lab)
    return box


def pump_mode(c):
    """Stato pompa dal canale di `fan status`: ("auto"|"max"|"fixed", pct)."""
    if c.get("modo") == 1 and c.get("pwm") is not None:
        return "fixed", pwm_pct(c["pwm"])
    if c.get("pump_max"):
        return "max", c["pump_max"]
    return "auto", None


def pump_text(v):
    """Testo di una pompa: da canale (dict) o da valore di profilo ("auto" | ("max", pct) | pct)."""
    if isinstance(v, dict):
        kind, pct = pump_mode(v)
        v = "auto" if kind == "auto" else ("max", pct) if kind == "max" else pct
    if v == "auto":
        return "auto"
    return "tetto %d %%" % v[1] if isinstance(v, tuple) else "fissa %d %%" % v


def curve_text(tokens, rpm_max=None):
    """Curva leggibile: '60 °C → 20 % (≈ 400 giri) · 75 °C → 100 % (≈ 2000 giri)'; senza rpm_max solo °C → %."""
    pts = curve_points(tokens)
    # ponytail: stima lineare giri = rpm_max × % (come CurveEditor); rpm_max lo misura "Identifica"
    giri = lambda pct: " (≈ %d giri)" % (rpm_max * pct / 100.0) if rpm_max else ""
    return " · ".join("%d °C → %d %%%s" % (t, pwm_pct(pwm), giri(pwm_pct(pwm))) for t, pwm in pts) if pts else None


def diff_label(base, new, unit="", lower_is_better=True):
    """Etichetta 'fabbrica → nuovo Δ': verde se più conservativo della baseline, rosso se più spinto, grigio se uguale."""
    def num(v):
        if isinstance(v, str) and v in POWER:
            return POWER.index(v)
        return v if isinstance(v, (int, float)) else None
    u = (" " + unit) if unit else ""
    if base is None or base == new:
        return label(fmt(new, u), ["numeric", "dim-label"], wrap=isinstance(new, str))   # curve lunghe vanno a capo
    b, n = num(base), num(new)
    text, css = "%s → %s" % (fmt(base), fmt(new, u)), "accent"
    if b is not None and n is not None:
        d = n - b
        if unit in ("W", "A") and b:
            text += "  %+.0f %%" % (d * 100.0 / b)
        elif isinstance(base, (int, float)):
            text += "  %+g" % d
        css = "success" if (d < 0) == lower_is_better else "error"
    lab = label("", ["numeric", css], wrap=isinstance(new, str))
    lab.set_markup("<b>%s</b>" % GLib.markup_escape_text(text))
    return lab


def values_of(lines):
    """Righe di profilo → {ppt, tdc, edc, fmax, tjmax, power, co: [8], fan: {n: {step: (su, giù), curve: str}}}."""
    v = {"fan": {}}
    for t in (l.split() for l in lines):
        try:
            if t[0] == "co":
                if len(t) == 9:
                    v["co"] = [int(x) for x in t[1:]]
                elif len(t) == 3:
                    co = v.setdefault("co", [None] * 8)
                    for c in (range(8) if t[1] == "all" else [int(t[1])]):
                        co[c] = int(t[2])
            elif t[0] == "fan" and len(t) >= 4:
                f = v["fan"].setdefault(int(t[1]), {})
                if t[2] == "step":
                    f["step"] = (int(t[3]), int(t[4]))
                elif t[2] == "curve":
                    f["curve"] = " ".join(t[3:])
                elif t[2] == "pump":   # auto | max <pct> | <pct>
                    f["pump"] = "auto" if t[3] == "auto" else ("max", int(t[4])) if t[3] == "max" else int(t[3])
            elif t[0] == "power":
                v["power"] = t[1]
            elif len(t) == 2:
                v[t[0]] = int(t[1])
        except (ValueError, IndexError):
            pass   # riga non riconosciuta: la valida ryzenctl, qui si mostra solo
    return v


def profile_table(lines, st):
    """Tabella 'parametro · fabbrica → profilo' colorata (baseline da status, ventole da fan status)."""
    v, base = values_of(lines), st.get("baseline") or {}
    fans = {c["canale"]: c for c in (st.get("fans") or {}).get("canali", [])}
    rows = [(title, diff_label(base.get(key), v[key], unit)) for key, title, unit in CPU_PARAMS if key in v]
    if "power" in v:
        rows.append(("Energia", diff_label(base.get("power"), v["power"])))
    if "co" in v:
        chips, bco = Gtk.Box(spacing=4), base.get("co") or [None] * 8
        for c in range(8):
            if v["co"][c] is not None:
                chip = diff_label(bco[c], v["co"][c])
                chip.set_text("%+d" % v["co"][c])
                chip.set_tooltip_text("core %d: fabbrica %s" % (c, fmt(bco[c])))
                chip.add_css_class("chip")
                chips.append(chip)
        rows.append(("CO (Curve Optimizer) per core", chips, CO_TIP))
    for n, f in sorted(v["fan"].items()):
        cur = fans.get(n, {})
        if "step" in f:
            tol = (st.get("caps") or {}).get("fan_step_tol_ms", 0)   # il chip arrotonda (es. 5000 → 5200)
            sec = lambda ms: None if ms is None else round(ms / 1000.0, 1)   # il chip lavora in ms, l'utente legge secondi
            for name, cur_v, new_v in (("salita", cur.get("step_up_ms"), f["step"][0]), ("discesa", cur.get("step_down_ms"), f["step"][1])):
                same = cur_v is not None and abs(cur_v - new_v) <= tol
                rows.append(("Ventola %d %s" % (n, name), diff_label(sec(new_v if same else cur_v), sec(new_v), "s", lower_is_better=False)))
        if "curve" in f:
            rm = cur.get("rpm_max")
            rows.append(("Ventola %d curva" % n, curve_label(curve_text(cur["curva"], rm) if cur.get("curva") else None, curve_text(f["curve"], rm))))
        if "pump" in f:   # stato attuale e nuovo come testo: "auto" | "tetto 70 %" | "fissa 65 %"
            rows.append(("Pompa %d" % n, diff_label(pump_text(cur) if cur else None, pump_text(f["pump"]))))
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin_top=6, margin_bottom=6, margin_start=12, margin_end=12)
    # valori corti (limiti, FMax, Tjmax, energia, step, pompa) uno accanto all'altro, a capo quando manca spazio
    flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, column_spacing=18, row_spacing=4, homogeneous=False,
                       min_children_per_line=1, max_children_per_line=6, halign=Gtk.Align.START)
    wide = Gtk.Grid(column_spacing=18, row_spacing=4)
    n_wide = 0
    for row in rows:
        is_wide = isinstance(row[1], Gtk.Box) or "curva" in row[0]      # chip del CO e punti curva: riga intera
        head = label(row[0], ["dim-label"], tooltip_text=row[2] if len(row) > 2 else None)
        if is_wide:
            wide.attach(head, 0, n_wide, 1, 1)
            wide.attach(row[1], 1, n_wide, 1, 1)
            n_wide += 1
        else:
            cell = Gtk.Box(spacing=6)
            cell.append(head)
            cell.append(row[1])
            flow.append(cell)
    for child in (flow, wide):
        if child.get_first_child():
            box.append(child)
    if not rows:
        box.append(label("profilo vuoto", ["dim-label"]))
    return box


def profile_view(lines, st):
    """Tabella colorata + righe grezze in un expander (per i dialoghi)."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    box.append(profile_table(lines, st))
    box.append(Gtk.Expander(label="Righe del profilo", child=label("\n".join(lines), ["numeric", "dim-label"], selectable=True, margin_top=6)))
    return box


class Param(Gtk.Box):
    """Riga parametro: etichetta, info, Scale con marks, SpinButton (stessa Adjustment), 'attuale → nuovo'."""

    def __init__(self, title, unit, info=False, tooltip=None, digits=0, step=1):
        super().__init__(spacing=12, tooltip_text=tooltip)
        self.unit, self.read, self.digits = unit, None, digits
        self.adj = Gtk.Adjustment(lower=0, upper=1, step_increment=step, page_increment=step * 5)
        self.append(label(title, ["heading"], width_chars=9))
        self.info = label("", ["dim-label", "numeric"], width_chars=26, visible=info)
        self.append(self.info)
        self.scale = Gtk.Scale(adjustment=self.adj, hexpand=True, draw_value=True, digits=digits, value_pos=Gtk.PositionType.TOP)
        self.append(self.scale)
        self.append(Gtk.SpinButton(adjustment=self.adj, digits=digits, valign=Gtk.Align.CENTER))
        self.delta = label("", ["numeric"], xalign=1.0, width_chars=15)
        self.append(self.delta)
        self.adj.connect("value-changed", self.show_delta)

    def setup(self, lo, hi, read, base=None):
        self.read = read
        self.adj.set_lower(lo)
        self.adj.set_upper(hi)
        self.scale.clear_marks()
        self.scale.add_mark(lo, Gtk.PositionType.BOTTOM, self.text(lo))
        self.scale.add_mark(hi, Gtk.PositionType.BOTTOM, self.text(hi))
        if base is not None and lo < base < hi:
            self.scale.add_mark(base, Gtk.PositionType.BOTTOM, "fabbrica " + self.text(base))
        self.reset()

    def text(self, v):
        return ("%.*f" % (self.digits, v)).replace(".", ",")

    def value(self):
        v = round(self.adj.get_value(), self.digits)
        return int(v) if self.digits == 0 else v

    def changed(self):
        return self.read is not None and self.value() != round(self.read, self.digits)

    def reset(self):
        if self.read is not None:
            self.adj.set_value(self.read)
        self.show_delta()

    def show_delta(self, *_):
        if self.read is None:
            return
        if self.changed():
            self.delta.set_markup("<span alpha='60%%'>%s</span> → <b>%s</b> %s" % (self.text(self.read), self.text(self.value()), self.unit))
            self.delta.add_css_class("accent")
        else:
            self.delta.set_markup("<span alpha='60%%'>%s %s</span>" % (self.text(self.read), self.unit))
            self.delta.remove_css_class("accent")


class CurveEditor(Gtk.Box):
    """Curva ventola in °C → % con giri stimati e grafico; il profilo resta `t:pwm` 0–255 (conversione qui,
    validazione in ryzenctl: temperature crescenti, pwm non decrescenti, minimo 20 %, ultimo 100 % entro 125 °C)."""
    T_LO, T_HI, PCT_LO, PCT_HI = 20, 125, 20, 100   # range dell'editor

    def __init__(self, read, max_points, rpm_max):
        super().__init__(spacing=12)
        self.read, self.max_points, self.rpm_max = read, max(2, min(5, max_points)), rpm_max
        self.read_pct = [(t, pwm_pct(pwm)) for t, pwm in read]
        self.rows = []
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        left.append(label("Curva (°C → %)", ["heading"], tooltip_text="La SmartFan del chip interpola fra i punti; sotto il primo tiene la sua %, oltre l'ultimo il 100 %"))
        self.rows_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        left.append(self.rows_box)
        btns = Gtk.Box(spacing=6)
        self.add_btn = button("+ punto", self.add_point)
        self.del_btn = button("− punto", self.del_point)
        btns.append(self.add_btn)
        btns.append(self.del_btn)
        left.append(btns)
        self.append(left)
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.graph = Gtk.DrawingArea(content_width=260, content_height=120, css_classes=["card"], valign=Gtk.Align.START)
        self.graph.set_draw_func(self.draw)
        right.append(self.graph)
        self.reaction = label("", ["dim-label", "caption"], wrap=True, max_width_chars=44)
        right.append(self.reaction)
        self.append(right)
        self.reset()

    def row(self, t, pct):
        box = Gtk.Box(spacing=6)
        ts = Gtk.SpinButton.new_with_range(self.T_LO, self.T_HI, 1)
        ts.set_value(t)
        ps = Gtk.SpinButton.new_with_range(self.PCT_LO, self.PCT_HI, 1)
        ps.set_value(pct)
        rpm = label("", ["dim-label", "numeric"], width_chars=20)
        for w in (ts, label("°C →"), ps, label("%"), rpm):
            box.append(w)
        ts.connect("value-changed", self.changed)
        ps.connect("value-changed", self.changed)
        return (box, ts, ps, rpm)

    def set_points(self, pts):
        for r in self.rows:
            self.rows_box.remove(r[0])
        self.rows = [self.row(t, pwm_pct(pwm)) for t, pwm in pts]
        for r in self.rows:
            self.rows_box.append(r[0])
        self.changed()

    def reset(self):
        self.set_points(self.read)

    def values(self):
        """[(°C, %)] come mostrati."""
        return [(int(ts.get_value()), int(ps.get_value())) for _, ts, ps, _ in self.rows]

    def points(self):
        """[(°C, pwm)] per il comando: se la % coincide con quella del punto letto resta il pwm letto (BIOS 77 = 30 %)."""
        out = []
        for i, (t, pct) in enumerate(self.values()):
            keep = i < len(self.read) and pwm_pct(self.read[i][1]) == pct
            out.append((t, self.read[i][1] if keep else pct_pwm(pct)))
        return out

    def changed(self, *_):
        vals = self.values()
        for (_, _, _, rpm), (_, pct) in zip(self.rows, vals):
            # ponytail: stima lineare giri = rpm_max × % (i giri reali non sono lineari con la %); basta per orientarsi
            rpm.set_text("≈ %d giri" % (self.rpm_max * pct / 100.0) if self.rpm_max else "giri: usa Identifica")
        self.add_btn.set_sensitive(len(vals) < self.max_points and vals[-1][0] + 5 <= self.T_HI)
        self.del_btn.set_sensitive(len(vals) > 2)
        self.graph.queue_draw()

    def add_point(self):
        self.set_points(self.points() + [(self.values()[-1][0] + 5, 255)])

    def del_point(self):
        self.set_points(self.points()[:-1])

    def set_reaction(self, up_s, down_s):
        self.reaction.set_text("Reazione: salita %s s · discesa %s s — quanto in fretta la ventola segue la curva; valori alti ignorano i picchi brevi"
                               % (("%.1f" % up_s).replace(".", ","), ("%.1f" % down_s).replace(".", ",")))

    def draw(self, area, cr, w, h):
        x0, y0, x1, y1 = 28, 6, w - 6, h - 14
        X = lambda t: x0 + (t - 20) / 80.0 * (x1 - x0)            # 20–100 °C
        Y = lambda pct: y1 - pct / 100.0 * (y1 - y0)               # 0–100 %
        col = area.get_color()
        cr.set_source_rgba(col.red, col.green, col.blue, 0.35)
        cr.set_line_width(1)
        cr.set_font_size(9)
        for pct in (0, 50, 100):
            cr.move_to(x0, Y(pct))
            cr.line_to(x1, Y(pct))
            cr.stroke()
            cr.move_to(2, Y(pct) + 3)
            cr.show_text("%d%%" % pct)
        for t in (20, 60, 100):
            cr.move_to(X(t), y0)
            cr.line_to(X(t), y1)
            cr.stroke()
            cr.move_to(X(t) - 8, h - 3)
            cr.show_text("%d°" % t)
        cr.rectangle(x0, y0, x1 - x0, y1 - y0)
        cr.clip()
        for pts, rgb, width in ((self.read_pct, (0.55, 0.55, 0.55), 1.5), (self.values(), (0.21, 0.52, 0.89), 2.0)):
            if not pts:
                continue
            cr.set_source_rgb(*rgb)
            cr.set_line_width(width)
            cr.move_to(X(20), Y(pts[0][1]))                 # sotto il primo punto: la sua %
            for t, pct in pts:
                cr.line_to(X(t), Y(pct))
            cr.line_to(X(130), Y(pts[-1][1]))               # oltre l'ultimo: resta la sua % (100)
            cr.stroke()


