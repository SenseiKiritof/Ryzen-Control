class HelperError(Exception):
    pass


class Helper:
    """Un solo processo `ryzenctl serve`; chiamate serializzate. `call` blocca: usarla via `bg`."""

    def __init__(self, mock):
        env = dict(os.environ)
        if mock:
            root = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "ryzen-control-mock")
            os.makedirs(root, exist_ok=True)
            env["RYZENCTL_ROOT"] = root
            subprocess.run([RYZENCTL, "boot"], env=env, check=False, stdout=subprocess.DEVNULL)   # la baseline del "boot" finto
            cmd = [RYZENCTL, "serve"]
        else:
            cmd = ["pkexec", RYZENCTL, "serve"]
        self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=env, text=True, bufsize=1)
        self.lock = threading.Lock()
        self.pending = collections.deque()      # richieste in attesa, nell'ordine: serve risponde in ordine
        threading.Thread(target=self._reader, daemon=True).start()

    def _reader(self):
        for line in self.p.stdout:
            with self.lock:
                ev, slot = self.pending.popleft()
            slot["line"] = line
            ev.set()
        with self.lock:                          # processo finito: sveglia chi aspetta
            while self.pending:
                ev, slot = self.pending.popleft()
                ev.set()

    def call(self, *argv):
        """Scrive subito e aspetta la risposta propria: così `autotune abort` parte mentre un
        passo lungo è ancora in corso (serve lo interrompe)."""
        ev, slot = threading.Event(), {}
        with self.lock:
            self.pending.append((ev, slot))
            try:
                self.p.stdin.write(json.dumps(list(argv)) + "\n")
                self.p.stdin.flush()
            except (OSError, ValueError):
                self.pending.remove((ev, slot))
                slot["line"] = ""
                ev.set()
        ev.wait()
        line = slot.get("line", "")
        if not line:
            raise HelperError("ryzenctl serve non risponde (pkexec negato o processo terminato): riavvia l'applicazione")
        r = json.loads(line)
        if not r.get("ok"):
            raise HelperError(r.get("error", "errore sconosciuto"))
        return r.get("data")

    def close(self):
        try:
            self.p.stdin.close()
            self.p.wait(timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            self.p.kill()


def bg(work, done, fail):
    """work() in un thread; done(risultato) o fail(messaggio) nel main loop. Mai bloccare la UI."""
    def run():
        try:
            out = work()
        except Exception as e:  # HelperError o bug: mostrato all'utente, mai perso
            GLib.idle_add(fail, str(e))
            return
        GLib.idle_add(done, out)
    threading.Thread(target=run, daemon=True).start()


def fmt(v, unit=""):
    return "n/d" if v is None else ("%g%s" if isinstance(v, (int, float)) else "%s%s") % (v, unit)


def mins(seconds):
    """Durata leggibile dalla stima in secondi: '~18 min' (arrotondata per eccesso), '0 min', 'n/d'."""
    if seconds is None:
        return "n/d"
    m = -(-int(seconds) // 60)
    return "~%d min" % m if m else "0 min"


def volts(v, unit=" V"):
    """Tensione leggibile con la virgola decimale: '1,245 V'; 'n/d' se assente."""
    return "n/d" if v is None else ("%.3f" % v).replace(".", ",") + unit


def mhz(v):
    """Frequenza leggibile con lo spazio delle migliaia: '5 175 MHz'; 'n/d' se assente."""
    return "n/d" if v is None else "{:,} MHz".format(int(v)).replace(",", " ")


def at_tested(st, c, level):
    """Il core c è stato davvero provato al livello di CO `level`? In parallelo i campioni riportano
    anche i core già usciti dalla prova, fermi al loro ultimo CO stabile: vanno ignorati."""
    u = st.get("unstable", {}).get(str(c))
    if u:
        return level >= u["value"]
    r = st.get("results", {}).get(str(c))
    return r is not None and level >= r


def at_sample(st, c, level=None):
    """(livello, V, MHz) misurati sul core c: al livello più vicino a `level`, o al più profondo se None."""
    best = None
    for lvl, smp in st.get("samples", {}).items():
        v = int(lvl)
        volt = (smp.get("volt") or [None] * 8)[c] if c < len(smp.get("volt") or []) else None
        if v == 0 or volt is None or not at_tested(st, c, v):
            continue
        key = abs(v - level) if level is not None else v
        if best is None or key < best[0]:
            best = (key, v, volt, (smp.get("mhz") or [None] * 8)[c] if c < len(smp.get("mhz") or []) else None)
    return best[1:] if best else None


