                up.setup(self.step_range[0] / 1000.0, self.step_range[1] / 1000.0, c["step_up_ms"] / 1000.0)
                down.setup(self.step_range[0] / 1000.0, self.step_range[1] / 1000.0, c["step_down_ms"] / 1000.0)
                editor = CurveEditor(curve_points(c["curva"]), len(c["curva"]), c.get("rpm_max"))
                for prm in (up, down):
                    prm.adj.connect("value-changed", lambda *_a, u=up, d=down, e=editor: e.set_reaction(u.value(), d.value()))
                editor.set_reaction(up.value(), down.value())
                for w in (up, down, editor):
                    box.append(w)
                self.chans[n] = (up, down, editor, c)
            elif role == "pompa":
                kind, pct = pump_mode(c)
                box.append(label(_("Normally the pump should be left to the BIOS (recommended). If at full load it rises to 100 % and hums, it can be limited: "
                                   "\"Maximum cap\" keeps the BIOS curve clipping the points above the cap, \"Fixed speed\" keeps it constant. "
                                   "Never below 50 %: the flow is not enough."), ["dim-label", "caption"], wrap=True))
                mode = Adw.ComboRow(title=_("Pump"), model=Gtk.StringList.new(list(PUMP_MODES)), selected=PUMP_KINDS.index(kind))
                lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
                lb.append(mode)
                box.append(lb)
                speed = Param(_("Pump"), "%", info=bool(c.get("rpm_max")), tooltip=_("Cap or fixed speed of the pump (50–100 %)"))
                speed.setup(50, 100, pct if pct is not None else 100)   # range 50–100 % (ryzenctl rejects the rest)
                speed.set_sensitive(kind != "auto")
                mode.connect("notify::selected", lambda r, _p, sp=speed: sp.set_sensitive(r.get_selected() != 0))
                if c.get("rpm_max"):   # ponytail: linear rpm estimate = rpm_max × %
                    show_rpm = lambda *_a, sp=speed, rm=c["rpm_max"]: sp.info.set_text(_("≈ %d rpm") % (rm * sp.adj.get_value() / 100.0))
                    speed.adj.connect("value-changed", show_rpm)
                    show_rpm()
                box.append(speed)
                self.pumps[n] = (mode, speed, c)
            elif role == "sconosciuto":
                self.unknown_cards.append(box)
            (self.unknown_box if role == "sconosciuto" else self.known).append(box)
            self.cards.append(box)
        self.unknown_title.set_text(_("Unknown channels (%d)") % len(self.unknown_cards))
        self.unknown.set_visible(bool(self.unknown_cards))

    def identify(self, n):
        self.win.toast(_("Channel %d at 100 %% for 5 seconds…") % n)
        bg(lambda: self.win.h.call("fan", "identify", str(n)),
           lambda r: self.win.toast(_("Channel %d: %d rpm at 100 %%") % (n, r["rpm_al_100"])), self.win.toast)

    def autodetect(self):
        def go(ok):
            if not ok:
                return
            self.detect_btn.set_sensitive(False)
            self.spin.start()
            def done(res):
                self.spin.stop()
                self.detect_btn.set_sensitive(True)
                self.win.info(_("Detected roles"), "\n".join(_("channel %s: %s (%s)") % (n, ROLE_NAMES.get(r["ruolo"], r["ruolo"]), r["perché"]) for n, r in res.items()))
                self.win.reload()
            def fail(msg):
                self.spin.stop()
                self.detect_btn.set_sensitive(True)
                self.win.toast(msg)
            bg(lambda: self.win.h.call("fan", "autodetect"), done, fail)
        self.win.confirm(_("Detect the channel roles?"), AUTODETECT_WARNING, _("Start"), go)

    def reset(self):
        for up, down, editor, c in self.chans.values():
            up.reset()
            down.reset()
            editor.reset()
        for mode, speed, c in self.pumps.values():
            mode.set_selected(PUMP_KINDS.index(pump_mode(c)[0]))
            speed.reset()

    def lines(self, only_changed):
        out = []
        for n, (up, down, editor, c) in sorted(self.chans.items()):
            ms = (int(round(up.value() * 1000)), int(round(down.value() * 1000)))
            if not only_changed or ms != (c["step_up_ms"], c["step_down_ms"]):
                out.append("fan %d step %d %d" % (n, ms[0], ms[1]))
            pts = editor.points()
            if not only_changed or pts != editor.read:
                out.append("fan %d curve %s" % (n, " ".join("%d:%d" % pt for pt in pts)))
        for n, (mode, speed, c) in sorted(self.pumps.items()):
            kind = PUMP_KINDS[mode.get_selected()]
            if only_changed and kind == pump_mode(c)[0] and (kind == "auto" or not speed.changed()):
                continue
            out.append("fan %d pump %s" % (n, {"auto": "auto", "max": "max %d" % speed.value(), "fixed": "%d" % speed.value()}[kind]))
        return out


# ---- Window ----------------------------------------------------------------------------
class Window(Adw.ApplicationWindow):
    def __init__(self, app, helper):
        super().__init__(application=app, title="Ryzen Control", default_width=840, default_height=700)
        self.h = helper
        self.status = {}
        self.ui = ui_load()   # per-user preferences shared by the pages, saved with ui_save
        self.polling = False
        self.stack = Adw.ViewStack()
        self.toasts = Adw.ToastOverlay(child=self.stack)
        self.banner = Adw.Banner(button_label=_("Decide…"))
        self.banner.connect("button-clicked", self.on_crash_banner)
        header = Adw.HeaderBar(title_widget=Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE))
        tv = Adw.ToolbarView(content=self.toasts)
        tv.add_top_bar(header)
        tv.add_top_bar(self.banner)
        self.set_content(tv)
        self.pages = [P(self) for P in (MonitorPage, ModesPage, CpuPage, CurvePage, FansPage, PrefsPage)]
        for p in self.pages:
            self.stack.add_titled_with_icon(p, p.NAME, p.TITLE, p.ICON)
        self.connect("close-request", lambda *_a: helper.close())
        self.reload()
        GLib.timeout_add_seconds(1, self.tick)

    # -- helper and reload --
    def reload(self):
        def work():
            st = self.h.call("status")
            st["profile_lines"] = {}
            for name in self.h.call("profile", "list")["profiles"]:
                if name in PRESETS:
                    st["profile_lines"][name] = self.h.call("profile", "show", name)["lines"]
            st["autotune"] = self.h.call("autotune", "status")
            try:   # BIOS fan settings captured at boot: the "stock" side of the fan rows in the profile tables
                st["baseline_lines"] = self.h.call("profile", "show", "baseline")["lines"]
            except HelperError:
                st["baseline_lines"] = []
            try:
                st["fans"] = self.h.call("fan", "status")
            except HelperError as e:   # chip missing: the Fans page shows the message
                st["fans"], st["fans_error"] = None, str(e)
            return st
        bg(work, self.got_status, self.toast)

    def got_status(self, st):
        self.status = st
        c = st.get("crashed")
        if c:
            self.banner.set_title(_("The '%s' profile was deactivated after a crash (%s)") % (c.get("profile") or "-", c.get("time", "?")))
        self.banner.set_revealed(bool(c))
        for p in self.pages:
            p.refresh(st)
        at = st.get("autotune") or {}
        if at.get("phase") and not getattr(self, "at_asked", False):
            self.at_asked = True   # once per session
            if at["phase"] == "done":   # finished without a choice (GUI closed): discard / save / save and apply is proposed again
                dlg = AutotuneDialog(self, at.get("mode", "eco"))
                dlg.show(at)
                dlg.done(at)
            else:
                self.ask_resume(at)

    def ask_resume(self, at):
        ph = at.get("phase")
        where = AT_PHASE_NAMES.get(ph, ph)
        if ph == "co":
            where += _(", CO level %s") % at.get("value") if at.get("parallel") else _(", core %s") % at.get("core")
        elif ph == "final" and at.get("single") is not None:
            where += _(", single-core test of core %s") % at["single"]
        story = crash_story(at, self.status.get("cores", 0)) or _("The step interrupted by the reboot has already been recorded as unstable.")
        d = Adw.AlertDialog(heading=_("Calibration interrupted"),
                            body=_("A %s calibration started on %s was left halfway (%s). %s Resume it from where it was, or "
                                   "discard it and stay on the stock values?") % (
                                       at.get("mode", "?").capitalize(), at.get("started", "?"), where, story))
        d.add_response("abort", _("Discard calibration"))
        d.add_response("resume", _("Resume"))
        d.set_response_appearance("resume", Adw.ResponseAppearance.SUGGESTED)
        def resp(_d, r):
            if r == "resume":
                dlg = AutotuneDialog(self, at.get("mode", "eco"))
                dlg.show(at)
                dlg.loop()
            else:
                self.run([["autotune", "abort"]], lambda _r: self.toast(_("Calibration discarded, CPU at baseline")))
        d.connect("response", resp)
        d.present(self)

    def tick(self):
        """Telemetry at 1 Hz, only if a page that uses it is visible and no read is in progress."""
        pages = [p for p in self.pages if hasattr(p, "telemetry") and p.get_mapped()]
        if pages and not self.polling:
            self.polling = True
            def done(t):
                self.polling = False
                for p in pages:
                    p.telemetry(t)
            def fail(msg):
                self.polling = False
                if not getattr(self, "poll_failed", False):   # a single warning, not one per second
                    self.poll_failed = True
                    self.toast(_("Telemetry: ") + msg)
            bg(lambda: self.h.call("telemetry"), done, fail)
        return True

    def run(self, cmds, done=None):
        """Sends the commands in sequence (thread); error → toast; in any case reloads the state."""
        def ok(res):
            if done:
                done(res)
            self.reload()
        def fail(msg):
            self.toast(msg)
            self.reload()
        bg(lambda: [self.h.call(*a) for a in cmds], ok, fail)

    def apply_lines(self, lines):
        if not lines:
            self.toast(_("No changes to apply"))
            return
        self.run([l.split() for l in lines], lambda _r: self.toast(_("Applied: ") + "; ".join(lines)))

    def save_profile(self, lines):
        if not lines:
            self.toast(_("Nothing to save"))
            return
        entry = Gtk.Entry(placeholder_text=_("name: a-z 0-9 _ - (max 32)"), activates_default=True)
        d = Adw.AlertDialog(heading=_("Save to profile"), body="\n".join(lines), extra_child=entry)
        d.add_response("cancel", _("Cancel"))
        d.add_response("save", _("Save"))
        d.set_default_response("save")
        d.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
        def resp(_d, r):
            name = entry.get_text().strip()
            if r == "save":
                self.run([["profile", "save", name] + lines], lambda _r: self.toast(_("Profile '%s' saved (%d lines)") % (name, len(lines))))
        d.connect("response", resp)
        d.present(self)

    # -- dialogs --
    def toast(self, msg):
        self.toasts.add_toast(Adw.Toast(title=str(msg), timeout=6))

    def info(self, heading, body):
        d = Adw.AlertDialog(heading=heading, body=body)
        d.add_response("close", _("Close"))
        d.present(self)

    def confirm(self, heading, body, label, cb, destructive=False, extra=None):
        d = Adw.AlertDialog(heading=heading, body=body, extra_child=extra)
        d.add_response("cancel", _("Cancel"))
        d.add_response("ok", label)
        d.set_response_appearance("ok", Adw.ResponseAppearance.DESTRUCTIVE if destructive else Adw.ResponseAppearance.SUGGESTED)
        d.connect("response", lambda _d, r: cb(r == "ok"))
        d.present(self)

    def on_crash_banner(self, *_a):
        c = self.status.get("crashed") or {}
        prof = c.get("profile")
        d = Adw.AlertDialog(heading=_("Crash with an active profile"),
                            body=_("The previous boot ended with a crash while the '%s' profile was active (%s). "
                                   "Reactivate it (also at startup) or stay on the stock values?") % (prof or "-", c.get("time", "?")))
        d.add_response("cancel", _("Cancel"))
        d.add_response("default", _("Stay on Default"))
        if prof:
            d.add_response("reactivate", _("Reactivate"))
            d.set_response_appearance("reactivate", Adw.ResponseAppearance.DESTRUCTIVE)
        def resp(_d, r):
            if r == "reactivate":
                self.run([["crashed", "clear"], ["autostart", "on"], ["apply", prof]], lambda _r: self.toast(_("Profile '%s' reactivated") % prof))
            elif r == "default":   # stock values for the fans too (the boot had applied them), profile deselected
                self.run([["crashed", "clear"], ["default"]], lambda _r: self.toast(_("Stock values; automatic start disabled")))
        d.connect("response", resp)
        d.present(self)


SHOT_SIZE = (1100, 800)   # window size of the README screenshots (make screenshots)


def save_png(widget, path):
    """PNG of a mapped widget rendered from its own widget tree: no screen grab, so it works on
    Wayland and contains only the application."""
    w, h = widget.get_width(), widget.get_height()
    snap = Gtk.Snapshot()
    Gtk.WidgetPaintable.new(widget).snapshot(snap, w, h)
    tex = widget.get_native().get_renderer().render_texture(snap.to_node(), Graphene.Rect().init(0, 0, w, h))
    tex.save_to_png(path)


class App(Adw.Application):
    def __init__(self, mock, smoke=False, shots=None):
        # the mock must not activate the real instance; --smoke/--screenshots run as their own instance,
        # otherwise a mock window already open would receive the activation and the check would pass untested
        super().__init__(application_id=APP_ID + (".Mock" if mock else ""),
                         flags=Gio.ApplicationFlags.NON_UNIQUE if (smoke or shots) else Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.mock, self.smoke, self.smoke_failed, self.shots = mock, smoke, False, shots

    def do_activate(self):
        if not self.props.active_window:
            prov = Gtk.CssProvider()
            try:
                prov.load_from_string(CSS)
            except AttributeError:   # GTK < 4.12
                prov.load_from_data(CSS.encode())
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            win = Window(self, Helper(self.mock))
            if self.smoke:
                GLib.timeout_add(500, self.run_smoke)
            if self.shots:
                Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
                win.set_default_size(*SHOT_SIZE)
                self.drive(self.screenshot_steps())
        self.props.active_window.present()

    def drive(self, steps):
        """Runs a generator that yields pauses in ms, letting GTK lay out and draw in between; an
        exception becomes exit code 1."""
        def tick():
            try:
                GLib.timeout_add(next(steps), tick)
            except StopIteration:
                self.quit()
            except Exception:
                import traceback
                traceback.print_exc()
                self.smoke_failed = True
                self.quit()
            return False
        GLib.timeout_add(500, tick)

    def screenshot_steps(self):
        """--mock --screenshots DIR (make screenshots): fills a fresh fake backend (fan roles, presets,
        the three calibrations if the CPU has a per-core CO), saves the frames of the Auto calibration
        (README GIF), then one PNG per page."""
        win = self.props.active_window
        h = win.h
        while not win.status:   # the windows are built with the core count of the first status
            yield 100
        h.call("fan", "autodetect")
        h.call("fan", "identify", "1")
        # a new fake boot: as on a real machine the fan roles exist at boot, so the baseline has the BIOS fan lines
        run_dir = os.path.join(MOCK_DIR, "run", "ryzenctl")
        for f in os.listdir(run_dir):
            os.remove(os.path.join(run_dir, f))
        subprocess.run([RYZENCTL, "boot"], env=dict(os.environ, RYZENCTL_ROOT=MOCK_DIR), check=True, stdout=subprocess.DEVNULL)
        for name in ("quiet", "performance"):
            h.call("preset", name)
        if win.status.get("co") is not None:   # the calibrations measure the CO: refused on CPUs without a per-core CO
            # Auto from scratch, one step at a time: a frame per step for the README GIF (assembled by `make
            # screenshots` from $RYZENCTL_ROOT/frames), the end state as calibration.png
            frames = os.path.join(MOCK_DIR, "frames")
            os.makedirs(frames, exist_ok=True)
            dlg = AutotuneDialog(win, "auto")
            st = h.call("autotune", "start", "auto", "step=3", "reuse=0")
            for i in range(300):
                dlg.show(st)
                yield 250
                save_png(dlg, os.path.join(frames, "f-%03d.png" % i))
                if st["phase"] == "done":
                    break
                st = h.call("autotune", "step")
            dlg.done(st)
            yield 800
            save_png(dlg, os.path.join(frames, "last.png"))
            h.call("autotune", "save")
            dlg.closable = True
            dlg.close()
            h.call("unlock", "on")   # Boost is calibrated and used only with the unlock: the screenshots show it usable
            for mode in ("eco", "boost"):   # Eco reuses the final pass Auto just validated: done at once
                st = h.call("autotune", "start", mode, "step=3")
                while st["phase"] != "done":
                    st = h.call("autotune", "step")
                h.call("autotune", "save")
            h.call("use", "auto")
            h.call("apply", "auto")
            h.call("autostart", "on")
        win.reload()
        yield 1500
        mon = next(p for p in win.pages if isinstance(p, MonitorPage))
        if mon.hist:   # the fake telemetry is steady: fill the 60 s window with it instead of waiting a minute
            mon.hist.extend([mon.hist[-1]] * mon.hist.maxlen)
        for page in win.pages:
            win.stack.set_visible_child(page)
            yield 1200 if page.NAME == "monitor" else 700
            save_png(win, os.path.join(self.shots, page.NAME + ".png"))

    def run_smoke(self):
        """--mock --smoke (make check): the per-core rows of Monitor and Curves follow the core count, the
        calibration window shows every real state of the fake backend for eco, auto and boost (all
        phases, end, resume dialog), the collapsible section of the unknown channels on the Fans page
        hides/shows only them and is saved, then the app exits; a rendering error becomes exit code 1
        instead of a traceback on the desktop."""
        win = self.props.active_window
        if not win.status:   # the windows are built with the core count of the first status
            return True
        try:
            win.h.call("autotune", "abort")
            modes = next(p for p in win.pages if isinstance(p, ModesPage))
            for on in (False, True):   # Boost only with unlock: disabled without it, usable as soon as the status says on
                modes.refresh(dict(win.status, unlock=on))
                row, chk, regen = modes.rows["boost"]
                assert chk.get_sensitive() == regen.get_sensitive() == on and (row.get_tooltip_text() is None) == on
            # per-core views follow the active cores, also when the count changes: rows replaced, not added
            mon = next(p for p in win.pages if isinstance(p, MonitorPage))
            curve = next(p for p in win.pages if isinstance(p, CurvePage))
            t, n = win.h.call("telemetry"), win.status["cores"]
            mon.telemetry(t)   # rows of every core, as after the first 1 Hz poll
            for k in (2, n):
                old = curve.cores
                mon.telemetry(dict(t, cores=t["cores"][:k]))
                curve.refresh(dict(win.status, cores=k))
                assert len(mon.cores) == len(curve.cores) == k and mon.grid.get_child_at(0, k + 1) is None, "core rows not following the count"
                assert not any(p.get_parent() for p in old), "old core rows kept"
            win.h.call("unlock", "on")   # needed by the Boost calibration below
            # the first Eco measures from scratch, the last one reuses the final passes just recorded: done at once;
            # no calibration without a per-core CO (ryzenctl refuses it)
            # Auto sweeps the PPT: not on CPUs whose PM table limits are unknown (ryzenctl refuses it)
            pm_limits = (win.status.get("limits") or {}).get("ppt") is not None
            for i, mode in enumerate((("eco", "auto", "boost", "eco") if pm_limits else ("eco", "boost", "eco"))
                                     if win.status.get("co") is not None else ()):
                dlg = AutotuneDialog(win, mode)
                st = win.h.call("autotune", "start", mode, "step=3", "reuse=%d" % (i > 0))
                dlg.show(st)
                for _i in range(300):
                    if st["phase"] == "done":
                        break
                    st = win.h.call("autotune", "step")
                    dlg.show(st)
                assert i == 0 or mode != "eco" or st.get("eco_from"), "Eco did not reuse the validated undervolt"
                dlg.done(st)
                win.h.call("autotune", "abort")
                dlg.closable = True
                dlg.close()
            if win.status.get("co") is not None:
                # the parameters: the single-core test of the final pass is on by default and sent to ryzenctl
                d = modes.calibrate_params("eco", win.h.call("autotune", "estimate", "eco"))
                assert d.single.get_active() and d.params()["single"] == 1 and d.single.get_subtitle(), "single-core switch"
                d.force_close()
            win.ask_resume({"mode": "auto", "phase": "ppt", "started": "today"})
            win.ask_resume({"mode": "eco", "phase": "co", "parallel": True, "value": -10, "started": "today"})
            win.ask_resume({"mode": "auto", "phase": "final", "started": "today", "params": {"margin": 3}, "final_margin": 6,
                            "results": {str(c): -35 for c in range(win.status["cores"])}, "unstable": {"0": {"value": -40, "why": "crash"}}})
            win.ask_resume({"mode": "auto", "phase": "final", "single": 1, "started": "today", "params": {"margin": 3}, "final_margin": 3,
                            "core_margin": {"1": 3}, "results": {str(c): -35 for c in range(win.status["cores"])}, "unstable": {},
                            "final_failures": [{"values": [-32] * win.status["cores"], "why": "crash", "core": 1}]})
            fans = next(p for p in win.pages if isinstance(p, FansPage))
            chans = [{"canale": 8, "rpm": 0, "pwm": 255, "modo": 0, "role": "non-controllabile"},
                     {"canale": 9, "rpm": 0, "pwm": 0, "modo": 5}]   # no role = unknown
            fans.show({"canali": chans})
            cards = list(fans.cards)
            for on in (not fans.unknown.get_expanded(), fans.unknown.get_expanded()):   # flip and back: the user's choice stays
                fans.unknown.set_expanded(on)
                assert fans.unknown.get_visible() and fans.cards == cards, "unknown section missing or cards rebuilt"
                assert cards[0].is_ancestor(fans.body) and cards[1].is_ancestor(fans.body) == on, "unknown channel not hidden/shown"
                assert ui_load().get("show_unknown_fans") == on == win.ui["show_unknown_fans"], "expanded state not saved"
            fans.show({"canali": chans[:1]})
            assert not any(c.get_parent() for c in cards), "old cards kept on reload"
            assert not fans.unknown.get_visible(), "unknown section shown without unknown channels"
        except Exception:
            import traceback
            traceback.print_exc()
            self.smoke_failed = True
        self.quit()
        return False


def main():
    argv = list(sys.argv)
    mock, smoke = "--mock" in argv, "--smoke" in argv
    shots = None
    if "--screenshots" in argv:   # --mock --screenshots DIR: README screenshots from the fake backend
        i = argv.index("--screenshots")
        shots = argv[i + 1] if i + 1 < len(argv) else None
        if not mock or not shots:
            sys.exit("usage: ryzen-control --mock --screenshots DIR")
        os.makedirs(shots, exist_ok=True)
        del argv[i:i + 2]
    app = App(mock, smoke and mock, shots)
    rc = app.run([a for a in argv if a not in ("--mock", "--smoke")])
    sys.exit(1 if app.smoke_failed else rc)


if __name__ == "__main__":
    main()
