    def telemetry(self, t):
        value, sub, _bar = self.tiles["tctl"]
        value.set_text(fmt(t["tctl"], " °C"))
        sub.set_text("Tccd " + fmt(t["tccd"], " °C") + " · Tjmax " + fmt(t["tjmax"], " °C"))
        for key, unit in (("ppt", "W"), ("tdc", "A")):
            value, sub, bar = self.tiles[key]
            v, lim = t[key], t[key + "_limit"]
            value.set_text(fmt(v, " " + unit))
            sub.set_text(_("limit ") + fmt(lim, " " + unit))
            if v is not None and lim:
                bar.set_max_value(lim)
                bar.set_value(min(v, lim))
        value, sub, _bar = self.tiles["fmax"]
        value.set_text(fmt(t["fmax"], " MHz"))
        sub.set_text(_("EDC limit ") + fmt(t["edc_limit"], " A"))
        self.legend["tctl"].set_text("Tctl " + fmt(t["tctl"], " °C"))
        self.legend["ppt"].set_text("PPT " + fmt(t["ppt"], " W") + " / " + _("limit ") + fmt(t["ppt_limit"], " W"))
        if t["tctl"] is not None:
            self.hist.append((t["tctl"], t["ppt"]))
            self.ppt_limit = t["ppt_limit"]
            self.graph.queue_draw()
        for c, labs in enumerate(self.cores):
            d = t["cores"][c] if c < len(t["cores"]) else {}
            labs[0].set_text(fmt(d.get("mhz")))
            labs[1].set_text(fmt(d.get("temp")))
            labs[2].set_text(volts(d.get("volt"), ""))
            labs[3].set_text("%+d" % d["co"] if d.get("co") is not None else _("n/a"))
        for f in t["fans"]:
            lab = self.fan_labels.get(f["canale"])
            if lab is None:
                lab = self.fan_labels[f["canale"]] = label("", ["numeric"])
                self.fans.append(lab)
            pwm = f.get("pwm")
            if pwm is None:   # telemetry does not carry the pwm: last `fan status` (updated at every reload)
                pwm = next((c["pwm"] for c in (self.win.status.get("fans") or {}).get("canali", []) if c["canale"] == f["canale"]), None)
            role = f.get("role", "sconosciuto")
            lab.set_visible(role != "sconosciuto" or bool(self.win.ui.get("show_unknown_fans")))   # same choice as the Fans page
            lab.set_text(_("%s (%s) · %d rpm%s") % (f.get("name") or _("Channel %d") % f["canale"], ROLE_NAMES.get(role, role), f["rpm"],
                                                   " · pwm %d (%d %%)" % (pwm, pwm_pct(pwm)) if pwm is not None else ""))
        if not self.fan_labels:
            self.fans.append(label(_("No fans detected"), ["dim-label"]))
            self.fan_labels[0] = None
        self.power.set_text(_("Power mode: ") + (t["power"] or _("n/a")))

    def draw(self, area, cr, w, h):
        """Four-step grid shared by both scales: Tctl 20–100 °C on the left, PPT in round watts that
        cover its limit on the right (the limit dashed); time runs left to right, newest at the edge."""
        plim = self.ppt_limit or 0
        pstep = -(-plim // 20) * 5   # a quarter of the PPT scale: limit / 4 rounded up to 5 W
        left = ["%d °C" % (20 + 20 * i) for i in range(5)]
        right = ["%d W" % (pstep * i) for i in range(5)] if pstep else []
        cr.set_font_size(10)
        x0 = max(cr.text_extents(s).x_advance for s in left) + 8
        x1 = w - max([cr.text_extents(s).x_advance for s in right] or [0]) - 8
        y0, y1 = 14, h - 20   # room above the top line for the limit label
        Y = lambda f: y1 - min(max(f, 0), 1) * (y1 - y0)   # f: fraction of the scale
        col = area.get_color()
        cr.set_line_width(1)
        for i in range(5):
            y = round(Y(i / 4)) + 0.5   # 1 px lines on a pixel row: crisp
            cr.set_source_rgba(col.red, col.green, col.blue, 0.25)
            cr.move_to(x0, y)
            cr.line_to(x1, y)
            cr.stroke()
            cr.set_source_rgb(*self.TCTL_RGB)
            cr.move_to(x0 - 4 - cr.text_extents(left[i]).x_advance, y + 3.5)
            cr.show_text(left[i])
            if right:
                cr.set_source_rgb(*self.PPT_RGB)
                cr.move_to(x1 + 4, y + 3.5)
                cr.show_text(right[i])
        cr.set_source_rgba(col.red, col.green, col.blue, 0.7)
        cr.move_to(x0, h - 4)
        cr.show_text(_("%d s ago") % self.hist.maxlen)
        now = _("now")
        cr.move_to(x1 - cr.text_extents(now).x_advance, h - 4)
        cr.show_text(now)
        series = [(0, self.TCTL_RGB, 20, 80)]
        if pstep:
            series.append((1, self.PPT_RGB, 0, 4 * pstep))
            yl = round(Y(plim / (4 * pstep))) + 0.5
            cr.set_source_rgb(*self.PPT_RGB)
            cr.set_dash([5, 4])
            cr.move_to(x0, yl)
            cr.line_to(x1, yl)
            cr.stroke()
            cr.set_dash([])
            text = _("PPT limit")
            cr.move_to(x1 - 4 - cr.text_extents(text).x_advance, yl - 4 if yl - y0 > 14 else y0 - 4)   # above the line, else above the top one
            cr.show_text(text)
        n = self.hist.maxlen
        cr.set_line_width(2)
        for idx, rgb, base, span in series:
            pts = [(x0 + (x1 - x0) * (n - len(self.hist) + i) / (n - 1), Y((v[idx] - base) / span))
                   for i, v in enumerate(self.hist) if v[idx] is not None]
            if len(pts) < 2:
                continue
            cr.set_source_rgb(*rgb)
            cr.move_to(*pts[0])
            for p in pts[1:]:
                cr.line_to(*p)
            cr.stroke()


class AutotuneDialog(Adw.Window):
