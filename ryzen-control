class HelperError(Exception):
    pass


class Helper:
    """Un solo processo `ryzenctl serve`; chiamate serializzate. `call` blocca: usarla via `bg`."""

    def __init__(self, mock):
        env = dict(os.environ)
        if mock:
            root = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "ryzen-control-mock")
            os.makedirs(root, exist_ok=True)
            env["RYZENCTL_ROOT"] = root
            subprocess.run([RYZENCTL, "boot"], env=env, check=False, stdout=subprocess.DEVNULL)   # la baseline del "boot" finto
            cmd = [RYZENCTL, "serve"]
        else:
            cmd = ["pkexec", RYZENCTL, "serve"]
        self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=env, text=True, bufsize=1)
        self.lock = threading.Lock()

    def call(self, *argv):
        with self.lock:
            try:
                self.p.stdin.write(json.dumps(list(argv)) + "\n")
                self.p.stdin.flush()
                line = self.p.stdout.readline()
            except (OSError, ValueError):
                line = ""
            if not line:
                raise HelperError("ryzenctl serve non risponde (pkexec negato o processo terminato): riavvia l'applicazione")
            r = json.loads(line)
            if not r.get("ok"):
                raise HelperError(r.get("error", "errore sconosciuto"))
            return r.get("data")

    def close(self):
        try:
            self.p.stdin.close()
            self.p.wait(timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            self.p.kill()


def bg(work, done, fail):
    """work() in un thread; done(risultato) o fail(messaggio) nel main loop. Mai bloccare la UI."""
    def run():
        try:
            out = work()
        except Exception as e:  # HelperError o bug: mostrato all'utente, mai perso
            GLib.idle_add(fail, str(e))
            return
        GLib.idle_add(done, out)
    threading.Thread(target=run, daemon=True).start()


def fmt(v, unit=""):
    return "n/d" if v is None else "%g%s" % (v, unit)


def button(label, cb, css=None):
    b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
    if css:
        b.add_css_class(css)
    b.connect("clicked", lambda *_: cb())
    return b


def label(text="", css=(), xalign=0.0, **kw):
    lab = Gtk.Label(label=text, xalign=xalign, **kw)
    for c in css:
        lab.add_css_class(c)
    return lab


def card(orientation=Gtk.Orientation.VERTICAL, spacing=6):
    return Gtk.Box(orientation=orientation, spacing=spacing, css_classes=["card", "tile"])


def summary(lines):
    """Riassunto di un profilo: 'PPT 89 W · FMax 4825 · balanced · ventole 10 s/5 s'."""
    out, fan = [], None
    for t in (l.split() for l in lines):
        if t[0] == "ppt":
            out.append("PPT %s W" % t[1])
        elif t[0] == "fmax":
            out.append("FMax %s" % t[1])
        elif t[0] == "tjmax":
            out.append("Tjmax %s °C" % t[1])
        elif t[0] == "power":
            out.append(t[1])
        elif t[0] == "fan" and len(t) == 5 and t[2] == "step" and fan is None:
            fan = "ventole %g s/%g s" % (int(t[3]) / 1000, int(t[4]) / 1000)
    return " · ".join(out + ([fan] if fan else [])) or "profilo vuoto"


class Param(Gtk.Box):
    """Riga parametro: etichetta, info, Scale con marks, SpinButton (stessa Adjustment), 'attuale → nuovo'."""

    def __init__(self, title, unit, info=False):
        super().__init__(spacing=12)
        self.unit, self.read = unit, None
        self.adj = Gtk.Adjustment(lower=0, upper=1, step_increment=1, page_increment=5)
        self.append(label(title, ["heading"], width_chars=9))
        self.info = label("", ["dim-label", "numeric"], width_chars=16, visible=info)
        self.append(self.info)
        self.scale = Gtk.Scale(adjustment=self.adj, hexpand=True, draw_value=True, digits=0, value_pos=Gtk.PositionType.TOP)
        self.append(self.scale)
        self.append(Gtk.SpinButton(adjustment=self.adj, digits=0, valign=Gtk.Align.CENTER))
        self.delta = label("", ["numeric"], xalign=1.0, width_chars=15)
        self.append(self.delta)
        self.adj.connect("value-changed", self.show_delta)

    def setup(self, lo, hi, read, base=None):
        self.read = read
        self.adj.set_lower(lo)
        self.adj.set_upper(hi)
        self.scale.clear_marks()
        self.scale.add_mark(lo, Gtk.PositionType.BOTTOM, None)
        self.scale.add_mark(hi, Gtk.PositionType.BOTTOM, None)
        if base is not None and lo <= base <= hi:
            self.scale.add_mark(base, Gtk.PositionType.BOTTOM, "base")
        self.reset()

    def value(self):
        return int(round(self.adj.get_value()))

    def changed(self):
        return self.read is not None and self.value() != self.read

    def reset(self):
        if self.read is not None:
            self.adj.set_value(self.read)
        self.show_delta()

    def show_delta(self, *_):
        if self.read is None:
            return
        if self.changed():
            self.delta.set_markup("<span alpha='60%%'>%d</span> → <b>%d</b> %s" % (self.read, self.value(), self.unit))
            self.delta.add_css_class("accent")
        else:
            self.delta.set_markup("<span alpha='60%%'>%d %s</span>" % (self.read, self.unit))
            self.delta.remove_css_class("accent")


class Page(Gtk.Box):
    """Contenuto scorrevole + barra pulsanti fissa in fondo."""

    def __init__(self, win, help_text=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.win = win
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=12, margin_bottom=12,
                            margin_start=12, margin_end=12)
        if help_text:
            self.body.append(label(help_text, ["dim-label"], wrap=True))
        self.append(Gtk.ScrolledWindow(child=self.body, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER))
        self.bar = Gtk.Box(spacing=12, halign=Gtk.Align.END, css_classes=["toolbar"])
        self.append(self.bar)

    def buttons(self, *extra):
        for b in extra:
            self.bar.append(b)
        self.bar.append(button("Ripristina valori letti", self.reset))
        self.bar.append(button("Salva nel profilo…", lambda: self.win.save_profile(self.lines(False))))
        self.bar.append(button("Applica ora", lambda: self.win.apply_lines(self.lines(True)), "suggested-action"))

    def telemetry(self, t):
        pass


