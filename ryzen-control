        grid = Gtk.Grid(column_spacing=14, row_spacing=4, hexpand=True)
        heads = ((_("Core"), None), (_("Stock"), _("Stock CO; below, the reference voltage measured at start under the same load")),
                 (_("Testing"), _("CO level under test on the core; below, the last voltage measured at full load and the difference from the reference")),
                 (_("Last stable"), None), (_("Unstable at"), None),
                 (_("Final"), _("measured limit + mode margin + 3 for every failed final pass")))
        for col, (h, tip) in enumerate(heads):
            grid.attach(label(h, ["heading"], tooltip_text=tip), col, 0, 1, 1)
        self.cells = []
        for c in range(win.status.get("cores", 0)):   # one row per active core
            cell = {"core": label("%d" % c, ["numeric"], valign=Gtk.Align.START)}
            boxes = []
            for key in ("fab", "prova"):   # two lines: CO above, voltage below; fixed width = no reflows
                cell[key] = (label("—", ["numeric"], width_chars=4 if key == "fab" else 8),
                             label(" ", ["numeric", "caption"], width_chars=9 if key == "fab" else 22))
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                box.append(cell[key][0])
                box.append(cell[key][1])
                boxes.append(box)
            for key, wc in (("stable", 6), ("unstable", 16), ("final", 6)):
                cell[key] = label("—", ["numeric"], valign=Gtk.Align.START, width_chars=wc)
            for col, w in enumerate([cell["core"]] + boxes + [cell["stable"], cell["unstable"], cell["final"]]):
                w.set_hexpand(col > 0)          # the data columns share the available width
                grid.attach(w, col, c + 1, 1, 1)
            self.cells.append(cell)
        body.append(grid)
        body.append(label(_("One CO (Curve Optimizer) step is worth about 3–5 mV less voltage at the same frequency; "
                            "here you see the real voltage measured at full load for every level."), ["dim-label", "caption"], wrap=True))
        self.slope = label("", ["numeric"], visible=False)
        body.append(self.slope)
        self.failures = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)   # failed final passes, one line each
        body.append(self.failures)
        self.sweeps = label("", ["numeric"], wrap=True)
        body.append(self.sweeps)
        self.result = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        body.append(self.result)
        bar = Gtk.Box(spacing=12, halign=Gtk.Align.END, css_classes=["toolbar"])
        self.abort_btn = button(_("Stop"), self.abort, "destructive-action")
        self.close_btn = button(_("Close"), self.discard)                        # error: nothing to save
        self.discard_btn = button(_("Discard"), self.discard, "destructive-action")
        self.save_btn = button(_("Save"), lambda: self.save(False))
        self.save_apply_btn = button(_("Save and apply"), lambda: self.save(True), "suggested-action")
        for b in (self.close_btn, self.discard_btn, self.save_btn, self.save_apply_btn):
            b.set_visible(False)
        self.save_btn.set_tooltip_text(_("Writes the %s profile without activating it: apply it from the Modes page") % mode)
        self.save_apply_btn.set_tooltip_text(_("Writes the %s profile, applies it right away and selects it") % mode)
        for b in (self.abort_btn, self.close_btn, self.discard_btn, self.save_btn, self.save_apply_btn):
            bar.append(b)
        # in a wide window the content stays centred and readable (max 1100 px), the grid widens
        clamp = Adw.Clamp(child=body, maximum_size=1100, tightening_threshold=800)
        self.scroller = Gtk.ScrolledWindow(child=clamp, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        tv = Adw.ToolbarView(content=self.scroller, top_bar_style=Adw.ToolbarStyle.RAISED)
        tv.add_top_bar(Adw.HeaderBar())
        tv.add_top_bar(Adw.Clamp(child=pinned, maximum_size=1100, tightening_threshold=800))
        tv.add_bottom_bar(bar)
        self.set_content(tv)
        self.present()

    def on_close_request(self, *_a):
        if not self.closable:
            self.win.toast(_("Calibration in progress: use \"Stop\""))
            return True     # blocks the close
        return False

    def start(self, params):
        argv = ["autotune", "start", self.mode] + ["%s=%d" % kv for kv in params.items()]
        bg(lambda: self.win.h.call(*argv), self.got, self.fail)

    def loop(self):
        if self.running or self.aborting:
            return
        self.running = True
        bg(lambda: self.win.h.call("autotune", "step"), self.got, self.fail)

    def got(self, st):
        self.running = False
        self.show(st)
        if st.get("phase") == "done":
            self.done(st)
        else:
            self.loop()

    def fail(self, msg):
        self.running = False
        self.phase.set_text(_("Error: ") + msg)
        self.abort_btn.set_visible(False)
        self.close_btn.set_visible(True)
        setattr(self, "closable", True)

    def show(self, st):
        ph, p = st.get("phase"), st.get("params", {})
        if st.get("resumed_after_crash"):
            self.note.set_text(_("The system rebooted during a test: that step has been marked unstable. If the final CO was already "
                                 "applied, the combination is unstable and the final pass is repeated with +3 on every core."))
            self.note.set_visible(True)
        if st.get("co_reused"):   # search skipped: table already populated, the CO phase counts as complete in the bar
            if st.get("eco_from"):   # Eco: final pass skipped too
                text = _("Undervolt validated by the final pass of %s, reused without load tests. %s") % (st["eco_from"], crash_story(st, len(self.cells)))
            else:
                text = _("CO limit reused from the measurement of %s. %s") % (st["co_reused"], crash_story(st, len(self.cells)))
            self.reuse.set_text(text)
            self.reuse.set_visible(True)
        eta = st.get("eta") or {}
        if eta:
            self.header.set_text(_("Started at %s · estimated %s in total") % (st.get("started", "")[-5:], mins(eta.get("total_s"))))
            self.eta.set_text(_("Estimated time remaining: %s") % mins(eta.get("remaining_s")))
        n = len(self.cells)
        if ph == "co" and st.get("parallel"):
            levels = max(1, (-(p.get("colimit") or -5)) // 5)      # levels of 5 (CO_STEP), like at_estimate in ryzenctl
            self.phase.set_text(_("CO level %d: testing all cores together (still under test: %d cores)…") % (st["value"], len(st.get("active_cores", []))))
            frac = AT_PHASES["co"] * max(0, (-st["value"]) // 5 - 1) / levels
        elif ph == "co":
            self.phase.set_text(_("Core %d: testing CO %d…") % (st["core"], st["value"]))
            frac = (st["core"] + min(1.0, st["value"] / p["colimit"] if p.get("colimit") else 0)) / max(1, len(self.cells))
        elif ph == "final":
            vals, c = self.final_values(st, n), st.get("single")
            if c is None:
                self.phase.set_text(_("Final pass on all cores at CO %s (attempt %d/3)") % (self.co_span(vals), st.get("final_tries", 0) + 1))
            else:   # the single-core part: one step per core
                self.phase.set_text(_("Final pass, single-core test: core %d alone at CO %d (%d of %d)…") % (c, vals[c], c + 1, n))
            part = 0 if c is None else (c + 1) / float(n + 1)
            frac = AT_PHASES["co"] + (AT_PHASES["final"] - AT_PHASES["co"]) * min(1.0, (st.get("final_tries", 0) + part) / 3)
        elif ph == "bench":                       # Boost: a single step, performance at stock and in boost
            self.phase.set_text(_("Measuring performance at stock and in boost (MT and ST)…") + self.load_text(st))
            frac = (AT_PHASES["final"] + AT_PHASES["bench"]) / 2
        elif ph in ("ppt", "fmax_knee"):          # Auto: performance/watt knee
            k = st.get("knee", {}).get("ppt" if ph == "ppt" else "fmax", {})
            tests, cur = k.get("tests", []), k.get("current")
            unit = "W" if ph == "ppt" else "MHz"
            if tests:
                last = tests[-1]
                self.phase.set_text(_("%s %s %s: %.0f op/s at %.0f W → trying %s %s…%s") % (
                    "PPT" if ph == "ppt" else "FMax", last[0], unit, last[1], last[2], cur, unit, self.load_text(st)))
            else:
                self.phase.set_text(_("%s %s %s: measuring performance and power…%s") % ("PPT" if ph == "ppt" else "FMax", cur, unit, self.load_text(st)))
            lo, hi = (AT_PHASES["final"], AT_PHASES["ppt"]) if ph == "ppt" else (AT_PHASES["ppt"], AT_PHASES["fmax_knee"])
            frac = lo + (hi - lo) * min(1.0, len(tests) / 6.0)
        else:
            self.phase.set_text(_("Calibration complete") if not st.get("error") else _("Calibration ended: ") + st["error"])
            frac = 1.0
        self.progress.set_fraction(max(0.0, min(1.0, frac)))
        self.queue_draw()                   # full redraw: no fragments of the previous frame
        self.follow()
        res, uns, fin = st.get("results", {}), st.get("unstable", {}), st.get("final")
        base_co = (self.win.status.get("baseline") or {}).get("co") or [None] * n
        ref = (st.get("samples", {}).get("0") or {}).get("volt") or [None] * n
        ref_mhz = (st.get("samples", {}).get("0") or {}).get("mhz") or [None] * n
        active = st.get("active_cores", []) if st.get("parallel") else [st.get("core")]
        for c, cell in enumerate(self.cells):
            fab_sub = volts(ref[c]) + (" · " + mhz(ref_mhz[c]) if ref_mhz[c] is not None else "") if ref[c] is not None else None
            self.two_lines(cell["fab"], "%d" % base_co[c] if base_co[c] is not None else "—", fab_sub)
            smp = at_sample(st, c)                      # deepest measurement available for this core
            cur = st["value"] if ph == "co" and c in active else (smp[0] if smp else None)
            sub, css = None, None
            if smp:
                dmv = round((smp[1] - ref[c]) * 1000) if ref[c] is not None else None
                sub = (("" if smp[0] == cur else _("at %d: ") % smp[0]) + volts(smp[1]) + (" · " + mhz(smp[2]) if smp[2] is not None else "")
                       + ("" if dmv is None else " · %+d mV" % dmv))
                css = "success" if dmv is not None and dmv < 0 else None
            self.two_lines(cell["prova"], "%d" % cur if cur is not None else "—", sub, css)
            why = uns[str(c)]["why"] if str(c) in uns else None
            for lab, text, cls in ((cell["stable"], "%d" % res[str(c)] if str(c) in res else None, "success"),
                                   (cell["unstable"], "%d (%s)" % (uns[str(c)]["value"], WHY_NAMES.get(why, why)) if str(c) in uns else None, "error"),
                                   (cell["final"], "%d" % fin[c] if fin else None, "success")):
                lab.set_markup("<b>%s</b>" % text if text and lab is cell["final"] else (text or "—"))
                (lab.add_css_class if text else lab.remove_css_class)(cls)
        fails = st.get("final_failures") or []
        while self.failures.get_first_child():
            self.failures.remove(self.failures.get_first_child())
        for f in fails:
            why = f.get("why", "?")
            if f.get("core") is not None:   # failed alone in the single-core part: only that core is raised
                text = _("Core %d failed alone at CO %d (%s): +3 on that core only and a new final pass") % (
                    f["core"], f["values"][f["core"]], WHY_NAMES.get(why, why))
            else:
                text = _("Final pass failed at CO %s (%s): +3 on every core and a new attempt") % (self.co_span(f.get("values") or [0]), WHY_NAMES.get(why, why))
            self.failures.append(label(text, ["warning"], wrap=True))
        slope = st.get("mv_per_step")          # median of the slopes per level, computed by ryzenctl
        self.slope.set_visible(slope is not None)
        if slope is not None:
            self.slope.set_text(_("Measured on this CPU: ≈ %s mV per CO step") % locale.format_string("%g", round(slope, 1)))
        knee, text = st.get("knee"), ""
        if knee:   # Auto: the knee sweeps
            for key, unit in (("ppt", "W"), ("fmax", "MHz")):
                if knee[key]["tests"]:
                    text += ("\n" if text else "") + _("%s sweep:\n") % key.upper() + "\n".join(
                        "%s %s → %.0f op/s, %.0f W" % (t[0], unit, t[1], t[2]) for t in knee[key]["tests"])
        self.sweeps.set_text(text)
        self.sweeps.set_visible(bool(text))   # Eco and Boost have no sweep: no empty gap above the result

    @staticmethod
    def final_values(st, cores):
        """CO of the final pass: measured limit + margin (computed by ryzenctl: mode, failed passes, crash) + the
        extra margin of the cores that failed alone in the single-core test (core_margin)."""
        m = st.get("final_margin", st.get("params", {}).get("margin", 0) + 3 * st.get("final_tries", 0))
        cm = st.get("core_margin") or {}
        return [min(0, st.get("results", {}).get(str(c), 0) + m + cm.get(str(c), 0)) for c in range(cores)]

    @staticmethod
    def co_span(vals):
        return "%d" % vals[0] if min(vals) == max(vals) else "%d … %d" % (min(vals), max(vals))

    @staticmethod
    def load_method(st):
        """stress-ng method chosen by ryzenctl as the heaviest on this CPU (Auto: knee.method, Boost: method)."""
        return (st.get("knee") or {}).get("method") or st.get("method")

    def load_text(self, st):
        m = self.load_method(st)
        return _(" (load: %s)") % m if m else ""

    @staticmethod
    def two_lines(pair, main, sub=None, sub_css=None):
        pair[0].set_text(main)
        pair[1].set_text(sub or "")
        if not sub:
            pair[1].set_text(" ")          # stays allocated: the row height does not change
        pair[1].remove_css_class("success")
        if sub_css:
            pair[1].add_css_class(sub_css)

    def follow(self):
        """New lines (sweeps, failed passes, results) go at the bottom: scroll there, unless the user
        scrolled up to read something."""
        adj = self.scroller.get_vadjustment()
        at_end = adj.get_value() >= adj.get_upper() - adj.get_page_size() - 40
        if at_end:   # after the layout of the new content
            GLib.idle_add(lambda: adj.set_value(adj.get_upper() - adj.get_page_size()) and False)

    def done(self, st):
        if st.get("error"):
            self.result.append(label(st["error"], ["warning"], wrap=True))
        tries = st.get("final_tries", 0)
        crashed = any(u.get("why") == "crash" for u in (st.get("unstable") or {}).values())
        if (tries or crashed) and st.get("final"):
            why = []
            if tries:
                why.append(_("the combined pass failed once") if tries == 1 else _("the combined pass failed %d times") % tries)
            if crashed:
                why.append(_("the search ended with a system lockup (+3)"))
            self.result.append(label(_("The final margin is +%d because %s") % (st.get("final_margin", 0), _(" and ").join(why)), ["warning"], wrap=True))
        cm = st.get("core_margin") or {}
        if cm and st.get("final"):   # cores that failed alone in the single-core test of the final pass
            self.result.append(label(_("Raised alone after failing the single-core test: %s") % ", ".join(
                _("core %s +%d") % (c, m) for c, m in sorted(cm.items(), key=lambda kv: int(kv[0]))), ["warning"], wrap=True))
        if st.get("final"):   # per core: stock → final CO and measured ΔV (sample at the final level or the closest one)
            n = len(st["final"])
            base_co = (self.win.status.get("baseline") or {}).get("co") or [None] * n
            ref = (st.get("samples", {}).get("0") or {}).get("volt") or [None] * n
            grid = Gtk.Grid(column_spacing=18, row_spacing=4)
            for col, h in enumerate((_("Core"), _("Stock → final CO"), _("Measured ΔV"))):
                grid.attach(label(h, ["heading"], tooltip_text=CO_TIP if col == 1 else None), col, 0, 1, 1)
            for c in range(n):
                grid.attach(label("%d" % c, ["numeric"]), 0, c + 1, 1, 1)
                grid.attach(diff_label(base_co[c], st["final"][c]), 1, c + 1, 1, 1)
                smp = at_sample(st, c, st["final"][c])
                if smp and ref[c] is not None:
                    dmv = round((smp[1] - ref[c]) * 1000)
                    lab = label(_("%+d mV (%s → %s%s at CO %d)") % (dmv, volts(ref[c]), volts(smp[1]), ", " + mhz(smp[2]) if smp[2] is not None else "", smp[0]),
                                ["numeric", "success" if dmv < 0 else "dim-label"])
                else:
                    lab = label(_("n/a"), ["numeric", "dim-label"])
                grid.attach(lab, 2, c + 1, 1, 1)
            self.result.append(label(_("CO (Curve Optimizer) per core: stock → final, with the measured voltage"), ["heading"], tooltip_text=CO_TIP))
            self.result.append(grid)
        bench = st.get("bench")
        if bench and bench.get("gain_mt_pct") is not None:
            pct = lambda v: locale.format_string("%+.1f %%", v) if v is not None else _("n/a")
            ops = lambda d: ("%.0f" % (d or {}).get("mt", [0])[0])
            g = bench["gain_mt_pct"]
            self.result.append(label(_("Measured gain: multi-thread %s (%s → %s op/s), single-thread %s") % (
                pct(g), ops(bench.get("fabbrica")), ops(bench.get("boost")), pct(bench.get("gain_st_pct"))),
                ["numeric", "success" if g > 0 else ("error" if g < 0 else "dim-label")], wrap=True))
        if st.get("profile_lines"):
            self.result.append(label(_("%s profile: stock → calibrated") % self.mode, ["heading"]))
            self.result.append(profile_view(st["profile_lines"], self.win.status))
        knee = st.get("knee")
        if knee and knee["ppt"].get("chosen"):
            self.result.append(label(_("Performance/watt knee: PPT %d W, FMax %d MHz (maximum loss %d %%)") % (
                knee["ppt"]["chosen"], knee["fmax"]["chosen"] or 0, st.get("params", {}).get("loss", 0)), ["numeric"], wrap=True))
        method = self.load_method(st)
        if method:
            self.result.append(label(_("Test load: %s — the one that draws the most power on this CPU") % method, ["dim-label"], wrap=True))
        # ponytail: "below the limit" = more than 5 % under; the PM table watts swing by a few units around the limit
        below = [t for t in (knee or {}).get("ppt", {}).get("tests", []) if len(t) >= 3 and t[2] < t[0] * 0.95]
        if len(below) > 1:
            self.result.append(label(_("The test load did not reach the configured power limit: the knee holds for loads of this intensity"),
                                     ["warning"], wrap=True))
        self.abort_btn.set_visible(False)
        if st.get("profile_lines"):
            self.phase.set_text(_("Calibration complete: discard, save, or save and apply?"))
            for b in (self.discard_btn, self.save_btn, self.save_apply_btn):
                b.set_visible(True)
        else:
            self.phase.set_text(_("Calibration ended without a profile to save"))
            self.close_btn.set_visible(True)
        self.follow()   # the proposed profile is at the bottom
        # the choice is mandatory: the window closes only afterwards (the state stays on disk and is proposed again)

    def choose(self, argv, msg):
        for b in (self.close_btn, self.discard_btn, self.save_btn, self.save_apply_btn):
            b.set_sensitive(False)
        self.win.run([argv], lambda _r: (self.win.toast(msg), setattr(self, "closable", True), self.close()))

    def discard(self):
        self.choose(["autotune", "abort"], _("Calibration discarded, CPU at baseline"))

    def save(self, apply):
        self.choose(["autotune", "save"] + (["apply"] if apply else []),
                    _("%s profile saved and applied") % self.mode if apply else _("%s profile saved (not applied)") % self.mode)

    def abort(self):
        self.aborting = True
        self.abort_btn.set_sensitive(False)
        self.phase.set_text(_("Stopping…"))
        self.win.run([["autotune", "abort"]], lambda _r: (self.win.toast(_("Calibration discarded, CPU at baseline")), setattr(self, "closable", True), self.close()))


class ModesPage(Gtk.ScrolledWindow):
    NAME, TITLE, ICON = "modes", _("Modes"), "emblem-default-symbolic"

    def __init__(self, win):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        self.win = win
        self.loading = False
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24, margin_top=12, margin_bottom=24, margin_start=12, margin_end=12)
        self.set_child(Adw.Clamp(child=content, maximum_size=1400, tightening_threshold=1000))   # two columns: wider than a PreferencesPage
        # two columns always side by side (a FlowBox stacked them: the expanded rows ask for more
        # natural width than half the window), presets and manual choices on the left, calibrated ones on the right
        cols = Gtk.Box(spacing=18, homogeneous=True)
        lists = {}
        for name, title, desc in (("preset", _("Presets"), _("Fixed values derived from the stock ones, no test; plus Default and Custom")),
                                  ("calibrate", _("Calibrated"), _("Measured on this CPU with load tests (Calibrate…)"))):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, valign=Gtk.Align.START, hexpand=True)
            col.append(label(title, ["heading"]))
            col.append(label(desc, ["dim-label", "caption"], wrap=True))
            lists[name] = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
            col.append(lists[name])
            cols.append(col)
        content.append(cols)
        self.rows, first = {}, None
        self.tables = {}
        for key, title, sub in MODES:
            if key in PRESETS:   # expandable: under the row the stock → profile table
                row = Adw.ExpanderRow(title=title, subtitle=sub, expanded=True)
            else:
                row = Adw.ActionRow(title=title, subtitle=sub, activatable=True)
            chk = Gtk.CheckButton(valign=Gtk.Align.CENTER, group=first)
            first = first or chk
            row.add_prefix(chk)
            if key not in PRESETS:
                row.set_activatable_widget(chk)
            chk.connect("toggled", self.on_mode, key)
            regen = None
            if key in PRESETS:
                # compact suffixes: with too many wide buttons the title was squeezed to a single column
                row.set_title_lines(1)
                row.set_subtitle_lines(3)          # half-window column: the subtitle needs one more line
                tag = Gtk.Label(label=_("calibrated") if key in CALIBRATED else _("preset"), valign=Gtk.Align.CENTER,
                                tooltip_text=_("Adapts to the hardware with load tests") if key in CALIBRATED
                                else _("Fixed values derived from the stock ones, no test"))
                tag.add_css_class("chip")
                tag.add_css_class("success" if key in CALIBRATED else "dim-label")
                row.add_suffix(tag)
                if key in CALIBRATED:
                    cal = button(_("Calibrate…"), lambda k=key: self.calibrate(k))
                    cal.set_tooltip_text(_("Measures on this CPU: per-core undervolt, FMax, limits and fans"))
                    row.add_suffix(cal)
                regen = Gtk.Button(icon_name="view-refresh-symbolic", valign=Gtk.Align.CENTER,
                                   tooltip_text=_("Regenerate the profile from the stock values"))
                regen.add_css_class("flat")
                regen.connect("clicked", lambda *_a, k=key: self.regen(k))
                row.add_suffix(regen)
            self.rows[key] = (row, chk, regen)
            if key == "boost":
                self.boost_widgets = (chk, cal, regen)
            lists["calibrate" if key in CALIBRATED else "preset"].append(row)
        self.lock_boost(True)   # until the status says that unlock is on

    def lock_boost(self, locked):
        """Boost only with unlock (ryzenctl refuses it too): radio and buttons insensitive, row dimmed,
        the reason in the tooltip of the row, which stays sensitive: GTK 4 hides a tooltip owned by an
        insensitive widget at the first pointer motion. The buttons' own tooltips are off meanwhile,
        so they do not cover the row's."""
        row = self.rows["boost"][0]
        for w in self.boost_widgets:
            w.set_sensitive(not locked)
            w.set_has_tooltip(not locked)
        (row.add_css_class if locked else row.remove_css_class)("dim-label")
        row.set_tooltip_text(_("Boost needs \"Allow beyond the stock values\": turn it on in Preferences") if locked else None)

    def refresh(self, st):
        self.loading = True
        self.lock_boost(not st.get("unlock"))
        prof = st.get("profile")
        shown = st.get("profile_lines", {})
        for key, title, sub in MODES:
            row, chk, regen = self.rows[key]
            if regen:
                exists = key in shown
                regen.set_visible(exists)
                row.set_subtitle(sub if exists else sub + _(" — profile not created yet: tick to create it"))
                if key in self.tables:
                    row.remove(self.tables.pop(key))
                if exists:   # explicit ListBoxRow: this way `row.remove` finds it again at the next refresh
                    self.tables[key] = Gtk.ListBoxRow(child=profile_table(shown[key], st), activatable=False, selectable=False)
                    row.add_row(self.tables[key])
                    row.set_expanded(True)
        current = prof if prof in PRESETS else ("custom" if prof else "default")
        self.rows[current][1].set_active(True)
        self.loading = False

    def on_mode(self, chk, key):
        if self.loading or not chk.get_active():
            return
        if key == "default":
            self.win.run([["default"]], lambda _r: self.win.toast(_("Stock values applied")))
        elif key == "custom":
            self.win.toast(_("Set the values in the CPU, Curves and Fans pages and use \"Apply now\""))
        elif key in self.win.status.get("profile_lines", {}):
            self.win.run([["apply", key], ["use", key]], lambda _r: self.win.toast(_("Profile '%s' applied") % key))
        else:
            def ask(res):
                def go(ok):
                    if ok:
                        self.win.run([["preset", key], ["apply", key], ["use", key]], lambda _r: self.win.toast(_("Profile '%s' created and applied") % key))
                    else:
                        self.win.reload()
                self.win.confirm(_("Create the '%s' profile?") % key, _("Stock values → profile (green = more conservative, red = more aggressive):"),
                                 _("Create and apply"), go, extra=profile_view(res["lines"], self.win.status))
            bg(lambda: self.win.h.call("preset", key, "show"), ask, lambda m: (self.win.toast(m), self.win.reload()))

    def calibrate(self, mode):
        """First the estimate (`autotune estimate`), then a simple choice: automatic with the ryzenctl defaults, or the parameters by hand."""
        def ask(est):
            p = est["params"]
            target = _("target Tctl %d °C, ") % p["target"] if "target" in p else ""   # Boost: no thermal target
            if est.get("eco_from"):   # Eco: these CO values already passed a final pass, nothing to test
                auto = _("reuses the undervolt validated by the final pass of %s, without load tests: the profile is proposed right away.") % est["eco_from"]
            elif est.get("co_reuse"):   # limit search already done: only the final pass with this mode's margin
                auto = _("CO (Curve Optimizer) limit already measured on %s: reused (repeat the search from \"Choose the values…\"), %s — %smargin %d, %d s per test.") % (
                    est["co_reuse"], mins(est["parallel_total_s"]), target, p["margin"], p["step"])
            else:
                auto = _("all cores together, %s — %sCO (Curve Optimizer) down to %d with margin %d, %d s per test.") % (
                    mins(est["parallel_total_s"]), target, p["colimit"], p["margin"], p["step"])
            # the chosen level as the subtitle (as a value at the end of the row the dialog cut it down to "…");
            # use_subtitle before model/selected: set after them, libadwaita leaves the subtitle empty
            fans = Adw.ComboRow(title=_("Fans"), use_subtitle=True, model=Gtk.StringList.new(list(FAN_LEVELS)), selected=p.get("fans", 0),
                                tooltip_text=_("Also in automatic mode: how much the mode touches the fans (only the channels recognised as fans)"))
            lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
            lb.append(fans)
            d = Adw.AlertDialog(heading=_("Calibrate the %s mode?") % mode.capitalize(),
                                body=_("Automatic (recommended): %s\n\n%s\n\n%s") % (auto, AT_WARNING, CO_TIP), extra_child=lb)
            d.add_response("cancel", _("Cancel"))
            d.add_response("custom", _("Choose the values…"))
            d.add_response("auto", _("Automatic (recommended)"))
            d.set_response_appearance("auto", Adw.ResponseAppearance.SUGGESTED)
            def resp(_d, r):
                if r == "auto":
                    AutotuneDialog(self.win, mode).start(dict(p, parallel=1, fans=fans.get_selected()))
                elif r == "custom":
                    self.calibrate_params(mode, dict(est, params=dict(p, fans=fans.get_selected())))
            d.connect("response", resp)
            d.present(self.win)
        bg(lambda: self.win.h.call("autotune", "estimate", mode), ask, self.win.toast)

    def calibrate_params(self, mode, est):
        """Parameters (ranges from AT_PARAMS, defaults from ryzenctl) with an estimate that follows the changes → autotune start → progress."""
        group = Adw.PreferencesGroup()
        spins = {}
        for key, title, unit, (lo, hi), sub in AT_PARAMS:
            if key not in est["params"]:   # e.g. Boost has no `target`
                continue
            r = Adw.SpinRow.new_with_range(lo, hi, 1)
            r.set_title(title + (" (%s)" % unit if unit else ""))
            r.set_subtitle(sub or "")
            r.set_value(est["params"][key])
            spins[key] = r
            group.add(r)
        parallel = Adw.SwitchRow(title=_("Test all cores together (fast, recommended)"), active=bool(est["params"].get("parallel", 1)))
        group.add(parallel)
        single = Adw.SwitchRow(title=_("Single-core test in the final pass"), active=bool(est["params"].get("single", 1)))
        group.add(single)
        fans = Adw.ComboRow(title=_("Fans"), use_subtitle=True, model=Gtk.StringList.new(list(FAN_LEVELS)), selected=est["params"].get("fans", 0))
        group.add(fans)
        repeat = Adw.SwitchRow(title=_("Repeat the CO limit search"), active=False, sensitive=bool(est.get("co_reuse")))
        group.add(repeat)
        estimate = label("", ["heading"], margin_top=6)
        params = lambda: dict(((k, int(r.get_value())) for k, r in spins.items()), parallel=int(parallel.get_active()),
                              single=int(single.get_active()), reuse=int(not repeat.get_active()), fans=fans.get_selected())
        def show_est(e):
            estimate.set_text(_("Estimated duration: %s") % mins(e["total_s"]) + (
                _(" (undervolt validated by the final pass of %s: no load test)") % e["eco_from"] if e.get("eco_from") else ""))
            parallel.set_subtitle(AT_PARALLEL_SUB % mins(e["sequential_total_s"]))
            single.set_subtitle(AT_SINGLE_SUB % mins(e.get("single_s")))
            repeat.set_subtitle(_("Off: reuses the measurement of %s; on: measures the limit again (longer)") % e["co_reuse"] if e.get("co_reuse")
                                else (_("full search") if repeat.get_active() else _("no usable previous measurement")))
        pending = {"timer": 0, "seq": 0}
        def refresh_est():
            pending["timer"] = 0
            pending["seq"] += 1
            seq = pending["seq"]
            def got(e):
                if seq == pending["seq"]:   # only the last requested estimate
                    show_est(e)
            argv = ["autotune", "estimate", mode] + ["%s=%d" % kv for kv in params().items()]
            bg(lambda: self.win.h.call(*argv), got, self.win.toast)
            return False
        def changed(*_a):   # debounce: one estimate after 400 ms of quiet
            if pending["timer"]:
                GLib.source_remove(pending["timer"])
            pending["timer"] = GLib.timeout_add(400, refresh_est)
        for r in spins.values():
            r.connect("notify::value", changed)
        for sw in (parallel, single, repeat):
            sw.connect("notify::active", changed)
        show_est(est)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.append(group)
        box.append(estimate)
        d = Adw.AlertDialog(heading=_("%s calibration parameters") % mode.capitalize(), body=AT_WARNING, extra_child=box)
        d.spins, d.parallel, d.single, d.repeat, d.estimate = spins, parallel, single, repeat, estimate   # reachable from the driven tests
        d.params = params
        d.add_response("cancel", _("Cancel"))
        d.add_response("start", _("Start"))
        d.set_response_appearance("start", Adw.ResponseAppearance.DESTRUCTIVE)
        def resp(_d, r):
            if pending["timer"]:
                GLib.source_remove(pending["timer"])
                pending["timer"] = 0
            if r == "start":
                AutotuneDialog(self.win, mode).start(params())
        d.connect("response", resp)
        d.present(self.win)
        return d

    def regen(self, key):
        def ask(res):
            def go(ok):
                if ok:
                    cmds = [["preset", key]] + ([["apply", key]] if self.win.status.get("profile") == key else [])
                    self.win.run(cmds, lambda _r: self.win.toast(_("Profile '%s' regenerated") % key))
            self.win.confirm(_("Regenerate '%s' from the stock values?") % key, _("The current profile is replaced by these values (green = more conservative, red = more aggressive):"),
                             _("Regenerate"), go, destructive=True, extra=profile_view(res["lines"], self.win.status))
        bg(lambda: self.win.h.call("preset", key, "show"), ask, self.win.toast)


class PrefsPage(Adw.PreferencesPage):
    NAME, TITLE, ICON = "preferences", _("Preferences"), "emblem-system-symbolic"

    def __init__(self, win):
        super().__init__()
        self.win = win
        self.loading = False
        self.autostart = Adw.SwitchRow(title=_("Apply at startup"), subtitle=_("Re-applies the selected profile at boot and on resume"))
        self.autostart.connect("notify::active", self.on_autostart)
        self.login = Adw.SwitchRow(title=_("Start Ryzen Control at login"), active=os.path.exists(LOGIN_DESKTOP),
                                   subtitle=_("Opens the window at every login (asks for the password, unless the option below is on). After a crash "
                                              "it shows the warning and leaves the profile deactivated: it never re-applies anything on its own"))
        self.login.connect("notify::active", self.on_login)
        self.trust = Adw.SwitchRow(title=_("Stop asking for the password"),
                                   subtitle=_("Polkit rule for your user, only for Ryzen Control in the local session: "
                                              "the password is needed once to write it, then never again"))
        self.trust.connect("notify::active", self.on_trust)
        self.unlock = Adw.SwitchRow(title=_("Allow beyond the stock values"), subtitle=_("PPT/TDC/EDC up to the unlock ceilings, FMax above the baseline"))
        self.unlock.connect("notify::active", self.on_unlock)
        hw = Adw.ActionRow(title=_("Hardware check"), subtitle=_("Writes and reads back one value per command, then restores the baseline"))
        self.hw_spin = Gtk.Spinner(valign=Gtk.Align.CENTER)
        self.hw_btn = button(_("Run"), self.hwtest)
        hw.add_suffix(self.hw_spin)
        hw.add_suffix(self.hw_btn)
        for title, items in ((_("Startup"), (self.autostart, self.login, self.trust)), (_("Limits and checks"), (self.unlock, hw))):
            g = Adw.PreferencesGroup(title=title)
            for r in items:
                g.add(r)
            self.add(g)

    def refresh(self, st):
        self.loading = True
        self.autostart.set_active(bool(st.get("autostart")))
        self.unlock.set_active(bool(st.get("unlock")))
        self.trust.set_active(bool(st.get("trusted")))
        self.loading = False

    def on_autostart(self, row, _p):
        if not self.loading:
            self.win.run([["autostart", "on" if row.get_active() else "off"]])

    def on_login(self, row, _p):
        """The user's XDG autostart (~/.config/autostart): no privilege, only the window at login."""
        try:
            if row.get_active():
                os.makedirs(os.path.dirname(LOGIN_DESKTOP), exist_ok=True)
                with open(LOGIN_DESKTOP, "w") as f:
                    f.write("[Desktop Entry]\nType=Application\nName=Ryzen Control\nExec=ryzen-control\nIcon=%s\n"
                            "Terminal=false\nX-GNOME-Autostart-enabled=true\n" % APP_ID)
            elif os.path.exists(LOGIN_DESKTOP):
                os.remove(LOGIN_DESKTOP)
        except OSError as e:
            self.win.toast(str(e))

    def on_unlock(self, row, _p):
        if self.loading:
            return
        if not row.get_active():
            self.win.run([["unlock", "off"]], lambda res: self.win.toast(str(res[0])))
            return
        def go(ok):
            if ok:
                self.win.run([["unlock", "on"]], lambda res: self.win.toast(str(res[0])))
            else:
                self.win.reload()   # puts the switch back to the real state
        self.win.confirm(_("Beyond the stock values?"), UNLOCK_WARNING, _("Unlock"), go, destructive=True)

    def on_trust(self, row, _p):
        if self.loading:
            return
        if not row.get_active():
            self.win.run([["trust", "off"]], lambda res: self.win.toast(_("Password asked again at every start")))
            return
        def go(ok):
            if ok:
                self.win.run([["trust", "on"]], lambda res: self.win.toast(_("Done: from the next start no password for %s") % res[0]["user"]))
            else:
                self.win.reload()   # puts the switch back to the real state
        self.win.confirm(_("Stop asking for the password?"), TRUST_WARNING, _("Remember"), go)

    def hwtest(self):
        self.hw_btn.set_sensitive(False)
        self.hw_spin.start()
        def done(res):
            self.hw_spin.stop()
            self.hw_btn.set_sensitive(True)
            self.win.info(_("Hardware check: ") + res.get("esito", "?"), "\n".join("%s: %s" % kv for kv in res.items()))
            self.win.reload()
        def fail(msg):
            self.hw_spin.stop()
            self.hw_btn.set_sensitive(True)
            self.win.toast(msg)
        bg(lambda: self.win.h.call("hwtest"), done, fail)


class CpuPage(Page):
    NAME, TITLE, ICON = "cpu", _("CPU"), "preferences-system-symbolic"

    def __init__(self, win):
        super().__init__(win, CPU_HELP)
        self.params = {}
        self.read_power = None
        for key, title, unit in CPU_PARAMS:
            p = self.params[key] = Param(title, unit, tooltip=PARAM_HELP[key])
            self.body.append(p)
        row = Gtk.Box(spacing=12)
        row.append(label(_("Power mode"), ["heading"], width_chars=9))
        self.power = Gtk.DropDown(model=Gtk.StringList.new(list(POWER)), valign=Gtk.Align.CENTER)
        row.append(self.power)
        row.append(label(_("system power profile (power-profiles-daemon / EPP)"), ["dim-label"]))
        self.body.append(row)
        self.nocaps = label(_("Baseline of this boot missing: no CPU write possible (ryzenctl.service did not capture it, see `ryzenctl status`)."),
                            ["warning"], wrap=True, visible=False)
        self.body.append(self.nocaps)
        self.buttons()

    def refresh(self, st):
        caps = st.get("caps")
        self.nocaps.set_visible(not caps)
        self.bar.set_sensitive(bool(caps))
        if not caps:
            return
        values = dict(st["limits"])
        values["fmax"] = st["fmax"]
        base = st.get("baseline") or {}
        for key, _t, _u in CPU_PARAMS:
            p, v = self.params[key], values.get(key)
            p.set_visible(v is not None and key in caps)
            if p.get_visible():
                p.setup(caps[key][0], caps[key][1], int(round(v)), base.get(key))
        self.read_power = st.get("power")
        self.power.set_sensitive(self.read_power in POWER)
        if self.read_power in POWER:
            self.power.set_selected(POWER.index(self.read_power))

    def reset(self):
        for p in self.params.values():
            p.reset()
        if self.read_power in POWER:
            self.power.set_selected(POWER.index(self.read_power))

    def lines(self, only_changed):
        out = ["%s %d" % (key, p.value()) for key, p in self.params.items() if p.get_visible() and (not only_changed or p.changed())]
        pw = POWER[self.power.get_selected()]
        if self.power.get_sensitive() and (not only_changed or pw != self.read_power):
            out.append("power " + pw)
        return out


class CurvePage(Page):
    NAME, TITLE, ICON = "curve", _("Curves"), "view-list-symbolic"

    def __init__(self, win):
        super().__init__(win, CO_HELP)
        self.loading = False
        self.missing = label("", ["warning"], wrap=True, visible=False)   # why the CO cannot be used on this CPU
        self.body.append(self.missing)
        self.all = Param(_("All"), "", tooltip=CO_TIP)
        self.all.adj.connect("value-changed", self.on_all)
        self.body.append(self.all)
        self.body.append(Gtk.Separator())
        self.cores = []   # one row per active core, built by refresh
        self.buttons()

    def refresh(self, st):
        if len(self.cores) != st.get("cores", 0):
            for p in self.cores:
                self.body.remove(p)
            self.cores = [Param(_("Core %d") % c, "", info=True, tooltip=PARAM_HELP["co"]) for c in range(st.get("cores", 0))]
            for p in self.cores:
                self.body.append(p)
        caps = st.get("caps")
        why = st.get("co_unavailable") if st.get("co") is None else None
        self.missing.set_text(_("Curve Optimizer not available on this CPU: %s") % why if why else "")
        self.missing.set_visible(bool(why))
        for w in [self.all, self.bar] + self.cores:
            w.set_sensitive(bool(caps) and not why)
        if not caps or why:
            return
        self.loading = True
        lo, hi = caps["co"]
        base = (st.get("baseline") or {}).get("co")
        for c, p in enumerate(self.cores):
            p.setup(lo, hi, st["co"][c], base[c] if base else None)
        self.all.setup(lo, hi, st["co"][0])
        self.loading = False

    def telemetry(self, t):
        for c, p in enumerate(self.cores):
            d = t["cores"][c] if c < len(t["cores"]) else {}
            parts = [num(d["mhz"] / 1000.0, 2) + " GHz" if d.get("mhz") is not None else _("n/a")]
            if d.get("temp") is not None:
                parts.append("%g °C" % d["temp"])
            if d.get("volt") is not None:
                parts.append(volts(d["volt"]))
            p.info.set_text(" · ".join(parts))

    def on_all(self, adj):
        if not self.loading:
            for p in self.cores:
                p.adj.set_value(adj.get_value())

    def reset(self):
        for p in self.cores:
            p.reset()

    def lines(self, only_changed):
        if only_changed:
            return ["co %d %d" % (c, p.value()) for c, p in enumerate(self.cores) if p.changed()]
        return ["co " + " ".join(str(p.value()) for p in self.cores)]


