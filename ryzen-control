    def telemetry(self, t):
        value, sub, _ = self.tiles["tctl"]
        value.set_text(fmt(t["tctl"], " °C"))
        sub.set_text("Tccd " + fmt(t["tccd"], " °C") + " · Tjmax " + fmt(t["tjmax"], " °C"))
        for key, unit in (("ppt", "W"), ("tdc", "A")):
            value, sub, bar = self.tiles[key]
            v, lim = t[key], t[key + "_limit"]
            value.set_text(fmt(v, " " + unit))
            sub.set_text("limite " + fmt(lim, " " + unit))
            if v is not None and lim:
                bar.set_max_value(lim)
                bar.set_value(min(v, lim))
        value, sub, _ = self.tiles["fmax"]
        value.set_text(fmt(t["fmax"], " MHz"))
        sub.set_text("EDC limite " + fmt(t["edc_limit"], " A"))
        if t["tctl"] is not None:
            self.hist.append((t["tctl"], t["ppt"]))
            self.ppt_limit = t["ppt_limit"]
            self.graph.queue_draw()
        for c, labs in enumerate(self.cores):
            d = t["cores"][c] if c < len(t["cores"]) else {}
            labs[0].set_text(fmt(d.get("mhz")))
            labs[1].set_text(fmt(d.get("temp")))
            labs[2].set_text(volts(d.get("volt"), ""))
            labs[3].set_text("%+d" % d["co"] if d.get("co") is not None else "n/d")
        for f in t["fans"]:
            lab = self.fan_labels.get(f["canale"])
            if lab is None:
                lab = self.fan_labels[f["canale"]] = label("", ["numeric"])
                self.fans.append(lab)
            lab.set_text("%s (%s) · %d giri/min" % (f.get("name") or "Canale %d" % f["canale"], f.get("role", "sconosciuto"), f["rpm"]))
        if not self.fan_labels:
            self.fans.append(label("Nessuna ventola rilevata", ["dim-label"]))
            self.fan_labels[0] = None
        self.power.set_text("Profilo energetico: " + (t["power"] or "n/d"))

    def draw(self, area, cr, w, h):
        lo, hi, plim = 30, 95, self.ppt_limit or 1
        y_t = lambda t: h - 14 - (min(max(t, lo), hi) - lo) / (hi - lo) * (h - 18)
        y_p = lambda p: h - 14 - min(max(p, 0), plim) / plim * (h - 18)
        col = area.get_color()
        cr.set_source_rgba(col.red, col.green, col.blue, 0.35)
        cr.set_line_width(1)
        cr.set_font_size(10)
        for t in (40, 60, 80, 95):
            cr.move_to(0, y_t(t))
            cr.line_to(w, y_t(t))
            cr.stroke()
            cr.move_to(4, y_t(t) - 2)
            cr.show_text("%d" % t)
            cr.move_to(w - 30, y_t(t) - 2)
            cr.show_text("%d" % round(plim * (t - lo) / (hi - lo)))
        n = self.hist.maxlen
        for idx, rgb in ((0, (0.21, 0.52, 0.89)), (1, (0.90, 0.45, 0.13))):
            pts = [(w * (n - len(self.hist) + i) / (n - 1), v[idx]) for i, v in enumerate(self.hist) if v[idx] is not None]
            if len(pts) < 2:
                continue
            cr.set_source_rgb(*rgb)
            cr.set_line_width(2)
            for i, (x, v) in enumerate(pts):
                (cr.move_to if i == 0 else cr.line_to)(x, y_t(v) if idx == 0 else y_p(v))
            cr.stroke()


class AutotuneDialog(Adw.Window):
    """Avanzamento della calibrazione: un `autotune step` alla volta finché phase == done.
    Finestra separata e ridimensionabile (Adw.Dialog ha dimensioni fisse e la tabella è alta)."""

    def __init__(self, win, mode):
        super().__init__(title="Calibrazione %s" % mode.capitalize(), transient_for=win, modal=True, destroy_with_parent=True,
                         default_width=max(640, int(win.get_width() * 0.9)), default_height=max(560, int(win.get_height() * 0.9)))
        self.win, self.mode = win, mode
        self.running = self.aborting = False
        self.closable = False
        self.connect("close-request", self.on_close_request)
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        self.header = label("", ["dim-label"], wrap=True)
        # altezze costanti: ogni cambio di altezza sposta la tabella e il compositore lascia frammenti
        self.phase = label("Avvio…", ["title-3"], hexpand=True, ellipsize=Pango.EllipsizeMode.END, single_line_mode=True)
        self.eta = label(" ", ["numeric"], xalign=1.0)
        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        top.append(self.phase)
        top.append(self.eta)
        self.progress = Gtk.ProgressBar(show_text=True)
        self.note = label("", ["warning"], wrap=True, visible=False)
        for w in (self.header, top, self.progress, self.note, label("CO (Curve Optimizer) per core", ["heading"], tooltip_text=CO_TIP)):
            body.append(w)
        grid = Gtk.Grid(column_spacing=14, row_spacing=4, hexpand=True)
        heads = (("Core", None), ("Fabbrica", "CO di fabbrica; sotto, la tensione di riferimento misurata all'avvio con lo stesso carico"),
                 ("In prova", "Livello di CO in prova sul core; sotto, l'ultima tensione misurata a pieno carico e la differenza dal riferimento"),
                 ("Ultimo stabile", None), ("Instabile a", None), ("Definitivo", None))
        for col, (h, tip) in enumerate(heads):
            grid.attach(label(h, ["heading"], tooltip_text=tip), col, 0, 1, 1)
        self.cells = []
        for c in range(8):
            cell = {"core": label("%d" % c, ["numeric"], valign=Gtk.Align.START)}
            boxes = []
            for key in ("fab", "prova"):   # due righe: CO sopra, tensione sotto; larghezza fissa = niente riflussi
                cell[key] = (label("—", ["numeric"], width_chars=4 if key == "fab" else 8),
                             label(" ", ["numeric", "caption"], width_chars=9 if key == "fab" else 22))
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                box.append(cell[key][0])
                box.append(cell[key][1])
                boxes.append(box)
            for key, wc in (("stable", 6), ("unstable", 16), ("final", 6)):
                cell[key] = label("—", ["numeric"], valign=Gtk.Align.START, width_chars=wc)
            for col, w in enumerate([cell["core"]] + boxes + [cell["stable"], cell["unstable"], cell["final"]]):
                w.set_hexpand(col > 0)          # le colonne dati si dividono la larghezza disponibile
                grid.attach(w, col, c + 1, 1, 1)
            self.cells.append(cell)
        body.append(grid)
        body.append(label("Un passo di CO (Curve Optimizer) vale circa 3–5 mV di tensione in meno a parità di frequenza; "
                          "qui vedi la tensione reale misurata a pieno carico per ogni livello.", ["dim-label", "caption"], wrap=True))
        self.slope = label("", ["numeric"], visible=False)
        body.append(self.slope)
        self.fmax = label("", ["numeric"], wrap=True)
        body.append(self.fmax)
        self.result = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        body.append(self.result)
        bar = Gtk.Box(spacing=12, halign=Gtk.Align.END, css_classes=["toolbar"])
        self.abort_btn = button("Interrompi", self.abort, "destructive-action")
        self.close_btn = button("Chiudi", self.finish, "suggested-action")
        self.close_btn.set_visible(False)
        bar.append(self.abort_btn)
        bar.append(self.close_btn)
        # a finestra larga il contenuto resta centrato e leggibile (max 1100 px), la griglia si allarga
        clamp = Adw.Clamp(child=body, maximum_size=1100, tightening_threshold=800)
        tv = Adw.ToolbarView(content=Gtk.ScrolledWindow(child=clamp, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER))
        tv.add_top_bar(Adw.HeaderBar())
        tv.add_bottom_bar(bar)
        self.set_content(tv)
        self.present()

    def on_close_request(self, *_):
        if not self.closable:
            self.win.toast("Calibrazione in corso: usa \"Interrompi\"")
            return True     # blocca la chiusura
        return False

    def start(self, params):
        argv = ["autotune", "start", self.mode] + ["%s=%d" % kv for kv in params.items()]
        bg(lambda: self.win.h.call(*argv), self.got, self.fail)

    def loop(self):
        if self.running or self.aborting:
            return
        self.running = True
        bg(lambda: self.win.h.call("autotune", "step"), self.got, self.fail)

    def got(self, st):
        self.running = False
        self.show(st)
        if st.get("phase") == "done":
            self.done(st)
        else:
            self.loop()

    def fail(self, msg):
        self.running = False
        self.phase.set_text("Errore: " + msg)
        self.abort_btn.set_visible(False)
        self.close_btn.set_visible(True)
        setattr(self, "closable", True)

    def show(self, st):
        ph, p = st.get("phase"), st.get("params", {})
        if st.get("resumed_after_crash"):
            self.note.set_text("Il sistema si è riavviato durante un test: quel passo è stato marcato instabile e la calibrazione è ripresa dal successivo.")
            self.note.set_visible(True)
        eta = st.get("eta") or {}
        if eta:
            self.header.set_text("Avviata alle %s · stimati %s in totale" % (st.get("started", "")[-5:], mins(eta.get("total_s"))))
            self.eta.set_text("Tempo rimanente stimato: %s" % mins(eta.get("remaining_s")))
        if ph == "co" and st.get("parallel"):
            levels = max(1, (-(p.get("colimit") or -5)) // 5)      # livelli di 5 (CO_STEP), come at_estimate in ryzenctl
            self.phase.set_text("Livello CO %d: provo tutti i core insieme (ancora in prova: %d core)…" % (st["value"], len(st.get("active_cores", []))))
            frac = AT_PHASES["co"] * max(0, (-st["value"]) // 5 - 1) / levels
        elif ph == "co":
            self.phase.set_text("Core %d: provo CO %d…" % (st["core"], st["value"]))
            frac = (st["core"] + min(1.0, st["value"] / p["colimit"] if p.get("colimit") else 0)) / 8
        elif ph == "final":
            self.phase.set_text("Passata finale su tutti i core (tentativo %d/3)" % (st.get("final_tries", 0) + 1))
            frac = AT_PHASES["co"] + (AT_PHASES["final"] - AT_PHASES["co"]) * min(1.0, st.get("final_tries", 0) / 3)
        elif ph == "fmax":
            f, tests = st["fmax"].get("current"), st["fmax"].get("tests", [])
            last = tests[-1] if tests else None
            self.phase.set_text("FMax %d MHz: picco Tctl %.1f °C > %d → provo %s MHz…" % (last[0], last[1], p["target"], f) if last
                                else "FMax %s MHz: misuro il picco Tctl…" % f)
            first = tests[0][0] if tests else f
            frac = AT_PHASES["final"] + (AT_PHASES["fmax"] - AT_PHASES["final"]) * ((first - f) / max(1, first - 4000) if f else 0)
        elif ph in ("ppt", "fmax_knee"):          # Auto: ginocchio prestazioni/watt
            k = st.get("knee", {}).get("ppt" if ph == "ppt" else "fmax", {})
            tests, cur = k.get("tests", []), k.get("current")
            unit = "W" if ph == "ppt" else "MHz"
            if tests:
                last = tests[-1]
                self.phase.set_text("%s %s %s: %.0f op/s a %.0f W → provo %s %s…" % (
                    "PPT" if ph == "ppt" else "FMax", last[0], unit, last[1], last[2], cur, unit))
            else:
                self.phase.set_text("%s %s %s: misuro prestazioni e potenza…" % ("PPT" if ph == "ppt" else "FMax", cur, unit))
            lo, hi = (AT_PHASES["final"], AT_PHASES["ppt"]) if ph == "ppt" else (AT_PHASES["ppt"], AT_PHASES["fmax_knee"])
            frac = lo + (hi - lo) * min(1.0, len(tests) / 6.0)
        else:
            self.phase.set_text("Calibrazione completata" if not st.get("error") else "Calibrazione terminata: " + st["error"])
            frac = 1.0
        self.progress.set_fraction(max(0.0, min(1.0, frac)))
        self.queue_draw()                   # ridisegno completo: niente frammenti del fotogramma precedente
        res, uns, fin = st.get("results", {}), st.get("unstable", {}), st.get("final")
        base_co = (self.win.status.get("baseline") or {}).get("co") or [None] * 8
        ref = (st.get("samples", {}).get("0") or {}).get("volt") or [None] * 8
        active = st.get("active_cores", []) if st.get("parallel") else [st.get("core")]
        for c, cell in enumerate(self.cells):
            self.two_lines(cell["fab"], "%d" % base_co[c] if base_co[c] is not None else "—", volts(ref[c]) if ref[c] is not None else None)
            smp = at_sample(st, c)                      # misura più profonda disponibile per questo core
            cur = st["value"] if ph == "co" and c in active else (smp[0] if smp else None)
            sub, css = None, None
            if smp:
                dmv = round((smp[1] - ref[c]) * 1000) if ref[c] is not None else None
                sub = ("" if smp[0] == cur else "a %d: " % smp[0]) + volts(smp[1]) + ("" if dmv is None else " · %+d mV" % dmv)
                css = "success" if dmv is not None and dmv < 0 else None
            self.two_lines(cell["prova"], "%d" % cur if cur is not None else "—", sub, css)
            for lab, text, cls in ((cell["stable"], "%d" % res[str(c)] if str(c) in res else None, "success"),
                                   (cell["unstable"], "%d (%s)" % (uns[str(c)]["value"], uns[str(c)]["why"]) if str(c) in uns else None, "error"),
                                   (cell["final"], "%d" % fin[c] if fin else None, "success")):
                lab.set_markup("<b>%s</b>" % text if text and lab is cell["final"] else (text or "—"))
                (lab.add_css_class if text else lab.remove_css_class)(cls)
        slope = at_slope(st)
        self.slope.set_visible(slope is not None)
        if slope is not None:
            self.slope.set_text("Misurato su questa CPU: ≈ %s mV per passo di CO" % ("%.1f" % slope).rstrip("0").rstrip(".").replace(".", ","))
        tests = st.get("fmax", {}).get("tests", [])
        text = "Test FMax:\n" + "\n".join("%d MHz → picco Tctl %.1f °C" % tuple(t) for t in tests) if tests else ""
        knee = st.get("knee")
        if knee:
            for key, unit in (("ppt", "W"), ("fmax", "MHz")):
                if knee[key]["tests"]:
                    text += ("\n" if text else "") + "Sweep %s:\n" % key.upper() + "\n".join(
                        "%s %s → %.0f op/s, %.0f W" % (t[0], unit, t[1], t[2]) for t in knee[key]["tests"])
        self.fmax.set_text(text)

    @staticmethod
    def two_lines(pair, main, sub=None, sub_css=None):
        pair[0].set_text(main)
        pair[1].set_text(sub or "")
        if not sub:
            pair[1].set_text(" ")          # resta allocata: l'altezza della riga non cambia
        pair[1].remove_css_class("success")
        if sub_css:
            pair[1].add_css_class(sub_css)

    def done(self, st):
        if st.get("error"):
            self.result.append(label(st["error"], ["warning"], wrap=True))
        if st.get("final"):   # per core: CO fabbrica → definitivo e ΔV misurata (campione al livello definitivo o al più vicino)
            base_co = (self.win.status.get("baseline") or {}).get("co") or [None] * 8
            ref = (st.get("samples", {}).get("0") or {}).get("volt") or [None] * 8
            grid = Gtk.Grid(column_spacing=18, row_spacing=4)
            for col, h in enumerate(("Core", "CO fabbrica → definitivo", "ΔV misurata")):
                grid.attach(label(h, ["heading"], tooltip_text=CO_TIP if col == 1 else None), col, 0, 1, 1)
            for c in range(8):
                grid.attach(label("%d" % c, ["numeric"]), 0, c + 1, 1, 1)
                grid.attach(diff_label(base_co[c], st["final"][c]), 1, c + 1, 1, 1)
                smp = at_sample(st, c, st["final"][c])
                if smp and ref[c] is not None:
                    dmv = round((smp[1] - ref[c]) * 1000)
                    lab = label("%+d mV (%s → %s a CO %d)" % (dmv, volts(ref[c]), volts(smp[1]), smp[0]), ["numeric", "success" if dmv < 0 else "dim-label"])
                else:
                    lab = label("n/d", ["numeric", "dim-label"])
                grid.attach(lab, 2, c + 1, 1, 1)
            self.result.append(label("CO (Curve Optimizer) per core: fabbrica → definitivo, con la tensione misurata", ["heading"], tooltip_text=CO_TIP))
            self.result.append(grid)
        if st.get("profile_lines"):
            self.result.append(label("Profilo %s: fabbrica → calibrato" % self.mode, ["heading"]))
            self.result.append(profile_view(st["profile_lines"], self.win.status))
        if st.get("fmax", {}).get("chosen") and not st.get("profile_lines"):
            self.result.append(label("FMax scelta: %d MHz" % st["fmax"]["chosen"], ["numeric"]))
        knee = st.get("knee")
        if knee and knee["ppt"].get("chosen"):
            self.result.append(label("Ginocchio prestazioni/watt: PPT %d W, FMax %d MHz (perdita massima %d %%)" % (
                knee["ppt"]["chosen"], knee["fmax"]["chosen"] or 0, st.get("params", {}).get("loss", 0)), ["numeric"], wrap=True))
        self.abort_btn.set_visible(False)
        self.close_btn.set_visible(True)
        setattr(self, "closable", True)

    def abort(self):
        self.aborting = True
        self.abort_btn.set_sensitive(False)
        self.phase.set_text("Interrompo…")
        self.win.run([["autotune", "abort"]], lambda _: (self.win.toast("Calibrazione annullata, CPU a baseline"), setattr(self, "closable", True), self.close()))

    def finish(self):
        self.close()
        self.win.reload()


class ModesPage(Adw.PreferencesPage):
    NAME, TITLE, ICON = "modes", "Modalità", "emblem-default-symbolic"

    def __init__(self, win):
        super().__init__()
        self.win = win
        self.loading = False
        g = Adw.PreferencesGroup(title="Modalità", description="Eco, Auto e Boost sono profili generati dai valori di fabbrica di questa CPU (la calibrazione li misurerà)")
        self.rows, first = {}, None
        self.tables = {}
        for key, title, sub in MODES:
            if key in PRESETS:   # espandibile: sotto la riga la tabella fabbrica → profilo
                row = Adw.ExpanderRow(title=title, subtitle=sub, expanded=True)
            else:
                row = Adw.ActionRow(title=title, subtitle=sub, activatable=True)
            chk = Gtk.CheckButton(valign=Gtk.Align.CENTER, group=first)
            first = first or chk
            row.add_prefix(chk)
            if key not in PRESETS:
                row.set_activatable_widget(chk)
            chk.connect("toggled", self.on_mode, key)
            regen = None
            if key in PRESETS:
                # suffissi compatti: con troppi pulsanti larghi il titolo veniva schiacciato a una colonna
                row.set_title_lines(1)
                row.set_subtitle_lines(2)
                tag = Gtk.Label(label="calibrata" if key in CALIBRATED else "preset", valign=Gtk.Align.CENTER,
                                tooltip_text="Si adatta all'hardware con test di carico" if key in CALIBRATED
                                else "Valori fissi ricavati da quelli di fabbrica, nessun test")
                tag.add_css_class("chip")
                tag.add_css_class("success" if key in CALIBRATED else "dim-label")
                row.add_suffix(tag)
                if key in CALIBRATED:
                    cal = button("Calibra…", lambda k=key: self.calibrate(k))
                    cal.set_tooltip_text("Misura su questa CPU: undervolt per core, FMax, limiti e ventole")
                    row.add_suffix(cal)
                regen = Gtk.Button(icon_name="view-refresh-symbolic", valign=Gtk.Align.CENTER,
                                   tooltip_text="Rigenera il profilo dai valori di fabbrica")
                regen.add_css_class("flat")
                regen.connect("clicked", lambda *_, k=key: self.regen(k))
                row.add_suffix(regen)
            self.rows[key] = (row, chk, regen)
            g.add(row)
        self.add(g)
        g = Adw.PreferencesGroup(title="Avvio e limiti")
        self.autostart = Adw.SwitchRow(title="Applica all'avvio", subtitle="Riapplica il profilo selezionato al boot e al resume")
        self.autostart.connect("notify::active", self.on_autostart)
        self.unlock = Adw.SwitchRow(title="Consenti oltre i valori di fabbrica", subtitle="PPT/TDC/EDC fino ai tetti di sblocco, FMax oltre la baseline")
        self.unlock.connect("notify::active", self.on_unlock)
        hw = Adw.ActionRow(title="Verifica hardware", subtitle="Scrive e rilegge un valore per comando, poi ripristina la baseline")
        self.hw_spin = Gtk.Spinner(valign=Gtk.Align.CENTER)
        self.hw_btn = button("Esegui", self.hwtest)
        hw.add_suffix(self.hw_spin)
        hw.add_suffix(self.hw_btn)
        for r in (self.autostart, self.unlock, hw):
            g.add(r)
        self.add(g)

    def refresh(self, st):
        self.loading = True
        prof = st.get("profile")
        shown = st.get("profile_lines", {})
        for key, title, sub in MODES:
            row, chk, regen = self.rows[key]
            if regen:
                exists = key in shown
                regen.set_visible(exists)
                row.set_subtitle(sub if exists else sub + " — profilo non ancora creato: spunta per crearlo")
                if key in self.tables:
                    row.remove(self.tables.pop(key))
                if exists:   # ListBoxRow esplicita: così `row.remove` la ritrova al prossimo refresh
                    self.tables[key] = Gtk.ListBoxRow(child=profile_table(shown[key], st), activatable=False, selectable=False)
                    row.add_row(self.tables[key])
                    row.set_expanded(True)
        current = prof if prof in PRESETS else ("custom" if prof else "default")
        self.rows[current][1].set_active(True)
        self.autostart.set_active(bool(st.get("autostart")))
        self.unlock.set_active(bool(st.get("unlock")))
        self.loading = False

    def on_mode(self, chk, key):
        if self.loading or not chk.get_active():
            return
        if key == "default":
            self.win.run([["default"]], lambda _: self.win.toast("Valori di fabbrica applicati"))
        elif key == "custom":
            self.win.toast("Imposta i valori nelle pagine CPU, Curve e Ventole e usa \"Applica ora\"")
        elif key in self.win.status.get("profile_lines", {}):
            self.win.run([["apply", key], ["use", key]], lambda _: self.win.toast("Profilo '%s' applicato" % key))
        else:
            def ask(res):
                def go(ok):
                    if ok:
                        self.win.run([["preset", key], ["apply", key], ["use", key]], lambda _: self.win.toast("Profilo '%s' creato e applicato" % key))
                    else:
                        self.win.reload()
                self.win.confirm("Creare il profilo '%s'?" % key, "Valori di fabbrica → profilo (verde = più conservativo, rosso = più spinto):",
                                 "Crea e applica", go, extra=profile_view(res["lines"], self.win.status))
            bg(lambda: self.win.h.call("preset", key, "show"), ask, lambda m: (self.win.toast(m), self.win.reload()))

    def calibrate(self, mode):
        """Prima la stima (`autotune estimate`), poi una scelta semplice: automatica con i default di ryzenctl, o i parametri a mano."""
        def ask(est):
            p = est["params"]
            d = Adw.AlertDialog(heading="Calibrare la modalità %s?" % mode.capitalize(),
                                body="Automatica (consigliata): tutti i core insieme, %s — Tctl obiettivo %d °C, CO (Curve Optimizer) fino a %d "
                                     "con margine %d, %d s per test.\n\n%s\n\n%s"
                                     % (mins(est["parallel_total_s"]), p["target"], p["colimit"], p["margin"], p["step"], AT_WARNING, CO_TIP))
            d.add_response("cancel", "Annulla")
            d.add_response("custom", "Scegli i valori…")
            d.add_response("auto", "Automatica (consigliata)")
            d.set_response_appearance("auto", Adw.ResponseAppearance.SUGGESTED)
            def resp(_d, r):
                if r == "auto":
                    AutotuneDialog(self.win, mode).start(dict(p, parallel=1))
                elif r == "custom":
                    self.calibrate_params(mode, est)
            d.connect("response", resp)
            d.present(self.win)
        bg(lambda: self.win.h.call("autotune", "estimate", mode), ask, self.win.toast)

    def calibrate_params(self, mode, est):
        """Parametri (range da AT_PARAMS, default da ryzenctl) con stima che segue le modifiche → autotune start → avanzamento."""
        group = Adw.PreferencesGroup()
        spins = {}
        for key, title, unit, (lo, hi) in AT_PARAMS:
            r = Adw.SpinRow.new_with_range(lo, hi, 1)
            r.set_title(title + (" (%s)" % unit if unit else ""))
            r.set_value(est["params"][key])
            spins[key] = r
            group.add(r)
        parallel = Adw.SwitchRow(title="Test di tutti i core insieme (veloce, consigliato)", active=bool(est["params"].get("parallel", 1)))
        group.add(parallel)
        estimate = label("", ["heading"], margin_top=6)
        params = lambda: dict(((k, int(r.get_value())) for k, r in spins.items()), parallel=int(parallel.get_active()))
        def show_est(e):
            estimate.set_text("Durata stimata: %s" % mins(e["total_s"]))
            parallel.set_subtitle(AT_PARALLEL_SUB % mins(e["sequential_total_s"]))
        pending = {"timer": 0, "seq": 0}
        def refresh_est():
            pending["timer"] = 0
            pending["seq"] += 1
            seq = pending["seq"]
            def got(e):
                if seq == pending["seq"]:   # solo l'ultima stima richiesta
                    show_est(e)
            argv = ["autotune", "estimate", mode] + ["%s=%d" % kv for kv in params().items()]
            bg(lambda: self.win.h.call(*argv), got, self.win.toast)
            return False
        def changed(*_):   # debounce: una stima dopo 400 ms di quiete
            if pending["timer"]:
                GLib.source_remove(pending["timer"])
            pending["timer"] = GLib.timeout_add(400, refresh_est)
        for r in spins.values():
            r.connect("notify::value", changed)
        parallel.connect("notify::active", changed)
        show_est(est)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.append(group)
        box.append(estimate)
        d = Adw.AlertDialog(heading="Parametri della calibrazione %s" % mode.capitalize(), body=AT_WARNING, extra_child=box)
        d.spins, d.parallel, d.estimate = spins, parallel, estimate   # raggiungibili dalle prove pilotate
        d.add_response("cancel", "Annulla")
        d.add_response("start", "Avvia")
        d.set_response_appearance("start", Adw.ResponseAppearance.DESTRUCTIVE)
        def resp(_d, r):
            if pending["timer"]:
                GLib.source_remove(pending["timer"])
                pending["timer"] = 0
            if r == "start":
                AutotuneDialog(self.win, mode).start(params())
        d.connect("response", resp)
        d.present(self.win)

    def regen(self, key):
        def ask(res):
            def go(ok):
                if ok:
                    cmds = [["preset", key]] + ([["apply", key]] if self.win.status.get("profile") == key else [])
                    self.win.run(cmds, lambda _: self.win.toast("Profilo '%s' rigenerato" % key))
            self.win.confirm("Rigenerare '%s' dai valori di fabbrica?" % key, "Il profilo attuale viene sostituito da questi valori (verde = più conservativo, rosso = più spinto):",
                             "Rigenera", go, destructive=True, extra=profile_view(res["lines"], self.win.status))
        bg(lambda: self.win.h.call("preset", key, "show"), ask, self.win.toast)

    def on_autostart(self, row, _):
        if not self.loading:
            self.win.run([["autostart", "on" if row.get_active() else "off"]])

    def on_unlock(self, row, _):
        if self.loading:
            return
        if not row.get_active():
            self.win.run([["unlock", "off"]], lambda res: self.win.toast(str(res[0])))
            return
        def go(ok):
            if ok:
                self.win.run([["unlock", "on"]], lambda res: self.win.toast(str(res[0])))
            else:
                self.win.reload()   # riporta l'interruttore allo stato reale
        self.win.confirm("Oltre i valori di fabbrica?", UNLOCK_WARNING, "Sblocca", go, destructive=True)

    def hwtest(self):
        self.hw_btn.set_sensitive(False)
        self.hw_spin.start()
        def done(res):
            self.hw_spin.stop()
            self.hw_btn.set_sensitive(True)
            self.win.info("Verifica hardware: " + res.get("esito", "?"), "\n".join("%s: %s" % kv for kv in res.items()))
            self.win.reload()
        def fail(msg):
            self.hw_spin.stop()
            self.hw_btn.set_sensitive(True)
            self.win.toast(msg)
        bg(lambda: self.win.h.call("hwtest"), done, fail)


class CpuPage(Page):
    NAME, TITLE, ICON = "cpu", "CPU", "preferences-system-symbolic"

    def __init__(self, win):
        super().__init__(win, CPU_HELP)
        self.params = {}
        self.read_power = None
        for key, title, unit in CPU_PARAMS:
            p = self.params[key] = Param(title, unit, tooltip=PARAM_HELP[key])
            self.body.append(p)
        row = Gtk.Box(spacing=12)
        row.append(label("Energia", ["heading"], width_chars=9))
        self.power = Gtk.DropDown(model=Gtk.StringList.new(list(POWER)), valign=Gtk.Align.CENTER)
        row.append(self.power)
        row.append(label("profilo energetico di sistema (power-profiles-daemon / EPP)", ["dim-label"]))
        self.body.append(row)
        self.nocaps = label("Baseline di questo boot assente: nessuna scrittura CPU possibile (ryzenctl.service non l'ha catturata, vedi `ryzenctl status`).",
                            ["warning"], wrap=True, visible=False)
        self.body.append(self.nocaps)
        self.buttons()

    def refresh(self, st):
        caps = st.get("caps")
        self.nocaps.set_visible(not caps)
        self.bar.set_sensitive(bool(caps))
        if not caps:
            return
        values = dict(st["limits"])
        values["fmax"] = st["fmax"]
        base = st.get("baseline") or {}
        for key, _, _ in CPU_PARAMS:
            p, v = self.params[key], values.get(key)
            p.set_visible(v is not None and key in caps)
            if p.get_visible():
                p.setup(caps[key][0], caps[key][1], int(round(v)), base.get(key))
        self.read_power = st.get("power")
        self.power.set_sensitive(self.read_power in POWER)
        if self.read_power in POWER:
            self.power.set_selected(POWER.index(self.read_power))

    def reset(self):
        for p in self.params.values():
            p.reset()
        if self.read_power in POWER:
            self.power.set_selected(POWER.index(self.read_power))

    def lines(self, only_changed):
        out = ["%s %d" % (key, p.value()) for key, p in self.params.items() if p.get_visible() and (not only_changed or p.changed())]
        pw = POWER[self.power.get_selected()]
        if self.power.get_sensitive() and (not only_changed or pw != self.read_power):
            out.append("power " + pw)
        return out


class CurvePage(Page):
    NAME, TITLE, ICON = "curve", "Curve", "view-list-symbolic"

    def __init__(self, win):
        super().__init__(win, CO_HELP)
        self.loading = False
        self.all = Param("Tutti", "", tooltip=CO_TIP)
        self.all.adj.connect("value-changed", self.on_all)
        self.body.append(self.all)
        self.body.append(Gtk.Separator())
        self.cores = [Param("Core %d" % c, "", info=True, tooltip=PARAM_HELP["co"]) for c in range(8)]
        for p in self.cores:
            self.body.append(p)
        self.buttons()

    def refresh(self, st):
        caps = st.get("caps")
        self.bar.set_sensitive(bool(caps))
        self.set_sensitive(bool(caps))
        if not caps:
            return
        self.loading = True
        lo, hi = caps["co"]
        base = (st.get("baseline") or {}).get("co")
        for c, p in enumerate(self.cores):
            p.setup(lo, hi, st["co"][c], base[c] if base else None)
        self.all.setup(lo, hi, st["co"][0])
        self.loading = False

    def telemetry(self, t):
        for c, p in enumerate(self.cores):
            d = t["cores"][c] if c < len(t["cores"]) else {}
            parts = [("%.2f GHz" % (d["mhz"] / 1000.0)).replace(".", ",") if d.get("mhz") is not None else "n/d"]
            if d.get("temp") is not None:
                parts.append("%g °C" % d["temp"])
            if d.get("volt") is not None:
                parts.append(volts(d["volt"]))
            p.info.set_text(" · ".join(parts))

    def on_all(self, adj):
        if not self.loading:
            for p in self.cores:
                p.adj.set_value(adj.get_value())

    def reset(self):
        for p in self.cores:
            p.reset()

    def lines(self, only_changed):
        if only_changed:
            return ["co %d %d" % (c, p.value()) for c, p in enumerate(self.cores) if p.changed()]
        return ["co " + " ".join(str(p.value()) for p in self.cores)]


class FansPage(Page):
    NAME, TITLE, ICON = "fans", "Ventole", "weather-windy-symbolic"

    def __init__(self, win):
        super().__init__(win, "Le ventole restano gestite dalla SmartFan del BIOS: qui si cambiano solo i tempi di salita/discesa e i punti "
                              "curva dei canali riconosciuti come ventola. Pompe e canali non controllabili sono protetti.")
        self.chans = {}     # n -> (up, down, curve_entry, info)
        self.cards = []
        self.missing = card()
        self.missing.append(label("Ventole non disponibili", ["heading"]))
        self.missing_text = label("", ["dim-label"], wrap=True)
        self.missing.append(self.missing_text)
        self.missing.append(button("Abilita (carica il modulo nct6775)", lambda: self.win.run([["fan", "enable"]], self.enabled), "suggested-action"))
        self.body.append(self.missing)
        self.spin = Gtk.Spinner(valign=Gtk.Align.CENTER)
        self.detect_btn = button("Rileva ruoli", self.autodetect)
        self.buttons(self.spin, self.detect_btn)

    def refresh(self, st):
        self.step_range = st.get("caps", {}).get("fan_step_ms") if st.get("caps") else None
        if st.get("fans"):
            self.show(st["fans"])
        else:
            self.show_missing(st.get("fans_error", "stato ventole non disponibile"))

    def show_missing(self, msg):
        self.missing_text.set_text(msg + "\n\n" + FAN_MISSING_HELP)
        self.missing.set_visible(True)
        self.bar.set_sensitive(False)
        self.clear()

    def enabled(self, res):
        r = res[0] or {}
        self.win.toast("Riavvio necessario: aggiunto acpi_enforce_resources=lax alla riga del kernel" if r.get("riavvio_necessario")
                       else "Chip %s disponibile" % r.get("chip", "?"))

    def clear(self):
        for c in self.cards:
            self.body.remove(c)
        self.cards, self.chans = [], {}

    def show(self, fs):
        self.missing.set_visible(False)
        self.bar.set_sensitive(True)
        self.clear()
        for c in fs["canali"]:
            n, role, why = c["canale"], c.get("role", "sconosciuto"), c.get("why", "")
            box = card()
            head = Gtk.Box(spacing=12)
            name = Gtk.Entry(text=c.get("name") or "", placeholder_text="Canale %d" % n, width_chars=14, valign=Gtk.Align.CENTER)
            name.connect("activate", lambda e, n=n: self.win.run([["fan", "name", str(n)] + e.get_text().split()]))
            head.append(label("%d" % n, ["title-3"]))
            head.append(name)
            chip = label(role, ["chip", ROLE_CSS.get(role, "dim-label")], valign=Gtk.Align.CENTER)
            head.append(chip)
            head.append(label("%d giri/min · pwm %d · modo %d" % (c["rpm"], c["pwm"], c["modo"]), ["numeric"], hexpand=True))
            head.append(button("Identifica", lambda n=n: self.identify(n)))
            for target in ("pompa", "sconosciuto"):
                if role != target:
                    head.append(button("Segna " + target, lambda n=n, t=target: self.win.run([["fan", "role", str(n), t]])))
            box.append(head)
            box.append(label(why or "ruolo non rilevato: usa \"Rileva ruoli\" (nome: Invio per salvare)", ["dim-label", "caption"]))
            if role == "ventola" and self.step_range:
                up, down = Param("Salita", "ms"), Param("Discesa", "ms")
                up.setup(self.step_range[0], self.step_range[1], c["step_up_ms"])
                down.setup(self.step_range[0], self.step_range[1], c["step_down_ms"])
                curve = Gtk.Entry(text=" ".join(c["curva"]), hexpand=True)
                crow = Gtk.Box(spacing=12)
                crow.append(label("Curva", ["heading"], width_chars=9))
                crow.append(curve)
                crow.append(label("°C:pwm crescenti, ultimo pwm 255", ["dim-label"]))
                for w in (up, down, crow):
                    box.append(w)
                self.chans[n] = (up, down, curve, c)
            self.body.append(box)
            self.cards.append(box)

    def identify(self, n):
        self.win.toast("Canale %d al 100 %% per 5 secondi…" % n)
        bg(lambda: self.win.h.call("fan", "identify", str(n)),
           lambda r: self.win.toast("Canale %d: %d giri/min al 100 %%" % (n, r["rpm_al_100"])), self.win.toast)

    def autodetect(self):
        def go(ok):
            if not ok:
                return
            self.detect_btn.set_sensitive(False)
            self.spin.start()
            def done(res):
                self.spin.stop()
                self.detect_btn.set_sensitive(True)
                self.win.info("Ruoli rilevati", "\n".join("canale %s: %s (%s)" % (n, r["ruolo"], r["perché"]) for n, r in res.items()))
                self.win.reload()
            def fail(msg):
                self.spin.stop()
                self.detect_btn.set_sensitive(True)
                self.win.toast(msg)
            bg(lambda: self.win.h.call("fan", "autodetect"), done, fail)
        self.win.confirm("Rilevare i ruoli dei canali?", AUTODETECT_WARNING, "Avvia", go)

    def reset(self):
        for up, down, curve, c in self.chans.values():
            up.reset()
            down.reset()
            curve.set_text(" ".join(c["curva"]))

    def lines(self, only_changed):
        out = []
        for n, (up, down, curve, c) in sorted(self.chans.items()):
            if not only_changed or up.changed() or down.changed():
                out.append("fan %d step %d %d" % (n, up.value(), down.value()))
            text = " ".join(curve.get_text().split())
            if not only_changed or text != " ".join(c["curva"]):
                out.append("fan %d curve %s" % (n, text))
        return out


