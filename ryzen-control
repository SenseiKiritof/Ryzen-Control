#!/usr/bin/python3
"""Ryzen Control — GUI GTK4/libadwaita per ryzenctl.

Gira come utente. Ogni lettura e scrittura passa da un unico processo `pkexec ryzenctl serve`
(un prompt per sessione): la GUI non valida nulla di definitivo, invia e mostra gli errori di
ryzenctl così come arrivano. Nessuna costante hardware qui: i range vengono da `status.caps`.
`--mock`: avvia `ryzenctl serve` sul backend finto (RYZENCTL_ROOT), senza driver né root.
"""
import json
import os
import subprocess
import sys
import tempfile
import threading
from collections import deque

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
