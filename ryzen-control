class HelperError(Exception):
    pass


class Helper:
    """Un solo processo `ryzenctl serve`; chiamate serializzate. `call` blocca: usarla via `bg`."""

    def __init__(self, mock):
        env = dict(os.environ)
        if mock:
            root = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "ryzen-control-mock")
            os.makedirs(root, exist_ok=True)
            env["RYZENCTL_ROOT"] = root
            subprocess.run([RYZENCTL, "boot"], env=env, check=False, stdout=subprocess.DEVNULL)   # la baseline del "boot" finto
            cmd = [RYZENCTL, "serve"]
        else:
            cmd = ["pkexec", RYZENCTL, "serve"]
        self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=env, text=True, bufsize=1)
        self.lock = threading.Lock()

    def call(self, *argv):
        with self.lock:
            try:
                self.p.stdin.write(json.dumps(list(argv)) + "\n")
                self.p.stdin.flush()
                line = self.p.stdout.readline()
            except (OSError, ValueError):
                line = ""
            if not line:
                raise HelperError("ryzenctl serve non risponde (pkexec negato o processo terminato): riavvia l'applicazione")
            r = json.loads(line)
            if not r.get("ok"):
                raise HelperError(r.get("error", "errore sconosciuto"))
            return r.get("data")

    def close(self):
        try:
            self.p.stdin.close()
            self.p.wait(timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            self.p.kill()


def bg(work, done, fail):
    """work() in un thread; done(risultato) o fail(messaggio) nel main loop. Mai bloccare la UI."""
    def run():
        try:
            out = work()
        except Exception as e:  # HelperError o bug: mostrato all'utente, mai perso
            GLib.idle_add(fail, str(e))
            return
        GLib.idle_add(done, out)
    threading.Thread(target=run, daemon=True).start()


def fmt(v, unit=""):
    return "n/d" if v is None else "%g%s" % (v, unit)


def button(label, cb, css=None):
    b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
    if css:
        b.add_css_class(css)
    b.connect("clicked", lambda *_: cb())
    return b


def actions_group(apply_cb, save_cb):
    g = Adw.PreferencesGroup()
    box = Gtk.Box(spacing=12, halign=Gtk.Align.END)
    box.append(button("Salva nel profilo…", save_cb))
    box.append(button("Applica ora", apply_cb, "suggested-action"))
    g.add(box)
    return g


def big_label(title):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
    value = Gtk.Label(label="—", css_classes=["title-1"])
    box.append(value)
    box.append(Gtk.Label(label=title, css_classes=["dim-label"]))
    return box, value


