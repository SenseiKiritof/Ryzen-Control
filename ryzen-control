class MonitorPage(Gtk.Box):
    NAME, TITLE, ICON = "monitor", "Monitor", "utilities-system-monitor-symbolic"

    def __init__(self, win):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=12, margin_bottom=12,
                         margin_start=12, margin_end=12)
        self.win = win
        self.hist = deque(maxlen=60)   # (tctl, ppt)
        self.ppt_limit = None
        self.fan_labels = {}
        tiles = Gtk.Box(spacing=12, homogeneous=True)
        self.tiles = {}
        for key, title in (("tctl", "Tctl"), ("ppt", "PPT"), ("tdc", "TDC"), ("fmax", "FMax")):
            c = card()
            value, sub = label("—", ["title-1", "numeric"]), label("", ["dim-label"])
            c.append(label(title, ["heading"]))
            c.append(value)
            c.append(sub)
            bar = Gtk.LevelBar(visible=key in ("ppt", "tdc"))
            c.append(bar)
            self.tiles[key] = (value, sub, bar)
            tiles.append(c)
        self.append(tiles)
        mid = Gtk.Box(spacing=12, vexpand=True)
        table = card()
        grid = Gtk.Grid(column_spacing=18, row_spacing=4)
        for col, h in enumerate(("Core", "MHz", "°C", "CO")):
            grid.attach(label(h, ["heading"], xalign=1.0 if col else 0.0), col, 0, 1, 1)
        self.cores = []
        for c in range(8):
            row = [label("%d" % c, ["numeric"])] + [label("—", ["numeric"], xalign=1.0) for _ in range(3)]
            for col, lab in enumerate(row):
                grid.attach(lab, col, c + 1, 1, 1)
            self.cores.append(row[1:])
        table.append(grid)
        mid.append(table)
        gcard = card()
        gcard.set_hexpand(True)
        gcard.append(label("Tctl (°C, sinistra) e PPT (W, destra) · ultimi 60 s", ["heading"]))
        self.graph = Gtk.DrawingArea(vexpand=True, content_height=150)
        self.graph.set_draw_func(self.draw)
        gcard.append(self.graph)
        mid.append(gcard)
        self.append(mid)
        bottom = card(Gtk.Orientation.HORIZONTAL, 18)
        self.fans = Gtk.Box(spacing=18, hexpand=True)
        bottom.append(self.fans)
        self.power = label("", ["dim-label"], xalign=1.0)
        bottom.append(self.power)
        self.append(bottom)

    def refresh(self, st):
        pass   # il monitor vive di `telemetry`

    def telemetry(self, t):
        value, sub, _ = self.tiles["tctl"]
        value.set_text(fmt(t["tctl"], " °C"))
        sub.set_text("Tccd " + fmt(t["tccd"], " °C") + " · Tjmax " + fmt(t["tjmax"], " °C"))
        for key, unit in (("ppt", "W"), ("tdc", "A")):
            value, sub, bar = self.tiles[key]
            v, lim = t[key], t[key + "_limit"]
            value.set_text(fmt(v, " " + unit))
            sub.set_text("limite " + fmt(lim, " " + unit))
            if v is not None and lim:
                bar.set_max_value(lim)
                bar.set_value(min(v, lim))
        value, sub, _ = self.tiles["fmax"]
        value.set_text(fmt(t["fmax"], " MHz"))
        sub.set_text("EDC limite " + fmt(t["edc_limit"], " A"))
        if t["tctl"] is not None:
            self.hist.append((t["tctl"], t["ppt"]))
            self.ppt_limit = t["ppt_limit"]
            self.graph.queue_draw()
        for c, labs in enumerate(self.cores):
            d = t["cores"][c] if c < len(t["cores"]) else {}
            labs[0].set_text(fmt(d.get("mhz")))
            labs[1].set_text(fmt(d.get("temp")))
            labs[2].set_text("%+d" % d["co"] if d.get("co") is not None else "n/d")
        for f in t["fans"]:
            lab = self.fan_labels.get(f["canale"])
            if lab is None:
                lab = self.fan_labels[f["canale"]] = label("", ["numeric"])
                self.fans.append(lab)
            lab.set_text("%s (%s) · %d giri/min" % (f.get("name") or "Canale %d" % f["canale"], f.get("role", "sconosciuto"), f["rpm"]))
        if not self.fan_labels:
            self.fans.append(label("Nessuna ventola rilevata", ["dim-label"]))
            self.fan_labels[0] = None
        self.power.set_text("Profilo energetico: " + (t["power"] or "n/d"))

    def draw(self, area, cr, w, h):
        lo, hi, plim = 30, 95, self.ppt_limit or 1
        y_t = lambda t: h - 14 - (min(max(t, lo), hi) - lo) / (hi - lo) * (h - 18)
        y_p = lambda p: h - 14 - min(max(p, 0), plim) / plim * (h - 18)
        col = area.get_color()
        cr.set_source_rgba(col.red, col.green, col.blue, 0.35)
        cr.set_line_width(1)
        cr.set_font_size(10)
        for t in (40, 60, 80, 95):
            cr.move_to(0, y_t(t))
            cr.line_to(w, y_t(t))
            cr.stroke()
            cr.move_to(4, y_t(t) - 2)
            cr.show_text("%d" % t)
            cr.move_to(w - 30, y_t(t) - 2)
            cr.show_text("%d" % round(plim * (t - lo) / (hi - lo)))
        n = self.hist.maxlen
        for idx, rgb in ((0, (0.21, 0.52, 0.89)), (1, (0.90, 0.45, 0.13))):
            pts = [(w * (n - len(self.hist) + i) / (n - 1), v[idx]) for i, v in enumerate(self.hist) if v[idx] is not None]
            if len(pts) < 2:
                continue
            cr.set_source_rgb(*rgb)
            cr.set_line_width(2)
            for i, (x, v) in enumerate(pts):
                (cr.move_to if i == 0 else cr.line_to)(x, y_t(v) if idx == 0 else y_p(v))
            cr.stroke()


class ModesPage(Adw.PreferencesPage):
    NAME, TITLE, ICON = "modes", "Modalità", "emblem-default-symbolic"

    def __init__(self, win):
        super().__init__()
        self.win = win
        self.loading = False
        g = Adw.PreferencesGroup(title="Modalità", description="Eco, Auto e Boost sono profili generati dai valori di fabbrica di questa CPU (la calibrazione li misurerà)")
        self.rows, first = {}, None
        for key, title, sub in MODES:
            row = Adw.ActionRow(title=title, subtitle=sub, activatable=True)
            chk = Gtk.CheckButton(valign=Gtk.Align.CENTER, group=first)
            first = first or chk
            row.add_prefix(chk)
            row.set_activatable_widget(chk)
            chk.connect("toggled", self.on_mode, key)
            regen = None
            if key in PRESETS:
                tag = Gtk.Label(label="calibrata sull'hardware" if key in CALIBRATED else "preset fisso", valign=Gtk.Align.CENTER)
                tag.add_css_class("chip")
                tag.add_css_class("success" if key in CALIBRATED else "dim-label")
                row.add_suffix(tag)
                if key in CALIBRATED:
                    cal = button("Calibra…", lambda k=key: self.win.toast("Calibrazione %s in arrivo (autotune): test di carico su questa CPU" % k))
                    row.add_suffix(cal)
                regen = button("Rigenera dai valori di fabbrica", lambda k=key: self.regen(k))
                row.add_suffix(regen)
            self.rows[key] = (row, chk, regen)
            g.add(row)
        self.add(g)
        g = Adw.PreferencesGroup(title="Avvio e limiti")
        self.autostart = Adw.SwitchRow(title="Applica all'avvio", subtitle="Riapplica il profilo selezionato al boot e al resume")
        self.autostart.connect("notify::active", self.on_autostart)
        self.unlock = Adw.SwitchRow(title="Consenti oltre i valori di fabbrica", subtitle="PPT/TDC/EDC fino ai tetti di sblocco, FMax oltre la baseline")
        self.unlock.connect("notify::active", self.on_unlock)
        hw = Adw.ActionRow(title="Verifica hardware", subtitle="Scrive e rilegge un valore per comando, poi ripristina la baseline")
        self.hw_spin = Gtk.Spinner(valign=Gtk.Align.CENTER)
        self.hw_btn = button("Esegui", self.hwtest)
        hw.add_suffix(self.hw_spin)
        hw.add_suffix(self.hw_btn)
        for r in (self.autostart, self.unlock, hw):
            g.add(r)
        self.add(g)

    def refresh(self, st):
        self.loading = True
        prof = st.get("profile")
        shown = st.get("profile_lines", {})
        for key, title, sub in MODES:
            row, chk, regen = self.rows[key]
            if regen:
                exists = key in shown
                regen.set_visible(exists)
                row.set_subtitle(summary(shown[key]) if exists else sub + " — profilo non ancora creato: clic per crearlo")
        current = prof if prof in PRESETS else ("custom" if prof else "default")
        self.rows[current][1].set_active(True)
        self.autostart.set_active(bool(st.get("autostart")))
        self.unlock.set_active(bool(st.get("unlock")))
        self.loading = False

    def on_mode(self, chk, key):
        if self.loading or not chk.get_active():
            return
        if key == "default":
            self.win.run([["default"]], lambda _: self.win.toast("Valori di fabbrica applicati"))
        elif key == "custom":
            self.win.toast("Imposta i valori nelle pagine CPU, Curve e Ventole e usa \"Applica ora\"")
        elif key in self.win.status.get("profile_lines", {}):
            self.win.run([["apply", key], ["use", key]], lambda _: self.win.toast("Profilo '%s' applicato" % key))
        else:
            def ask(res):
                def go(ok):
                    if ok:
                        self.win.run([["preset", key], ["apply", key], ["use", key]], lambda _: self.win.toast("Profilo '%s' creato e applicato" % key))
                    else:
                        self.win.reload()
                self.win.confirm("Creare il profilo '%s' con questi valori?" % key, "\n".join(res["lines"]), "Crea e applica", go)
            bg(lambda: self.win.h.call("preset", key, "show"), ask, lambda m: (self.win.toast(m), self.win.reload()))

    def regen(self, key):
        def ask(res):
            def go(ok):
                if ok:
                    cmds = [["preset", key]] + ([["apply", key]] if self.win.status.get("profile") == key else [])
                    self.win.run(cmds, lambda _: self.win.toast("Profilo '%s' rigenerato" % key))
            self.win.confirm("Rigenerare '%s' dai valori di fabbrica?" % key, "\n".join(res["lines"]), "Rigenera", go, destructive=True)
        bg(lambda: self.win.h.call("preset", key, "show"), ask, self.win.toast)

    def on_autostart(self, row, _):
        if not self.loading:
            self.win.run([["autostart", "on" if row.get_active() else "off"]])

    def on_unlock(self, row, _):
        if self.loading:
            return
        if not row.get_active():
            self.win.run([["unlock", "off"]], lambda res: self.win.toast(str(res[0])))
            return
        def go(ok):
            if ok:
                self.win.run([["unlock", "on"]], lambda res: self.win.toast(str(res[0])))
            else:
                self.win.reload()   # riporta l'interruttore allo stato reale
        self.win.confirm("Oltre i valori di fabbrica?", UNLOCK_WARNING, "Sblocca", go, destructive=True)

    def hwtest(self):
        self.hw_btn.set_sensitive(False)
        self.hw_spin.start()
        def done(res):
            self.hw_spin.stop()
            self.hw_btn.set_sensitive(True)
            self.win.info("Verifica hardware: " + res.get("esito", "?"), "\n".join("%s: %s" % kv for kv in res.items()))
            self.win.reload()
        def fail(msg):
            self.hw_spin.stop()
            self.hw_btn.set_sensitive(True)
            self.win.toast(msg)
        bg(lambda: self.win.h.call("hwtest"), done, fail)


class CpuPage(Page):
    NAME, TITLE, ICON = "cpu", "CPU", "preferences-system-symbolic"

    def __init__(self, win):
        super().__init__(win, CPU_HELP)
        self.params = {}
        self.read_power = None
        for key, title, unit in CPU_PARAMS:
            p = self.params[key] = Param(title, unit)
            self.body.append(p)
        row = Gtk.Box(spacing=12)
        row.append(label("Energia", ["heading"], width_chars=9))
        self.power = Gtk.DropDown(model=Gtk.StringList.new(list(POWER)), valign=Gtk.Align.CENTER)
        row.append(self.power)
        row.append(label("profilo energetico di sistema (power-profiles-daemon / EPP)", ["dim-label"]))
        self.body.append(row)
        self.nocaps = label("Baseline di questo boot assente: nessuna scrittura CPU possibile (ryzenctl.service non l'ha catturata, vedi `ryzenctl status`).",
                            ["warning"], wrap=True, visible=False)
        self.body.append(self.nocaps)
        self.buttons()

    def refresh(self, st):
        caps = st.get("caps")
        self.nocaps.set_visible(not caps)
        self.bar.set_sensitive(bool(caps))
        if not caps:
            return
        values = dict(st["limits"])
        values["fmax"] = st["fmax"]
        base = st.get("baseline") or {}
        for key, _, _ in CPU_PARAMS:
            p, v = self.params[key], values.get(key)
            p.set_visible(v is not None and key in caps)
            if p.get_visible():
                p.setup(caps[key][0], caps[key][1], int(round(v)), base.get(key))
        self.read_power = st.get("power")
        self.power.set_sensitive(self.read_power in POWER)
        if self.read_power in POWER:
            self.power.set_selected(POWER.index(self.read_power))

    def reset(self):
        for p in self.params.values():
            p.reset()
        if self.read_power in POWER:
            self.power.set_selected(POWER.index(self.read_power))

    def lines(self, only_changed):
        out = ["%s %d" % (key, p.value()) for key, p in self.params.items() if p.get_visible() and (not only_changed or p.changed())]
        pw = POWER[self.power.get_selected()]
        if self.power.get_sensitive() and (not only_changed or pw != self.read_power):
            out.append("power " + pw)
        return out


class CurvePage(Page):
    NAME, TITLE, ICON = "curve", "Curve", "view-list-symbolic"

    def __init__(self, win):
        super().__init__(win, CO_HELP)
        self.loading = False
        self.all = Param("Tutti", "")
        self.all.adj.connect("value-changed", self.on_all)
        self.body.append(self.all)
        self.body.append(Gtk.Separator())
        self.cores = [Param("Core %d" % c, "", info=True) for c in range(8)]
        for p in self.cores:
            self.body.append(p)
        self.buttons()

    def refresh(self, st):
        caps = st.get("caps")
        self.bar.set_sensitive(bool(caps))
        self.set_sensitive(bool(caps))
        if not caps:
            return
        self.loading = True
        lo, hi = caps["co"]
        base = (st.get("baseline") or {}).get("co")
        for c, p in enumerate(self.cores):
            p.setup(lo, hi, st["co"][c], base[c] if base else None)
        self.all.setup(lo, hi, st["co"][0])
        self.loading = False

    def telemetry(self, t):
        for c, p in enumerate(self.cores):
            d = t["cores"][c] if c < len(t["cores"]) else {}
            p.info.set_text(fmt(d.get("mhz"), " MHz") + (" · %g °C" % d["temp"] if d.get("temp") is not None else ""))

    def on_all(self, adj):
        if not self.loading:
            for p in self.cores:
                p.adj.set_value(adj.get_value())

    def reset(self):
        for p in self.cores:
            p.reset()

    def lines(self, only_changed):
        if only_changed:
            return ["co %d %d" % (c, p.value()) for c, p in enumerate(self.cores) if p.changed()]
        return ["co " + " ".join(str(p.value()) for p in self.cores)]


class FansPage(Page):
    NAME, TITLE, ICON = "fans", "Ventole", "weather-windy-symbolic"

    def __init__(self, win):
        super().__init__(win, "Le ventole restano gestite dalla SmartFan del BIOS: qui si cambiano solo i tempi di salita/discesa e i punti "
                              "curva dei canali riconosciuti come ventola. Pompe e canali non controllabili sono protetti.")
        self.chans = {}     # n -> (up, down, curve_entry, info)
        self.cards = []
        self.missing = card()
        self.missing.append(label("Ventole non disponibili", ["heading"]))
        self.missing_text = label("", ["dim-label"], wrap=True)
        self.missing.append(self.missing_text)
        self.missing.append(button("Abilita (carica il modulo nct6775)", lambda: self.win.run([["fan", "enable"]], self.enabled), "suggested-action"))
        self.body.append(self.missing)
        self.spin = Gtk.Spinner(valign=Gtk.Align.CENTER)
        self.detect_btn = button("Rileva ruoli", self.autodetect)
        self.buttons(self.spin, self.detect_btn)

    def refresh(self, st):
        self.step_range = st.get("caps", {}).get("fan_step_ms") if st.get("caps") else None
        bg(lambda: self.win.h.call("fan", "status"), self.show, self.show_missing)

    def show_missing(self, msg):
        self.missing_text.set_text(msg + "\n\n" + FAN_MISSING_HELP)
        self.missing.set_visible(True)
        self.bar.set_sensitive(False)
        self.clear()

    def enabled(self, res):
        r = res[0] or {}
        self.win.toast("Riavvio necessario: aggiunto acpi_enforce_resources=lax alla riga del kernel" if r.get("riavvio_necessario")
                       else "Chip %s disponibile" % r.get("chip", "?"))

    def clear(self):
        for c in self.cards:
            self.body.remove(c)
        self.cards, self.chans = [], {}

    def show(self, fs):
        self.missing.set_visible(False)
        self.bar.set_sensitive(True)
        self.clear()
        for c in fs["canali"]:
            n, role, why = c["canale"], c.get("role", "sconosciuto"), c.get("why", "")
            box = card()
            head = Gtk.Box(spacing=12)
            name = Gtk.Entry(text=c.get("name") or "", placeholder_text="Canale %d" % n, width_chars=14, valign=Gtk.Align.CENTER)
            name.connect("activate", lambda e, n=n: self.win.run([["fan", "name", str(n)] + e.get_text().split()]))
            head.append(label("%d" % n, ["title-3"]))
            head.append(name)
            chip = label(role, ["chip", ROLE_CSS.get(role, "dim-label")], valign=Gtk.Align.CENTER)
            head.append(chip)
            head.append(label("%d giri/min · pwm %d · modo %d" % (c["rpm"], c["pwm"], c["modo"]), ["numeric"], hexpand=True))
            head.append(button("Identifica", lambda n=n: self.identify(n)))
            for target in ("pompa", "sconosciuto"):
                if role != target:
                    head.append(button("Segna " + target, lambda n=n, t=target: self.win.run([["fan", "role", str(n), t]])))
            box.append(head)
            box.append(label(why or "ruolo non rilevato: usa \"Rileva ruoli\" (nome: Invio per salvare)", ["dim-label", "caption"]))
            if role == "ventola" and self.step_range:
                up, down = Param("Salita", "ms"), Param("Discesa", "ms")
                up.setup(self.step_range[0], self.step_range[1], c["step_up_ms"])
                down.setup(self.step_range[0], self.step_range[1], c["step_down_ms"])
                curve = Gtk.Entry(text=" ".join(c["curva"]), hexpand=True)
                crow = Gtk.Box(spacing=12)
                crow.append(label("Curva", ["heading"], width_chars=9))
                crow.append(curve)
                crow.append(label("°C:pwm crescenti, ultimo pwm 255", ["dim-label"]))
                for w in (up, down, crow):
                    box.append(w)
                self.chans[n] = (up, down, curve, c)
            self.body.append(box)
            self.cards.append(box)

    def identify(self, n):
        self.win.toast("Canale %d al 100 %% per 5 secondi…" % n)
        bg(lambda: self.win.h.call("fan", "identify", str(n)),
           lambda r: self.win.toast("Canale %d: %d giri/min al 100 %%" % (n, r["rpm_al_100"])), self.win.toast)

    def autodetect(self):
        def go(ok):
            if not ok:
                return
            self.detect_btn.set_sensitive(False)
            self.spin.start()
            def done(res):
                self.spin.stop()
                self.detect_btn.set_sensitive(True)
                self.win.info("Ruoli rilevati", "\n".join("canale %s: %s (%s)" % (n, r["ruolo"], r["perché"]) for n, r in res.items()))
                self.win.reload()
            def fail(msg):
                self.spin.stop()
                self.detect_btn.set_sensitive(True)
                self.win.toast(msg)
            bg(lambda: self.win.h.call("fan", "autodetect"), done, fail)
        self.win.confirm("Rilevare i ruoli dei canali?", AUTODETECT_WARNING, "Avvia", go)

    def reset(self):
        for up, down, curve, c in self.chans.values():
            up.reset()
            down.reset()
            curve.set_text(" ".join(c["curva"]))

    def lines(self, only_changed):
        out = []
        for n, (up, down, curve, c) in sorted(self.chans.items()):
            if not only_changed or up.changed() or down.changed():
                out.append("fan %d step %d %d" % (n, up.value(), down.value()))
            text = " ".join(curve.get_text().split())
            if not only_changed or text != " ".join(c["curva"]):
                out.append("fan %d curve %s" % (n, text))
        return out


