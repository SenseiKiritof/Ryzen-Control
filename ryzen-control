class Window(Adw.ApplicationWindow):
    def __init__(self, app, helper):
        super().__init__(application=app, title="Ryzen Control", default_width=840, default_height=700)
        self.h = helper
        self.status = {}
        self.ui = ui_load()   # per-user preferences shared by the pages, saved with ui_save
        self.polling = False
        self.stack = Adw.ViewStack()
        self.toasts = Adw.ToastOverlay(child=self.stack)
        self.banner = Adw.Banner(button_label=_("Decide…"))
        self.banner.connect("button-clicked", self.on_crash_banner)
        header = Adw.HeaderBar(title_widget=Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE))
        tv = Adw.ToolbarView(content=self.toasts)
        tv.add_top_bar(header)
        tv.add_top_bar(self.banner)
        self.set_content(tv)
        self.pages = [P(self) for P in (MonitorPage, ModesPage, CpuPage, CurvePage, FansPage, PrefsPage)]
        for p in self.pages:
            self.stack.add_titled_with_icon(p, p.NAME, p.TITLE, p.ICON)
        self.connect("close-request", lambda *_a: helper.close())
        self.reload()
        GLib.timeout_add_seconds(1, self.tick)

    # -- helper and reload --
    def reload(self):
        def work():
            st = self.h.call("status")
            st["profile_lines"] = {}
            for name in self.h.call("profile", "list")["profiles"]:
                if name in PRESETS:
                    st["profile_lines"][name] = self.h.call("profile", "show", name)["lines"]
            st["autotune"] = self.h.call("autotune", "status")
            try:   # BIOS fan settings captured at boot: the "stock" side of the fan rows in the profile tables
                st["baseline_lines"] = self.h.call("profile", "show", "baseline")["lines"]
            except HelperError:
                st["baseline_lines"] = []
            try:
                st["fans"] = self.h.call("fan", "status")
            except HelperError as e:   # chip missing: the Fans page shows the message
                st["fans"], st["fans_error"] = None, str(e)
            return st
        bg(work, self.got_status, self.toast)

    def got_status(self, st):
        self.status = st
        c = st.get("crashed")
        if c:
            self.banner.set_title(_("The '%s' profile was deactivated after a crash (%s)") % (c.get("profile") or "-", c.get("time", "?")))
        self.banner.set_revealed(bool(c))
        for p in self.pages:
            p.refresh(st)
        at = st.get("autotune") or {}
        if at.get("phase") and not getattr(self, "at_asked", False):
            self.at_asked = True   # once per session
            if at["phase"] == "done":   # finished without a choice (GUI closed): discard / save / save and apply is proposed again
                dlg = AutotuneDialog(self, at.get("mode", "eco"))
                dlg.show(at)
                dlg.done(at)
            else:
                self.ask_resume(at)

    def ask_resume(self, at):
        ph = at.get("phase")
        where = AT_PHASE_NAMES.get(ph, ph)
        if ph == "co":
            where += _(", CO level %s") % at.get("value") if at.get("parallel") else _(", core %s") % at.get("core")
        story = crash_story(at) or _("The step interrupted by the reboot has already been recorded as unstable.")
        d = Adw.AlertDialog(heading=_("Calibration interrupted"),
                            body=_("A %s calibration started on %s was left halfway (%s). %s Resume it from where it was, or "
                                   "discard it and stay on the stock values?") % (
                                       at.get("mode", "?").capitalize(), at.get("started", "?"), where, story))
        d.add_response("abort", _("Discard calibration"))
        d.add_response("resume", _("Resume"))
        d.set_response_appearance("resume", Adw.ResponseAppearance.SUGGESTED)
        def resp(_d, r):
            if r == "resume":
                dlg = AutotuneDialog(self, at.get("mode", "eco"))
                dlg.show(at)
                dlg.loop()
            else:
                self.run([["autotune", "abort"]], lambda _r: self.toast(_("Calibration discarded, CPU at baseline")))
        d.connect("response", resp)
        d.present(self)

    def tick(self):
        """Telemetry at 1 Hz, only if a page that uses it is visible and no read is in progress."""
        pages = [p for p in self.pages if hasattr(p, "telemetry") and p.get_mapped()]
        if pages and not self.polling:
            self.polling = True
            def done(t):
                self.polling = False
                for p in pages:
                    p.telemetry(t)
            def fail(msg):
                self.polling = False
                if not getattr(self, "poll_failed", False):   # a single warning, not one per second
                    self.poll_failed = True
                    self.toast(_("Telemetry: ") + msg)
            bg(lambda: self.h.call("telemetry"), done, fail)
        return True

    def run(self, cmds, done=None):
        """Sends the commands in sequence (thread); error → toast; in any case reloads the state."""
        def ok(res):
            if done:
                done(res)
            self.reload()
        def fail(msg):
            self.toast(msg)
            self.reload()
        bg(lambda: [self.h.call(*a) for a in cmds], ok, fail)

    def apply_lines(self, lines):
        if not lines:
            self.toast(_("No changes to apply"))
            return
        self.run([l.split() for l in lines], lambda _r: self.toast(_("Applied: ") + "; ".join(lines)))

    def save_profile(self, lines):
        if not lines:
            self.toast(_("Nothing to save"))
            return
        entry = Gtk.Entry(placeholder_text=_("name: a-z 0-9 _ - (max 32)"), activates_default=True)
        d = Adw.AlertDialog(heading=_("Save to profile"), body="\n".join(lines), extra_child=entry)
        d.add_response("cancel", _("Cancel"))
        d.add_response("save", _("Save"))
        d.set_default_response("save")
        d.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
        def resp(_d, r):
            name = entry.get_text().strip()
            if r == "save":
                self.run([["profile", "save", name] + lines], lambda _r: self.toast(_("Profile '%s' saved (%d lines)") % (name, len(lines))))
        d.connect("response", resp)
        d.present(self)

    # -- dialogs --
    def toast(self, msg):
        self.toasts.add_toast(Adw.Toast(title=str(msg), timeout=6))

    def info(self, heading, body):
        d = Adw.AlertDialog(heading=heading, body=body)
        d.add_response("close", _("Close"))
        d.present(self)

    def confirm(self, heading, body, label, cb, destructive=False, extra=None):
        d = Adw.AlertDialog(heading=heading, body=body, extra_child=extra)
        d.add_response("cancel", _("Cancel"))
        d.add_response("ok", label)
        d.set_response_appearance("ok", Adw.ResponseAppearance.DESTRUCTIVE if destructive else Adw.ResponseAppearance.SUGGESTED)
        d.connect("response", lambda _d, r: cb(r == "ok"))
        d.present(self)

    def on_crash_banner(self, *_a):
        c = self.status.get("crashed") or {}
        prof = c.get("profile")
        d = Adw.AlertDialog(heading=_("Crash with an active profile"),
                            body=_("The previous boot ended with a crash while the '%s' profile was active (%s). "
                                   "Reactivate it (also at startup) or stay on the stock values?") % (prof or "-", c.get("time", "?")))
        d.add_response("cancel", _("Cancel"))
        d.add_response("default", _("Stay on Default"))
        if prof:
            d.add_response("reactivate", _("Reactivate"))
            d.set_response_appearance("reactivate", Adw.ResponseAppearance.DESTRUCTIVE)
        def resp(_d, r):
            if r == "reactivate":
                self.run([["crashed", "clear"], ["autostart", "on"], ["apply", prof]], lambda _r: self.toast(_("Profile '%s' reactivated") % prof))
            elif r == "default":   # stock values for the fans too (the boot had applied them), profile deselected
                self.run([["crashed", "clear"], ["default"]], lambda _r: self.toast(_("Stock values; automatic start disabled")))
        d.connect("response", resp)
        d.present(self)


SHOT_SIZE = (1100, 800)   # window size of the README screenshots (make screenshots)


def save_png(widget, path):
    """PNG of a mapped widget rendered from its own widget tree: no screen grab, so it works on
    Wayland and contains only the application."""
    w, h = widget.get_width(), widget.get_height()
    snap = Gtk.Snapshot()
    Gtk.WidgetPaintable.new(widget).snapshot(snap, w, h)
    tex = widget.get_native().get_renderer().render_texture(snap.to_node(), Graphene.Rect().init(0, 0, w, h))
    tex.save_to_png(path)


class App(Adw.Application):
    def __init__(self, mock, smoke=False, shots=None):
        # the mock must not activate the real instance; --smoke/--screenshots run as their own instance,
        # otherwise a mock window already open would receive the activation and the check would pass untested
        super().__init__(application_id=APP_ID + (".Mock" if mock else ""),
                         flags=Gio.ApplicationFlags.NON_UNIQUE if (smoke or shots) else Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.mock, self.smoke, self.smoke_failed, self.shots = mock, smoke, False, shots

    def do_activate(self):
        if not self.props.active_window:
            prov = Gtk.CssProvider()
            try:
                prov.load_from_string(CSS)
            except AttributeError:   # GTK < 4.12
                prov.load_from_data(CSS.encode())
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            win = Window(self, Helper(self.mock))
            if self.smoke:
                GLib.timeout_add(500, self.run_smoke)
            if self.shots:
                Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
                win.set_default_size(*SHOT_SIZE)
                self.drive(self.screenshot_steps())
        self.props.active_window.present()

    def drive(self, steps):
        """Runs a generator that yields pauses in ms, letting GTK lay out and draw in between; an
        exception becomes exit code 1."""
        def tick():
            try:
                GLib.timeout_add(next(steps), tick)
            except StopIteration:
                self.quit()
            except Exception:
                import traceback
                traceback.print_exc()
                self.smoke_failed = True
                self.quit()
            return False
        GLib.timeout_add(500, tick)

    def screenshot_steps(self):
        """--mock --screenshots DIR (make screenshots): fills a fresh fake backend (fan roles, presets,
        the three calibrations), then saves the calibration window at its end and one PNG per page."""
        win = self.props.active_window
        h = win.h
        h.call("fan", "autodetect")
        h.call("fan", "identify", "1")
        # a new fake boot: as on a real machine the fan roles exist at boot, so the baseline has the BIOS fan lines
        run_dir = os.path.join(MOCK_DIR, "run", "ryzenctl")
        for f in os.listdir(run_dir):
            os.remove(os.path.join(run_dir, f))
        subprocess.run([RYZENCTL, "boot"], env=dict(os.environ, RYZENCTL_ROOT=MOCK_DIR), check=True, stdout=subprocess.DEVNULL)
        for name in ("quiet", "performance"):
            h.call("preset", name)
        dlg = AutotuneDialog(win, "eco")   # the real flow: steps in the background, choice at the end
        dlg.start({"step": 3, "reuse": 0})
        for _i in range(150):
            if dlg.save_btn.get_visible() or dlg.close_btn.get_visible():
                break
            yield 200
        if not dlg.save_btn.get_visible():
            raise RuntimeError("the fake Eco calibration did not finish")
        yield 800
        save_png(dlg, os.path.join(self.shots, "calibration.png"))
        h.call("autotune", "save")
        dlg.closable = True
        dlg.close()
        for mode in ("auto", "boost"):
            st = h.call("autotune", "start", mode, "step=3")
            while st["phase"] != "done":
                st = h.call("autotune", "step")
            h.call("autotune", "save")
        h.call("use", "auto")
        h.call("apply", "auto")
        h.call("autostart", "on")
        win.reload()
        yield 1500
        mon = next(p for p in win.pages if isinstance(p, MonitorPage))
        if mon.hist:   # the fake telemetry is steady: fill the 60 s window with it instead of waiting a minute
            mon.hist.extend([mon.hist[-1]] * mon.hist.maxlen)
        for page in win.pages:
            win.stack.set_visible_child(page)
            yield 1200 if page.NAME == "monitor" else 700
            save_png(win, os.path.join(self.shots, page.NAME + ".png"))

    def run_smoke(self):
        """--mock --smoke (make check): the calibration window shows every real state of the fake
        backend for eco, auto and boost (all phases, end, resume dialog), the Fans page flag for unknown
        channels hides/shows them and is saved, then the app exits; a rendering error becomes exit code 1
        instead of a traceback on the desktop."""
        win = self.props.active_window
        try:
            win.h.call("autotune", "abort")
            for mode in ("eco", "auto", "boost"):
                dlg = AutotuneDialog(win, mode)
                st = win.h.call("autotune", "start", mode, "step=3")
                dlg.show(st)
                for _i in range(300):
                    st = win.h.call("autotune", "step")
                    dlg.show(st)
                    if st["phase"] == "done":
                        break
                dlg.done(st)
                win.h.call("autotune", "abort")
                dlg.closable = True
                dlg.close()
            win.ask_resume({"mode": "auto", "phase": "ppt", "started": "today"})
            win.ask_resume({"mode": "eco", "phase": "co", "parallel": True, "value": -10, "started": "today"})
            win.ask_resume({"mode": "auto", "phase": "final", "started": "today", "params": {"margin": 3}, "final_margin": 6,
                            "results": {str(c): -35 for c in range(8)}, "unstable": {"0": {"value": -40, "why": "crash"}}})
            fans = next(p for p in win.pages if isinstance(p, FansPage))
            fans.show({"canali": [{"canale": 9, "rpm": 0, "pwm": 0, "modo": 5}]})   # no role = unknown
            for on in (not fans.unknown.get_active(), fans.unknown.get_active()):   # flip and back: the user's choice stays
                fans.unknown.set_active(on)
                assert fans.unknown_cards[0].get_visible() == on and ui_load().get("show_unknown_fans") == on
        except Exception:
            import traceback
            traceback.print_exc()
            self.smoke_failed = True
        self.quit()
        return False


def main():
    argv = list(sys.argv)
    mock, smoke = "--mock" in argv, "--smoke" in argv
    shots = None
    if "--screenshots" in argv:   # --mock --screenshots DIR: README screenshots from the fake backend
        i = argv.index("--screenshots")
        shots = argv[i + 1] if i + 1 < len(argv) else None
        if not mock or not shots:
            sys.exit("usage: ryzen-control --mock --screenshots DIR")
        os.makedirs(shots, exist_ok=True)
        del argv[i:i + 2]
    app = App(mock, smoke and mock, shots)
    rc = app.run([a for a in argv if a not in ("--mock", "--smoke")])
    sys.exit(1 if app.smoke_failed else rc)


if __name__ == "__main__":
    main()
