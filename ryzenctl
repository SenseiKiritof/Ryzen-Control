    FAKE.save()
    assert run(["ppt", "150"]) == {"ppt": 150.0}     # prima scrittura ignorata, seconda ok
    FAKE.s["drop"] = 2
    FAKE.save()
    expect_err(["ppt", "140"], "ripristinato")
    assert run(["status"])["limits"]["ppt"] == 162.0
    # dry-run: valida senza toccare l'hardware
    assert run(["ppt", "150"], {"dry": True}) == {"ppt": 150.0} and FAKE.s["ppt"] == 162.0
    expect_err(["ppt", "500"], "fuori", {"dry": True})
    # PM table assente: limiti rifiutati, CO ok
