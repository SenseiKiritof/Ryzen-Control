        raise Err("uso: preset quiet|eco|auto|boost [show]")
    lines = preset_lines(args[0], load_baseline())
    if len(args) == 2:
        return {"profile": args[0], "lines": lines}
    return cmd_profile(ctx, ["save", args[0]] + lines)


