AT_PATH = STATE + "/autotune.json"
AT_DEFAULTS = {"eco": {"target": 70, "colimit": -25, "margin": 5, "step": 90, "parallel": 1},
               "auto": {"target": 70, "colimit": -40, "margin": 3, "step": 90, "loss": 10, "parallel": 1}}
# parallel=1 (default): tutti i core insieme a ogni livello di CO, un worker per core (8x più
# veloce); parallel=0: un core alla volta (attribuisce con certezza anche un crash).
AT_FMAX_TESTS_EST, AT_PPT_TESTS_EST, AT_FKNEE_TESTS_EST, BURST_SEC = 5, 5, 6, 5   # per le stime di durata
PPT_SWEEP_STEP, PPT_SWEEP_MIN, BENCH_SEC, FMAX_KNEE_SPAN = 0.10, 0.50, 15, 800   # Auto: ginocchio prestazioni/W
CO_STEP, FINAL_SEC, FINAL_RETRIES = 5, 300, 3
FMAX_STEP, FMAX_SWEEP_MIN, BURSTS = 100, 4000, 12


def boot_id():
    return FAKE.s["boot_id"] if FAKE else read_text("/proc/sys/kernel/random/boot_id")


def at_load():
    try:
        return json.loads(open(P(AT_PATH)).read())
    except (OSError, ValueError):
        return None


def at_save(st):
    write_atomic(P(AT_PATH), json.dumps(st, indent=1))


def mce_since(ts):
    r = subprocess.run(["journalctl", "-k", "-q", "--since", "@%d" % int(ts), "-g", "mce|Hardware Error"],
                       capture_output=True, text=True)
    return bool(r.stdout.strip())


def run_load(args, seconds):
    """stress-ng con argomenti fissi; True se finisce bene e senza errori MCE."""
    if FAKE:
        return FAKE.load_ok(args)
    t0 = time.time()
    try:
        r = subprocess.run(["stress-ng"] + args + ["-t", str(int(seconds)), "-q"], capture_output=True)
    except OSError:
        raise Err("stress-ng non installato: serve per i test di carico")
    return r.returncode == 0 and not mce_since(t0)


def co_test(cores, seconds):
    """Tre fasi: pieno carico con verifica, 50 %, 10 % (le instabilità CO emergono a basso carico)."""
    sec = max(1, seconds // 3)
    base = ["--cpu", str(len(cores)), "--cpu-method", "all", "--verify"]
    if len(cores) == 1:
        base += ["--taskset", str(cores[0])]
    for extra in ([], ["--cpu-load", "50"], ["--cpu-load", "10"]):
        if not run_load(base + extra, sec):
            return False
    return True


def co_test_sampled(cores, seconds):
    """Come co_test, ma a metà della fase a pieno carico campiona tensione e MHz per core:
    è la misura di "a cosa corrisponde" un passo di CO. Restituisce (ok, campione)."""
    if FAKE:
        return FAKE.load_ok(["--taskset", str(cores[0])] if len(cores) == 1 else []), sample_cores()
    sec = max(1, seconds // 3)
    base = ["--cpu", str(len(cores)), "--cpu-method", "all", "--verify"]
    if len(cores) == 1:
        base += ["--taskset", str(cores[0])]
    pr = spawn_load(base, sec)
    time.sleep(max(1, sec // 2))
    sample = sample_cores()
    if pr.wait() != 0 or mce_since(time.time() - sec - 1):
        return False, sample
    for extra in (["--cpu-load", "50"], ["--cpu-load", "10"]):
        if not run_load(base + extra, sec):
            return False, sample
    return True, sample


def spawn_load(args, seconds):
    return subprocess.Popen(["stress-ng"] + args + ["-t", str(int(seconds)), "-q"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def mce_cores_since(ts, cores):
    """Core con errori MCE dal timestamp; se la riga non dice la CPU, tutti (prudenza)."""
    r = subprocess.run(["journalctl", "-k", "-q", "--since", "@%d" % int(ts), "-g", "mce|Hardware Error"],
                       capture_output=True, text=True)
    if not r.stdout.strip():
        return set()
    cpus = re.findall(r"CPU[ :]+(\d+)", r.stdout)
    if not cpus:
        return set(cores)
    # ponytail: cpu logica → core fisico = cpu % CORES (su questa topologia cpuN e cpuN+8 sono il core N)
    return {int(c) % CORES for c in cpus} & set(cores)


def co_test_parallel(cores, seconds):
    """Tutti i core insieme, un worker per core (così l'instabilità software resta attribuita al
    core): pieno carico, poi 50 %, poi raffiche singole a turno per toccare il boost massimo
    di ogni core. Restituisce (core falliti, campione tensioni/MHz a pieno carico)."""
    if FAKE:
        return {c for c in cores if not FAKE.load_ok(["--taskset", str(c)])}, sample_cores()
    sec = max(1, seconds // 3)
    failed = set()
    sample = None
    t0 = time.time()
    for extra in ([], ["--cpu-load", "50"]):
        procs = {c: spawn_load(["--cpu", "1", "--taskset", str(c), "--cpu-method", "all", "--verify"] + extra, sec)
                 for c in cores if c not in failed}
        if not extra:
            time.sleep(max(1, sec // 2))
            sample = sample_cores()                    # tensioni a pieno carico a questo livello di CO
        for c, pr in procs.items():
            if pr.wait() != 0:
                failed.add(c)
    burst = max(3, sec // max(1, len(cores)))
    for c in cores:
        if c not in failed and not run_load(["--cpu", "1", "--taskset", str(c), "--cpu-method", "all", "--verify"], burst):
            failed.add(c)
    return failed | mce_cores_since(t0, cores), sample


def at_total_estimate(mode, p):
    """Durata stimata (s) di una calibrazione completa con questi parametri (massimo per il CO)."""
    levels = max(1, (-p["colimit"]) // CO_STEP)
    t = levels * p["step"] * (1 if p.get("parallel", 1) else CORES) + FINAL_SEC
    if mode == "eco":
        t += AT_FMAX_TESTS_EST * BURSTS * BURST_SEC
    else:
        t += AT_PPT_TESTS_EST * (5 + BENCH_SEC) + AT_FKNEE_TESTS_EST * (3 + BENCH_SEC)
    return int(t)


def at_estimate(st):
    """{total_s, remaining_s}: tempo rimanente stimato dalla fase corrente."""
    p, ph = st["params"], st["phase"]
    levels = max(1, (-p["colimit"]) // CO_STEP)
    rem = 0
    if ph == "co":
        level_idx = (-st["value"]) // CO_STEP - 1          # livelli già completati
        if st.get("parallel"):
            rem += (levels - level_idx) * p["step"]
        else:
            rem += ((CORES - st["core"] - 1) * levels + (levels - level_idx)) * p["step"]
    if ph in ("co", "final"):
        rem += FINAL_SEC
    if st["mode"] == "eco" and ph in ("co", "final", "fmax"):
        n = AT_FMAX_TESTS_EST
        if ph == "fmax" and st["fmax"].get("current"):
            possible = max(1, (st["fmax"]["current"] - FMAX_SWEEP_MIN) // FMAX_STEP + 1)
            n = min(possible, max(1, AT_FMAX_TESTS_EST - len(st["fmax"]["tests"])))   # scende a ogni test
        rem += n * BURSTS * BURST_SEC
    if st["mode"] == "auto" and ph in ("co", "final", "ppt", "fmax_knee"):
        knee = st.get("knee", {})
        if ph != "fmax_knee":
            done = len(knee.get("ppt", {}).get("tests", [])) if ph == "ppt" else 0
            rem += max(0, AT_PPT_TESTS_EST - done) * (5 + BENCH_SEC)
        done_f = len(knee.get("fmax", {}).get("tests", [])) if ph == "fmax_knee" else 0
        rem += max(0, AT_FKNEE_TESTS_EST - done_f) * (3 + BENCH_SEC)
    return {"total_s": at_total_estimate(st["mode"], p), "remaining_s": int(rem)}


def at_params(mode, kvs):
    params = dict(AT_DEFAULTS[mode])
    for kv in kvs:
        k, _, v = kv.partition("=")
        if k not in params:
            raise Err("parametro sconosciuto '%s' (%s)" % (k, ", ".join(params)))
        params[k] = to_int(v, k)
    check_range("colimit", params["colimit"], CO_MIN, 0)
    check_range("margin", params["margin"], 0, 20)
    check_range("step", params["step"], 3, 3600, " s")
    check_range("target", params["target"], 50, 90, " °C")
    check_range("parallel", params["parallel"], 0, 1)
    if "loss" in params:
        check_range("loss", params["loss"], 1, 50, " %")
    return params


def tctl_p95():
    """p95 dei picchi Tctl su BURSTS raffiche di 2 s, metà all-core e metà single-core (solo
    k10temp: niente letture PM durante la misura, scaldano il die)."""
    if FAKE:
        return FAKE.peak_tctl()
    peaks = []
    core = best_core()
    for i in range(BURSTS):
        # metà raffiche su tutti i core (lo "scatto" all'avvio di un programma pesante), metà su
        # un solo core al boost massimo: sono i due picchi che fanno partire le ventole
        args = ["--cpu", "0"] if i % 2 == 0 else ["--cpu", "1", "--taskset", str(core)]
        p = subprocess.Popen(["stress-ng"] + args + ["-t", "2", "-q"])
        peak = 0.0
        while p.poll() is None:
            peak = max(peak, tctl() or 0.0)
            time.sleep(0.05)
        peaks.append(peak)
        time.sleep(3)
    return sorted(peaks)[max(0, int(len(peaks) * 0.95) - 1)]


def rapl_energy():
    """Energia package in µJ e range di wrap, o (None, None)."""
    try:
        d = "/sys/class/powercap/intel-rapl:0"
        return int(read_text(d + "/energy_uj")), int(read_text(d + "/max_energy_range_uj"))
    except (OSError, ValueError):
        return None, None


def bench(threads, core=None):
    """(bogo-ops/s, W medi) di stress-ng matrixprod per BENCH_SEC secondi; W da RAPL, fallback PM d[3]."""
    if FAKE:
        return FAKE.bench(threads)
    args = ["stress-ng", "--cpu", str(threads), "--cpu-method", "matrixprod", "--metrics", "-Y", "/dev/stdout",
            "-t", str(BENCH_SEC), "-q"]
    if core is not None:
        args += ["--taskset", str(core)]
    e0, rng = rapl_energy()
    pm_samples = []
    t0 = time.monotonic()
    p = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    while p.poll() is None:
        if e0 is None:
            pm_samples.append(read_limits().get("ppt") or 0)
        time.sleep(0.5)
    out = p.stdout.read()
    dt = max(0.1, time.monotonic() - t0)
    m = re.search(r"bogo-ops-per-second-real-time:\s*([0-9.]+)", out)
    if not m:
        raise Err("stress-ng non ha riportato le metriche")
    if e0 is not None:
        e1, _ = rapl_energy()
        watts = ((e1 - e0) % rng) / 1e6 / dt
    else:
        watts = sum(pm_samples) / max(1, len(pm_samples))
    return float(m.group(1)), round(watts, 1)


def best_core():
    """Core con prefcore più alto (per il test single-thread)."""
    if FAKE:
        return 1
    best, rank = 0, -1
    for c in range(CORES):
        try:
            r = int(read_text("/sys/devices/system/cpu/cpu%d/cpufreq/amd_pstate_prefcore_ranking" % c))
        except (OSError, ValueError):
            r = 0
        if r > rank:
            best, rank = c, r
    return best


def at_scaled_limits(base, ppt):
    """TDC/EDC in proporzione al PPT scelto, mai sotto i floor."""
    k = ppt / float(base["ppt"])
    return {"ppt": ppt, "tdc": max(TDC_MIN, round(base["tdc"] * k)) if "tdc" in base else None,
            "edc": max(EDC_MIN, round(base["edc"] * k)) if "edc" in base else None}


def at_knee_step(ctx, st, base):
    """Auto: un punto dello sweep PPT (multi-thread) o FMax (single-thread); sceglie il valore più
    basso con prestazioni ≥ (100 − loss) % del massimo misurato."""
    k = st["knee"]
    loss = st["params"]["loss"] / 100.0
    if st["phase"] == "ppt":
        v = k["ppt"]["current"]
        lim = at_scaled_limits(base, v)
        for key in ("ppt", "tdc", "edc"):
            if lim[key] is not None:
                run([key, str(lim[key])], ctx)
        pause(5)
        ops, watts = bench(CORES * 2)
        k["ppt"]["tests"].append([v, ops, watts])
        best = max(t[1] for t in k["ppt"]["tests"])
        nxt = round(v - base["ppt"] * PPT_SWEEP_STEP)
        if ops < best * (1 - loss):
            k["ppt"]["chosen"] = k["ppt"]["tests"][-2][0] if len(k["ppt"]["tests"]) > 1 else v
        elif nxt < base["ppt"] * PPT_SWEEP_MIN or nxt < PPT_MIN:
            k["ppt"]["chosen"] = v
        else:
            k["ppt"]["current"] = nxt
            return
        lim = at_scaled_limits(base, k["ppt"]["chosen"])
        for key in ("ppt", "tdc", "edc"):
            if lim[key] is not None:
                run([key, str(lim[key])], ctx)
        st["phase"] = "fmax_knee"
        k["fmax"]["current"] = base["fmax"]
        return
    if st["phase"] == "fmax_knee":
        v = k["fmax"]["current"]
        run(["fmax", str(v)], ctx)
        pause(3)
        ops, watts = bench(1, best_core())
        k["fmax"]["tests"].append([v, ops, watts])
        best = max(t[1] for t in k["fmax"]["tests"])
        nxt = v - FMAX_STEP
        if ops < best * (1 - loss):
            k["fmax"]["chosen"] = k["fmax"]["tests"][-2][0] if len(k["fmax"]["tests"]) > 1 else v
        elif nxt < base["fmax"] - FMAX_KNEE_SPAN or nxt < FMAX_MIN:
            k["fmax"]["chosen"] = v
        else:
            k["fmax"]["current"] = nxt
            return
        at_finish_auto(ctx, st, base)


def at_finish_auto(ctx, st, base):
    """Profili auto (CO, limiti e FMax al ginocchio, ventole 3 s/2 s) e boost (fabbrica + CO)."""
    k = st["knee"]
    lim = at_scaled_limits(base, k["ppt"]["chosen"])
    co = "co " + " ".join(str(v) for v in st["final"])
    lines = [co] + ["%s %d" % (key, lim[key]) for key in ("ppt", "tdc", "edc") if lim[key] is not None]
    lines.append("fmax %d" % k["fmax"]["chosen"])
    lines += [l for l in preset_lines("auto", base) if l.split()[0] not in ("co", "ppt", "tdc", "edc", "fmax")]
    cmd_profile(ctx, ["save", "auto"] + lines)
    cmd_profile(ctx, ["save", "boost", co] + [l for l in preset_lines("boost", base) if not l.startswith("co ")])
    run(["apply", "auto"], ctx)
    run(["use", "auto"], ctx)
    st["phase"] = "done"
    st["profile_lines"] = lines


def at_final_values(st):
    m = st["params"]["margin"]
    return [min(0, st["results"].get(str(c), 0) + m) for c in range(CORES)]


def cmd_autotune(ctx, args):
    """autotune start eco|auto [chiave=valore…] | step | status | abort | estimate eco|auto [chiave=valore…]"""
    st = _autotune(ctx, args)
    if isinstance(st, dict) and st.get("phase"):
        st["eta"] = at_estimate(st)
    return st


def _autotune(ctx, args):
    if not args:
        raise Err("uso: autotune start eco|auto [target=70 colimit=-25 margin=5 step=90 parallel=1] | step | status | abort | estimate eco|auto […]")
    if args[0] == "status":
        return at_load() or {"phase": None}
    if args[0] == "estimate":
        if len(args) < 2 or args[1] not in AT_DEFAULTS:
            raise Err("uso: autotune estimate eco|auto [chiave=valore…]")
        p = at_params(args[1], args[2:])
        return {"total_s": at_total_estimate(args[1], p),
                "parallel_total_s": at_total_estimate(args[1], dict(p, parallel=1)),
                "sequential_total_s": at_total_estimate(args[1], dict(p, parallel=0)), "params": p}
    if args[0] == "abort":
        st = at_load()
        rm(P(AT_PATH))
        if st:
            apply_lines(profile_lines("baseline"), ctx, "cpu")
            rm(marker("active"))                       # stato CPU = baseline
        return {"phase": None, "aborted": bool(st)}
    if args[0] == "start":
        if len(args) < 2 or args[1] not in AT_DEFAULTS:
            raise Err("uso: autotune start eco|auto [chiave=valore…]")
        check_cpu()
        load_baseline()
        params = at_params(args[1], args[2:])
        apply_lines(profile_lines("baseline"), ctx, "cpu")      # tutti i core a baseline
        _, ref = co_test_parallel(list(range(CORES)), 9)        # riferimento: tensioni a CO di fabbrica, stesso carico
        st = {"mode": args[1], "params": params, "phase": "co", "core": 0, "value": -CO_STEP,
              "samples": {"0": ref},
              "parallel": bool(params["parallel"]), "active_cores": list(range(CORES)),
              "results": {}, "unstable": {}, "in_progress": None, "final_tries": 0,
              "fmax": {"current": None, "tests": [], "chosen": None},
              "started": time.strftime("%Y-%m-%d %H:%M"), "resumed_after_crash": False}
        at_save(st)
        return st
    if args[0] != "step":
        raise Err("uso: autotune start|step|status|abort")
    st = at_load()
    if not st or st["phase"] == "done":
        raise Err("nessuna calibrazione in corso (autotune start eco|auto)")
    check_cpu()
    base = load_baseline()
    ip = st.get("in_progress")
    if ip and ip.get("boot_id") != boot_id():          # il passo precedente ha fatto crashare il sistema
        st["resumed_after_crash"] = True
        st["in_progress"] = None
        if ip["kind"] == "co":
            at_core_failed(st, ip["core"], ip["value"], "crash")
        elif ip["kind"] == "co_par":                   # non attribuibile: tutti i core in prova instabili a v
            for c in ip["cores"]:
                st["unstable"][str(c)] = {"value": ip["value"], "why": "crash"}
                st["results"].setdefault(str(c), 0)
            st["active_cores"] = []
            st["phase"] = "final"
        elif ip["kind"] == "final":
            at_final_failed(st)
        at_save(st)
        return st
    if st["phase"] == "co" and st.get("parallel"):
        v, cores = st["value"], st["active_cores"]
        st["in_progress"] = {"kind": "co_par", "cores": cores, "value": v, "boot_id": boot_id()}
        at_save(st)
        for c in cores:
            run(["co", str(c), str(v)], ctx)
        failed, sample = co_test_parallel(cores, st["params"]["step"])
        st["in_progress"] = None
        if sample:
            st.setdefault("samples", {})[str(v)] = sample
        for c in cores:
            if c in failed:
                st["unstable"][str(c)] = {"value": v, "why": "instabile"}
                st["results"].setdefault(str(c), 0)
                run(["co", str(c), str(st["results"][str(c)])], ctx)   # torna all'ultimo stabile
            else:
                st["results"][str(c)] = v
        st["active_cores"] = [c for c in cores if c not in failed]
        if not st["active_cores"] or v - CO_STEP < st["params"]["colimit"]:
            st["phase"] = "final"
        else:
            st["value"] = v - CO_STEP
        at_save(st)
        return st
    if st["phase"] == "co":
        c, v = st["core"], st["value"]
        st["in_progress"] = {"kind": "co", "core": c, "value": v, "boot_id": boot_id()}
        at_save(st)
        run(["co", str(c), str(v)], ctx)
        ok, sample = co_test_sampled([c], st["params"]["step"])
        st["in_progress"] = None
        if sample:
            st.setdefault("samples", {}).setdefault(str(v), {"volt": [None] * CORES, "mhz": [None] * CORES})
            st["samples"][str(v)]["volt"][c] = sample["volt"][c]
            st["samples"][str(v)]["mhz"][c] = sample["mhz"][c]
        if ok:
            st["results"][str(c)] = v
            if v - CO_STEP < st["params"]["colimit"]:
                at_next_core(st, base)
            else:
                st["value"] = v - CO_STEP
        else:
            at_core_failed(st, c, v, "instabile")
        at_save(st)
        return st
    if st["phase"] == "final":
        vals = at_final_values(st)
        st["in_progress"] = {"kind": "final", "boot_id": boot_id()}
        at_save(st)
        run(["co"] + [str(v) for v in vals], ctx)
        ok = co_test(list(range(CORES)), FINAL_SEC)
        st["in_progress"] = None
        if ok:
            st["final"] = vals
            if st["mode"] == "eco":
                st["phase"] = "fmax"
                st["fmax"]["current"] = base["fmax"]
                for t in preset_lines("eco", base):    # limiti, Tjmax ed energia eco PRIMA di misurare i picchi
                    if t.split()[0] in ("ppt", "tdc", "edc", "tjmax", "power"):
                        run(t.split(), ctx)
            else:
                st["phase"] = "ppt"
                st["knee"] = {"ppt": {"current": base["ppt"], "tests": [], "chosen": None},
                              "fmax": {"current": None, "tests": [], "chosen": None}}
        else:
            at_final_failed(st)
        at_save(st)
        return st
    if st["phase"] == "fmax":
        f = st["fmax"]["current"]
        run(["fmax", str(f)], ctx)
        p95 = tctl_p95()
        st["fmax"]["tests"].append([f, p95])
        if p95 <= st["params"]["target"] or f - FMAX_STEP < FMAX_SWEEP_MIN:
            st["fmax"]["chosen"] = f
            at_finish_eco(ctx, st, base)
        else:
            st["fmax"]["current"] = f - FMAX_STEP
        at_save(st)
        return st
    if st["phase"] in ("ppt", "fmax_knee"):
        at_knee_step(ctx, st, base)
        at_save(st)
        return st
    raise Err("fase sconosciuta: %s" % st["phase"])


def at_core_failed(st, c, v, why):
    st["unstable"][str(c)] = {"value": v, "why": why}
    st["results"].setdefault(str(c), 0)             # ultimo stabile: quello già registrato, o 0
    at_next_core(st, load_baseline())


def at_next_core(st, base):
    run(["co", str(st["core"]), str(base["co"][st["core"]])], {})   # il core torna a baseline fino alla passata finale
    st["core"] += 1
    st["value"] = -CO_STEP
    if st["core"] >= CORES:
        st["phase"] = "final"


def at_final_failed(st):
    st["final_tries"] += 1
    if st["final_tries"] >= FINAL_RETRIES:
        st["phase"] = "done"
        st["error"] = "passata finale instabile anche con margine aumentato: CO lasciato a baseline"
        run(["apply", "baseline", "cpu"], {})
        return
    for c in range(CORES):                            # +3 a tutti e si riprova
        st["results"][str(c)] = min(0, st["results"].get(str(c), 0) + 3)


def at_finish_eco(ctx, st, base):
    """Profilo eco dalle misure: CO finale, FMax scelto, limiti eco, ventole lente + curva dal target."""
    lines = ["co " + " ".join(str(v) for v in st["final"]), "fmax %d" % st["fmax"]["chosen"]]
    lines += [l for l in preset_lines("eco", base) if l.split()[0] not in ("co", "fmax")]
    d = fans_dir()
    if d:
        tj = min(base.get("tjmax", TJMAX_ABS_MAX), PRESETS["eco"]["tjmax"])
        for n in fan_channels(d):
            if fan_role(n) == "ventola":
                cur = fan_info(d, n)["curva"]
                pwm_min = int(cur[0].split(":")[1]) if cur else FAN_PWM_MIN
                lines.append("fan %d curve %d:%d %d:255" % (n, st["params"]["target"] - 10, max(FAN_PWM_MIN, pwm_min), tj - 5))
    cmd_profile(ctx, ["save", "eco"] + lines)
    run(["apply", "eco"], ctx)
    run(["use", "eco"], ctx)
    st["phase"] = "done"
    st["profile_lines"] = lines


# ---- Crash-guard: marker dirty / active / crashed -----------------------------------------
def marker(name):
    return P(STATE + "/" + name)


def rm(path):
    try:
        os.remove(path)
    except OSError:
        pass


def crashed_info():
    try:
        return json.loads(open(marker("crashed")).read())
    except (OSError, ValueError):
        return None


def apply_autostart(ctx, parts):
    """Applica il profilo di avvio (se attivo e non in stato crashed). Mai un'eccezione:
    il servizio deve restare attivo perché ExecStop possa rimuovere `dirty`."""
    s = load_settings()
    out = {"profile": s["profile"], "autostart": s["autostart"], "crashed": crashed_info(), "applied": {}, "errors": {}}
    if not (s["autostart"] and s["profile"]):
        return out
    for part in parts:
        if part == "cpu" and out["crashed"]:
            out["errors"][part] = "profilo CPU non applicato: crash nel boot precedente"
            continue
        try:
            out["applied"][part] = apply_lines(profile_lines(s["profile"]), ctx, part)
        except Err as e:
            out["errors"][part] = str(e)
    return out


def cmd_boot(ctx, args):
    os.makedirs(P(STATE), exist_ok=True)
    os.makedirs(P(RUN), exist_ok=True)
    out = {}
    if os.path.exists(P(RUN + "/booted")):          # restart nello stesso boot: ExecStop ha tolto dirty
        touch_sync(marker("dirty"))
    else:
        s = load_settings()
        if os.path.exists(marker("dirty")) and os.path.exists(marker("active")):
            write_atomic(marker("crashed"), json.dumps({"time": time.strftime("%Y-%m-%d %H:%M"),
                                                        "profile": s["profile"]}))
        rm(marker("active"))
        touch_sync(marker("dirty"))                 # prima di qualunque scrittura SMU
        touch_sync(P(RUN + "/booted"))
        try:
            cmd_baseline(ctx, [])
        except Err as e:
            out["baseline_error"] = str(e)
    out.update(apply_autostart(ctx, ("fan", "cpu")))
    return out


def cmd_shutdown(ctx, args):
    rm(marker("dirty"))
    return {"dirty": False}


def cmd_resume(ctx, args):
    return apply_autostart(ctx, ("fan", "cpu"))


def cmd_default(ctx, args):
    done = apply_lines(profile_lines("baseline"), ctx)
    rm(marker("active"))
    s = load_settings()
    s["autostart"] = False
    s["profile"] = None          # Default = nessun profilo selezionato (la GUI mostra la modalità da qui)
    save_settings(s)
    return {"applied": done, "autostart": False, "profile": None}


def cmd_crashed(ctx, args):
    if args == ["clear"]:
        rm(marker("crashed"))
        return {"crashed": None}
    if args:
        raise Err("uso: crashed [clear]")
    return {"crashed": crashed_info()}


def cmd_notify(ctx, args):
    """Da autostart XDG dell'utente: avvisa se il boot precedente è finito con un crash."""
    info = crashed_info()
    if info:
        msg = "Il profilo '%s' è stato disattivato: il sistema è andato in crash (%s). Apri Ryzen Control per decidere." % (
            info.get("profile") or "-", info.get("time", "?"))
        if FAKE:  # il selftest gira nella sessione dell'utente: niente notifiche vere
            FAKE.s["notified"] = msg
            FAKE.save()
        else:
            subprocess.run(["notify-send", "-u", "critical", "-a", "Ryzen Control", "Ryzen Control", msg],
                           capture_output=True)
    return {"crashed": info}


# ---- Ventole (nct6775 via hwmon) ----------------------------------------------------------
def pause(seconds):
    if not FAKE:
        time.sleep(seconds)


def fans_dir():
    """Directory hwmon del Super I/O Nuvoton, o None."""
    try:
        for d in sorted(os.listdir(P(HWMON))):
            try:
                if read_text("%s/%s/name" % (HWMON, d)).startswith("nct6"):
                    return HWMON + "/" + d
            except OSError:
                pass
    except OSError:
        pass
    return None


def hw_read(path):
    return int(read_text(path))


def hw_write(path, value):
    with open(P(path), "w") as f:
        f.write(str(int(value)))
    if FAKE:
        FAKE.after_fan_write(path, int(value))


def fan_channels(d):
    """Indici N con pwmN e fanN_input presenti."""
    out = []
    for f in sorted(os.listdir(P(d))):
        if re.fullmatch(r"pwm\d+", f) and os.path.exists(P("%s/fan%s_input" % (d, f[3:]))):
            out.append(int(f[3:]))
    return sorted(out)


def fan_points(d, n):
    k = 1
    while os.path.exists(P("%s/pwm%d_auto_point%d_temp" % (d, n, k))):
        k += 1
    return k - 1


def fan_roles():
    return load_settings().get("fans", {})


def fan_role(n):
    return fan_roles().get(str(n), {}).get("role", "sconosciuto")


def fan_set_role(n, role, why=""):
    s = load_settings()
    s.setdefault("fans", {}).setdefault(str(n), {})
    s["fans"][str(n)].update({"role": role, "why": why})
    save_settings(s)


def fan_require_writable(n):
    if fan_role(n) != "ventola":
        raise Err("canale %d non scrivibile: ruolo '%s' (solo 'ventola', assegnato da `fan autodetect`)" % (n, fan_role(n)))


def fan_info(d, n):
    info = {"canale": n, "rpm": hw_read("%s/fan%d_input" % (d, n)), "pwm": hw_read("%s/pwm%d" % (d, n)),
            "modo": hw_read("%s/pwm%d_enable" % (d, n)),
            "step_up_ms": hw_read("%s/pwm%d_step_up_time" % (d, n)),
            "step_down_ms": hw_read("%s/pwm%d_step_down_time" % (d, n)),
            "curva": ["%d:%d" % (hw_read("%s/pwm%d_auto_point%d_temp" % (d, n, k)) // 1000,
                                 hw_read("%s/pwm%d_auto_point%d_pwm" % (d, n, k))) for k in range(1, fan_points(d, n) + 1)]}
    info.update(fan_roles().get(str(n), {"role": "sconosciuto"}))
    return info


def fan_capture_lines():
    d = fans_dir()
    if not d:
        return []
    lines = []
    for n in fan_channels(d):
        if fan_role(n) == "ventola":
            i = fan_info(d, n)
            lines.append("fan %d step %d %d" % (n, i["step_up_ms"], i["step_down_ms"]))
            lines.append("fan %d curve %s" % (n, " ".join(i["curva"])))
    return lines


def fan_need(d_or_none):
    if not d_or_none:
        raise Err("nessun chip nct67xx in hwmon: `fan enable` (modulo nct6775, eventuale parametro kernel)")
    return d_or_none


def median(values):
    v = sorted(values)
    return v[len(v) // 2]


def tctl_median(seconds):
    if FAKE:
        return tctl()
    samples = []
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        samples.append(tctl())
        time.sleep(0.25)
    return median(samples)


def cmd_fan_autodetect(ctx, d):
    """Ruoli dal comportamento fisico, senza intervento umano (vedi costanti FAN_*)."""
    channels = [n for n in fan_channels(d) if hw_read("%s/fan%d_input" % (d, n)) > 0]
    if not channels:
        raise Err("nessun canale con giri > 0")
    load = None
    if not FAKE:
        try:
            load = subprocess.Popen(["stress-ng", "--cpu", "4", "--quiet"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            raise Err("stress-ng non installato: serve per il carico di prova")
    results = {}
    try:
        pause(10)   # carico a regime
        for n in channels:
            enable, pwm = hw_read("%s/pwm%d_enable" % (d, n)), hw_read("%s/pwm%d" % (d, n))
            rpm0 = hw_read("%s/fan%d_input" % (d, n))
            t0 = tctl_median(5)
            peak, aborted = 0.0, False
            test_pwm = max(FAN_TEST_MIN_PWM, min(FAN_TEST_PWM, int(pwm * 0.6)))
            try:
                hw_write("%s/pwm%d_enable" % (d, n), 1)
                hw_write("%s/pwm%d" % (d, n), test_pwm)
                end = time.monotonic() + (0 if FAKE else FAN_TEST_SEC)
                while True:
                    t = tctl()
                    peak = max(peak, t - t0)
                    if t > FAN_ABORT_TCTL or peak > FAN_ABORT_DT:
                        aborted = True
                        break
                    if time.monotonic() >= end:
                        break
                    time.sleep(0.5)
                rpm1 = hw_read("%s/fan%d_input" % (d, n))
                dt = max(peak, tctl_median(5) - t0) if not aborted else peak
            finally:
                hw_write("%s/pwm%d" % (d, n), pwm)
                hw_write("%s/pwm%d_enable" % (d, n), enable)
            rpm_changed = abs(rpm1 - rpm0) >= FAN_RPM_CHANGE * max(rpm0, 1)
            if aborted or dt >= FAN_PUMP_DT:
                role = "pompa"
            elif not rpm_changed:
                role = "non-controllabile"     # ventola 3 pin o pompa a 12 V fissi: protetto
            elif rpm1 >= FAN_PUMP_RPM:
                role = "pompa"
            elif dt < FAN_FAN_DT:
                role = "ventola"
            else:
                role = "sconosciuto"
            why = "ΔTctl %.1f °C, giri %d→%d al %d%%%s" % (dt, rpm0, rpm1, test_pwm * 100 // 255, ", interrotto" if aborted else "")
            fan_set_role(n, role, why)
            results[n] = {"ruolo": role, "perché": why}
            pause(10)   # torna a regime prima del canale successivo
    finally:
        if load:
            load.terminate()
            load.wait()
    return results


def cmd_fan(ctx, args):
    """fan status | autodetect | identify N | role N pompa|sconosciuto | name N <nome> |
    enable | disable | <N> step <su_ms> <giù_ms> | <N> curve t:pwm …"""
    if not args:
        raise Err("uso: fan status|autodetect|identify N|role N pompa|sconosciuto|name N <nome>|enable|disable|<N> step <su> <giù>|<N> curve t:pwm …")
    if args[0] == "enable":
        return fan_enable(ctx)
    if args[0] == "disable":
        return fan_disable(ctx)
    d = fan_need(fans_dir())
    if args == ["status"]:
        return {"chip": read_text(d + "/name"), "canali": [fan_info(d, n) for n in fan_channels(d)]}
    if args == ["autodetect"]:
        if ctx.get("dry"):
            return {}
        return cmd_fan_autodetect(ctx, d)
    if len(args) == 2 and args[0] == "identify":
        n = to_int(args[1], "canale")
        enable, pwm = hw_read("%s/pwm%d_enable" % (d, n)), hw_read("%s/pwm%d" % (d, n))
        try:
            hw_write("%s/pwm%d_enable" % (d, n), 1)
            hw_write("%s/pwm%d" % (d, n), 255)
            pause(5)
            rpm = hw_read("%s/fan%d_input" % (d, n))
        finally:
            hw_write("%s/pwm%d" % (d, n), pwm)
            hw_write("%s/pwm%d_enable" % (d, n), enable)
        return {"canale": n, "rpm_al_100": rpm}
    if len(args) == 3 and args[0] == "role":
        n = to_int(args[1], "canale")
        if args[2] not in ("pompa", "sconosciuto"):
            raise Err("a mano si può solo declassare: role N pompa|sconosciuto ('ventola' solo da autodetect)")
        fan_set_role(n, args[2], "impostato a mano")
        return {"canale": n, "ruolo": args[2]}
    if len(args) >= 3 and args[0] == "name":
        n = to_int(args[1], "canale")
        s = load_settings()
        s.setdefault("fans", {}).setdefault(str(n), {"role": "sconosciuto"})["name"] = " ".join(args[2:])
        save_settings(s)
        return {"canale": n, "nome": " ".join(args[2:])}
    n = to_int(args[0], "canale")
    if n not in fan_channels(d):
        raise Err("canale %d inesistente (%s)" % (n, ", ".join(str(c) for c in fan_channels(d))))
    if len(args) == 4 and args[1] == "step":
        up, down = to_int(args[2], "step up"), to_int(args[3], "step down")
        check_range("step up", up, 0, FAN_STEP_MAX_MS, " ms")
        check_range("step down", down, 0, FAN_STEP_MAX_MS, " ms")
        fan_require_writable(n)
        if ctx.get("dry"):
            return {"canale": n, "step": [up, down]}
        for attr, v in (("step_up_time", up), ("step_down_time", down)):
            hw_write("%s/pwm%d_%s" % (d, n, attr), v)
            got = hw_read("%s/pwm%d_%s" % (d, n, attr))
            if abs(got - v) > FAN_STEP_TOL_MS:
                raise Err("fan %d %s: scritto %d ma riletto %d" % (n, attr, v, got))
        return {"canale": n, "step": [hw_read("%s/pwm%d_step_up_time" % (d, n)), hw_read("%s/pwm%d_step_down_time" % (d, n))]}
    if len(args) >= 3 and args[1] == "curve":
        pts = []
        for p in args[2:]:
            try:
                t, pw = (int(x) for x in p.split(":"))
            except ValueError:
                raise Err("punto curva '%s': atteso temperatura:pwm (es. 60:150)" % p)
            pts.append((t, pw))
        k = fan_points(d, n)
        if not 1 <= len(pts) <= k:
            raise Err("curva: da 1 a %d punti per il canale %d" % (k, n))
        for i, (t, pw) in enumerate(pts):
            check_range("pwm", pw, FAN_PWM_MIN, 255)
            if i and (t <= pts[i - 1][0] or pw < pts[i - 1][1]):
                raise Err("curva: temperature crescenti e pwm non decrescenti")
        if pts[-1][1] != 255 or pts[-1][0] > FAN_CURVE_LAST_TEMP_MAX:
            raise Err("curva: l'ultimo punto deve essere pwm 255 a <= %d °C" % FAN_CURVE_LAST_TEMP_MAX)
        fan_require_writable(n)
        if ctx.get("dry"):
            return {"canale": n, "curva": ["%d:%d" % p for p in pts]}
        while len(pts) < k:   # punti rimanenti: pieno regime, un grado oltre
            pts.append((pts[-1][0] + 1, 255))
        for i, (t, pw) in enumerate(pts, 1):
            hw_write("%s/pwm%d_auto_point%d_temp" % (d, n, i), t * 1000)
            hw_write("%s/pwm%d_auto_point%d_pwm" % (d, n, i), pw)
        return {"canale": n, "curva": fan_info(d, n)["curva"]}
    raise Err("uso: fan <N> step <su_ms> <giù_ms> | fan <N> curve t:pwm …")


def fan_enable(ctx):
    """Carica nct6775 e lo rende permanente; se il chip non appare, aggiunge il parametro
    kernel acpi_enforce_resources=lax (grubby) e chiede il riavvio."""
    write_atomic(P("/etc/modules-load.d/nct6775.conf"), "nct6775\n")
    out = {"modules-load": True}
    if FAKE:
        FAKE.s["modprobe"] = "nct6775"
        FAKE.save()
    else:
        subprocess.run(["modprobe", "nct6775"], capture_output=True)
    if fans_dir():
        out["chip"] = read_text(fans_dir() + "/name")
        return out
    cmdline = FAKE.s.get("cmdline", "") if FAKE else read_text("/proc/cmdline")
    if "acpi_enforce_resources=lax" in cmdline:
        raise Err("nct6775 caricato ma nessun chip nct67xx in hwmon: Super I/O non raggiungibile via LPC")
    if FAKE:
        FAKE.s["cmdline"] += " acpi_enforce_resources=lax"
        FAKE.save()
        out["grubby"] = True
    elif subprocess.run(["grubby", "--update-kernel=ALL", "--args=acpi_enforce_resources=lax"], capture_output=True).returncode == 0:
        out["grubby"] = True
    else:
        raise Err("conflitto ACPI: aggiungere acpi_enforce_resources=lax alla riga del kernel (GRUB_CMDLINE_LINUX_DEFAULT) e riavviare")
    out["riavvio_necessario"] = True
    return out


def fan_disable(ctx):
    rm(P("/etc/modules-load.d/nct6775.conf"))
    if FAKE:
        FAKE.s["cmdline"] = FAKE.s.get("cmdline", "").replace(" acpi_enforce_resources=lax", "")
        FAKE.save()
    else:
        subprocess.run(["grubby", "--update-kernel=ALL", "--remove-args=acpi_enforce_resources=lax"], capture_output=True)
    return {"modules-load": False, "grubby": False}


def fmt_fan(r):
    if "canali" not in r:
        return json.dumps(r, ensure_ascii=False)
    lines = ["Chip %s" % r["chip"]]
    for c in r["canali"]:
        lines.append("pwm%-2d %-17s %5d giri  pwm %3d  modo %d  step %d/%d ms  curva %s%s" % (
            c["canale"], c.get("role", "sconosciuto") + (" (%s)" % c["name"] if c.get("name") else ""),
            c["rpm"], c["pwm"], c["modo"], c["step_up_ms"], c["step_down_ms"], " ".join(c["curva"]),
            "  [%s]" % c["why"] if c.get("why") else ""))
    return "\n".join(lines)


# ---- hwtest: verifica su hardware automatica e reversibile ------------------------------
def cmd_hwtest(ctx, args):
    """Per ogni comando: un valore poco distante dalla baseline, readback, poi il valore
    baseline. Continua anche se un passo fallisce; alla fine riapplica la baseline."""
    check_cpu()
    base = load_baseline()
    steps = [("co", ["7", str(max(CO_MIN, base["co"][7] - 3))], ["7", str(base["co"][7])]),
             ("fmax", [str(max(FMAX_MIN, base["fmax"] - 200))], [str(base["fmax"])])]
    for key, floor, delta in (("ppt", PPT_MIN, 12), ("tdc", TDC_MIN, 10), ("edc", EDC_MIN, 10), ("tjmax", TJMAX_MIN, 10)):
        if key in base:
            steps.append((key, [str(max(floor, base[key] - delta))], [str(base[key])]))
        else:
            steps.append((key, None, None))
    results = {}
    for key, test, restore in steps:
        if test is None:
            results[key] = "saltato: nessuna baseline (PM table assente)"
            continue
        try:
            run([key] + test, ctx)
            run([key] + restore, ctx)
            results[key] = "ok (%s -> %s)" % (" ".join(test), " ".join(restore))
        except Err as e:
            results[key] = "errore: %s" % e
    try:
        apply_lines(profile_lines("baseline"), ctx)
        rm(marker("active"))
        results["baseline"] = "ripristinata"
    except Err as e:
        results["baseline"] = "errore nel ripristino: %s" % e
    results["esito"] = "ok" if all(v.startswith(("ok", "ripristinata", "saltato")) for v in results.values()) else "FALLITO"
    return results


def fmt_hwtest(r):
    return "\n".join("%-9s %s" % (k, v) for k, v in r.items())


