    assert run(["fan", "enable"])["chip"] == "nct6798" and os.path.exists(P("/etc/modules-load.d/nct6775.conf"))
    run(["fan", "disable"])
    assert not os.path.exists(P("/etc/modules-load.d/nct6775.conf"))
    # baseline con le righe fan dei canali "ventola"; il boot dopo un crash applica comunque le ventole
    run(["use", "f"])
    run(["autostart", "on"])
    reboot()
    hw_write(Fake.FAN_DIR + "/pwm1_step_up_time", 400)
