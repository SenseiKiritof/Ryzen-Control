    run(["unlock", "off"])
    expect_err(["ppt", "163"], "out of range")
    assert run(["ppt", "162"]) == {"ppt": 162.0}     # the baseline value is always allowed
    # failed readback: retry, then baseline restore
    FAKE.s["drop"] = 1
    FAKE.save()
    assert run(["ppt", "150"]) == {"ppt": 150.0}     # first write ignored, second ok
    FAKE.s["drop"] = 2
    FAKE.save()
    expect_err(["ppt", "140"], "restored")
