    assert "fan" in " ".join(" ".join(t) for t in profile_lines("baseline"))
    assert out["applied"]["fan"] == ["fan 1 step 12000 6000"] and hw_read(Fake.FAN_DIR + "/pwm1_step_up_time") == 12000
    reboot()                                           # crash: la parte CPU no, le ventole sì
    out = run(["boot"])
