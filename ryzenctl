#!/usr/bin/python3
"""ryzenctl — helper privilegiato di Ryzen Control (Ryzen 7 9800X3D, Granite Ridge).

Unico punto che parla con l'SMU (driver ryzen_smu) e con le ventole. Stessa grammatica
di comandi per CLI, file profilo e protocollo `serve`. Con RYZENCTL_ROOT impostato usa
un backend finto (stesso del selftest): nessun driver, nessun root.
"""
import fcntl
import json
import os
import re
import struct
import subprocess
import sys
import tempfile
import time
import traceback

# ---- Manopole di calibrazione (tutte qui, non sparpagliarle) -----------------------
CORES = 8                      # 9800X3D: 1 CCD, 8 core, nessun core fuso
GRANITE_RIDGE = 23             # indice codename del driver ryzen_smu
PM_FAMILY = 0x62               # pm_table_version >> 16 — ponytail: euristica famiglia,
                               # mappa misurata solo su 0x620105 (gnr-smu)
PM = {"ppt_limit": 2, "ppt": 3, "tdc_limit": 8, "tdc": 9,
      "thm_limit": 10, "tctl": 11, "edc_limit": 63}   # indici float nella PM table
CO_MIN, CO_MAX = -50, 30       # Curve Optimizer e Curve Shaper
FMAX_MIN, FMAX_UNLOCK_EXTRA = 3000, 200
TJMAX_MIN, TJMAX_ABS_MAX = 60, 95
PPT_MIN, TDC_MIN, EDC_MIN = 45, 30, 45           # W, A, A — mai 0: PPT 0 blocca a 606 MHz
UNLOCK_PPT, UNLOCK_TDC, UNLOCK_EDC = 230, 160, 230
READBACK_TOL = 0.6             # W/A: i limiti tornano come float dalla PM table
READBACK_WAIT = 1.0            # s: l'SMU aggiorna la PM table col suo passo, non subito
READBACK_POLL = 0.02
# Ventole (nct6775). Autodetect: canale al 40 % per 20 s sotto carico; la pompa alza Tctl di
# gradi in secondi, una ventola del radiatore scalda il liquido lentamente.
# ponytail: soglie tarate su un AIO 360; ritoccare se un radiatore piccolo le sfiora.
FAN_TEST_PWM, FAN_TEST_MIN_PWM, FAN_TEST_SEC = 102, 51, 20   # prova al 60 % del pwm attuale, tra 20 % e 40 %
FAN_PUMP_DT, FAN_FAN_DT, FAN_PUMP_RPM = 2.0, 1.0, 1500
FAN_ABORT_TCTL, FAN_ABORT_DT = 80.0, 8.0
FAN_RPM_CHANGE = 0.05          # sotto: il canale non risponde al PWM
FAN_STEP_MAX_MS, FAN_STEP_TOL_MS = 60000, 200
FAN_PWM_MIN, FAN_CURVE_LAST_TEMP_MAX = 51, 125    # 51 = 20 %, minimo delle curve BIOS; 125 = loro ultimo punto
FAN_ROLES = ("ventola", "pompa", "non-controllabile", "sconosciuto")
POWER_PROFILES = ("power-saver", "balanced", "performance")

# ---- Percorsi ------------------------------------------------------------------------
ROOT = os.environ.get("RYZENCTL_ROOT", "")
SMU_DIR = "/sys/kernel/ryzen_smu_drv"
HWMON = "/sys/class/hwmon"
ETC = "/etc/ryzenctl"
STATE = "/var/lib/ryzenctl"
RUN = "/run/ryzenctl"


def P(path):
    return ROOT + path


# ---- Allowlist SMU: nient'altro viene mai inviato ------------------------------------
MP1, RSMU = "mp1_smu_cmd", "rsmu_cmd"
CMD = {
    "co_set": (MP1, 0x35),      # SetDldoPsmMargin: core<<20 | margin&0xFFFF
    "ppt_set": (MP1, 0x3E),     # mW
    "tdc_set": (MP1, 0x3C),     # mA
    "edc_set": (MP1, 0x3D),     # mA
    "co_get": (RSMU, 0xD5),     # GetDldoPsmMargin: arg0 = core<<20
    "fmax_set": (RSMU, 0x70),   # SetBoostLimitFrequencyAllCores, MHz
    "fmax_get": (RSMU, 0x6E),   # GetBoostLimitFrequency
    "tjmax_set": (RSMU, 0x59),  # SetTctlMax, °C
    "shaper_set": (RSMU, 0xA6),  # hi<<24 | med<<16 | lo<<8 | 0x80 | tier
    "shaper_get": (RSMU, 0x84),  # 5 parole, una per tier
}
SMU_STATUS = {0: "WAITING", 1: "OK", 0xFF: "FAILED", 0xFE: "UNKNOWN_CMD",
              0xFD: "REJECTED_PREREQ", 0xFC: "BUSY", 0xFB: "TIMEOUT", 0xFA: "INVALID_ARG",
              0xF9: "UNSUPPORTED_PLATFORM", 0xF8: "BUFFER", 0xF7: "MMAP", 0xF6: "PCI"}


class Err(Exception):
    """Errore riportato all'utente (CLI: stderr + exit 1; serve: {"ok": false})."""


def s8(v):
    return v - 0x100 if v & 0x80 else v


def s16(v):
    v &= 0xFFFF
    return v - 0x10000 if v & 0x8000 else v


def co_arg(core, margin):
    return (core << 20) | (margin & 0xFFFF)


def shaper_arg(tier, lo, med, hi):
    return ((hi & 0xFF) << 24) | ((med & 0xFF) << 16) | ((lo & 0xFF) << 8) | 0x80 | (tier & 0x7F)


def shaper_decode(word):
    return [s8((word >> 8) & 0xFF), s8((word >> 16) & 0xFF), s8((word >> 24) & 0xFF)]


# ---- Trasporto SMU (reale) -----------------------------------------------------------
def read_text(path):
    with open(P(path)) as f:
        return f.read().strip()


def _lock():
    os.makedirs(P(RUN), exist_ok=True)
    fd = os.open(P(RUN + "/lock"), os.O_RDWR | os.O_CREAT, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def smu_raw(mailbox, cmd, args):
    """Una transazione: args → cmd → (stato, args di risposta). smu_args del driver è
    globale: lock obbligatorio."""
    fd = _lock()
    try:
        with open(P(SMU_DIR + "/smu_args"), "wb") as f:
            f.write(struct.pack("<6I", *(list(args) + [0] * (6 - len(args)))))
        with open(P(SMU_DIR + "/" + mailbox), "wb") as f:
            f.write(struct.pack("<I", cmd))
        with open(P(SMU_DIR + "/" + mailbox), "rb") as f:
            status = struct.unpack("<I", f.read(4))[0]
        with open(P(SMU_DIR + "/smu_args"), "rb") as f:
            out = list(struct.unpack("<6I", f.read(24)))
    finally:
        os.close(fd)
    return status, out


def pm_raw():
    """(versione, [float]) oppure (None, None) se il driver non espone la tabella."""
    try:
        with open(P(SMU_DIR + "/pm_table_version"), "rb") as f:
            version = struct.unpack("<I", f.read(4))[0]
        fd = _lock()
        try:
            with open(P(SMU_DIR + "/pm_table"), "rb") as f:
                data = f.read()
        finally:
            os.close(fd)
    except OSError:
        return None, None
    return version, list(struct.unpack("<%df" % (len(data) // 4), data[:len(data) // 4 * 4]))


# ---- Backend finto (selftest, RYZENCTL_ROOT, GUI --mock) -----------------------------
class Fake:
    """Simula SMU, PM table, k10temp e profilo energetico di un 9800X3D. Stato su file
    così più invocazioni CLI lo condividono. `drop` = prossime scritture accettate ma
    ignorate (prova del readback). `log` registra i marker presenti a ogni scrittura."""

    DEFAULT = {"codename": GRANITE_RIDGE, "co": [0] * CORES, "fmax": 5225,
               "ppt": 162.0, "tdc": 120.0, "edc": 180.0, "thm": 95.0,
               "shaper": [0x80 | t for t in range(5)], "tctl": 52.0, "power": "performance",
               "pm_version": 0x620105, "drop": 0, "log": [], "tctl_base": 52.0, "cmdline": "quiet",
               # ventole simulate: 1 ventola radiatore, 2 pompa AIO, 3 ventola 3 pin (non risponde al PWM)
               "fans": {"1": {"kind": "fan", "rpm": 1200}, "2": {"kind": "pump", "rpm": 2800},
                        "3": {"kind": "uncontrollable", "rpm": 900}},
               # autotune simulato: sotto questi CO il core è instabile; boot_id cambia a ogni reboot()
               "co_limits": {"7": -15, "3": -25}, "boot_id": "boot-1"}
    FAN_DIR = HWMON + "/hwmon0"

    def __init__(self):
        self.path = P("/fake_smu.json")
        self.s = json.loads(open(self.path).read() if os.path.exists(self.path) else json.dumps(self.DEFAULT))
        if not os.path.exists(P(self.FAN_DIR + "/name")):
            self._make_hwmon()

    def _make_hwmon(self):
        d = P(self.FAN_DIR)
        os.makedirs(d, exist_ok=True)
        files = {"name": "nct6798"}
        for n, f in self.s["fans"].items():
            files.update({"fan%s_input" % n: f["rpm"], "pwm%s" % n: 153, "pwm%s_enable" % n: 5,
                          "pwm%s_step_up_time" % n: 400, "pwm%s_step_down_time" % n: 400})
            for k, (t, pw) in enumerate(((40, 77), (50, 110), (60, 150), (70, 200), (80, 255)), 1):
                files["pwm%s_auto_point%d_temp" % (n, k)] = t * 1000
                files["pwm%s_auto_point%d_pwm" % (n, k)] = pw
        for name, v in files.items():
            with open("%s/%s" % (d, name), "w") as fh:
                fh.write(str(v))

    def after_fan_write(self, path, value):
        """Fisica finta: in manuale la ventola segue il PWM e scalda poco, la pompa rallentata
        alza Tctl di 5 °C, il canale 3 pin ignora il PWM."""
        m = re.search(r"/pwm(\d+)(_enable)?$", path)
        if not m:
            return
        n = m.group(1)
        kind = self.s["fans"][n]["kind"]
        d = P(self.FAN_DIR)
        enable = int(open("%s/pwm%s_enable" % (d, n)).read())
        pwm = int(open("%s/pwm%s" % (d, n)).read())
        rpm, tctl_now = self.s["fans"][n]["rpm"], self.s["tctl_base"]
        if enable == 1 and kind == "fan":
            rpm, tctl_now = int(1500 * pwm / 255), self.s["tctl_base"] + (0.3 if pwm < 200 else 0)
        elif enable == 1 and kind == "pump":
            rpm, tctl_now = 1500 + int(1300 * pwm / 255), self.s["tctl_base"] + (5.0 if pwm < 200 else 0)
        with open("%s/fan%s_input" % (d, n), "w") as fh:
            fh.write(str(rpm))
        self.s["tctl"] = tctl_now
        self.save()

    def save(self):
        write_atomic(self.path, json.dumps(self.s))

    def _write(self, apply):
        self.s["log"].append({"dirty": os.path.exists(P(STATE + "/dirty")),
                              "active": os.path.exists(P(STATE + "/active"))})
        if self.s["drop"] > 0:
            self.s["drop"] -= 1
        else:
            apply()
        self.save()

    def smu(self, mailbox, cmd, args):
        a = args[0] if args else 0
        s = self.s
        if (mailbox, cmd) == CMD["co_set"]:
            self._write(lambda: s["co"].__setitem__((a >> 20) & 0xF, s16(a)))
        elif (mailbox, cmd) in (CMD["ppt_set"], CMD["tdc_set"], CMD["edc_set"]):
            key = {CMD["ppt_set"]: "ppt", CMD["tdc_set"]: "tdc", CMD["edc_set"]: "edc"}[(mailbox, cmd)]
            self._write(lambda: s.__setitem__(key, a / 1000.0))
        elif (mailbox, cmd) == CMD["co_get"]:
            return 1, [s["co"][(a >> 20) & 0xF] & 0xFFFFFFFF, 0, 0, 0, 0, 0]
        elif (mailbox, cmd) == CMD["fmax_set"]:
            self._write(lambda: s.__setitem__("fmax", a & 0xFFFFF))
        elif (mailbox, cmd) == CMD["fmax_get"]:
            return 1, [s["fmax"], 0, 0, 0, 0, 0]
        elif (mailbox, cmd) == CMD["tjmax_set"]:
            self._write(lambda: s.__setitem__("thm", float(a)))
        elif (mailbox, cmd) == CMD["shaper_set"]:
            self._write(lambda: s["shaper"].__setitem__(a & 0x7F, a))
        elif (mailbox, cmd) == CMD["shaper_get"]:
            return 1, list(s["shaper"]) + [0]
        else:
            return 0xFE, [0] * 6
        return 1, [0] * 6

    def load_ok(self, args):
        """Carico simulato: fallisce se un core testato è sotto la sua soglia di stabilità."""
        cores = [int(args[args.index("--taskset") + 1])] if "--taskset" in args else range(CORES)
        return all(self.s["co"][c] >= self.s.get("co_limits", {}).get(str(c), -100) for c in cores)

    def bench(self, threads):
        """(bogo-ops/s, W) simulati: multi-thread satura con il PPT, single-thread segue FMax."""
        import math
        if threads > 1:
            return round(1000 * (1 - math.exp(-self.s["ppt"] / 50)), 1), round(self.s["ppt"] * 0.9, 1)
        return round(self.s["fmax"] / 5.0, 1), 45.0

    def peak_tctl(self):
        """Picco Tctl sotto raffica: 60 °C a 4000 MHz, +20 °C ogni 1250 MHz."""
        return round(60 + (self.s["fmax"] - 4000) / 1250 * 20, 1)

    def pm(self):
        s = self.s
        if not s["pm_version"]:
            return None, None
        t = [0.0] * 457
        t[PM["ppt_limit"]], t[PM["ppt"]] = s["ppt"], 61.0
        t[PM["tdc_limit"]], t[PM["tdc"]] = s["tdc"], 23.0
        t[PM["thm_limit"]], t[PM["tctl"]] = s["thm"], s["tctl"]
        t[PM["edc_limit"]] = s["edc"]
        return s["pm_version"], t


FAKE = Fake() if ROOT else None


def smu(name, *args):
    mailbox, cmd = CMD[name]
    status, out = FAKE.smu(mailbox, cmd, args) if FAKE else smu_raw(mailbox, cmd, args)
    if status != 1:
        hint = " (PBO disabilitato nel BIOS? impostarlo su Advanced/Motherboard)" if status == 0xFD else ""
        raise Err("SMU %s 0x%02X: %s%s" % (mailbox, cmd, SMU_STATUS.get(status, hex(status)), hint))
    return out


def pm_table():
    version, t = FAKE.pm() if FAKE else pm_raw()
    if version is None or (version >> 16) != PM_FAMILY:
        return None, None
    return version, t


def check_cpu():
    try:
        code = int(FAKE.s["codename"]) if FAKE else int(read_text(SMU_DIR + "/codename"))
    except (OSError, ValueError):
        raise Err("driver ryzen_smu non caricato (%s)" % P(SMU_DIR))
    if code != GRANITE_RIDGE:
        raise Err("CPU non supportata (codename %d, atteso Granite Ridge %d)" % (code, GRANITE_RIDGE))


def tctl():
    if FAKE:
        return FAKE.s["tctl"]
    for d in sorted(os.listdir(P(HWMON))):
        try:
            if read_text("%s/%s/name" % (HWMON, d)) == "k10temp":
                return int(read_text("%s/%s/temp1_input" % (HWMON, d))) / 1000.0
        except OSError:
            pass
    return None


def power_get():
    if FAKE:
        return FAKE.s["power"]
    r = subprocess.run(["busctl", "get-property", "net.hadess.PowerProfiles",
                        "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles", "ActiveProfile"],
                       capture_output=True, text=True)
    if r.returncode == 0:
        return r.stdout.split('"')[1]
    try:  # nessun demone: EPP di cpu0
        epp = read_text("/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference")
        return {"power": "power-saver", "performance": "performance"}.get(epp, "balanced")
    except OSError:
        return None


def power_set(profile):
    if FAKE:
        FAKE.s["power"] = profile
        FAKE.save()
        return
    r = subprocess.run(["busctl", "set-property", "net.hadess.PowerProfiles",
                        "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles", "ActiveProfile",
                        "s", profile], capture_output=True, text=True)
    if r.returncode == 0:
        return
    epp = {"power-saver": "power", "balanced": "balance_performance", "performance": "performance"}[profile]
    cpus = P("/sys/devices/system/cpu")
    for d in os.listdir(cpus):
        f = "%s/%s/cpufreq/energy_performance_preference" % (cpus, d)
        if d.startswith("cpu") and d[3:].isdigit() and os.path.exists(f):
            with open(f, "w") as fh:
                fh.write(epp)


# ---- File di stato (scritture atomiche) ----------------------------------------------
def write_atomic(path, text):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d)
    with os.fdopen(fd, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    os.chmod(path, 0o644)
    dfd = os.open(d, os.O_RDONLY)
    os.fsync(dfd)
    os.close(dfd)


def touch_sync(path):
    write_atomic(path, "")


def load_settings():
    s = {"autostart": False, "profile": None, "unlock": False, "fans": {}}
    try:
        s.update(json.loads(open(P(ETC + "/settings.json")).read()))
    except (OSError, ValueError):
        pass
    return s


def save_settings(s):
    write_atomic(P(ETC + "/settings.json"), json.dumps(s, indent=1))


def parse_lines(text):
    """Righe-comando di profilo/baseline → liste di token. `#` commenta."""
    out = []
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if line:
            out.append(line.split())
    return out


def values_from_lines(lines):
    """Interpreta le righe come stato: {"co": [...], "ppt": 162, "shaper": {tier: [...]}, ...}."""
    v = {"shaper": {}}
    for t in lines:
        if t[0] == "co" and len(t) == CORES + 1:
            v["co"] = [int(x) for x in t[1:]]
        elif t[0] in ("ppt", "tdc", "edc", "fmax", "tjmax") and len(t) == 2:
            v[t[0]] = int(t[1])
        elif t[0] == "shaper" and len(t) == 5:
            v["shaper"][int(t[1])] = [int(x) for x in t[2:]]
        elif t[0] == "power" and len(t) == 2:
            v["power"] = t[1]
    return v


# ---- Letture di stato CPU ------------------------------------------------------------
def read_co():
    return [s16(smu("co_get", core << 20)[0]) for core in range(CORES)]


def read_fmax():
    return smu("fmax_get")[0]


def read_shaper():
    return [shaper_decode(w) for w in smu("shaper_get")[:5]]


def read_limits():
    """Limiti e valori istantanei dalla PM table; {} se la tabella non c'è."""
    version, t = pm_table()
    if t is None:
        return {}
    return {k: round(t[i], 1) for k, i in PM.items()}


def capture_lines():
    """Stato corrente nel formato profilo (la baseline è un profilo come gli altri)."""
    lim = read_limits()
    lines = ["co " + " ".join(str(v) for v in read_co()), "fmax %d" % read_fmax()]
    for key, pm_key in (("ppt", "ppt_limit"), ("tdc", "tdc_limit"), ("edc", "edc_limit"), ("tjmax", "thm_limit")):
        if pm_key in lim:
            lines.append("%s %d" % (key, round(lim[pm_key])))
    # Curve Shaper escluso: sul 9800X3D (SMU 98.81.0) 0xA6 risponde OK ma 0x84 non cambia,
    # quindi non è verificabile; resta solo come comando sperimentale (`shaper probe`).
    power = power_get()
    if power:
        lines.append("power " + power)
    lines += fan_capture_lines()   # solo canali già classificati "ventola"
    return lines


# ---- Baseline e tetti -------------------------------------------------------------------
def cmd_baseline(ctx, args):
    """`baseline`: cattura lo stato attuale come baseline di questo boot (solo se nessuna
    scrittura è già avvenuta). `baseline show`: la stampa."""
    if args == ["show"]:
        return load_baseline(strict=False)
    if args:
        raise Err("uso: baseline [show]")
    check_cpu()
    if os.path.exists(P(STATE + "/active")):
        raise Err("baseline non catturata: stato CPU già modificato in questo boot")
    lines = capture_lines()
    write_atomic(P(STATE + "/baseline.conf"), "# baseline catturata da ryzenctl\n" + "\n".join(lines) + "\n")
    touch_sync(P(RUN + "/baseline-done"))
    return values_from_lines(parse_lines("\n".join(lines)))


def load_baseline(strict=True):
    """Valori baseline. strict: deve essere stata catturata in QUESTO boot."""
    try:
        text = open(P(STATE + "/baseline.conf")).read()
    except OSError:
        raise Err("baseline assente: scritture CPU rifiutate (il servizio ryzenctl non ha girato?)")
    if strict and not os.path.exists(P(RUN + "/baseline-done")):
        raise Err("baseline non catturata in questo boot: scritture CPU rifiutate")
    return values_from_lines(parse_lines(text))


def cap_of(base, key, unlock):
    if key not in base:
        raise Err("nessuna baseline per %s (PM table assente?): scrittura rifiutata" % key)
    if key == "tjmax":
        return min(base[key], TJMAX_ABS_MAX)
    if key == "fmax":
        return base[key] + (FMAX_UNLOCK_EXTRA if unlock else 0)
    hard = {"ppt": UNLOCK_PPT, "tdc": UNLOCK_TDC, "edc": UNLOCK_EDC}[key]
    return max(base[key], hard) if unlock else base[key]


def check_range(name, v, lo, hi, unit=""):
    if not lo <= v <= hi:
        raise Err("%s %d%s fuori dal consentito %d..%d%s" % (name, v, unit, lo, hi, unit))


def to_int(s, name):
    try:
        return int(s)
    except ValueError:
        raise Err("%s: '%s' non è un intero" % (name, s))


# ---- Scrittura con readback e ripristino -----------------------------------------------
def write_verify(ctx, name, value, write, read, base_value, equal=lambda a, b: a == b):
    """Scrive, rilegge, ripete una volta, altrimenti ripristina la baseline ed errore.
    Il marker `active` precede la prima scrittura SMU (crash-guard)."""
    if ctx.get("dry"):
        return value
    if not equal(base_value, value):
        touch_sync(P(STATE + "/active"))
    wait = 0.05 if FAKE else READBACK_WAIT
    for _ in range(2):
        write(value)
        deadline = time.monotonic() + wait
        while True:
            got = read()
            if equal(got, value) or time.monotonic() >= deadline:
                break
            time.sleep(READBACK_POLL)
        if equal(got, value):
            return got
    if base_value is not None:
        write(base_value)
    raise Err("%s: scritto %s ma riletto %s; ripristinato %s" % (name, value, got, base_value))


def near(a, b):
    return a is not None and b is not None and abs(a - b) <= READBACK_TOL


def limit_setter(key, pm_key, cmd_name, unit, lo):
    def cmd(ctx, args):
        if len(args) != 1:
            raise Err("uso: %s <%s>" % (key, unit))
        v = to_int(args[0], key)
        check_cpu()
        s = load_settings()
        base = load_baseline()
        check_range(key, v, lo, cap_of(base, key, s["unlock"]), " " + unit)
        if not read_limits():
            raise Err("PM table assente: impossibile verificare %s, scrittura rifiutata" % key)
        scale = 1 if key == "tjmax" else 1000
        got = write_verify(ctx, key, float(v), lambda x: smu(cmd_name, int(x * scale)),
                           lambda: read_limits().get(pm_key), float(base[key]), near)
        return {key: got}
    return cmd


def cmd_co(ctx, args):
    """`co <core> <v>` | `co all <v>` | `co v0 … v7`."""
    if len(args) == CORES:
        wanted = {c: to_int(x, "co") for c, x in enumerate(args)}
    elif len(args) == 2 and args[0] == "all":
        wanted = {c: to_int(args[1], "co") for c in range(CORES)}
    elif len(args) == 2:
        core = to_int(args[0], "core")
        check_range("core", core, 0, CORES - 1)
        wanted = {core: to_int(args[1], "co")}
    else:
        raise Err("uso: co <core|all> <valore> | co v0 … v%d" % (CORES - 1))
    for v in wanted.values():
        check_range("co", v, CO_MIN, CO_MAX)
    check_cpu()
    base = load_baseline()
    for core, v in wanted.items():
        write_verify(ctx, "co core %d" % core, v, lambda x, c=core: smu("co_set", co_arg(c, x)),
                     lambda c=core: read_co()[c], base["co"][core])
    return {"co": None if ctx.get("dry") else read_co()}


