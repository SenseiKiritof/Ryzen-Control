def caps(base, unlock):
    """Intervalli ammessi (min, max) per la GUI: stessa logica di cap_of."""
    out = {"co": [CO_MIN, CO_MAX], "fan_step_ms": [0, FAN_STEP_MAX_MS], "fan_step_tol_ms": FAN_STEP_TOL_MS}
    for key, lo in (("ppt", PPT_MIN), ("tdc", TDC_MIN), ("edc", EDC_MIN), ("fmax", FMAX_MIN), ("tjmax", TJMAX_MIN)):
        if key in base:
            out[key] = [lo, cap_of(base, key, unlock)]
    return out


PM_CORE_TEMP = 317   # 0x620105: temperature per core d[317..324] (gnr-smu, CONFIRMED)
PM_CORE_VOLT = 309   # 0x620105: tensione per core d[309..316] (gnr-smu, CONFIRMED)
PM_CORE_MHZ = 325    # 0x620105: frequenza per core d[325..332] (gnr-smu, CONFIRMED)


def sample_cores():
    """Tensione (V) e frequenza (MHz) per core dalla PM table, solo 0x620105; altrimenti None."""
    if FAKE:
        return {"volt": [round(1.25 + c * 0.003, 3) for c in FAKE.s["co"]], "mhz": [FAKE.s["fmax"] - 50] * CORES}
    version, t = pm_table()
    if t is None or version != 0x620105 or len(t) <= PM_CORE_MHZ + CORES:
        return None
    return {"volt": [round(t[PM_CORE_VOLT + c], 3) for c in range(CORES)],
            "mhz": [int(t[PM_CORE_MHZ + c] * 1000) if t[PM_CORE_MHZ + c] < 100 else int(t[PM_CORE_MHZ + c]) for c in range(CORES)]}


def cmd_telemetry(ctx, args):
    """Letture rapide per il monitor della GUI (1 Hz): niente scritture."""
    check_cpu()
    version, t = pm_table()
    lim = read_limits()
    cores = []
    for c in range(CORES):
        try:
            mhz = int(read_text("/sys/devices/system/cpu/cpu%d/cpufreq/scaling_cur_freq" % c)) // 1000
        except (OSError, ValueError):
            mhz = 3000 + c * 100 if FAKE else None
        temp = round(t[PM_CORE_TEMP + c], 1) if t is not None and version == 0x620105 and len(t) > PM_CORE_TEMP + c else None
        cores.append({"mhz": mhz, "temp": temp})
    co = read_co()
    sample = sample_cores()
    for c in range(CORES):
        cores[c]["co"] = co[c]
        cores[c]["volt"] = sample["volt"][c] if sample else None
    tccd = None
    if FAKE:
        tccd = round(FAKE.s["tctl"] - 15, 1)
    else:
        for d in sorted(os.listdir(P(HWMON))):
            try:
                if read_text("%s/%s/name" % (HWMON, d)) == "k10temp":
                    tccd = int(read_text("%s/%s/temp3_input" % (HWMON, d))) / 1000.0
            except OSError:
                pass
    fans = []
    fd = fans_dir()
    if fd:
        for n in fan_channels(fd):
            rpm = hw_read("%s/fan%d_input" % (fd, n))
            if rpm > 0 or fan_role(n) != "sconosciuto":
                info = fan_roles().get(str(n), {})
                fans.append({"canale": n, "rpm": rpm, "role": info.get("role", "sconosciuto"), "name": info.get("name")})
    return {"tctl": tctl(), "tccd": tccd, "ppt": lim.get("ppt"), "ppt_limit": lim.get("ppt_limit"),
            "tdc": lim.get("tdc"), "tdc_limit": lim.get("tdc_limit"), "edc_limit": lim.get("edc_limit"),
            "tjmax": lim.get("thm_limit"), "fmax": read_fmax(), "cores": cores, "fans": fans, "power": power_get()}


def fmt_status(st):
