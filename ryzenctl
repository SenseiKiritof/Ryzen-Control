    assert run(["profile", "save", "quiet", "ppt 150", "co all -10", "# commento", "fmax 5000", "power balanced"])["lines"] == 4
    assert run(["profile", "list"]) == {"profiles": ["quiet"], "active": None}
    assert run(["profile", "show", "quiet"])["lines"][0] == "ppt 150"
    expect_err(["apply", "nope"], "inesistente")
    expect_err(["autostart", "on"], "nessun profilo")
    assert run(["use", "quiet"]) == {"profile": "quiet"}

    # ---- crash-guard ----
    def reboot():
        """Riavvio simulato: /run svuotato, SMU torna ai valori BIOS."""
        for f in os.listdir(P(RUN)):
            os.remove(P(RUN + "/" + f))
        FAKE.s.update({k: Fake.DEFAULT[k] for k in ("co", "fmax", "ppt", "tdc", "edc", "thm", "shaper")})
        FAKE.s["co"] = list(Fake.DEFAULT["co"])
        FAKE.s["shaper"] = list(Fake.DEFAULT["shaper"])
        FAKE.save()
        FAKE._make_hwmon()                             # il BIOS riprogramma la SmartFan a ogni boot
        FAKE.s["boot_id"] = "boot-%d" % (int(FAKE.s["boot_id"].split("-")[1]) + 1)
        FAKE.save()

    def exists(name):
        return os.path.exists(marker(name))

    # 1. primo boot (dirty mai esistito): marker a posto, nulla applicato
    reboot()
    out = run(["boot"])
