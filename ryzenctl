# readback ID (Zen2Settings marks GetDldoPsmMargin 0x7C "Not sure") and no FMax set command;
# Matisse (Ryzen 3000, 4) has no Curve Optimizer. Both need a verified PM table map for the limits.
SMU_STATUS = {0: "WAITING", 1: "OK", 0xFF: "FAILED", 0xFE: "UNKNOWN_CMD",
              0xFD: "REJECTED_PREREQ", 0xFC: "BUSY", 0xFB: "TIMEOUT", 0xFA: "INVALID_ARG",
              0xF9: "UNSUPPORTED_PLATFORM", 0xF8: "BUFFER", 0xF7: "MMAP", 0xF6: "PCI"}


class Err(Exception):
    """Error reported to the user (CLI: stderr + exit 1; serve: {"ok": false})."""


def s8(v):
    return v - 0x100 if v & 0x80 else v


def s16(v):
    v &= 0xFFFF
    return v - 0x10000 if v & 0x8000 else v


def co_mask(core):
    """SMU mask of active core `core` (index in TOPO): (physical CCD << 28) | (slot in the CCD << 20), as
    ZenStates-Core's MakeCoreMask (one CCX per CCD from Zen 3 on). The slot is the physical position of
    the core among the 8 of its CCD, from core_map()."""
    ccd, slot = core_map()[core]
    return (ccd << 28) | (slot << 20)


_CORE_MAP = []   # computed once per process: [(physical ccd, slot)] per active core, or None


def core_map():
    """Physical (CCD, slot) of every active core, or None when it cannot be known for sure.
    Linux lists only the enabled cores, in the order of their slots, grouped by CCD (sysfs core_id // 8).
    With every CCD complete (8 cores) the slots are 0–7 in order and no register is read (9800X3D,
    9950X). With disabled cores the firmware skips their slots, so the enabled slots come from the
    core fuses read through SMN (read-only, addresses of the family entry), and the result is used
    only if the fuses agree with the topology (same CCD count, same cores per CCD)."""
    if _CORE_MAP:
        return _CORE_MAP[0]
    groups = {}
    for i, (cid, _cpus) in enumerate(TOPO):
        groups.setdefault(cid // 8, []).append(i)
    if all(len(g) == 8 for g in groups.values()) and sorted(groups) == list(range(len(groups))):
        result = [None] * CORES
        for ccd, idxs in groups.items():
            for i in idxs:
                result[i] = (ccd, TOPO[i][0] % 8)
    else:
        result = fused_core_map(groups)
    _CORE_MAP.append(result)
    return result


def fused_core_map(groups):
    """Core map of CCDs with disabled cores from the CCD and core fuses (ZenStates-Core layout), or None."""
    fz = family().get("fuses")
    if not fz:
        return None
    try:
        present, down = smn_read(fz["ccd"][0]), smn_read(fz["ccd"][1])
        if present == 0xFFFFFFFF:
            return None
        ccd_down = ((present >> 30) & 3) | ((down & 0x3F) << 2)
        physical = [b for b in range(2) if ((present >> 22) & 3) & ~ccd_down >> b & 1]   # CCD0/1 present, not down
        if len(physical) != len(groups):
            return None
        result = [None] * CORES
        for (_lccd, idxs), pccd in zip(sorted(groups.items()), physical):
            disabled = smn_read(fz["core"] + fz["stride"] * pccd) & 0xFF
            slots = [s for s in range(8) if not disabled >> s & 1]
            if len(slots) != len(idxs):
                return None
            for i, slot in zip(sorted(idxs, key=lambda i: TOPO[i][0]), slots):
                result[i] = (pccd, slot)
        return result
    except (OSError, struct.error):
        return None


def smn_read(addr):
    """One SMN register read through the driver: writing 4 bytes (the address) reads it, 8 bytes would
    write it and are never sent. Only the fuse addresses of the family entry are allowed."""
    fz = family().get("fuses") or {}
    allowed = set(fz.get("ccd", ())) | {fz["core"] + fz["stride"] * c for c in range(2)} if fz else set()
    if addr not in allowed:
        raise Err(_("SMN read of 0x%08X not allowed") % addr)
    if FAKE:
        return FAKE.smn(addr)
    fd = _lock()
    try:
        with open(P(SMU_DIR + "/smn"), "wb", buffering=0) as f:
            if f.write(struct.pack("<I", addr)) != 4:
                raise OSError("short SMN write")
        with open(P(SMU_DIR + "/smn"), "rb") as f:
            return struct.unpack("<I", f.read(4))[0]
    finally:
        os.close(fd)


def co_arg(core, margin):
    return co_mask(core) | (margin & 0xFFFF)


def shaper_arg(tier, lo, med, hi):
    return ((hi & 0xFF) << 24) | ((med & 0xFF) << 16) | ((lo & 0xFF) << 8) | 0x80 | (tier & 0x7F)


def shaper_decode(word):
    return [s8((word >> 8) & 0xFF), s8((word >> 16) & 0xFF), s8((word >> 24) & 0xFF)]


# ---- SMU transport (real) ------------------------------------------------------------
def read_text(path):
    with open(P(path)) as f:
        return f.read().strip()


def _lock():
    os.makedirs(P(RUN), exist_ok=True)
    fd = os.open(P(RUN + "/lock"), os.O_RDWR | os.O_CREAT, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def smu_raw(mailbox, cmd, args):
    """One transaction: args → cmd → (status, reply args). The driver's smu_args is
    global: lock required."""
    fd = _lock()
    try:
        with open(P(SMU_DIR + "/smu_args"), "wb") as f:
            f.write(struct.pack("<6I", *(list(args) + [0] * (6 - len(args)))))
        with open(P(SMU_DIR + "/" + mailbox), "wb") as f:
            f.write(struct.pack("<I", cmd))
        with open(P(SMU_DIR + "/" + mailbox), "rb") as f:
            status = struct.unpack("<I", f.read(4))[0]
        with open(P(SMU_DIR + "/smu_args"), "rb") as f:
            out = list(struct.unpack("<6I", f.read(24)))
    finally:
        os.close(fd)
    return status, out


def pm_raw():
    """(version, [float]) or (None, None) if the driver does not expose the table."""
    try:
        with open(P(SMU_DIR + "/pm_table_version"), "rb") as f:
            version = struct.unpack("<I", f.read(4))[0]
        fd = _lock()
        try:
            with open(P(SMU_DIR + "/pm_table"), "rb") as f:
                data = f.read()
        finally:
            os.close(fd)
    except OSError:
        return None, None
    return version, list(struct.unpack("<%df" % (len(data) // 4), data[:len(data) // 4 * 4]))


# ---- Fake backend (selftest, RYZENCTL_ROOT, GUI --mock) ------------------------------
class Fake:
    """Simulates the SMU, PM table, topology, k10temp and power profile of a CPU of the variant
    in RYZENCTL_FAKE_FAMILY (default: a 9800X3D). State on file so that several CLI invocations
    share it. `drop` = next writes accepted but ignored (readback test). `log` records the
    markers present at each write."""

    VARIANTS = {"granite": {"codename": 23, "cores": 8, "ccds": 1, "pm_version": 0x620105},      # 9800X3D
                "granite16": {"codename": 23, "cores": 16, "ccds": 2, "pm_version": 0x620205},   # 9950X: 2 CCDs
                "nopm": {"codename": 23, "cores": 8, "ccds": 1, "pm_version": 0},               # no PM table
                "granite12": {"codename": 23, "cores": 12, "ccds": 2, "pm_version": 0x620205,   # 9900X: 2 CCDs × 6
                              "disabled": [[2, 5], [0, 7]]},   # disabled slots of each CCD (core fuses)
                "fusebad": {"codename": 23, "cores": 12, "ccds": 2, "pm_version": 0x620205,    # fuses that contradict
                            "disabled": [[2], [0, 7]]},   # the topology (7 + 6 slots for 6 + 6 cores): no per-core CO
                "raphael": {"codename": 20, "cores": 8, "ccds": 1, "pm_version": 0x540104}}     # 7700X
    FAN_DIR = HWMON + "/hwmon0"

    def __init__(self, variant=None):
        v = self.VARIANTS[variant or os.environ.get("RYZENCTL_FAKE_FAMILY") or "granite"]
        per = v["cores"] // v["ccds"]
        self.cids = [(c // per) * 8 + c % per for c in range(v["cores"])]   # sysfs core_id: CCD n starts at 8n
        self.disabled = v.get("disabled", [[] for _ccd in range(v["ccds"])])
        # physical (ccd, slot) of each core: the firmware skips the disabled slots, Linux numbers the rest in order
        self.slots = [(ccd, s) for ccd in range(v["ccds"]) for s in range(8) if s not in self.disabled[ccd]]
        self.default = {"codename": v["codename"], "co": [0] * v["cores"], "fmax": 5225,
                        "ppt": 162.0, "tdc": 120.0, "edc": 180.0, "thm": 95.0,
                        "shaper": [0x80 | t for t in range(5)], "tctl": 52.0, "power": "performance",
                        "pm_version": v["pm_version"], "drop": 0, "log": [], "tctl_base": 52.0, "cmdline": "quiet",
                        # simulated fans: 1 radiator fan, 2 AIO pump, 3 3-pin fan (does not respond to the PWM)
                        "fans": {"1": {"kind": "fan", "rpm": 1200}, "2": {"kind": "pump", "rpm": 2800},
                                 "3": {"kind": "uncontrollable", "rpm": 900}},
                        # simulated autotune: below these CO values the core is unstable; boot_id changes at each reboot()
                        "co_limits": {"7": -15, "3": -25}, "boot_id": "boot-1"}
        self.path = P("/fake_smu.json")
        self.s = json.loads(open(self.path).read() if os.path.exists(self.path) else json.dumps(self.default))
        if not os.path.exists(P(self.FAN_DIR + "/name")):
            self._make_hwmon()
        if not os.path.exists(P("/sys/devices/system/cpu/cpu0")):
            for c, cid in enumerate(self.cids):   # both SMT threads: cpuN and cpuN+cores
                for cpu in (c, c + len(self.cids)):
                    d = P("/sys/devices/system/cpu/cpu%d/topology" % cpu)
                    os.makedirs(d, exist_ok=True)
                    with open(d + "/core_id", "w") as fh:
                        fh.write(str(cid))

    def core(self, mask):
        """Core index addressed by an SMU core mask, or None: a wrong mask (8 << 20 on two CCDs, the slot
        of a disabled core) is answered OK by a real SMU and does nothing."""
        ccd, ccx, slot = (mask >> 28) & 0xF, (mask >> 24) & 0xF, (mask >> 20) & 0xF
        return self.slots.index((ccd, slot)) if ccx == 0 and (ccd, slot) in self.slots else None

    def smn(self, addr):
        """The CCD and core fuse registers of the family (ZenStates-Core layout)."""
        fz = FAMILIES[self.s["codename"]]["fuses"]
        ccds = len(self.disabled)
        if addr == fz["ccd"][0]:
            return ((1 << ccds) - 1) << 22          # CCD0/1 present, none down
        if addr == fz["ccd"][1]:
            return 0
        ccd = (addr - fz["core"]) // fz["stride"]
        return sum(1 << s for s in self.disabled[ccd]) if 0 <= ccd < ccds else 0xFFFFFFFF

    def _make_hwmon(self):
        d = P(self.FAN_DIR)
        os.makedirs(d, exist_ok=True)
        files = {"name": "nct6798"}
        for n, f in self.s["fans"].items():
            files.update({"fan%s_input" % n: f["rpm"], "pwm%s" % n: 153, "pwm%s_enable" % n: 5,
                          "pwm%s_step_up_time" % n: 400, "pwm%s_step_down_time" % n: 400})
            for k, (t, pw) in enumerate(((40, 77), (50, 110), (60, 150), (70, 200), (80, 255)), 1):
                files["pwm%s_auto_point%d_temp" % (n, k)] = t * 1000
                files["pwm%s_auto_point%d_pwm" % (n, k)] = pw
        for name, v in files.items():
            with open("%s/%s" % (d, name), "w") as fh:
                fh.write(str(v))

    def after_fan_write(self, path, value):
        """Fake physics: in manual mode the fan follows the PWM and warms little, the slowed-down
        pump raises Tctl by 5 °C, the 3-pin channel ignores the PWM."""
        if re.search(r"/pwm\d+_step_(up|down)_time$", path) and value < FAN_STEP_MIN_MS:   # like nct6775: minimum register 1
            with open(P(path), "w") as f:
                f.write(str(FAN_STEP_MIN_MS))
            return
        m = re.search(r"/pwm(\d+)(_enable)?$", path)
        if not m:
            return
        n = m.group(1)
        kind = self.s["fans"][n]["kind"]
        d = P(self.FAN_DIR)
        enable = int(open("%s/pwm%s_enable" % (d, n)).read())
        pwm = int(open("%s/pwm%s" % (d, n)).read())
        rpm, tctl_now = self.s["fans"][n]["rpm"], self.s["tctl_base"]
        if enable == 1 and kind == "fan":
            rpm, tctl_now = int(1500 * pwm / 255), self.s["tctl_base"] + (0.3 if pwm < 200 else 0)
        elif enable == 1 and kind == "pump":
            rpm, tctl_now = 1500 + int(1300 * pwm / 255), self.s["tctl_base"] + (5.0 if pwm < 200 else 0)
        with open("%s/fan%s_input" % (d, n), "w") as fh:
            fh.write(str(rpm))
        self.s["tctl"] = tctl_now
        self.save()

    def save(self):
        write_atomic(self.path, json.dumps(self.s))

    def _write(self, apply):
        self.s["log"].append({"dirty": os.path.exists(P(STATE + "/dirty")),
                              "active": os.path.exists(P(STATE + "/active"))})
        if self.s["drop"] > 0:
            self.s["drop"] -= 1
        else:
            apply()
        self.save()

    def smu(self, mailbox, cmd, args):
        a = args[0] if args else 0
        s = self.s
        CMD = FAMILIES[s["codename"]]["cmd"]
        if (mailbox, cmd) == CMD["co_set"]:
            c = self.core(a)
            self._write(lambda: c is not None and s["co"].__setitem__(c, s16(a)))
        elif (mailbox, cmd) in (CMD["ppt_set"], CMD["tdc_set"], CMD["edc_set"]):
            key = {CMD["ppt_set"]: "ppt", CMD["tdc_set"]: "tdc", CMD["edc_set"]: "edc"}[(mailbox, cmd)]
            self._write(lambda: s.__setitem__(key, a / 1000.0))
        elif (mailbox, cmd) == CMD["co_get"]:
            c = self.core(a)
            return 1, [(s["co"][c] if c is not None else 0) & 0xFFFFFFFF, 0, 0, 0, 0, 0]
        elif (mailbox, cmd) == CMD["fmax_set"]:
            self._write(lambda: s.__setitem__("fmax", a & 0xFFFFF))
        elif (mailbox, cmd) == CMD["fmax_get"]:
            return 1, [s["fmax"], 0, 0, 0, 0, 0]
        elif (mailbox, cmd) == CMD["tjmax_set"]:
            self._write(lambda: s.__setitem__("thm", float(a)))
        elif (mailbox, cmd) == CMD["shaper_set"]:
            self._write(lambda: s["shaper"].__setitem__(a & 0x7F, a))
        elif (mailbox, cmd) == CMD["shaper_get"]:
            return 1, list(s["shaper"]) + [0]
        else:
            return 0xFE, [0] * 6
        return 1, [0] * 6

    def load_ok(self, args):
        """Simulated load: fails if a tested core is below its stability threshold;
        with `combined_stricter` the load on all cores needs 3 more steps of margin."""
        if "--taskset" in args:
            cores, extra = [int(args[args.index("--taskset") + 1].split(",")[0])], 0
        else:
            cores, extra = range(CORES), self.s.get("combined_stricter", 0)
        return all(self.s["co"][c] >= self.s.get("co_limits", {}).get(str(c), -100) + extra for c in cores)

    def bench(self, threads):
        """Simulated (bogo-ops/s, W): multi-thread saturates with the PPT, single-thread follows FMax."""
        import math
        if threads > 1:
            return round(1000 * (1 - math.exp(-self.s["ppt"] / 50)), 1), round(self.s["ppt"] * 0.9, 1)
        return round(self.s["fmax"] / 5.0, 1), 45.0

    def pm(self):
        s = self.s
        fam = FAMILIES.get(s["codename"])
        if not s["pm_version"] or not fam:
            return None, None
        if not fam["pm"]:   # a table this program cannot read: only its version
            return s["pm_version"], [0.0] * 457
        PM = fam["pm"]
        t = [0.0] * 457
        t[PM["ppt_limit"]], t[PM["ppt"]] = s["ppt"], 61.0
        t[PM["tdc_limit"]], t[PM["tdc"]] = s["tdc"], 23.0
        t[PM["thm_limit"]], t[PM["tctl"]] = s["thm"], s["tctl"]
        t[PM["edc_limit"]] = s["edc"]
        layout = fam["pm_cores"].get(s["pm_version"])
        for c in range(len(self.cids) if layout else 0):   # per-core temperatures, a few degrees apart like a real idle CPU
            t[layout["temp"] + c] = s["tctl"] - 6.0 + c % 3
        return s["pm_version"], t


FAKE = Fake() if ROOT else None


def read_topology():
    """Physical cores in order: [(core_id, "cpu,cpu")] from sysfs, both SMT threads of each core.
    On Zen the core_id carries the CCD (core_id // 8) and leaves gaps for fused-off cores."""
    cores = {}
    base = P("/sys/devices/system/cpu")
    for name in os.listdir(base) if os.path.isdir(base) else []:
        m = re.fullmatch(r"cpu(\d+)", name)
        try:
            cid = int(read_text("/sys/devices/system/cpu/%s/topology/core_id" % name)) if m else None
        except (OSError, ValueError):   # offline CPU: no topology
            cid = None
        if cid is not None:
            cores.setdefault(cid, []).append(int(m.group(1)))
    return [(cid, ",".join(str(c) for c in sorted(cpus))) for cid, cpus in sorted(cores.items())]


def init_cpu():
    global TOPO, CORES
    TOPO = read_topology()
    CORES = len(TOPO)
    _CORE_MAP.clear()


init_cpu()


def family():
    """FAMILIES entry of this CPU; any other codename is refused in full (fail closed)."""
    try:
        code = int(FAKE.s["codename"]) if FAKE else int(read_text(SMU_DIR + "/codename"))
    except (OSError, ValueError):
        raise Err(_("ryzen_smu driver not loaded (%s)") % P(SMU_DIR))
    if code not in FAMILIES:
        raise Err(_("unsupported CPU (codename %d; supported: %s)") % (
            code, ", ".join("%s %d" % (f["name"], c) for c, f in sorted(FAMILIES.items()))))
    if not CORES:
        raise Err(_("CPU topology not readable (/sys/devices/system/cpu)"))
    return FAMILIES[code]


def smu(name, *args):
    try:
        mailbox, cmd = family()["cmd"][name]
    except KeyError:   # not in this family's allowlist: never sent
        raise Err(_("%s is not available on this CPU") % name)
    status, out = FAKE.smu(mailbox, cmd, args) if FAKE else smu_raw(mailbox, cmd, args)
    if status != 1:
        hint = _(" (PBO disabled in the BIOS? set it to Advanced/Motherboard)") if status == 0xFD else ""
        raise Err(_("SMU %s 0x%02X: %s%s") % (mailbox, cmd, SMU_STATUS.get(status, hex(status)), hint))
    return out


def pm_table():
    try:
        prefix = family()["pm_prefix"]
    except Err:
        return None, None
    version, t = FAKE.pm() if FAKE else pm_raw()
    if version is None or prefix is None or (version >> 16) != prefix:
        return None, None
    return version, t


def check_cpu():
    return family()


def co_support():
    """None if the per-core Curve Optimizer can be used on this CPU, otherwise the reason."""
    if not {"co_set", "co_get"} <= set(family()["cmd"]):
        return _("no verified Curve Optimizer commands for this CPU family")
    if core_map() is None:
        return _("the physical position of the cores is unknown (core fuses unreadable or not matching the topology)")
    return None


def tctl():
    if FAKE:
        return FAKE.s["tctl"]
    for d in sorted(os.listdir(P(HWMON))):
        try:
            if read_text("%s/%s/name" % (HWMON, d)) == "k10temp":
                return int(read_text("%s/%s/temp1_input" % (HWMON, d))) / 1000.0
        except OSError:
            pass
    return None


def power_get():
    if FAKE:
        return FAKE.s["power"]
    r = subprocess.run(["busctl", "get-property", "net.hadess.PowerProfiles",
                        "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles", "ActiveProfile"],
                       capture_output=True, text=True)
    if r.returncode == 0:
        return r.stdout.split('"')[1]
    try:  # no daemon: EPP of cpu0
        epp = read_text("/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference")
        return {"power": "power-saver", "performance": "performance"}.get(epp, "balanced")
    except OSError:
        return None


def power_set(profile):
    if FAKE:
        FAKE.s["power"] = profile
        FAKE.save()
        return
    r = subprocess.run(["busctl", "set-property", "net.hadess.PowerProfiles",
                        "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles", "ActiveProfile",
                        "s", profile], capture_output=True, text=True)
    if r.returncode == 0:
        return
    epp = {"power-saver": "power", "balanced": "balance_performance", "performance": "performance"}[profile]
    cpus = P("/sys/devices/system/cpu")
    for d in os.listdir(cpus):
        f = "%s/%s/cpufreq/energy_performance_preference" % (cpus, d)
        if d.startswith("cpu") and d[3:].isdigit() and os.path.exists(f):
            with open(f, "w") as fh:
                fh.write(epp)


# ---- State files (atomic writes) -----------------------------------------------------
def write_atomic(path, text):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d)
    with os.fdopen(fd, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    os.chmod(path, 0o644)
    dfd = os.open(d, os.O_RDONLY)
    os.fsync(dfd)
    os.close(dfd)


def touch_sync(path):
    write_atomic(path, "")


def load_settings():
    s = {"autostart": False, "profile": None, "unlock": False, "fans": {}}
    try:
        s.update(json.loads(open(P(ETC + "/settings.json")).read()))
    except (OSError, ValueError):
        pass
    return s


def save_settings(s):
    write_atomic(P(ETC + "/settings.json"), json.dumps(s, indent=1))


def parse_lines(text):
    """Profile/baseline command lines → lists of tokens. `#` starts a comment."""
    out = []
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if line:
            out.append(line.split())
    return out


def values_from_lines(lines):
    """Interprets the lines as state: {"co": [...], "ppt": 162, "shaper": {tier: [...]}, ...}."""
    v = {"shaper": {}}
    for t in lines:
        if t[0] == "co" and len(t) == CORES + 1:
            v["co"] = [int(x) for x in t[1:]]
        elif t[0] in ("ppt", "tdc", "edc", "fmax", "tjmax") and len(t) == 2:
            v[t[0]] = int(t[1])
        elif t[0] == "shaper" and len(t) == 5:
            v["shaper"][int(t[1])] = [int(x) for x in t[2:]]
        elif t[0] == "power" and len(t) == 2:
            v["power"] = t[1]
    return v


# ---- CPU state reads -----------------------------------------------------------------
def read_co():
    """CO per core, or None where it cannot be used safely (co_support)."""
    if co_support():
        return None
    return [s16(smu("co_get", co_mask(core))[0]) for core in range(CORES)]


def read_fmax():
    return smu("fmax_get")[0]


def read_shaper():
    if "shaper_get" not in family()["cmd"]:
        return None
    return [shaper_decode(w) for w in smu("shaper_get")[:5]]


def read_limits():
    """Limits and instantaneous values from the PM table; {} if the table is absent."""
    version, t = pm_table()
    if t is None:
        return {}
    return {k: round(t[i], 1) for k, i in family()["pm"].items()}


def capture_lines():
    """Current state in profile format (the baseline is a profile like any other)."""
    lim = read_limits()
    co = read_co()
    lines = (["co " + " ".join(str(v) for v in co)] if co is not None else []) + ["fmax %d" % read_fmax()]
    for key, pm_key in (("ppt", "ppt_limit"), ("tdc", "tdc_limit"), ("edc", "edc_limit"), ("tjmax", "thm_limit")):
        if pm_key in lim:
            lines.append("%s %d" % (key, round(lim[pm_key])))
    # Curve Shaper excluded: on the 9800X3D (SMU 98.81.0) 0xA6 replies OK but 0x84 does not change,
    # so it cannot be verified; it remains only as an experimental command (`shaper probe`).
    power = power_get()
    if power:
        lines.append("power " + power)
    lines += fan_capture_lines()   # only channels already classified "ventola" (fan)
    return lines


# ---- Baseline and caps -----------------------------------------------------------------
def cmd_baseline(ctx, args):
    """`baseline`: captures the current state as the baseline of this boot (only if no
    write has happened yet). `baseline show`: prints it."""
    if args == ["show"]:
        return load_baseline(strict=False)
    if args:
        raise Err(_("usage: baseline [show]"))
    check_cpu()
    if os.path.exists(P(STATE + "/active")):
        raise Err(_("baseline not captured: CPU state already modified in this boot"))
    lines = capture_lines()
    write_atomic(P(STATE + "/baseline.conf"), "# baseline captured by ryzenctl\n" + "\n".join(lines) + "\n")
    touch_sync(P(RUN + "/baseline-done"))
    return values_from_lines(parse_lines("\n".join(lines)))


def load_baseline(strict=True):
    """Baseline values. strict: it must have been captured in THIS boot."""
    try:
        text = open(P(STATE + "/baseline.conf")).read()
    except OSError:
        raise Err(_("baseline missing: CPU writes refused (did the ryzenctl service run?)"))
    if strict and not os.path.exists(P(RUN + "/baseline-done")):
        raise Err(_("baseline not captured in this boot: CPU writes refused"))
    return values_from_lines(parse_lines(text))


def cap_of(base, key, unlock):
    if key not in base:
        raise Err(_("no baseline for %s (PM table missing?): write refused") % key)
    if key == "tjmax":
        return min(base[key], family().get("tjmax_max", TJMAX_ABS_MAX), TJMAX_ABS_MAX)
    if key == "fmax":
        return base[key] + (FMAX_UNLOCK_EXTRA if unlock else 0)
    hard = {"ppt": UNLOCK_PPT, "tdc": UNLOCK_TDC, "edc": UNLOCK_EDC}[key]
    return max(base[key], hard) if unlock else base[key]


def check_range(name, v, lo, hi, unit=""):
    if not lo <= v <= hi:
        raise Err(_("%s %d%s out of range (allowed %d..%d%s)") % (name, v, unit, lo, hi, unit))


def to_int(s, name):
    try:
        return int(s)
    except ValueError:
        raise Err(_("%s: '%s' is not an integer") % (name, s))


# ---- Write with readback and restore ---------------------------------------------------
def write_verify(ctx, name, value, write, read, base_value, equal=lambda a, b: a == b):
    """Writes, reads back, retries once, otherwise restores the baseline and raises.
    The `active` marker precedes the first SMU write (crash guard)."""
    if ctx.get("dry"):
        return value
    if not equal(base_value, value):
        touch_sync(P(STATE + "/active"))
    wait = 0.05 if FAKE else READBACK_WAIT
    for _attempt in range(2):
        write(value)
        deadline = time.monotonic() + wait
        while True:
            got = read()
            if equal(got, value) or time.monotonic() >= deadline:
                break
            time.sleep(READBACK_POLL)
        if equal(got, value):
            return got
    if base_value is not None:
        write(base_value)
    raise Err(_("%s: wrote %s but read back %s; restored %s") % (name, value, got, base_value))


def near(a, b):
    return a is not None and b is not None and abs(a - b) <= READBACK_TOL


def limit_setter(key, pm_key, cmd_name, unit, lo):
    def cmd(ctx, args):
        if len(args) != 1:
            raise Err(_("usage: %s <%s>") % (key, unit))
        v = to_int(args[0], key)
        check_cpu()
        s = load_settings()
        base = load_baseline()
        check_range(key, v, lo, cap_of(base, key, s["unlock"]), " " + unit)
        if not read_limits():
            raise Err(_("PM table missing: cannot verify %s, write refused") % key)
        scale = 1 if key == "tjmax" else 1000
        got = write_verify(ctx, key, float(v), lambda x: smu(cmd_name, int(x * scale)),
                           lambda: read_limits().get(pm_key), float(base[key]), near)
        return {key: got}
    return cmd


def cmd_co(ctx, args):
    """`co <core> <v>` | `co all <v>` | `co v0 … v7`."""
    if len(args) == CORES:
        wanted = {c: to_int(x, "co") for c, x in enumerate(args)}
    elif len(args) == 2 and args[0] == "all":
        wanted = {c: to_int(args[1], "co") for c in range(CORES)}
    elif len(args) == 2:
        core = to_int(args[0], "core")
        check_range("core", core, 0, CORES - 1)
        wanted = {core: to_int(args[1], "co")}
    else:
        raise Err(_("usage: co <core|all> <value> | co v0 … v%d") % (CORES - 1))
    for v in wanted.values():
        check_range("co", v, CO_MIN, CO_MAX)
    check_cpu()
    why = co_support()
    if why:
        raise Err(_("Curve Optimizer not available on this CPU: %s") % why)
    base = load_baseline()
    for core, v in wanted.items():
        write_verify(ctx, "co core %d" % core, v, lambda x, c=core: smu("co_set", co_arg(c, x)),
                     lambda c=core: read_co()[c], base["co"][core])
    return {"co": None if ctx.get("dry") else read_co()}


def cmd_fmax(ctx, args):
    if len(args) != 1:
        raise Err(_("usage: fmax <MHz>"))
    v = to_int(args[0], "fmax")
    check_cpu()
    base = load_baseline()
    check_range("fmax", v, FMAX_MIN, cap_of(base, "fmax", load_settings()["unlock"]), " MHz")
    return {"fmax": write_verify(ctx, "fmax", v, lambda x: smu("fmax_set", x & 0xFFFFF), read_fmax, base["fmax"])}


def cmd_shaper(ctx, args):
    """Experimental: not verified on hardware. `shaper raw` = words of 0x84;
    `shaper probe` = writes tier 4 -2/-2/-2, reads at once and after 1 s, restores."""
    raw = lambda: ["0x%08X" % w for w in smu("shaper_get")]
    if args == ["raw"]:
        check_cpu()
        return {"raw": raw()}
    if args == ["probe"]:
        check_cpu()
        base = load_baseline()
        out = {"prima": raw()}
        smu("shaper_set", shaper_arg(4, -2, -2, -2))
        out["subito"] = raw()
        time.sleep(1)
        out["dopo_1s"] = raw()
        smu("shaper_set", shaper_arg(4, *base["shaper"].get(4, [0, 0, 0])))
        out["ripristino"] = raw()
        out["per_tier_arg0"] = ["0x%08X" % smu("shaper_get", t)[0] for t in range(5)]   # 0x84 with arg0 = tier
        return out
    if len(args) != 4:
        raise Err(_("usage: shaper <tier 0-4> <lowT> <midT> <highT> | shaper raw | shaper probe"))
    tier = to_int(args[0], "tier")
    check_range("tier", tier, 0, 4)
    v = [to_int(x, "shaper") for x in args[1:]]
    for m in v:
        check_range("shaper", m, CO_MIN, CO_MAX)
    check_cpu()
    base = load_baseline()
    got = write_verify(ctx, "shaper tier %d" % tier, v, lambda x: smu("shaper_set", shaper_arg(tier, *x)),
                       lambda: read_shaper()[tier], base["shaper"].get(tier))
    return {"shaper": {tier: got}}


def cmd_power(ctx, args):
    if len(args) != 1 or args[0] not in POWER_PROFILES:
        raise Err(_("usage: power <%s>") % "|".join(POWER_PROFILES))
    if not ctx.get("dry"):
        power_set(args[0])
    return {"power": args[0]}


def cmd_unlock(ctx, args):
    if args not in (["on"], ["off"]):
        raise Err(_("usage: unlock on|off"))
    s = load_settings()
    if args == ["off"] and s["profile"] == "boost":   # it would stay applied (and reapplied at boot) without unlock
        raise Err(_("Boost is the selected mode and requires unlock: switch to another mode first"))
    s["unlock"] = args == ["on"]
    save_settings(s)
    if s["unlock"]:
        return (_("WARNING: limits beyond the factory values enabled (PPT up to %d W, TDC %d A, EDC %d A, FMax +%d MHz). More heat and power draw; Tjmax stays <= baseline anyway.")
                % (UNLOCK_PPT, UNLOCK_TDC, UNLOCK_EDC, FMAX_UNLOCK_EXTRA))
    return _("limits back to the factory caps")


def check_boost(name):
    """Boost puts limits and FMax at the unlock ceilings by design: creating, calibrating, selecting
    or applying it (also at boot) is refused while unlock is off."""
    if name == "boost" and not load_settings()["unlock"]:
        raise Err(_("Boost requires unlock (ryzenctl unlock on; in the GUI: Preferences, \"Allow beyond the stock values\")"))


# ---- Remembered authorization: polkit rule for the calling user -----------------------------
TRUST_RULE = "/etc/polkit-1/rules.d/50-ryzen-control.rules"
POLKIT_ACTION = "org.ryzencontrol.RyzenControl.serve"


def trust_user():
    """User who called ryzenctl via pkexec (GUI) or sudo (CLI); None if unknown."""
    uid = os.environ.get("PKEXEC_UID")
    if uid:
        import pwd
        return pwd.getpwuid(int(uid)).pw_name
    return os.environ.get("SUDO_USER")


def trust_users():
    try:
        m = re.search(r"(\[[^\]]*\])\.indexOf\(subject\.user\)", read_text(TRUST_RULE))
    except OSError:
        return []
    return json.loads(m.group(1)) if m else []


def cmd_trust(ctx, args):
    """trust on|off|status: the calling user no longer re-enters the password for Ryzen Control.
    Polkit rule limited to this action (pkexec ryzenctl serve), to that user and to their
    active local session: it is not a generic sudo. The first write requires the password."""
    if args == ["status"]:
        return {"trusted": trust_users(), "user": trust_user()}
    if args not in (["on"], ["off"]):
        raise Err(_("usage: trust on|off|status"))
    user = trust_user()
    if not user:
        raise Err(_("unknown calling user (pkexec or sudo required)"))
    users = set(trust_users())
    users = users | {user} if args == ["on"] else users - {user}
    users = sorted(users)
    if users:
        write_atomic(P(TRUST_RULE),
                     "// Generated by `ryzenctl trust on`: these users run Ryzen Control without re-entering the password.\n"
                     "// Applies only to the action %s (pkexec ryzenctl serve) in an active local session.\n"
                     "polkit.addRule(function(action, subject) {\n"
                     "    if (action.id == \"%s\" && subject.local && subject.active &&\n"
                     "        %s.indexOf(subject.user) >= 0)\n"
                     "        return polkit.Result.YES;\n"
                     "});\n" % (POLKIT_ACTION, POLKIT_ACTION, json.dumps(users)))
    else:
        rm(P(TRUST_RULE))
    return {"trusted": users, "user": user}


# ---- Status ------------------------------------------------------------------------------
def cmd_status(ctx, args):
    fam = check_cpu()
    lim = read_limits()
    s = load_settings()
    try:
        base = load_baseline(strict=False)
    except Err:
        base = None
    return {
        "cpu": fam["name"], "cores": CORES, "ccds": len({cid // 8 for cid, _cpus in TOPO}),
        "verified": fam["verified"], "co_unavailable": co_support(),
        "smu_version": _("fake") if FAKE else read_text(SMU_DIR + "/version"),
        "pm_version": hex((FAKE.pm() if FAKE else pm_raw())[0] or 0),
        "co": read_co(), "fmax": read_fmax(), "shaper": read_shaper(),
        "limits": {"ppt": lim.get("ppt_limit"), "tdc": lim.get("tdc_limit"),
                   "edc": lim.get("edc_limit"), "tjmax": lim.get("thm_limit")},
        "now": {"ppt": lim.get("ppt"), "tdc": lim.get("tdc"), "tctl": tctl(), "tctl_pm": lim.get("tctl")},
        "power": power_get(),
        "baseline": base, "baseline_fresh": os.path.exists(P(RUN + "/baseline-done")),
        "unlock": s["unlock"], "autostart": s["autostart"], "profile": s["profile"],
        "trusted": trust_user() in trust_users(),
        "crashed": crashed_info(), "caps": caps(base, s["unlock"]) if base else None,
        "active": os.path.exists(marker("active")),
    }


def caps(base, unlock):
    """Allowed ranges (min, max) for the GUI: same logic as cap_of."""
    out = {"co": [CO_MIN, CO_MAX], "fan_step_ms": [0, FAN_STEP_MAX_MS], "fan_step_tol_ms": FAN_STEP_TOL_MS}
    for key, lo in (("ppt", PPT_MIN), ("tdc", TDC_MIN), ("edc", EDC_MIN), ("fmax", FMAX_MIN), ("tjmax", TJMAX_MIN)):
        if key in base:
            out[key] = [lo, cap_of(base, key, unlock)]
    return out


def pm_cores(version, t):
    """Per-core offsets of the PM table for this version, only for a verified layout that has room
    for every core; otherwise None."""
    layout = family()["pm_cores"].get(version) if t is not None else None
    return layout if layout and len(t) > max(layout.values()) + CORES else None


def sample_cores():
    """Voltage (V) and frequency (MHz) per core from the PM table (verified layouts only); otherwise None."""
    if FAKE:
        return {"volt": [round(1.25 + c * 0.003, 3) for c in FAKE.s["co"]], "mhz": [FAKE.s["fmax"] - 50] * CORES}
    version, t = pm_table()
    m = pm_cores(version, t)
    if not m:
        return None
    return {"volt": [round(t[m["volt"] + c], 3) for c in range(CORES)],
            "mhz": [int(t[m["mhz"] + c] * 1000) if t[m["mhz"] + c] < 100 else int(t[m["mhz"] + c]) for c in range(CORES)]}


def cmd_telemetry(ctx, args):
    """Quick reads for the GUI monitor (1 Hz): no writes."""
    check_cpu()
    version, t = pm_table()
    m = pm_cores(version, t)
    lim = read_limits()
    cores = []
    for c in range(CORES):
        try:
            mhz = int(read_text("/sys/devices/system/cpu/cpu%s/cpufreq/scaling_cur_freq" % first_cpu(c))) // 1000
        except (OSError, ValueError):
            mhz = 3000 + c * 100 if FAKE else None
        temp = round(t[m["temp"] + c], 1) if m else None
        cores.append({"mhz": mhz, "temp": temp})
    co = read_co()
    sample = sample_cores()
    for c in range(CORES):
        cores[c]["co"] = co[c] if co else None
        cores[c]["volt"] = sample["volt"][c] if sample else None
    tccd = None
    if FAKE:
        tccd = round(FAKE.s["tctl"] - 15, 1)
    else:
        for d in sorted(os.listdir(P(HWMON))):
            try:
                if read_text("%s/%s/name" % (HWMON, d)) == "k10temp":
                    tccd = int(read_text("%s/%s/temp3_input" % (HWMON, d))) / 1000.0
            except OSError:
                pass
    fans = []
    fd = fans_dir()
    if fd:
        for n in fan_channels(fd):
            rpm = hw_read("%s/fan%d_input" % (fd, n))
            if rpm > 0 or fan_role(n) != "sconosciuto":
                info = fan_roles().get(str(n), {})
                fans.append({"canale": n, "rpm": rpm, "pwm": hw_read("%s/pwm%d" % (fd, n)),
                             "role": info.get("role", "sconosciuto"), "name": info.get("name")})
    return {"tctl": tctl(), "tccd": tccd, "ppt": lim.get("ppt"), "ppt_limit": lim.get("ppt_limit"),
            "tdc": lim.get("tdc"), "tdc_limit": lim.get("tdc_limit"), "edc_limit": lim.get("edc_limit"),
            "tjmax": lim.get("thm_limit"), "fmax": read_fmax(), "cores": cores, "fans": fans, "power": power_get()}


def fmt_status(st):
    f = lambda v, u="": _("n/a") if v is None else ("%g%s" % (v, u) if isinstance(v, (int, float)) else str(v))
    b = st["baseline"] or {}
    bl = lambda k, u="": (" (base %s)" % f(b.get(k), u)) if k in b else ""
    lines = [
        _("CPU %s, %d cores, SMU %s, PM table %s") % (st["cpu"], st["cores"], st["smu_version"], st["pm_version"])
        + ("" if st["verified"] else _("  (family not verified on hardware yet: run hwtest)")),
        ("CO      " + " ".join("%+d" % v for v in st["co"]) + ("  (base %s)" % " ".join("%+d" % v for v in b["co"]) if "co" in b else ""))
        if st["co"] is not None else _("CO      n/a: %s") % st["co_unavailable"],
        ("Shaper  " + "  ".join("t%d:%+d/%+d/%+d" % (i, *v) for i, v in enumerate(st["shaper"])) + _("  (experimental, not verified)"))
        if st["shaper"] is not None else _("Shaper  n/a on this CPU"),
        "FMax    %s MHz%s" % (f(st["fmax"]), bl("fmax", " MHz")),
        _("Limits  PPT %s%s  TDC %s%s  EDC %s%s  Tjmax %s%s") % (
            f(st["limits"]["ppt"], " W"), bl("ppt", " W"), f(st["limits"]["tdc"], " A"), bl("tdc", " A"),
            f(st["limits"]["edc"], " A"), bl("edc", " A"), f(st["limits"]["tjmax"], " °C"), bl("tjmax", " °C")),
        _("Now     PPT %s  TDC %s  Tctl %s") % (f(st["now"]["ppt"], " W"), f(st["now"]["tdc"], " A"), f(st["now"]["tctl"], " °C")),
        _("Power   %s%s") % (st["power"] or _("n/a"), bl("power")),
        _("Baseline %s, unlock %s, autostart %s, profile %s") % (
            _("of this boot") if st["baseline_fresh"] else (_("stale") if b else _("missing")),
            "ON" if st["unlock"] else "off", "ON" if st["autostart"] else "off", st["profile"] or "-"),
    ]
    return "\n".join(lines)


# ---- Profiles ----------------------------------------------------------------------------
PROFILE_CMDS = {"co", "ppt", "tdc", "edc", "fmax", "tjmax", "power", "fan"}  # shaper: experimental, excluded
FAN_PROFILE_SUBCMDS = ("step", "curve", "pump")   # `fan <N> step …` | `fan <N> curve …` | `fan <N> pump auto|<pct>`
NAME_RE = re.compile(r"^[a-z0-9_-]{1,32}$")


def profile_path(name):
    if name == "baseline":
        return P(STATE + "/baseline.conf")
    if not NAME_RE.match(name):
        raise Err(_("invalid profile name '%s' (only a-z 0-9 _ -)") % name)
    return P(ETC + "/profiles/" + name + ".conf")


def profile_lines(name):
    try:
        lines = parse_lines(open(profile_path(name)).read())
    except OSError:
        raise Err(_("profile '%s' does not exist") % name)
    if name == "baseline":  # written by us: an older version may contain lines excluded today (shaper)
        return [t for t in lines if t[0] in PROFILE_CMDS]
    return with_stock(lines)


def with_stock(lines):
    """A profile is the baseline overridden by its own lines: whatever it does not set (an older or
    hand-made profile without a fan curve or without CPU limits) is the stock value, written first.
    So every mode shows and applies a complete state, and switching mode never leaves the previous
    mode's fans or limits behind. The pump is left out: it is never part of a mode."""
    try:
        base = profile_lines("baseline")
    except Err:
        return lines
    have = {tuple(t[:3]) if t[0] == "fan" else (t[0],) for t in lines}
    full_co = any(t[0] == "co" and (len(t) == CORES + 1 or t[1:2] == ["all"]) for t in lines)   # "co 7 -3" alone: the other cores at stock
    fans = fans_dir()
    stock = [t for t in base
             if (t[0] == "fan" and fans and len(t) > 2 and t[2] in ("step", "curve") and tuple(t[:3]) not in have
                 and fan_role(int(t[1])) == "ventola")
             or (t[0] == "co" and not full_co)
             or (t[0] not in ("fan", "co") and (t[0],) not in have)]
    return stock + lines


def apply_lines(lines, ctx, part=None):
    """Executes the lines (part: 'cpu' | 'fan' | None=all). Stops at the first error."""
    done = []
    for n, t in enumerate(lines, 1):
        is_fan = t[0] == "fan"
        if part == "fan" and not is_fan or part == "cpu" and is_fan:
            continue
        if t[0] not in PROFILE_CMDS or (is_fan and (len(t) < 3 or t[2] not in FAN_PROFILE_SUBCMDS)):
            raise Err(_("line %d: '%s' not allowed in a profile") % (n, " ".join(t[:3])))
        try:
            run(t, ctx)
        except Err as e:
            raise Err(_("line %d (%s): %s") % (n, " ".join(t), e))
        done.append(" ".join(t))
    return done


def cmd_apply(ctx, args):
    if len(args) not in (1, 2) or (len(args) == 2 and args[1] not in ("cpu", "fan")):
        raise Err(_("usage: apply <profile|baseline> [cpu|fan]"))
    check_boost(args[0])
    return {"applied": apply_lines(profile_lines(args[0]), ctx, args[1] if len(args) == 2 else None)}


def cmd_profile(ctx, args):
    """profile list | show <n> | save <n> <line>… | delete <n>"""
    s = load_settings()
    if args == ["list"]:
        d = P(ETC + "/profiles")
        names = sorted(f[:-5] for f in os.listdir(d) if f.endswith(".conf")) if os.path.isdir(d) else []
        return {"profiles": names, "active": s["profile"]}
    if len(args) == 2 and args[0] == "show":
        return {"lines": [" ".join(t) for t in profile_lines(args[1])]}
    if len(args) >= 2 and args[0] == "save":
        name, path = args[1], profile_path(args[1])
        if name == "baseline":
            raise Err(_("'baseline' is reserved"))
        lines = parse_lines("\n".join(args[2:]))
        apply_lines(lines, {"dry": True})          # validates everything, does not touch the hardware
        write_atomic(path, "# ryzenctl profile '%s'\n" % name + "\n".join(" ".join(t) for t in lines) + "\n")
        return {"saved": name, "lines": len(lines)}
    if len(args) == 2 and args[0] == "delete":
        path = profile_path(args[1])
        if args[1] == "baseline" or not os.path.exists(path):
            raise Err(_("profile '%s' does not exist or is reserved") % args[1])
        os.remove(path)
        if s["profile"] == args[1]:
            s["profile"] = None
            save_settings(s)
        return {"deleted": args[1]}
    raise Err(_("usage: profile list | show <name> | save <name> <line>… | delete <name>"))


def cmd_use(ctx, args):
    if len(args) != 1:
        raise Err(_("usage: use <profile>"))
    check_boost(args[0])
    profile_lines(args[0])
    s = load_settings()
    s["profile"] = args[0]
    save_settings(s)
    return {"profile": args[0]}


def cmd_autostart(ctx, args):
    if args not in (["on"], ["off"]):
        raise Err(_("usage: autostart on|off"))
    s = load_settings()
    if args == ["on"] and not s["profile"]:
        raise Err(_("no profile selected (use <profile>)"))
    s["autostart"] = args == ["on"]
    save_settings(s)
    return {"autostart": s["autostart"], "profile": s["profile"]}


# ---- Mode presets (until the phase 4 calibration replaces them) ---------
# ponytail: fixed ratios relative to the baseline (quiet ≈ AMD's 65 W eco on a 162 W part, auto ≈ 105 W eco);
# the Auto calibration replaces them with values measured on this CPU, the Eco one adds the measured CO.
PRESETS = {
    "quiet": {"ppt": 0.55, "tdc": 0.63, "edc": 0.83, "fmax": -400, "tjmax": 80, "power": "balanced", "fan": (10000, 5000)},
    # eco: same values as quiet; `autotune eco` adds Auto's validated CO and the fan curve
    "eco": {"ppt": 0.55, "tdc": 0.63, "edc": 0.83, "fmax": -400, "tjmax": 80, "power": "balanced", "fan": (10000, 5000)},
    "auto": {"ppt": 0.88, "tdc": 0.92, "edc": 0.94, "fmax": 0, "tjmax": None, "power": "balanced", "fan": (3000, 2000)},
    "performance": {"ppt": 1.0, "tdc": 1.0, "edc": 1.0, "fmax": 0, "tjmax": None, "power": "performance", "fan": None},
    # boost: same values as performance until `autotune boost` replaces them (pushed CO, limits and
    # FMax at the allowed caps, stability check and measured gain)
    "boost": {"ppt": 1.0, "tdc": 1.0, "edc": 1.0, "fmax": 0, "tjmax": None, "power": "performance", "fan": None},
}


def preset_lines(name, base):
    pr = PRESETS[name]
    lines = ["co " + " ".join(str(v) for v in base["co"])] if "co" in base else []   # presets do not touch the CO
    for key, floor in (("ppt", PPT_MIN), ("tdc", TDC_MIN), ("edc", EDC_MIN)):
        if key in base:
            lines.append("%s %d" % (key, max(floor, round(base[key] * pr[key]))))
    if "fmax" in base:
        lines.append("fmax %d" % max(FMAX_MIN, base["fmax"] + pr["fmax"]))
    if "tjmax" in base:
        lines.append("tjmax %d" % (base["tjmax"] if pr["tjmax"] is None else min(base["tjmax"], pr["tjmax"])))
    lines.append("power " + pr["power"])
    d = fans_dir()
    if d:
        for n in fan_channels(d):
            if fan_role(n) == "ventola":
                if pr["fan"]:
                    lines.append("fan %d step %d %d" % (n, *pr["fan"]))
                else:   # boost: BIOS values (baseline)
                    for t in profile_lines("baseline"):
                        if t[:3] == ["fan", str(n), "step"]:
                            lines.append(" ".join(t))
    return lines


def cmd_preset(ctx, args):
    """`preset quiet|performance|eco|auto|boost [show]`: creates (or regenerates) the profile from the baseline; `show` only lists."""
    if not args or args[0] not in PRESETS or len(args) > 2 or (len(args) == 2 and args[1] != "show"):
        raise Err(_("usage: preset quiet|performance|eco|auto|boost [show]"))
    lines = preset_lines(args[0], load_baseline())
    if len(args) == 2:   # what the profile will show and apply once created (stock values included)
        return {"profile": args[0], "lines": [" ".join(t) for t in with_stock([l.split() for l in lines])]}
    check_boost(args[0])
    return cmd_profile(ctx, ["save", args[0]] + lines)


# ---- Autotune: step machine (Eco/Auto), state on disk, resume after a crash ----------
AT_PATH = STATE + "/autotune.json"
# The CO stability limit is one per core: the search is shared between the modes (down to −40; a
# deeper measurement is valid for all) and saved in CO_LIMITS_PATH, with the memory of the final
# passes (final_failures: never retried; final_passed: Eco reuses them without load tests). Every
# mode applies the same margin +3: Eco = Auto's undervolt with the quiet limits. reuse=1 reuses the
# previous measurement; `target` only places the quiet fan curve (fans=2: minimum up to target−10 °C).
AT_DEFAULTS = {"eco": {"target": 70, "colimit": -40, "margin": 3, "step": 90, "parallel": 1, "reuse": 1, "fans": 2},
               "auto": {"target": 70, "colimit": -40, "margin": 3, "step": 90, "loss": 10, "parallel": 1, "reuse": 1, "fans": 1},
               "boost": {"colimit": -40, "margin": 3, "step": 90, "parallel": 1, "reuse": 1, "fans": 1}}   # no target: the fans use eco's
# fans: 0 = BIOS (baseline steps and curves); 1 = moderate: rise 3 s / fall 2 s and the BIOS curve raised
# by 10 % with 100 % at 100 °C (the BIOS curves reach 100 % only at 125 °C, so under load the fans hardly
# react; this is the curve tuned by hand on the 9800X3D); 2 = quiet: 10 s / 5 s, BIOS minimum up to
# target−10 °C, 100 % at Tjmax−5 °C
FAN_STEPS = {1: (3000, 2000), 2: (10000, 5000)}
FAN_RAISE_PWM, FAN_FULL_TEMP = 26, 100   # moderate: +10 % (26/255) on the BIOS points, 100 % at 100 °C
CO_LIMITS_PATH = STATE + "/co_limits.json"
BOOST_BENCHES = 4   # MT and ST at factory and in boost: the measured gain
# parallel=1 (default): all cores together at each CO level, one worker per core (8x
# faster); parallel=0: one core at a time (attributes even a crash with certainty).
AT_PPT_TESTS_EST, AT_FKNEE_TESTS_EST = 5, 6   # for the duration estimates
PPT_SWEEP_STEP, PPT_SWEEP_MIN, BENCH_SEC, FMAX_KNEE_SPAN = 0.10, 0.50, 15, 800   # Auto: performance/W knee
CO_STEP, FINAL_SEC, FINAL_RETRIES = 5, 300, 3
FINAL_HEAVY_SEC = 60   # final pass: first the heaviest method at full load (fft on 16 threads locked up the 9800X3D at −37)
FMAX_STEP = 100   # Auto: FMax knee sweep


def boot_id():
    return FAKE.s["boot_id"] if FAKE else read_text("/proc/sys/kernel/random/boot_id")


def at_load():
    try:
        return json.loads(open(P(AT_PATH)).read())
    except (OSError, ValueError):
        return None


def at_save(st):
    write_atomic(P(AT_PATH), json.dumps(st, indent=1))


def mce_since(ts):
    r = subprocess.run(["journalctl", "-k", "-q", "--since", "@%d" % int(ts), "-g", "mce|Hardware Error"],
                       capture_output=True, text=True)
    return bool(r.stdout.strip())


AT_ABORT_FLAG = RUN + "/autotune-abort"
_children = set()        # running stress-ng processes: `autotune abort` terminates them at once


class Unstable(Exception):
    """A load died or reported errors with the final CO applied: unstable combination."""


class Aborted(Exception):
    """Abort requested during a step: the step returns without recording anything."""


def at_request_abort():
    """From another thread/process: raises the flag and terminates the running loads. Simple
    and tolerant creation: it may run concurrently with `start`/`abort`, which remove it."""
    try:
        os.makedirs(P(RUN), exist_ok=True)
        open(P(AT_ABORT_FLAG), "w").close()
    except OSError:
        pass
    for pr in list(_children):
        try:
            pr.terminate()
        except OSError:
            pass


def check_abort():
    if os.path.exists(P(AT_ABORT_FLAG)):
        raise Aborted()


def wait_child(pr):
    """Waits for a child, checking the abort request every half second."""
    try:
        while pr.poll() is None:
            if os.path.exists(P(AT_ABORT_FLAG)):
                pr.terminate()
                pr.wait()
                raise Aborted()
            time.sleep(0.5)
        return pr.returncode
    finally:
        _children.discard(pr)


LAST_FAIL = {"why": ""}   # reason of the last failed load (for the calibration status)


def run_load(args, seconds):
    """stress-ng with fixed arguments; True if it finishes cleanly and without MCE errors."""
    if FAKE:
        check_abort()
        ok = FAKE.load_ok(args)
        if not ok:
            LAST_FAIL["why"] = "simulato"
        return ok
    t0 = time.time()
    rc = wait_child(spawn_load(args, seconds))
    if rc != 0:
        LAST_FAIL["why"] = _("stress-ng exit code %d (result verification failed or process terminated)") % rc
        return False
    if mce_since(t0):
        LAST_FAIL["why"] = _("MCE error in the kernel log")
        return False
    return True


def core_cpus(c):
    """Logical CPUs of physical core c (both SMT threads), e.g. "3,11"."""
    return TOPO[c][1]


def first_cpu(c):
    return TOPO[c][1].split(",")[0]


def core_load_args(c, extra=(), method="all"):
    """Stability load for one core: both threads, with result verification."""
    return ["--cpu", "2", "--taskset", core_cpus(c), "--cpu-method", method, "--verify"] + list(extra)


def co_test(cores, seconds):
    """Three phases: full load with verification, 50 %, 10 % (CO instabilities show up at low load)."""
    sec = max(1, seconds // 3)
    base = core_load_args(cores[0]) if len(cores) == 1 else ["--cpu", "0", "--cpu-method", "all", "--verify"]
    for extra in ([], ["--cpu-load", "50"], ["--cpu-load", "10"]):
        if not run_load(base + extra, sec):
            return False
    return True


def co_test_final(method, seconds):
    """Combined pass: first the heaviest method at full load with verification (on the 9800X3D fft
    on 16 threads exposed at −37 an instability that `all` did not see in 5 minutes), then the
    three phases of co_test."""
    if not run_load(["--cpu", "0", "--cpu-method", method, "--verify"], FINAL_HEAVY_SEC):
        return False
    return co_test(list(range(CORES)), seconds)


def co_test_sampled(cores, seconds, method="all"):
    """One core at a time: heaviest method at full load (sampling voltage and MHz halfway through:
    it is the measurement of "what a CO step corresponds to"), then mixed methods at full load, 50 %, 10 %.
    Returns (ok, sample)."""
    if FAKE:
        check_abort()
        return FAKE.load_ok(["--taskset", str(cores[0])] if len(cores) == 1 else []), sample_cores()
    sec = max(1, seconds // 4)
    base = core_load_args(cores[0]) if len(cores) == 1 else ["--cpu", "0", "--cpu-method", "all", "--verify"]
    heavy = core_load_args(cores[0], method=method) if len(cores) == 1 else ["--cpu", "0", "--cpu-method", method, "--verify"]
    pr = spawn_load(heavy, sec)
    time.sleep(max(1, sec // 2))
    sample = sample_cores()
    if wait_child(pr) != 0 or mce_since(time.time() - sec - 1):
        return False, sample
    for extra in ([], ["--cpu-load", "50"], ["--cpu-load", "10"]):
        if not run_load(base + extra, sec):
            return False, sample
    return True, sample


def spawn_load(args, seconds):
    try:
        pr = subprocess.Popen(["stress-ng"] + args + ["-t", str(int(seconds)), "-q"],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        raise Err(_("stress-ng not installed: required for the load tests"))
    _children.add(pr)
    return pr


def mce_cores_since(ts, cores):
    """Cores with MCE errors since the timestamp; if the line does not name the CPU, all of them (caution)."""
    r = subprocess.run(["journalctl", "-k", "-q", "--since", "@%d" % int(ts), "-g", "mce|Hardware Error"],
                       capture_output=True, text=True)
    if not r.stdout.strip():
        return set()
    cpus = re.findall(r"CPU[ :]+(\d+)", r.stdout)
    if not cpus:
        return set(cores)
    core_of = {int(cpu): i for i, (_cid, threads) in enumerate(TOPO) for cpu in threads.split(",")}
    return {core_of[int(c)] for c in cpus if int(c) in core_of} & set(cores)


def co_test_parallel(cores, seconds, method="all"):
    """All cores together, one worker per core on both SMT threads (so that a software instability
    stays attributed to the core): heaviest method at full load (the one that on the
    9800X3D locked up the system where `all` passed), mixed methods at full load, then 50 %, then
    single bursts in turn for the maximum boost of each core. Returns (failed cores,
    voltage/MHz sample)."""
    if FAKE:
        check_abort()
        return {c for c in cores if not FAKE.load_ok(["--taskset", str(c)])}, sample_cores()
    sec = max(1, seconds // 3)
    failed = set()
    sample = None
    t0 = time.time()
    for i, (meth, extra) in enumerate(((method, []), ("all", []), ("all", ["--cpu-load", "50"]))):
        procs = {c: spawn_load(core_load_args(c, extra, meth), sec) for c in cores if c not in failed}
        if i == 0:
            time.sleep(max(1, sec // 2))
            sample = sample_cores()                    # voltages at full load at this CO level
        for c, pr in procs.items():
            if wait_child(pr) != 0:
                failed.add(c)
    burst = max(3, sec // max(1, len(cores)))
    for c in cores:
        if c not in failed and not run_load(core_load_args(c), burst):
            failed.add(c)
    return failed | mce_cores_since(t0, cores), sample


def at_total_estimate(mode, p):
    """Estimated duration (s) of a full calibration with these parameters (maximum for the CO)."""
    reused = at_reused(mode, p)
    if reused.get("eco_from"):
        return 0                                                    # Eco: CO already validated, no load test
    levels = max(1, (-p["colimit"]) // CO_STEP)
    t = (0 if reused else levels * p["step"] * (1 if p.get("parallel", 1) else CORES))
    t += len(BENCH_METHODS) * 6 + FINAL_HEAVY_SEC + FINAL_SEC       # method probe + final pass
    if mode == "auto":
        t += AT_PPT_TESTS_EST * (5 + BENCH_SEC) + AT_FKNEE_TESTS_EST * (3 + BENCH_SEC)
    elif mode == "boost":
        t += BOOST_BENCHES * (5 + BENCH_SEC)
    return int(t)


def at_estimate(st):
    """{total_s, remaining_s}: estimated remaining time from the current phase."""
    p, ph = st["params"], st["phase"]
    levels = max(1, (-p["colimit"]) // CO_STEP)
    rem = 0
    if ph == "co":
        level_idx = (-st["value"]) // CO_STEP - 1          # levels already completed
        if st.get("parallel"):
            rem += (levels - level_idx) * p["step"]
        else:
            rem += ((CORES - st["core"] - 1) * levels + (levels - level_idx)) * p["step"]
    if ph in ("co", "final"):
        rem += FINAL_SEC + FINAL_HEAVY_SEC + (0 if st.get("method") else len(BENCH_METHODS) * 6)
    if st["mode"] == "boost" and ph in ("co", "final", "bench"):
        rem += BOOST_BENCHES * (5 + BENCH_SEC)
    if st["mode"] == "auto" and ph in ("co", "final", "ppt", "fmax_knee"):
        knee = st.get("knee", {})
        if ph != "fmax_knee":
            done = len(knee.get("ppt", {}).get("tests", [])) if ph == "ppt" else 0
            rem += max(0, AT_PPT_TESTS_EST - done) * (5 + BENCH_SEC)
        done_f = len(knee.get("fmax", {}).get("tests", [])) if ph == "fmax_knee" else 0
        rem += max(0, AT_FKNEE_TESTS_EST - done_f) * (3 + BENCH_SEC)
    return {"total_s": st.get("eta_total", at_total_estimate(st["mode"], p)), "remaining_s": int(rem)}


def co_limits_load():
    try:
        return json.loads(open(P(CO_LIMITS_PATH)).read())
    except (OSError, ValueError):
        return None


def co_limits_reusable(params):
    """The saved measurement is valid if it covers all cores and is at least as deep as requested."""
    saved = co_limits_load()
    if not saved or not params.get("reuse", 1):
        return None
    if saved.get("colimit", 0) > params["colimit"] or len(saved.get("results", {})) != CORES \
            or saved.get("cores", 8) != CORES:   # another CPU (files before 0.5 are all from 8-core CPUs)
        return None
    if not saved.get("method"):          # measurement from a version without the heavy method in the search: not valid
        return None
    return saved


def co_limits_save(st):
    write_atomic(P(CO_LIMITS_PATH), json.dumps({"results": st["results"], "unstable": st["unstable"],
                                                "colimit": st["params"]["colimit"], "samples": st.get("samples", {}),
                                                "method": st.get("method"), "cores": CORES,
                                                "time": time.strftime("%Y-%m-%d %H:%M"), "mode": st["mode"]}, indent=1))


def co_limits_note(st, key, entry):
    """Memory of the final passes for the next calibrations (final_failures: never retried,
    final_passed: reused by Eco), only in the measurement this calibration is using."""
    saved = co_limits_load()
    if saved and saved.get("results") == st["results"]:
        saved.setdefault(key, []).append(entry)
        write_atomic(P(CO_LIMITS_PATH), json.dumps(saved, indent=1))


def at_params(mode, kvs):
    params = dict(AT_DEFAULTS[mode])
    for kv in kvs:
        k, _sep, v = kv.partition("=")
        if k not in params:
            raise Err(_("unknown parameter '%s' (%s)") % (k, ", ".join(params)))
        params[k] = to_int(v, k)
    check_range("colimit", params["colimit"], CO_MIN, 0)
    check_range("margin", params["margin"], 0, 20)
    check_range("step", params["step"], 3, 3600, " s")
    if "target" in params:
        check_range("target", params["target"], 50, 90, " °C")
    check_range("parallel", params["parallel"], 0, 1)
    check_range("reuse", params["reuse"], 0, 1)
    check_range("fans", params["fans"], 0, 2)
    if "loss" in params:
        check_range("loss", params["loss"], 1, 50, " %")
    return params


def rapl_energy():
    """Package energy in µJ and wrap range, or (None, None)."""
    try:
        d = "/sys/class/powercap/intel-rapl:0"
        return int(read_text(d + "/energy_uj")), int(read_text(d + "/max_energy_range_uj"))
    except (OSError, ValueError):
        return None, None


BENCH_METHODS = ("matrixprod", "fft", "double", "int64")   # candidates: the one that draws the most power is measured


def heaviest_method():
    """The stress-ng method that draws the most power on this CPU: the PPT sweep must hit
    the limit, otherwise the knee is measured on a light load and the chosen PPT
    penalizes real heavy loads."""
    if FAKE:
        return "matrixprod"
    best, watts_best = BENCH_METHODS[0], -1.0
    for m in BENCH_METHODS:
        _ops, w = bench(CORES * 2, method=m, seconds=6)
        if w > watts_best:
            best, watts_best = m, w
    return best


def bench(threads, core=None, method="matrixprod", seconds=None):
    """(bogo-ops/s, average W) of stress-ng for `seconds` (default BENCH_SEC); W from RAPL, fallback PM d[3]."""
    if FAKE:
        check_abort()
        if FAKE.s.get("bench_fail"):
            raise Unstable("simulato: benchmark terminated")
        return FAKE.bench(threads)
    sec = seconds or BENCH_SEC
    args = ["stress-ng", "--cpu", str(threads), "--cpu-method", method, "--metrics", "-Y", "/dev/stdout",
            "-t", str(sec), "-q"]
    if core is not None:
        args += ["--taskset", str(core)]
    e0, rng = rapl_energy()
    pm_samples = []
    t0, t0_epoch = time.monotonic(), time.time()
    p = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    _children.add(p)
    while p.poll() is None:
        check_abort()
        if e0 is None:
            pm_samples.append(read_limits().get("ppt") or 0)
        time.sleep(0.5)
    out = p.stdout.read()
    _children.discard(p)
    dt = max(0.1, time.monotonic() - t0)
    # A worker that dies (SIGSEGV/SIGILL) or an MCE error with the final CO applied is instability, not a
    # low metric: on the 9800X3D the fft bench at −37 died after 1 s and the next point locked up the system.
    if p.returncode != 0 or dt < 0.7 * sec or mce_since(t0_epoch):
        raise Unstable(_("stress-ng %s terminated after %.0f s (exit code %s) during the benchmark") % (method, dt, p.returncode))
    m = re.search(r"bogo-ops-per-second-real-time:\s*([0-9.]+)", out)
    if not m:
        raise Err(_("stress-ng reported no metrics"))
    if e0 is not None:
        e1, _rng = rapl_energy()
        watts = ((e1 - e0) % rng) / 1e6 / dt
    else:
        watts = sum(pm_samples) / max(1, len(pm_samples))
    return float(m.group(1)), round(watts, 1)


def best_core():
    """Core with the highest prefcore ranking (for the single-thread test)."""
    if FAKE:
        return 1
    best, rank = 0, -1
    for c in range(CORES):
        try:
            r = int(read_text("/sys/devices/system/cpu/cpu%s/cpufreq/amd_pstate_prefcore_ranking" % first_cpu(c)))
        except (OSError, ValueError):
            r = 0
        if r > rank:
            best, rank = c, r
    return best


def at_scaled_limits(base, ppt):
    """TDC/EDC in proportion to the chosen PPT, never below the floors."""
    k = ppt / float(base["ppt"])
    return {"ppt": ppt, "tdc": max(TDC_MIN, round(base["tdc"] * k)) if "tdc" in base else None,
            "edc": max(EDC_MIN, round(base["edc"] * k)) if "edc" in base else None}


def at_knee_step(ctx, st, base):
    """Auto: one point of the PPT sweep (multi-thread) or of the FMax sweep (single-thread); picks the
    lowest value with performance ≥ (100 − loss) % of the measured maximum."""
    k = st["knee"]
    loss = st["params"]["loss"] / 100.0
    k.setdefault("method", st.get("method") or heaviest_method())
    if st["phase"] == "ppt":
        v = k["ppt"]["current"]
        lim = at_scaled_limits(base, v)
        for key in ("ppt", "tdc", "edc"):
            if lim[key] is not None:
                run([key, str(lim[key])], ctx)
        pause(5)
        ops, watts = bench(CORES * 2, method=k["method"])
        k["ppt"]["tests"].append([v, ops, watts])
        best = max(t[1] for t in k["ppt"]["tests"])
        nxt = round(v - base["ppt"] * PPT_SWEEP_STEP)
        if ops < best * (1 - loss):
            k["ppt"]["chosen"] = k["ppt"]["tests"][-2][0] if len(k["ppt"]["tests"]) > 1 else v
        elif nxt < base["ppt"] * PPT_SWEEP_MIN or nxt < PPT_MIN:
            k["ppt"]["chosen"] = v
        else:
            k["ppt"]["current"] = nxt
            return
        lim = at_scaled_limits(base, k["ppt"]["chosen"])
        for key in ("ppt", "tdc", "edc"):
            if lim[key] is not None:
                run([key, str(lim[key])], ctx)
        st["phase"] = "fmax_knee"
        k["fmax"]["current"] = base["fmax"]
        return
    if st["phase"] == "fmax_knee":
        v = k["fmax"]["current"]
        run(["fmax", str(v)], ctx)
        pause(3)
        ops, watts = bench(1, best_core(), method=k["method"])
        k["fmax"]["tests"].append([v, ops, watts])
        best = max(t[1] for t in k["fmax"]["tests"])
        nxt = v - FMAX_STEP
        if ops < best * (1 - loss):
            k["fmax"]["chosen"] = k["fmax"]["tests"][-2][0] if len(k["fmax"]["tests"]) > 1 else v
        elif nxt < base["fmax"] - FMAX_KNEE_SPAN or nxt < FMAX_MIN:
            k["fmax"]["chosen"] = v
        else:
            k["fmax"]["current"] = nxt
            return
        at_finish_auto(ctx, st, base)


def boost_lines(st, base):
    """Boost: CO found, limits and FMax at the allowed caps (factory, or unlock), performance
    power profile, BIOS fans."""
    unlock = load_settings()["unlock"]
    lines = ["co " + " ".join(str(v) for v in st["final"])]
    for key in ("ppt", "tdc", "edc", "fmax"):
        if key in base:
            lines.append("%s %d" % (key, cap_of(base, key, unlock)))
    lines += [l for l in preset_lines("boost", base) if l.split()[0] not in ("co", "ppt", "tdc", "edc", "fmax", "fan")]
    return lines + at_fan_lines(st, base)


def at_boost_bench(ctx, st, base):
    """A single step: MT and ST performance at factory and with the boost profile → measured gain.
    The profile is proposed (`autotune save [apply]`), not written."""
    core, m = best_core(), st.get("method") or heaviest_method()
    apply_lines(profile_lines("baseline"), ctx, "cpu")
    pause(5)
    fab = {"mt": bench(CORES * 2, method=m), "st": bench(1, core, method=m)}
    lines = boost_lines(st, base)
    apply_lines([l.split() for l in lines], ctx)
    pause(5)
    bst = {"mt": bench(CORES * 2, method=m), "st": bench(1, core, method=m)}
    st["method"] = m
    st["bench"] = {"fabbrica": fab, "boost": bst,
                   "gain_mt_pct": round((bst["mt"][0] / fab["mt"][0] - 1) * 100, 1) if fab["mt"][0] else None,
                   "gain_st_pct": round((bst["st"][0] / fab["st"][0] - 1) * 100, 1) if fab["st"][0] else None}
    at_done(ctx, st, lines)


def at_finish_auto(ctx, st, base):
    """Auto profile: CO, limits and FMax at the knee, fans according to `fans` (default moderate)."""
    k = st["knee"]
    lim = at_scaled_limits(base, k["ppt"]["chosen"])
    co = "co " + " ".join(str(v) for v in st["final"])
    lines = [co] + ["%s %d" % (key, lim[key]) for key in ("ppt", "tdc", "edc") if lim[key] is not None]
    lines.append("fmax %d" % k["fmax"]["chosen"])
    lines += [l for l in preset_lines("auto", base) if l.split()[0] not in ("co", "ppt", "tdc", "edc", "fmax", "fan")]
    at_done(ctx, st, lines + at_fan_lines(st, base))


def at_done(ctx, st, lines):
    """Calibration finished: CPU back at baseline, profile only proposed. `autotune save [apply]`
    writes it; `autotune abort` discards it."""
    apply_lines(profile_lines("baseline"), ctx, "cpu")
    rm(marker("active"))
    st["phase"] = "done"
    st["profile_lines"] = lines


def at_known_bad(st, vals):
    """Has this CO combination already proved unstable (or is it more aggressive than an
    unstable one on every core)?"""
    return any(all(v <= f for v, f in zip(vals, ff["values"])) for ff in st.get("final_failures", []))


CRASH_MARGIN = 3   # the search ended with a system lock-up: the "stable" level below was one step from the crash


def at_margin(st):
    """Margin over the measured limit: the mode's own, +3 for each failed final pass, +3 if
    the search ended with a crash (the stable level was tried only for `step` seconds)."""
    crashed = any(u.get("why") == "crash" for u in st.get("unstable", {}).values())
    return st["params"]["margin"] + 3 * st.get("final_tries", 0) + (CRASH_MARGIN if crashed else 0)


def at_final_values(st):
    m = at_margin(st)
    return [min(0, st["results"].get(str(c), 0) + m) for c in range(CORES)]


def at_reused(mode, params):
    """Fields of a calibration that reuses the saved CO limit ({} if not reusable): final pass from
    the first margin not failed yet; for Eco also `eco_from`, the date of a recorded final pass at
    least as negative on every core (and not contradicted by a failure): already validated."""
    saved = co_limits_reusable(params)
    if not saved:
        return {}
    st = {"params": params, "phase": "final", "results": saved["results"], "unstable": saved["unstable"],
          "samples": saved.get("samples") or {}, "co_reused": saved["time"], "active_cores": [], "final_tries": 0,
          "final_failures": list(saved.get("final_failures", []))}
    while st["final_tries"] < FINAL_RETRIES and at_known_bad(st, at_final_values(st)):   # already failed (even with a crash): +3
        st["final_tries"] += 1
    vals = at_final_values(st)
    for ps in saved.get("final_passed", []) if mode == "eco" else []:
        if all(v <= e for v, e in zip(ps["values"], vals)) and not at_known_bad(st, ps["values"]):
            st["eco_from"] = ps["time"]
    return st


def at_mv_per_step(st):
    """Median of the slopes (V0 − Vlevel)/|level| over the cores tried at each level: robust
    to a sample taken under different conditions (frequency/temperature)."""
    smp = st.get("samples", {})
    ref = smp.get("0", {}).get("volt")
    if not ref:
        return None
    slopes = []
    for lvl, sm in smp.items():
        v = int(lvl)
        if v >= 0:
            continue
        for c in range(CORES):
            if sm["volt"][c] is not None and ref[c] is not None:
                slopes.append((ref[c] - sm["volt"][c]) * 1000.0 / -v)
    return round(median(slopes), 1) if slopes else None


def cmd_autotune(ctx, args):
    """autotune start eco|auto|boost [key=value…] | step | status | abort | save [apply] | estimate eco|auto|boost [key=value…]"""
    st = _autotune(ctx, args)
    if isinstance(st, dict) and st.get("phase"):
        st["eta"] = at_estimate(st)
        st["mv_per_step"] = at_mv_per_step(st)
        st["final_margin"] = at_margin(st)
    return st


def _autotune(ctx, args):
    if not args:
        raise Err(_("usage: autotune start eco|auto|boost [target=70 colimit=-40 margin=3 step=90 parallel=1 reuse=1] | step | status | abort | save [apply] | estimate eco|auto|boost […]"))
    if args[0] == "status":
        return at_load() or {"phase": None}
    if args[0] == "estimate":
        if len(args) < 2 or args[1] not in AT_DEFAULTS:
            raise Err(_("usage: autotune estimate eco|auto [key=value…]"))
        p = at_params(args[1], args[2:])
        reused = at_reused(args[1], p)
        return {"total_s": at_total_estimate(args[1], p),
                "parallel_total_s": at_total_estimate(args[1], dict(p, parallel=1)),
                "sequential_total_s": at_total_estimate(args[1], dict(p, parallel=0)), "params": p,
                "co_reuse": reused.get("co_reused"), "eco_from": reused.get("eco_from")}
    if args[0] == "abort":
        st = at_load()
        if st:
            at_attribute_crash(st)                     # a crash not yet attributed stays in memory
        rm(P(AT_PATH))
        if st:
            apply_lines(profile_lines("baseline"), ctx, "cpu")
            rm(marker("active"))                       # CPU state = baseline
        rm(P(AT_ABORT_FLAG))
        return {"phase": None, "aborted": bool(st)}
    if args[0] == "save":
        st = at_load()
        if not st or st["phase"] != "done" or not st.get("profile_lines"):
            raise Err(_("no completed calibration to save"))
        if args[1:] not in ([], ["apply"]):
            raise Err(_("usage: autotune save [apply]"))
        cmd_profile(ctx, ["save", st["mode"]] + st["profile_lines"])
        if args[1:]:
            run(["apply", st["mode"]], ctx)
            run(["use", st["mode"]], ctx)
        rm(P(AT_PATH))
        return {"phase": None, "saved": st["mode"], "applied": bool(args[1:])}
    if args[0] == "start":
        if len(args) < 2 or args[1] not in AT_DEFAULTS:
            raise Err(_("usage: autotune start eco|auto [key=value…]"))
        check_boost(args[1])
        check_cpu()
        why = co_support()
        if why:   # every calibration measures the CO
            raise Err(_("Curve Optimizer not available on this CPU: %s") % why)
        base = load_baseline()
        params = at_params(args[1], args[2:])
        rm(P(AT_ABORT_FLAG))
        st = {"mode": args[1], "params": params, "phase": "co", "core": 0, "value": -CO_STEP,
              "parallel": bool(params["parallel"]), "active_cores": list(range(CORES)),
              "results": {}, "unstable": {}, "in_progress": None, "final_tries": 0,
              "started": time.strftime("%Y-%m-%d %H:%M"), "resumed_after_crash": False,
              "eta_total": at_total_estimate(args[1], params)}   # fixed at start (afterwards the reuse would lower it)
        st.update(at_reused(args[1], params))       # limit already measured: only the final pass with this mode's margin
        if st.get("eco_from"):                      # Eco: these values already passed a final pass, no load test
            st["final"] = at_final_values(st)
            at_finish_eco(ctx, st, base)
        elif st["final_tries"] >= FINAL_RETRIES:
            raise Err(_("the combined CO already proved unstable up to margin +%d: raise margin or repeat the search with reuse=0")
                      % (params["margin"] + 3 * (FINAL_RETRIES - 1)))
        else:
            apply_lines(profile_lines("baseline"), ctx, "cpu")      # all cores at baseline
            st["method"] = heaviest_method()                        # probed at factory CO: used in the search, final pass and knee
            _failed, ref = co_test_parallel(list(range(CORES)), 9, st["method"])   # reference: voltages at factory CO, same load
            st["samples"] = st.get("samples") or {"0": ref}
        at_save(st)
        return st
    if args[0] != "step":
        raise Err(_("usage: autotune start|step|status|abort|save|estimate"))
    st = at_load()
    if not st or st["phase"] == "done":
        raise Err(_("no calibration in progress (autotune start eco|auto|boost)"))
    check_cpu()
    base = load_baseline()
    try:
        return at_step(ctx, st, base)
    except Aborted:
        st = at_load() or st
        st["in_progress"] = None
        st["interrupted"] = True          # no result recorded: `autotune abort` will do the rest
        at_save(st)
        return st


def at_attribute_crash(st):
    """The step in `in_progress` belongs to a previous boot: the system crashed during that
    test. State only, no SMU write (so that `boot` calls it too, and the memory of the
    failures is updated before the user chooses Resume or Cancel)."""
    ip = st.get("in_progress")
    if not ip or ip.get("boot_id") == boot_id():
        return False
    st["resumed_after_crash"] = True
    st["in_progress"] = None
    if ip["kind"] == "co":
        st["unstable"][str(ip["core"])] = {"value": ip["value"], "why": "crash"}
        st["results"].setdefault(str(ip["core"]), 0)
        st["core"] += 1                                # after the reboot the CPU is already at baseline
        st["value"] = -CO_STEP
        if st["core"] >= CORES:
            st["phase"] = "final"
            co_limits_save(st)
    elif ip["kind"] == "co_par":                       # not attributable: all cores under test unstable at v
        for c in ip["cores"]:
            st["unstable"][str(c)] = {"value": ip["value"], "why": "crash"}
            st["results"].setdefault(str(c), 0)
        st["active_cores"] = []
        st["phase"] = "final"
        co_limits_save(st)
    elif ip["kind"] == "final":
        at_final_failed(st, "crash")
    else:                                              # post: final CO applied, unstable combination
        at_post_failed(st, "crash")
    return True


def at_step(ctx, st, base):
    st.pop("interrupted", None)
    if at_attribute_crash(st):
        at_save(st)
        return st
    if st["phase"] == "co" and st.get("parallel"):
        v, cores = st["value"], st["active_cores"]
        st["in_progress"] = {"kind": "co_par", "cores": cores, "value": v, "boot_id": boot_id()}
        at_save(st)
        for c in cores:
            run(["co", str(c), str(v)], ctx)
        failed, sample = co_test_parallel(cores, st["params"]["step"], st.get("method", "all"))
        st["in_progress"] = None
        if sample:   # cores already out of the test are not at this level: sample not meaningful for them
            for key in ("volt", "mhz"):
                sample[key] = [sample[key][c] if c in cores else None for c in range(CORES)]
            st.setdefault("samples", {})[str(v)] = sample
        for c in cores:
            if c in failed:
                st["unstable"][str(c)] = {"value": v, "why": "instabile"}
                st["results"].setdefault(str(c), 0)
                run(["co", str(c), str(st["results"][str(c)])], ctx)   # back to the last stable value
            else:
                st["results"][str(c)] = v
        st["active_cores"] = [c for c in cores if c not in failed]
        if not st["active_cores"] or v - CO_STEP < st["params"]["colimit"]:
            st["phase"] = "final"
            co_limits_save(st)
        else:
            st["value"] = v - CO_STEP
        at_save(st)
        return st
    if st["phase"] == "co":
        c, v = st["core"], st["value"]
        st["in_progress"] = {"kind": "co", "core": c, "value": v, "boot_id": boot_id()}
        at_save(st)
        run(["co", str(c), str(v)], ctx)
        ok, sample = co_test_sampled([c], st["params"]["step"], st.get("method", "all"))
        st["in_progress"] = None
        if sample:
            st.setdefault("samples", {}).setdefault(str(v), {"volt": [None] * CORES, "mhz": [None] * CORES})
            st["samples"][str(v)]["volt"][c] = sample["volt"][c]
            st["samples"][str(v)]["mhz"][c] = sample["mhz"][c]
        if ok:
            st["results"][str(c)] = v
            if v - CO_STEP < st["params"]["colimit"]:
                at_next_core(st, base)
            else:
                st["value"] = v - CO_STEP
        else:
            at_core_failed(st, c, v, "instabile")
        at_save(st)
        return st
    if st["phase"] == "final":
        vals = at_final_values(st)
        st["in_progress"] = {"kind": "final", "boot_id": boot_id()}
        at_save(st)
        run(["co"] + [str(v) for v in vals], ctx)
        try:
            if "method" not in st:          # probed with the final CO applied: it is already part of the test
                st["method"] = heaviest_method()
            ok = co_test_final(st["method"], FINAL_SEC)
        except Unstable as e:
            LAST_FAIL["why"] = str(e)
            ok = False
        st["in_progress"] = None
        if ok:
            st["final"] = vals
            co_limits_note(st, "final_passed", {"values": vals, "time": time.strftime("%Y-%m-%d %H:%M"), "mode": st["mode"]})
            if st["mode"] == "eco":
                at_finish_eco(ctx, st, base)
            elif st["mode"] == "boost":
                st["phase"] = "bench"
            else:
                st["phase"] = "ppt"
                st["knee"] = {"method": st["method"], "ppt": {"current": base["ppt"], "tests": [], "chosen": None},
                              "fmax": {"current": None, "tests": [], "chosen": None}}
        else:
            at_final_failed(st)
        at_save(st)
        return st
    if st["phase"] in ("ppt", "fmax_knee", "bench"):
        # phases with the final CO applied: a crash or a load that dies = unstable combination
        st["in_progress"] = {"kind": "post", "boot_id": boot_id()}
        at_save(st)
        try:
            if st["phase"] == "bench":
                at_boost_bench(ctx, st, base)
            else:
                at_knee_step(ctx, st, base)
        except Unstable as e:
            at_post_failed(st, str(e))
        st["in_progress"] = None
        at_save(st)
        return st
    raise Err(_("unknown phase: %s") % st["phase"])


def at_post_failed(st, why):
    """Instability that emerged after the final pass (dead benchmark, crash): the CO combination is
    unstable → final pass repeated with +3 and the next phase from scratch."""
    at_final_failed(st, why)
    if st["phase"] != "done":
        st["phase"] = "final"
        st.pop("knee", None)


def at_core_failed(st, c, v, why):
    st["unstable"][str(c)] = {"value": v, "why": why}
    st["results"].setdefault(str(c), 0)             # last stable: the one already recorded, or 0
    at_next_core(st, load_baseline())


def at_next_core(st, base):
    run(["co", str(st["core"]), str(base["co"][st["core"]])], {})   # the core goes back to baseline until the final pass
    st["core"] += 1
    st["value"] = -CO_STEP
    if st["core"] >= CORES:
        st["phase"] = "final"
        co_limits_save(st)


def at_final_failed(st, why=None):
    """The combined pass failed: it is recorded and retried with +3 on all cores
    (the measured per-core limits stay unchanged)."""
    entry = {"values": at_final_values(st), "why": why or LAST_FAIL["why"] or "crash"}
    st.setdefault("final_failures", []).append(entry)
    co_limits_note(st, "final_failures", entry)
    st["final_tries"] += 1
    if st["final_tries"] >= FINAL_RETRIES:
        st["phase"] = "done"
        st["error"] = _("final pass unstable even with the increased margin: CO left at baseline")
        run(["apply", "baseline", "cpu"], {})


def bios_curve(d, n):
    """BIOS curve of channel n as [(°C, pwm)]: from the baseline, captured at boot before any profile (a
    profile's curve must never be raised again by a recalibration); the chip's current curve only if the
    baseline has none (fan roles assigned after boot)."""
    for t in profile_lines("baseline"):
        if t[:3] == ["fan", str(n), "curve"]:
            return [tuple(int(x) for x in p.split(":")) for p in t[3:]]
    return [tuple(int(x) for x in p.split(":")) for p in fan_info(d, n)["curva"]]


def at_fan_lines(st, base):
    """Fan lines of a calibration according to `fans` (see FAN_STEPS); only "ventola" (fan) channels."""
    d = fans_dir()
    if not d:
        return []
    level, lines = st["params"].get("fans", 0), []
    for n in fan_channels(d):
        if fan_role(n) != "ventola":
            continue
        if not level:   # BIOS: the baseline steps and curve, written out so the proposal shows them
            lines += [" ".join(t) for t in profile_lines("baseline") if t[:3] in (["fan", str(n), "step"], ["fan", str(n), "curve"])]
            continue
        bios = bios_curve(d, n)
        if level == 1:   # the BIOS shape, 10 % higher, full speed at 100 °C instead of its last point (125 °C)
            full = min(bios[-1][0], FAN_FULL_TEMP)
            pts = [(t, min(255, pw + FAN_RAISE_PWM)) for t, pw in bios if t < full] + [(full, 255)]
        else:
            tj = min(base.get("tjmax", TJMAX_ABS_MAX), PRESETS[st["mode"]]["tjmax"] or TJMAX_ABS_MAX)
            lo = st["params"].get("target", AT_DEFAULTS["eco"]["target"]) - 10
            pts = [(lo, max(FAN_PWM_MIN, bios[0][1])), (max(tj - 5, lo + 5), 255)]
        lines.append("fan %d step %d %d" % ((n,) + FAN_STEPS[level]))
        lines.append("fan %d curve %s" % (n, " ".join("%d:%d" % p for p in pts)))
    return lines


def at_finish_eco(ctx, st, base):
    """Eco profile: the validated final CO (Auto's undervolt) with the Eco preset (limits, FMax,
    Tjmax, power profile), fans according to `fans` (default quiet)."""
    lines = ["co " + " ".join(str(v) for v in st["final"])]
    lines += [l for l in preset_lines("eco", base) if l.split()[0] not in ("co", "fan")]
    at_done(ctx, st, lines + at_fan_lines(st, base))


# ---- Crash guard: dirty / active / crashed markers -----------------------------------------
def marker(name):
    return P(STATE + "/" + name)


def rm(path):
    try:
        os.remove(path)
    except OSError:
        pass


def crashed_info():
    try:
        return json.loads(open(marker("crashed")).read())
    except (OSError, ValueError):
        return None


def apply_autostart(ctx, parts):
    """Applies the startup profile (if enabled and not in crashed state). Never an exception:
    the service must stay active so that ExecStop can remove `dirty`."""
    s = load_settings()
    out = {"profile": s["profile"], "autostart": s["autostart"], "crashed": crashed_info(), "applied": {}, "errors": {}}
    if not (s["autostart"] and s["profile"]):
        return out
    for part in parts:
        if part == "cpu" and out["crashed"]:
            out["errors"][part] = _("CPU profile not applied: crash in the previous boot")
            continue
        try:
            out["applied"][part] = cmd_apply(ctx, [s["profile"], part])["applied"]   # same checks as `apply` (Boost)
        except Err as e:
            out["errors"][part] = str(e)
    return out


def cmd_boot(ctx, args):
    os.makedirs(P(STATE), exist_ok=True)
    os.makedirs(P(RUN), exist_ok=True)
    out = {}
    if os.path.exists(P(RUN + "/booted")):          # restart in the same boot: ExecStop removed dirty
        touch_sync(marker("dirty"))
    else:
        s = load_settings()
        if os.path.exists(marker("dirty")) and os.path.exists(marker("active")):
            write_atomic(marker("crashed"), json.dumps({"time": time.strftime("%Y-%m-%d %H:%M"),
                                                        "profile": s["profile"]}))
        rm(marker("active"))
        touch_sync(marker("dirty"))                 # before any SMU write
        touch_sync(P(RUN + "/booted"))
        st = load_settings()                        # the BIOS reprogrammed the pump: cap to be reapplied
        for f in st.get("fans", {}).values():
            f.pop("pump_max", None)
        save_settings(st)
        try:
            cmd_baseline(ctx, [])
        except Err as e:
            out["baseline_error"] = str(e)
    try:                                            # calibration interrupted by a crash: attributed at once
        at = at_load()
        if at and at_attribute_crash(at):
            at_save(at)
            out["autotune_crash"] = at["phase"]
    except Exception as e:  # boot must never fail
        out["autotune_error"] = str(e)
    out.update(apply_autostart(ctx, ("fan", "cpu")))
    return out


def cmd_shutdown(ctx, args):
    rm(marker("dirty"))
    return {"dirty": False}


def cmd_resume(ctx, args):
    return apply_autostart(ctx, ("fan", "cpu"))


def cmd_default(ctx, args):
    done = apply_lines(profile_lines("baseline"), ctx)
    rm(marker("active"))
    s = load_settings()
    s["autostart"] = False
    s["profile"] = None          # Default = no profile selected (the GUI derives the mode from here)
    save_settings(s)
    return {"applied": done, "autostart": False, "profile": None}


def cmd_crashed(ctx, args):
    if args == ["clear"]:
        rm(marker("crashed"))
        return {"crashed": None}
    if args:
        raise Err(_("usage: crashed [clear]"))
    return {"crashed": crashed_info()}


def cmd_notify(ctx, args):
    """From the user's XDG autostart: warns if the previous boot ended with a crash. A click
    on the notification opens Ryzen Control (notify-send --action waits for the choice; with a
    libnotify without --action the plain notification remains)."""
    info = crashed_info()
    if info:
        msg = _("Profile '%s' has been disabled: the system crashed (%s). Click to open Ryzen Control and decide.") % (
            info.get("profile") or "-", info.get("time", "?"))
        if FAKE:  # the selftest runs in the user's session: no real notifications
            FAKE.s["notified"] = msg
            FAKE.save()
        else:
            cmd = ["notify-send", "-u", "critical", "-a", "Ryzen Control", "-i", "org.ryzencontrol.RyzenControl",
                   "-h", "string:desktop-entry:org.ryzencontrol.RyzenControl", "Ryzen Control", msg]
            r = subprocess.run(cmd[:1] + ["-A", "default=" + _("Open Ryzen Control")] + cmd[1:], capture_output=True, text=True)
            if r.returncode != 0:
                subprocess.run(cmd, capture_output=True)
            elif r.stdout.strip() == "default":
                subprocess.Popen(["ryzen-control"], start_new_session=True, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return {"crashed": info}


# ---- Fans (nct6775 via hwmon) ----------------------------------------------------------
def pause(seconds):
    if not FAKE:
        time.sleep(seconds)


def fans_dir():
    """hwmon directory of the Nuvoton Super I/O, or None."""
    try:
        for d in sorted(os.listdir(P(HWMON))):
            try:
                if read_text("%s/%s/name" % (HWMON, d)).startswith("nct6"):
                    return HWMON + "/" + d
            except OSError:
                pass
    except OSError:
        pass
    return None


def hw_read(path):
    return int(read_text(path))


def hw_write(path, value):
    with open(P(path), "w") as f:
        f.write(str(int(value)))
    if FAKE:
        FAKE.after_fan_write(path, int(value))


def fan_channels(d):
    """Indices N with pwmN and fanN_input present."""
    out = []
    for f in sorted(os.listdir(P(d))):
        if re.fullmatch(r"pwm\d+", f) and os.path.exists(P("%s/fan%s_input" % (d, f[3:]))):
            out.append(int(f[3:]))
    return sorted(out)


def fan_points(d, n):
    k = 1
    while os.path.exists(P("%s/pwm%d_auto_point%d_temp" % (d, n, k))):
        k += 1
    return k - 1


def fan_roles():
    return load_settings().get("fans", {})


def fan_role(n):
    return fan_roles().get(str(n), {}).get("role", "sconosciuto")


def fan_set_role(n, role, why=""):
    s = load_settings()
    s.setdefault("fans", {}).setdefault(str(n), {})
    s["fans"][str(n)].update({"role": role, "why": why})
    save_settings(s)


def fan_require_writable(n):
    if fan_role(n) != "ventola":
        raise Err(_("channel %d not writable: role '%s' (only 'ventola', assigned by `fan autodetect`)") % (n, fan_role(n)))


def fan_curve_compact(points):
    """The filler points after the first one at pwm 255 (written by `fan curve` to complete the
    SmartFan) add no information: the curve comes back in the form it was written in."""
    out = []
    for t, pw in points:
        out.append("%d:%d" % (t, pw))
        if pw == 255:
            break
    return out


def fan_info(d, n):
    info = {"canale": n, "rpm": hw_read("%s/fan%d_input" % (d, n)), "pwm": hw_read("%s/pwm%d" % (d, n)),
            "modo": hw_read("%s/pwm%d_enable" % (d, n)),
            "step_up_ms": hw_read("%s/pwm%d_step_up_time" % (d, n)),
            "step_down_ms": hw_read("%s/pwm%d_step_down_time" % (d, n)),
            "curva": fan_curve_compact([(hw_read("%s/pwm%d_auto_point%d_temp" % (d, n, k)) // 1000,
                                         hw_read("%s/pwm%d_auto_point%d_pwm" % (d, n, k))) for k in range(1, fan_points(d, n) + 1)])}
    info.update({k: v for k, v in fan_roles().get(str(n), {"role": "sconosciuto"}).items() if k != "bios_curve"})
    return info


def fan_points_raw(d, n):
    return [(hw_read("%s/pwm%d_auto_point%d_temp" % (d, n, k)) // 1000, hw_read("%s/pwm%d_auto_point%d_pwm" % (d, n, k)))
            for k in range(1, fan_points(d, n) + 1)]


def fan_points_write(d, n, pts):
    for i, (t, pw) in enumerate(pts, 1):
        hw_write("%s/pwm%d_auto_point%d_temp" % (d, n, i), t * 1000)
        hw_write("%s/pwm%d_auto_point%d_pwm" % (d, n, i), pw)


def pump_settings(n):
    return load_settings().get("fans", {}).get(str(n), {})


def fan_capture_lines():
    d = fans_dir()
    if not d:
        return []
    lines = []
    for n in fan_channels(d):
        role = fan_role(n)
        if role == "ventola":
            i = fan_info(d, n)
            lines.append("fan %d step %d %d" % (n, i["step_up_ms"], i["step_down_ms"]))
            lines.append("fan %d curve %s" % (n, " ".join(i["curva"])))
        elif role == "pompa":
            i, ps = fan_info(d, n), pump_settings(n)
            if i["modo"] == 1:
                lines.append("fan %d pump %d" % (n, round(i["pwm"] * 100 / 255)))
            elif ps.get("pump_max"):
                lines.append("fan %d pump max %d" % (n, ps["pump_max"]))
            else:
                lines.append("fan %d pump auto" % n)
                st = load_settings()                      # reference BIOS curve (for `pump auto`)
                st.setdefault("fans", {}).setdefault(str(n), {"role": "pompa"})["bios_curve"] = fan_points_raw(d, n)
                save_settings(st)
    return lines


def fan_need(d_or_none):
    if not d_or_none:
        raise Err(_("no nct67xx chip in hwmon: `fan enable` (nct6775 module, kernel parameter if needed)"))
    return d_or_none


def median(values):
    v = sorted(values)
    return v[len(v) // 2]


def tctl_median(seconds):
    if FAKE:
        return tctl()
    samples = []
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        samples.append(tctl())
        time.sleep(0.25)
    return median(samples)


def cmd_fan_autodetect(ctx, d):
    """Roles from the physical behaviour, without human intervention (see the FAN_* constants)."""
    channels = [n for n in fan_channels(d) if hw_read("%s/fan%d_input" % (d, n)) > 0]
    if not channels:
        raise Err(_("no channel with rpm > 0"))
    load = None
    if not FAKE:
        try:
            load = subprocess.Popen(["stress-ng", "--cpu", "4", "--quiet"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            raise Err(_("stress-ng not installed: required for the test load"))
    results = {}
    try:
        pause(10)   # load at steady state
        for n in channels:
            enable, pwm = hw_read("%s/pwm%d_enable" % (d, n)), hw_read("%s/pwm%d" % (d, n))
            rpm0 = hw_read("%s/fan%d_input" % (d, n))
            t0 = tctl_median(5)
            peak, aborted = 0.0, False
            test_pwm = max(FAN_TEST_MIN_PWM, min(FAN_TEST_PWM, int(pwm * 0.6)))
            try:
                hw_write("%s/pwm%d_enable" % (d, n), 1)
                hw_write("%s/pwm%d" % (d, n), test_pwm)
                end = time.monotonic() + (0 if FAKE else FAN_TEST_SEC)
                while True:
                    t = tctl()
                    peak = max(peak, t - t0)
                    if t > FAN_ABORT_TCTL or peak > FAN_ABORT_DT:
                        aborted = True
                        break
                    if time.monotonic() >= end:
                        break
                    time.sleep(0.5)
                rpm1 = hw_read("%s/fan%d_input" % (d, n))
                dt = max(peak, tctl_median(5) - t0) if not aborted else peak
            finally:
                hw_write("%s/pwm%d" % (d, n), pwm)
                hw_write("%s/pwm%d_enable" % (d, n), enable)
            rpm_changed = abs(rpm1 - rpm0) >= FAN_RPM_CHANGE * max(rpm0, 1)
            if aborted or dt >= FAN_PUMP_DT:
                role = "pompa"
            elif not rpm_changed:
                role = "non-controllabile"     # 3-pin fan or pump at fixed 12 V: protected
            elif rpm1 >= FAN_PUMP_RPM:
                role = "pompa"
            elif dt < FAN_FAN_DT:
                role = "ventola"
            else:
                role = "sconosciuto"
            why = _("ΔTctl %.1f °C, rpm %d→%d at %d%%%s") % (dt, rpm0, rpm1, test_pwm * 100 // 255, _(", aborted") if aborted else "")
            fan_set_role(n, role, why)
            results[n] = {"ruolo": role, "perché": why}
            pause(10)   # back to steady state before the next channel
    finally:
        if load:
            load.terminate()
            load.wait()
    return results


def cmd_fan(ctx, args):
    """fan status | autodetect | identify N | role N pompa|sconosciuto | name N <name> |
    enable | disable | <N> step <up_ms> <down_ms> | <N> curve t:pwm …"""
    if not args:
        raise Err(_("usage: fan status|autodetect|identify N|role N pompa|sconosciuto|name N <name>|enable|disable|<N> step <up> <down>|<N> curve t:pwm …"))
    if args[0] == "enable":
        return fan_enable(ctx)
    if args[0] == "disable":
        return fan_disable(ctx)
    d = fan_need(fans_dir())
    if args == ["status"]:
        return {"chip": read_text(d + "/name"), "canali": [fan_info(d, n) for n in fan_channels(d)]}
    if args == ["autodetect"]:
        if ctx.get("dry"):
            return {}
        return cmd_fan_autodetect(ctx, d)
    if len(args) == 2 and args[0] == "identify":
        n = to_int(args[1], _("channel"))
        enable, pwm = hw_read("%s/pwm%d_enable" % (d, n)), hw_read("%s/pwm%d" % (d, n))
        try:
            hw_write("%s/pwm%d_enable" % (d, n), 1)
            hw_write("%s/pwm%d" % (d, n), 255)
            pause(5)
            rpm = hw_read("%s/fan%d_input" % (d, n))
        finally:
            hw_write("%s/pwm%d" % (d, n), pwm)
            hw_write("%s/pwm%d_enable" % (d, n), enable)
        s = load_settings()
        s.setdefault("fans", {}).setdefault(str(n), {"role": "sconosciuto"})["rpm_max"] = rpm   # to estimate the rpm from the %
        save_settings(s)
        return {"canale": n, "rpm_al_100": rpm}
    if len(args) == 3 and args[0] == "role":
        n = to_int(args[1], _("channel"))
        if args[2] not in ("pompa", "sconosciuto"):
            raise Err(_("manually you can only demote: role N pompa|sconosciuto ('ventola' only from autodetect)"))
        fan_set_role(n, args[2], _("set manually"))
        return {"canale": n, "ruolo": args[2]}
    if len(args) >= 3 and args[0] == "name":
        n = to_int(args[1], _("channel"))
        s = load_settings()
        s.setdefault("fans", {}).setdefault(str(n), {"role": "sconosciuto"})["name"] = " ".join(args[2:])
        save_settings(s)
        return {"canale": n, "nome": " ".join(args[2:])}
    n = to_int(args[0], _("channel"))
    if n not in fan_channels(d):
        raise Err(_("channel %d does not exist (%s)") % (n, ", ".join(str(c) for c in fan_channels(d))))
    if len(args) == 4 and args[1] == "step":
        up, down = to_int(args[2], "step up"), to_int(args[3], "step down")
        check_range("step up", up, 0, FAN_STEP_MAX_MS, " ms")
        check_range("step down", down, 0, FAN_STEP_MAX_MS, " ms")
        fan_require_writable(n)
        if ctx.get("dry"):
            return {"canale": n, "step": [up, down]}
        for attr, v in (("step_up_time", up), ("step_down_time", down)):
            hw_write("%s/pwm%d_%s" % (d, n, attr), v)
            got = hw_read("%s/pwm%d_%s" % (d, n, attr))
            if abs(got - v) > FAN_STEP_TOL_MS and not v < got <= FAN_STEP_MIN_MS:
                raise Err(_("fan %d %s: wrote %d but read back %d") % (n, attr, v, got))
        return {"canale": n, "step": [hw_read("%s/pwm%d_step_up_time" % (d, n)), hw_read("%s/pwm%d_step_down_time" % (d, n))]}
    if len(args) in (3, 4) and args[1] == "pump":
        if fan_role(n) != "pompa":
            raise Err(_("channel %d is not a pump (role '%s'; only role 'pompa')") % (n, fan_role(n)))
        if args[2:] == ["auto"]:
            if ctx.get("dry"):
                return {"canale": n, "pump": "auto"}
            st = load_settings()
            ps = st.setdefault("fans", {}).setdefault(str(n), {"role": "pompa"})
            if ps.get("pump_max") and ps.get("bios_curve"):   # removes the cap: BIOS curve
                fan_points_write(d, n, [tuple(p) for p in ps["bios_curve"]])
            ps.pop("pump_max", None)
            save_settings(st)
            hw_write("%s/pwm%d_enable" % (d, n), ps.get("enable_auto", 5))   # back to the BIOS SmartFan
            return {"canale": n, "pump": "auto", "modo": hw_read("%s/pwm%d_enable" % (d, n)), "curva": fan_info(d, n)["curva"]}
        if len(args) == 4 and args[2] == "max":
            cap = to_int(args[3], _("pump max %"))
            check_range(_("pump max"), cap, FAN_PUMP_MIN_PCT, 100, " %")
            if ctx.get("dry"):
                return {"canale": n, "pump_max": cap}
            st = load_settings()
            ps = st.setdefault("fans", {}).setdefault(str(n), {"role": "pompa"})
            if hw_read("%s/pwm%d_enable" % (d, n)) == 1:          # from fixed speed to the BIOS curve with the cap
                hw_write("%s/pwm%d_enable" % (d, n), ps.get("enable_auto", 5))
            if not ps.get("pump_max") or not ps.get("bios_curve"):
                ps["bios_curve"] = fan_points_raw(d, n)              # the current curve is the BIOS one
            cap_pwm = round(cap * 255 / 100)
            fan_points_write(d, n, [(t, min(pw, cap_pwm)) for t, pw in ps["bios_curve"]])
            ps["pump_max"] = cap
            save_settings(st)
            return {"canale": n, "pump_max": cap, "curva": fan_info(d, n)["curva"]}
        if len(args) != 3:
            raise Err(_("usage: fan <N> pump auto | fan <N> pump max <50-100> | fan <N> pump <50-100>"))
        pct = to_int(args[2], _("pump %"))
        check_range(_("pump"), pct, FAN_PUMP_MIN_PCT, 100, " %")
        if ctx.get("dry"):
            return {"canale": n, "pump": pct}
        enable = hw_read("%s/pwm%d_enable" % (d, n))
        if enable != 1:                                       # remember the BIOS mode for `pump auto`
            s = load_settings()
            s.setdefault("fans", {}).setdefault(str(n), {"role": "pompa"})["enable_auto"] = enable
            save_settings(s)
            hw_write("%s/pwm%d_enable" % (d, n), 1)
        pwm = round(pct * 255 / 100)
        hw_write("%s/pwm%d" % (d, n), pwm)
        got = hw_read("%s/pwm%d" % (d, n))
        if abs(got - pwm) > FAN_PUMP_TOL:
            raise Err(_("pump %d: wrote pwm %d but read back %d") % (n, pwm, got))
        st = load_settings()
        if st.get("fans", {}).get(str(n), {}).pop("pump_max", None) is not None:
            save_settings(st)
        return {"canale": n, "pump": pct, "pwm": got, "rpm": hw_read("%s/fan%d_input" % (d, n))}
    if len(args) >= 3 and args[1] == "curve":
        pts = []
        for p in args[2:]:
            try:
                t, pw = (int(x) for x in p.split(":"))
            except ValueError:
                raise Err(_("curve point '%s': expected temperature:pwm (e.g. 60:150)") % p)
            pts.append((t, pw))
        k = fan_points(d, n)
        if not 1 <= len(pts) <= k:
            raise Err(_("curve: 1 to %d points for channel %d") % (k, n))
        for i, (t, pw) in enumerate(pts):
            check_range("pwm", pw, FAN_PWM_MIN, 255)
            if i and (t <= pts[i - 1][0] or pw < pts[i - 1][1]):
                raise Err(_("curve: temperatures must increase and pwm must not decrease"))
        if pts[-1][1] != 255 or pts[-1][0] > FAN_CURVE_LAST_TEMP_MAX:
            raise Err(_("curve: the last point must be pwm 255 at <= %d °C") % FAN_CURVE_LAST_TEMP_MAX)
        fan_require_writable(n)
        if ctx.get("dry"):
            return {"canale": n, "curva": ["%d:%d" % p for p in pts]}
        while len(pts) < k:   # remaining points: full speed, one degree further
            pts.append((pts[-1][0] + 1, 255))
        for i, (t, pw) in enumerate(pts, 1):
            hw_write("%s/pwm%d_auto_point%d_temp" % (d, n, i), t * 1000)
            hw_write("%s/pwm%d_auto_point%d_pwm" % (d, n, i), pw)
        return {"canale": n, "curva": fan_info(d, n)["curva"]}
    raise Err(_("usage: fan <N> step <up_ms> <down_ms> | fan <N> curve t:pwm … | fan <N> pump auto|max <50-100>|<50-100>"))


def fan_enable(ctx):
    """Loads nct6775 and makes it permanent; if the chip does not show up, adds the kernel
    parameter acpi_enforce_resources=lax (grubby) and asks for a reboot."""
    write_atomic(P("/etc/modules-load.d/nct6775.conf"), "nct6775\n")
    out = {"modules-load": True}
    if FAKE:
        FAKE.s["modprobe"] = "nct6775"
        FAKE.save()
    else:
        subprocess.run(["modprobe", "nct6775"], capture_output=True)
    if fans_dir():
        out["chip"] = read_text(fans_dir() + "/name")
        return out
    cmdline = FAKE.s.get("cmdline", "") if FAKE else read_text("/proc/cmdline")
    if "acpi_enforce_resources=lax" in cmdline:
        raise Err(_("nct6775 loaded but no nct67xx chip in hwmon: Super I/O not reachable via LPC"))
    if FAKE:
        FAKE.s["cmdline"] += " acpi_enforce_resources=lax"
        FAKE.save()
        out["grubby"] = True
    elif subprocess.run(["grubby", "--update-kernel=ALL", "--args=acpi_enforce_resources=lax"], capture_output=True).returncode == 0:
        out["grubby"] = True
    else:
        raise Err(_("ACPI conflict: add acpi_enforce_resources=lax to the kernel command line (GRUB_CMDLINE_LINUX_DEFAULT) and reboot"))
    out["riavvio_necessario"] = True
    return out


def fan_disable(ctx):
    rm(P("/etc/modules-load.d/nct6775.conf"))
    if FAKE:
        FAKE.s["cmdline"] = FAKE.s.get("cmdline", "").replace(" acpi_enforce_resources=lax", "")
        FAKE.save()
    else:
        subprocess.run(["grubby", "--update-kernel=ALL", "--remove-args=acpi_enforce_resources=lax"], capture_output=True)
    return {"modules-load": False, "grubby": False}


def fmt_fan(r):
    if "canali" not in r:
        return json.dumps(r, ensure_ascii=False)
    lines = [_("Chip %s") % r["chip"]]
    for c in r["canali"]:
        lines.append(_("pwm%-2d %-17s %5d rpm  pwm %3d  mode %d  step %d/%d ms  curve %s%s") % (
            c["canale"], c.get("role", "sconosciuto") + (" (%s)" % c["name"] if c.get("name") else ""),
            c["rpm"], c["pwm"], c["modo"], c["step_up_ms"], c["step_down_ms"], " ".join(c["curva"]),
            "  [%s]" % c["why"] if c.get("why") else ""))
    return "\n".join(lines)


# ---- hwtest: automatic and reversible check on hardware ------------------------------
def cmd_hwtest(ctx, args):
    """For each command: a value slightly away from the baseline, readback, then the baseline
    value. Continues even if a step fails; at the end reapplies the baseline."""
    check_cpu()
    base = load_baseline()
    last = CORES - 1   # the last core (7 on 8 cores)
    no_co = co_support()
    steps = [("co", [str(last), str(max(CO_MIN, base["co"][last] - 3))], [str(last), str(base["co"][last])]) if not no_co
             else ("co", None, _("skipped: %s") % no_co),
             ("fmax", [str(max(FMAX_MIN, base["fmax"] - 200))], [str(base["fmax"])])]
    for key, floor, delta in (("ppt", PPT_MIN, 12), ("tdc", TDC_MIN, 10), ("edc", EDC_MIN, 10), ("tjmax", TJMAX_MIN, 10)):
        if key in base:
            steps.append((key, [str(max(floor, base[key] - delta))], [str(base[key])]))
        else:
            steps.append((key, None, _("skipped: no baseline (PM table missing)")))
    results, failed = {}, False
    for key, test, restore in steps:
        if test is None:
            results[key] = restore   # the reason of the skip
            continue
        try:
            run([key] + test, ctx)
            run([key] + restore, ctx)
            results[key] = "ok (%s -> %s)" % (" ".join(test), " ".join(restore))
        except Err as e:
            results[key] = _("error: %s") % e
            failed = True
    try:
        apply_lines(profile_lines("baseline"), ctx)
        rm(marker("active"))
        results["baseline"] = _("restored")
    except Err as e:
        results["baseline"] = _("error restoring the baseline: %s") % e
        failed = True
    results["esito"] = _("FAILED") if failed else "ok"
    return results


def fmt_hwtest(r):
    return "\n".join("%-9s %s" % (k, v) for k, v in r.items())


# ---- serve: protocol for the GUI (one JSON line per request and per reply) ---------
SERVE_DENY = {"serve", "boot", "shutdown", "resume", "selftest"}   # autotune step is allowed: the GUI drives it


def serve_one(line):
    try:
        argv = json.loads(line)
        if not isinstance(argv, list) or not all(isinstance(a, str) for a in argv) or not argv:
            raise Err(_("invalid request: expected a JSON array of strings"))
        if argv[0] in SERVE_DENY:
            raise Err(_("command '%s' not available via serve") % argv[0])
        return {"ok": True, "data": run(argv)}
    except Err as e:
        return {"ok": False, "error": str(e)}
    except Exception as e:  # never die on a bug: the GUI shows the error
        return {"ok": False, "error": _("internal: %r") % e}


def cmd_serve(ctx, args):
    """Requests run in order on a single thread (serialized SMU); the reader stays
    free so that `autotune abort` interrupts a long step at once (flag + stress-ng terminated)."""
    import queue
    import threading
    q = queue.Queue()

    def worker():
        while True:
            line = q.get()
            if line is None:
                return
            sys.stdout.write(json.dumps(serve_one(line), ensure_ascii=False) + "\n")
            sys.stdout.flush()
    t = threading.Thread(target=worker, daemon=True)
    t.start()
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            if json.loads(line) == ["autotune", "abort"]:
                at_request_abort()
        except ValueError:
            pass
        q.put(line)
    q.put(None)
    t.join()


