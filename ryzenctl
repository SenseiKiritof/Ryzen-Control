    run(["boot"])
    run(["ppt", "162"])
    assert run(["resume"])["applied"]["cpu"] and run(["status"])["limits"]["ppt"] == 150.0
    write_atomic(marker("crashed"), json.dumps({"time": "x", "profile": "quiet"}))
    run(["ppt", "162"])
    assert "crash" in run(["resume"])["errors"]["cpu"] and run(["status"])["limits"]["ppt"] == 162.0
    run(["crashed", "clear"])
    # 7. default: everything at baseline, active gone, autostart off; a crash afterwards is not our fault
    run(["apply", "quiet"])
    with open(P(STATE + "/baseline.conf"), "a") as f:   # baseline of an old version with a shaper line
