    expect_err(["autotune", "estimate", "eco", "parallel=2"], "fuori")
    st = run(["autotune", "start", "eco", "step=9"])
    assert st["phase"] == "co" and st["params"]["colimit"] == -25 and st["params"]["step"] == 9 and st["parallel"]
    assert st["eta"]["remaining_s"] == 5 * 9 + 300 + 300 and st["eta"]["total_s"] == 5 * 9 + 300 + 300, st["eta"]
    steps = 0
    for _ in range(200):
        st = run(["autotune", "step"])
        steps += 1
        if st["phase"] == "done":
            break
    assert steps == 5 + 1 + 7 and st["eta"]["remaining_s"] == 0, steps   # 5 livelli in parallelo, finale, 7 FMax
    assert st["samples"]["0"]["volt"][0] == 1.25 and st["samples"]["-20"]["volt"][0] == 1.19, st["samples"]   # −20 ≈ −60 mV nel finto
    assert run(["telemetry"])["cores"][0]["volt"] is not None
    assert run(["status"])["limits"]["ppt"] == 89.0 and run(["status"])["limits"]["tjmax"] == 80.0
    assert st["phase"] == "done" and "error" not in st, st
    # core 7 stabile fino a -15, instabile a -20 → finale -15+5 = -10; gli altri arrivano al limite -25 → -20
    assert st["final"] == [-20] * 7 + [-10] and st["unstable"]["7"]["value"] == -20, st["final"]
    assert st["fmax"]["chosen"] == 4625 and st["fmax"]["tests"][0][0] == 5225, st["fmax"]
    eco = run(["profile", "show", "eco"])["lines"]
