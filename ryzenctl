_T = None


def _(s):
    """Translate a user-facing message (domain 'ryzenctl'); catalogs come from RYZEN_CONTROL_LOCALEDIR or the system locale dir; selftest disables them so its English assertions are stable."""
    global _T
    if _T is None:
        _T = gettext.translation("ryzenctl", localedir=os.environ.get("RYZEN_CONTROL_LOCALEDIR"), fallback=True)
    return _T.gettext(s)


