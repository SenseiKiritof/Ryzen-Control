    run(["profile", "delete", "f"])

    # ---- preset ----
    pl = run(["preset", "eco", "show"])["lines"]
    assert "ppt 89" in pl and "tdc 76" in pl and "edc 149" in pl and "fmax 4825" in pl and "tjmax 80" in pl and "power balanced" in pl, pl
    assert "fan 1 step 10000 5000" in pl and not any(l.startswith("fan 2") for l in pl)
    assert run(["preset", "auto"])["saved"] == "auto" and "auto" in run(["profile", "list"])["profiles"]
