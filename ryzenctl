    assert run(["profile", "save", "quiet", "ppt 150", "co all -10", "# comment", "fmax 5000", "power balanced"])["lines"] == 4
    assert run(["profile", "list"]) == {"profiles": ["quiet"], "active": None}
    shown = run(["profile", "show", "quiet"])["lines"]
    # a profile shows and applies the stock values of what it does not set, first, then its own lines
    assert shown[-4:] == ["ppt 150", "co all -10", "fmax 5000", "power balanced"] and "tdc 120" in shown and "edc 180" in shown, shown
    assert not any(l.startswith("co ") for l in shown[:-4]), shown   # "co all" sets every core: no stock co line
    expect_err(["apply", "nope"], "does not exist")
    expect_err(["autostart", "on"], "no profile")
    assert run(["use", "quiet"]) == {"profile": "quiet"}

    # ---- crash guard ----
    def reboot():
        """Simulated reboot: /run emptied, SMU back to the BIOS values."""
        for f in os.listdir(P(RUN)):
            os.remove(P(RUN + "/" + f))
        FAKE.s.update({k: FAKE.default[k] for k in ("co", "fmax", "ppt", "tdc", "edc", "thm", "shaper")})
        FAKE.s["co"] = list(FAKE.default["co"])
