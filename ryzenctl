    assert "fan 1 step 10000 5000" in eco and "fan 1 curve 60:77 75:255" in eco, eco
    assert run(["status"])["profile"] == "eco" and run(["status"])["co"][7] == -10
    # ripresa dopo crash (core per core): il passo in corso diventa instabile, si passa al core successivo
    st = run(["autotune", "start", "auto", "step=9", "parallel=0"])
    assert not st["parallel"] and st["eta"]["remaining_s"] == 8 * 8 * 9 + 300 + 5 * 20 + 6 * 18, st["eta"]
    run(["autotune", "step"])                          # core 0 a -5: ok
    st = run(["autotune", "status"])
    st["in_progress"] = {"kind": "co", "core": 0, "value": -10, "boot_id": "altro-boot"}
    at_save(st)
    st = run(["autotune", "step"])
    assert st["resumed_after_crash"] and st["unstable"]["0"] == {"value": -10, "why": "crash"} and st["core"] == 1
    assert run(["autotune", "abort"])["aborted"] and run(["autotune", "status"]) == {"phase": None}
    assert run(["status"])["co"] == [0] * CORES          # abort riporta la CPU a baseline
    # crash in parallelo: tutti i core in prova instabili a quel livello, si passa alla finale
    run(["autotune", "start", "eco", "step=9"])
    st = run(["autotune", "step"])                     # tutti a -5: ok
    st["in_progress"] = {"kind": "co_par", "cores": st["active_cores"], "value": -10, "boot_id": "altro-boot"}
    at_save(st)
    st = run(["autotune", "step"])
