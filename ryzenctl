        FAKE.save()

    def exists(name):
        return os.path.exists(marker(name))

    # 1. first boot (dirty never existed): markers in place, nothing applied
    reboot()
    out = run(["boot"])
    assert exists("dirty") and not exists("active") and not exists("crashed") and out["applied"] == {}
    assert os.path.exists(P(RUN + "/booted")) and run(["status"])["baseline_fresh"]
    # 2. runtime change, clean shutdown → no crash
