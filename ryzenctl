def cmd_shaper(ctx, args):
    """Sperimentale: non verificato su hardware. `shaper raw` = parole di 0x84;
    `shaper probe` = scrive tier 4 -2/-2/-2, legge subito e dopo 1 s, ripristina."""
    raw = lambda: ["0x%08X" % w for w in smu("shaper_get")]
    if args == ["raw"]:
        check_cpu()
        return {"raw": raw()}
    if args == ["probe"]:
        check_cpu()
        base = load_baseline()
        out = {"prima": raw()}
        smu("shaper_set", shaper_arg(4, -2, -2, -2))
        out["subito"] = raw()
        time.sleep(1)
        out["dopo_1s"] = raw()
        smu("shaper_set", shaper_arg(4, *base["shaper"].get(4, [0, 0, 0])))
        out["ripristino"] = raw()
        out["per_tier_arg0"] = ["0x%08X" % smu("shaper_get", t)[0] for t in range(5)]   # 0x84 con arg0 = tier
        return out
    if len(args) != 4:
        raise Err("uso: shaper <tier 0-4> <bassaT> <mediaT> <altaT> | shaper raw | shaper probe")
    tier = to_int(args[0], "tier")
    check_range("tier", tier, 0, 4)
    v = [to_int(x, "shaper") for x in args[1:]]
    for m in v:
        check_range("shaper", m, CO_MIN, CO_MAX)
    check_cpu()
    base = load_baseline()
    got = write_verify(ctx, "shaper tier %d" % tier, v, lambda x: smu("shaper_set", shaper_arg(tier, *x)),
                       lambda: read_shaper()[tier], base["shaper"].get(tier))
    return {"shaper": {tier: got}}


