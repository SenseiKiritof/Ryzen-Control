    assert exists("dirty") and not exists("active")
    assert run(["notify"])["crashed"]["profile"] == "quiet" and "quiet" in FAKE.s["notified"]
    # 3b. crash again while nothing is applied: the previous crashed stays, no new active
    reboot()
    out = run(["boot"])
    assert out["crashed"]["profile"] == "quiet" and not exists("active")
    # "Stay on Default"
    run(["crashed", "clear"])
