COMMANDS = {
    "status": cmd_status, "baseline": cmd_baseline, "co": cmd_co,
    "ppt": limit_setter("ppt", "ppt_limit", "ppt_set", "W", PPT_MIN),
    "tdc": limit_setter("tdc", "tdc_limit", "tdc_set", "A", TDC_MIN),
    "edc": limit_setter("edc", "edc_limit", "edc_set", "A", EDC_MIN),
    "tjmax": limit_setter("tjmax", "thm_limit", "tjmax_set", "°C", TJMAX_MIN),
    "fmax": cmd_fmax, "shaper": cmd_shaper, "power": cmd_power, "unlock": cmd_unlock,
    "apply": cmd_apply, "profile": cmd_profile, "use": cmd_use, "autostart": cmd_autostart, "trust": cmd_trust,
    "default": cmd_default, "boot": cmd_boot, "shutdown": cmd_shutdown, "resume": cmd_resume,
    "crashed": cmd_crashed, "notify": cmd_notify, "serve": cmd_serve, "hwtest": cmd_hwtest,
    "fan": cmd_fan, "telemetry": cmd_telemetry, "preset": cmd_preset, "autotune": cmd_autotune,
}
FORMAT = {"status": fmt_status, "hwtest": fmt_hwtest, "fan": fmt_fan}


def run(argv, ctx=None):
    if not argv or argv[0] not in COMMANDS:
        raise Err(_("unknown command: %s (available: %s)") % (argv[:1], ", ".join(sorted(COMMANDS))))
    return COMMANDS[argv[0]](ctx or {}, argv[1:])


# ---- Selftest --------------------------------------------------------------------------
def expect_err(argv, needle, ctx=None):
    try:
        run(argv, ctx)
    except Err as e:
        assert needle in str(e), "expected '%s' in: %s" % (needle, e)
        return
    raise AssertionError("%s accepted, expected error '%s'" % (argv, needle))


def selftest():
    global ROOT, FAKE, _T
    _T = gettext.NullTranslations()
    ROOT = tempfile.mkdtemp(prefix="ryzenctl-selftest-")
    FAKE = Fake("granite")
    init_cpu()
    # topology and encodings: 8 cores of one CCD, core c = cpus c and c+8, mask = core << 20 (as before phase 5)
    assert TOPO[3] == (3, "3,11") and CORES == 8
    assert co_arg(7, -30) == (7 << 20) | 0xFFE2
    assert s16(0xFFFFFFE2) == -30 and s16(0x0005) == 5
    assert shaper_arg(2, -10, -5, 3) == (3 << 24) | (0xFB << 16) | (0xF6 << 8) | 0x80 | 2
    assert shaper_decode(shaper_arg(4, -50, 0, 30)) == [-50, 0, 30]
    # CPU gate
    FAKE.s["codename"] = 24
    FAKE.save()
    expect_err(["status"], "unsupported")
    FAKE.s["codename"] = 23
    FAKE.save()
    # status
    st = run(["status"])
    assert st["co"] == [0] * CORES and st["fmax"] == 5225 and st["baseline"] is None
    assert st["limits"] == {"ppt": 162.0, "tdc": 120.0, "edc": 180.0, "tjmax": 95.0}
    assert "Granite Ridge" in fmt_status(st)
    expect_err(["nope"], "unknown")
    assert FAKE.smu(MP1, 0x10, [0])[0] == 0xFE   # outside the allowlist → UNKNOWN_CMD
    # no CPU write without a baseline
    expect_err(["ppt", "150"], "baseline")
    expect_err(["co", "7", "-3"], "baseline")
    base = run(["baseline"])
    assert base["ppt"] == 162 and base["co"] == [0] * CORES and base["shaper"] == {}   # experimental shaper: excluded
    assert run(["baseline", "show"]) == base and run(["status"])["baseline_fresh"]
    assert "(base performance)" in fmt_status(run(["status"]))
    # validation
    expect_err(["co", "7", "-51"], "out of range")
