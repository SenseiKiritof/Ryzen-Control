    selftest_variants()
    print("selftest ok (%s)" % ROOT)


def selftest_variants():
    """Phase 5: the same ryzenctl on a 16-core CPU with two CCDs and on a CPU whose PM table cannot be
    read (PPT/TDC/EDC/Tjmax refused, CO/FMax fine)."""
    global ROOT, FAKE
    # ---- 16 cores on two CCDs (9950X) ----
    ROOT = tempfile.mkdtemp(prefix="ryzenctl-selftest-16-")
    FAKE = Fake("granite16")
    init_cpu()
    assert CORES == 16 and TOPO[8] == (8, "8,24") and TOPO[15] == (15, "15,31")
    assert co_mask(7) == 7 << 20 and co_mask(8) == (1 << 8) << 20 and co_mask(15) == ((1 << 8) | 7) << 20
    st = run(["status"])
    assert st["cores"] == 16 and st["ccds"] == 2 and st["co"] == [0] * 16 and st["cpu"] == "Granite Ridge"
    run(["boot"])
    assert run(["baseline", "show"])["co"] == [0] * 16
    assert run(["co", "15", "-10"])["co"][15] == -10           # second CCD: (1 << 8 | 7) << 20, read back
    assert run(["co", "all", "-5"])["co"] == [-5] * 16
    FAKE.smu(MP1, 0x35, [(8 << 20) | (-20 & 0xFFFF)])          # single-CCD mask for core 8: answered OK, does nothing
    FAKE.save()
    assert run(["status"])["co"][8] == -5
    expect_err(["co", "16", "0"], "out of range")
    run(["profile", "save", "p16", "co " + " ".join(["-3"] * 16), "ppt 150"])
    run(["apply", "p16"])
    assert run(["status"])["co"] == [-3] * 16 and run(["status"])["limits"]["ppt"] == 150.0
    assert "co" not in values_from_lines([["co"] + ["0"] * 8])  # the CO line of another CPU (8 values) is ignored
    tele = run(["telemetry"])
    assert len(tele["cores"]) == 16 and tele["cores"][15]["temp"] is None   # no verified per-core layout for 0x620205
    run(["default"])
    st = run(["autotune", "start", "auto", "step=3", "reuse=0"])
    for _i in range(300):
        st = run(["autotune", "step"])
        if st["phase"] == "done":
            break
    assert st["phase"] == "done" and len(st["final"]) == 16 and st["final"][8] == -37 and st["final"][7] == -12, st["final"]
    assert json.loads(open(P(CO_LIMITS_PATH)).read())["cores"] == 16
    run(["autotune", "abort"])
    # ---- a PM table that cannot be read: fail closed for the limits ----
    ROOT = tempfile.mkdtemp(prefix="ryzenctl-selftest-nopm-")
    FAKE = Fake("nopm")
    init_cpu()
    run(["boot"])
    base = run(["baseline", "show"])
    assert base["co"] == [0] * 8 and not any(k in base for k in ("ppt", "tdc", "edc", "tjmax")), base
    for argv in (["ppt", "100"], ["tdc", "60"], ["edc", "100"], ["tjmax", "80"]):
        expect_err(argv, "PM table")
    assert run(["co", "0", "-5"])["co"][0] == -5 and run(["fmax", "5000"])["fmax"] == 5000
    assert run(["telemetry"])["cores"][0]["temp"] is None and run(["status"])["limits"]["ppt"] is None
    # ---- two CCDs with 6 cores each (9900X): the physical slots come from the core fuses ----
    ROOT = tempfile.mkdtemp(prefix="ryzenctl-selftest-12-")
    FAKE = Fake("granite12")          # CCD0 slots 2 and 5 disabled, CCD1 slots 0 and 7
    init_cpu()
    assert CORES == 12 and TOPO[6][0] == 8 and co_support() is None
    assert core_map() == [(0, 0), (0, 1), (0, 3), (0, 4), (0, 6), (0, 7), (1, 1), (1, 2), (1, 3), (1, 4), (1, 5), (1, 6)]
    assert co_mask(2) == 3 << 20 and co_mask(6) == (1 << 28) | (1 << 20)
    try:
        smn_read(0x12345678)
        raise AssertionError("SMN read outside the fuse addresses accepted")
    except Err as e:
        assert "not allowed" in str(e)
    run(["boot"])
    assert run(["baseline", "show"])["co"] == [0] * 12
    assert run(["co", "2", "-7"])["co"] == [0, 0, -7] + [0] * 9 and FAKE.s["co"][2] == -7   # slot 3, not slot 2
    FAKE.smu(MP1, 0x35, [(2 << 20) | (-20 & 0xFFFF)])            # Linux numbering as a slot: slot 2 is disabled, nothing
    FAKE.save()
    assert run(["status"])["co"][2] == -7 and run(["status"])["co"] == [0, 0, -7] + [0] * 9
    st = run(["autotune", "start", "auto", "step=3", "reuse=0"])
    for _i in range(300):
        st = run(["autotune", "step"])
        if st["phase"] == "done":
            break
    assert st["phase"] == "done" and len(st["final"]) == 12, st
    run(["autotune", "abort"])
    r = run(["hwtest"])
    assert r["co"].startswith("ok") and r["esito"] == "ok", r
    # fuses that do not match the topology (a core more on CCD0 than Linux sees): no per-core CO at all
    ROOT = tempfile.mkdtemp(prefix="ryzenctl-selftest-12b-")
    FAKE = Fake("fusebad")
    init_cpu()
    assert core_map() is None and "physical position" in co_support()
    st = run(["status"])
    assert st["co"] is None and st["co_unavailable"] and "CO      n/a" in fmt_status(st)
    run(["boot"])
    base = run(["baseline", "show"])
    assert "co" not in base and base["fmax"] == 5225 and base["ppt"] == 162, base
    expect_err(["co", "0", "-5"], "physical position")
    expect_err(["co", "all", "-5"], "physical position")
    expect_err(["autotune", "start", "auto", "step=3"], "physical position")
    assert not any(l.startswith("co ") for l in run(["preset", "quiet", "show"])["lines"])
    assert run(["fmax", "5000"])["fmax"] == 5000 and run(["ppt", "150"])["ppt"] == 150.0
    r = run(["hwtest"])
    assert r["co"].startswith("skipped") and r["fmax"].startswith("ok") and r["esito"] == "ok", r
    assert all(c["co"] is None for c in run(["telemetry"])["cores"])
    # ---- Raphael (Ryzen 7000): IDs of ZenStates-Core, not verified, no readable map of the limits ----
    ROOT = tempfile.mkdtemp(prefix="ryzenctl-selftest-raphael-")
    FAKE = Fake("raphael")
    init_cpu()
    st = run(["status"])
    assert st["cpu"] == "Raphael" and not st["verified"] and st["shaper"] is None and "not verified" in fmt_status(st)
    run(["boot"])
    base = run(["baseline", "show"])
    assert base["co"] == [0] * 8 and not any(k in base for k in ("ppt", "tdc", "edc", "tjmax")), base
    assert run(["co", "3", "-7"])["co"][3] == -7 and run(["fmax", "5000"])["fmax"] == 5000
    for argv in (["ppt", "100"], ["tjmax", "80"]):
        expect_err(argv, "PM table")
    expect_err(["shaper", "raw"], "not available")


def main():
    argv = sys.argv[1:]
    try:
        if argv == ["selftest"]:
            return selftest()
        result = run(argv)
    except Err as e:
        print(_("error: %s") % e, file=sys.stderr)
        sys.exit(1)
    except Exception:  # never an unhandled exception: ABRT would report it as a "crash"
        traceback.print_exc()
        sys.exit(2)
    if isinstance(result, dict) and (argv[0] in ("boot", "resume") and result.get("errors") or result.get("baseline_error")):
        print("ryzenctl %s: %s" % (argv[0], json.dumps(result, ensure_ascii=False)), file=sys.stderr)
    if argv[0] in FORMAT:
        print(FORMAT[argv[0]](result))
    elif isinstance(result, str):
        print(result)
    elif result is not None:
        print(json.dumps(result, ensure_ascii=False))


if __name__ == "__main__":
    main()
