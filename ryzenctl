PROFILE_CMDS = {"co", "ppt", "tdc", "edc", "fmax", "tjmax", "power", "fan"}  # shaper: sperimentale, fuori
FAN_PROFILE_SUBCMDS = ("step", "curve")   # in un profilo: `fan <N> step …` | `fan <N> curve …`
NAME_RE = re.compile(r"^[a-z0-9_-]{1,32}$")


def profile_path(name):
    if name == "baseline":
        return P(STATE + "/baseline.conf")
    if not NAME_RE.match(name):
        raise Err("nome profilo non valido '%s' (solo a-z 0-9 _ -)" % name)
    return P(ETC + "/profiles/" + name + ".conf")


def profile_lines(name):
    try:
        lines = parse_lines(open(profile_path(name)).read())
    except OSError:
        raise Err("profilo '%s' inesistente" % name)
    if name == "baseline":  # scritta da noi: una versione precedente può avere righe oggi escluse (shaper)
        lines = [t for t in lines if t[0] in PROFILE_CMDS]
    return lines


def apply_lines(lines, ctx, part=None):
    """Esegue le righe (part: 'cpu' | 'fan' | None=tutte). Si ferma al primo errore."""
    done = []
    for n, t in enumerate(lines, 1):
        is_fan = t[0] == "fan"
        if part == "fan" and not is_fan or part == "cpu" and is_fan:
            continue
        if t[0] not in PROFILE_CMDS or (is_fan and (len(t) < 3 or t[2] not in FAN_PROFILE_SUBCMDS)):
            raise Err("riga %d: '%s' non ammesso in un profilo" % (n, " ".join(t[:3])))
        try:
            run(t, ctx)
        except Err as e:
            raise Err("riga %d (%s): %s" % (n, " ".join(t), e))
        done.append(" ".join(t))
    return done


def cmd_apply(ctx, args):
    if len(args) not in (1, 2) or (len(args) == 2 and args[1] not in ("cpu", "fan")):
        raise Err("uso: apply <profilo|baseline> [cpu|fan]")
    return {"applied": apply_lines(profile_lines(args[0]), ctx, args[1] if len(args) == 2 else None)}


def cmd_profile(ctx, args):
    """profile list | show <n> | save <n> <riga>… | delete <n>"""
    s = load_settings()
    if args == ["list"]:
        d = P(ETC + "/profiles")
        names = sorted(f[:-5] for f in os.listdir(d) if f.endswith(".conf")) if os.path.isdir(d) else []
        return {"profiles": names, "active": s["profile"]}
    if len(args) == 2 and args[0] == "show":
        return {"lines": [" ".join(t) for t in profile_lines(args[1])]}
    if len(args) >= 2 and args[0] == "save":
        name, path = args[1], profile_path(args[1])
        if name == "baseline":
            raise Err("'baseline' è riservato")
        lines = parse_lines("\n".join(args[2:]))
        apply_lines(lines, {"dry": True})          # valida tutto, non tocca l'hardware
        write_atomic(path, "# profilo ryzenctl '%s'\n" % name + "\n".join(" ".join(t) for t in lines) + "\n")
        return {"saved": name, "lines": len(lines)}
    if len(args) == 2 and args[0] == "delete":
        path = profile_path(args[1])
        if args[1] == "baseline" or not os.path.exists(path):
            raise Err("profilo '%s' inesistente o riservato" % args[1])
        os.remove(path)
        if s["profile"] == args[1]:
            s["profile"] = None
            save_settings(s)
        return {"deleted": args[1]}
    raise Err("uso: profile list | show <nome> | save <nome> <riga>… | delete <nome>")


