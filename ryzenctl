    assert replies[0]["ok"] and replies[0]["data"]["fmax"] == 5225
    assert not replies[1]["ok"] and "fuori" in replies[1]["error"]
    assert not replies[2]["ok"] and "serve" in replies[2]["error"]
    assert not replies[3]["ok"]
    assert replies[4]["ok"] and replies[4]["data"]["co"][7] == -3
    print("selftest ok (%s)" % ROOT)


def main():
    argv = sys.argv[1:]
    try:
        if argv == ["selftest"]:
            return selftest()
        result = run(argv)
    except Err as e:
        print("errore: %s" % e, file=sys.stderr)
        sys.exit(1)
    except Exception:  # mai un'eccezione non gestita: ABRT la segnalerebbe come "crash"
        traceback.print_exc()
        sys.exit(2)
    if argv[0] in ("boot", "resume") and result.get("errors") or result and result.get("baseline_error"):
        print("ryzenctl %s: %s" % (argv[0], json.dumps(result, ensure_ascii=False)), file=sys.stderr)
    if argv[0] in FORMAT:
        print(FORMAT[argv[0]](result))
    elif isinstance(result, str):
        print(result)
    elif result is not None:
        print(json.dumps(result, ensure_ascii=False))


if __name__ == "__main__":
    main()
