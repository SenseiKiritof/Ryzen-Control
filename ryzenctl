    expect_err(["co", "8", "0"], "out of range")
    expect_err(["ppt", "44"], "out of range")
    expect_err(["ppt", "0"], "out of range")
    expect_err(["ppt", "163"], "out of range")
    expect_err(["fmax", "5226"], "out of range")
    expect_err(["tjmax", "96"], "out of range")
    expect_err(["shaper", "5", "0", "0", "0"], "out of range")
    expect_err(["ppt", "x"], "integer")
    expect_err(["power", "turbo"], "usage")
    # writes with readback
    assert run(["co", "7", "-3"])["co"][7] == -3
    assert run(["co", "all", "-10"])["co"] == [-10] * CORES
    assert run(["co"] + ["-5"] * 7 + ["0"])["co"] == [-5] * 7 + [0]
    assert run(["ppt", "150"]) == {"ppt": 150.0}
    assert run(["tdc", "100"]) == {"tdc": 100.0} and run(["edc", "150"]) == {"edc": 150.0}
    assert run(["fmax", "5000"]) == {"fmax": 5000}
    assert run(["tjmax", "85"]) == {"tjmax": 85.0}
    assert run(["shaper", "2", "-10", "-5", "3"]) == {"shaper": {2: [-10, -5, 3]}}
    assert run(["shaper", "raw"])["raw"][2] == "0x%08X" % shaper_arg(2, -10, -5, 3)
    probe = run(["shaper", "probe"])
