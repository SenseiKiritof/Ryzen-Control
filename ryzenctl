SERVE_DENY = {"serve", "boot", "shutdown", "resume", "selftest"}   # autotune step è ammesso: la GUI lo pilota


def cmd_serve(ctx, args):
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            argv = json.loads(line)
            if not isinstance(argv, list) or not all(isinstance(a, str) for a in argv) or not argv:
                raise Err("richiesta non valida: atteso un array JSON di stringhe")
            if argv[0] in SERVE_DENY:
                raise Err("comando '%s' non disponibile via serve" % argv[0])
            reply = {"ok": True, "data": run(argv)}
        except Err as e:
            reply = {"ok": False, "error": str(e)}
        except Exception as e:  # mai morire su un bug: la GUI mostra l'errore
            reply = {"ok": False, "error": "interno: %r" % e}
        sys.stdout.write(json.dumps(reply, ensure_ascii=False) + "\n")
        sys.stdout.flush()


