    expect_err(["preset", "turbo"], "uso")
    run(["profile", "delete", "auto"])

    # ---- autotune eco: CO discreto per core, passata finale, FMax dal target, profilo eco ----
    expect_err(["autotune", "step"], "nessuna calibrazione")
    expect_err(["autotune", "start", "eco", "colimit=5"], "fuori")
