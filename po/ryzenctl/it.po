#: ryzenctl
msgid " (PBO disabled in the BIOS? set it to Advanced/Motherboard)"
msgstr " (PBO disabilitato nel BIOS? impostarlo su Advanced/Motherboard)"

#: ryzenctl
#, python-format
msgid "SMU %s 0x%02X: %s%s"
msgstr "SMU %s 0x%02X: %s%s"

#: ryzenctl
#, python-format
msgid "ryzen_smu driver not loaded (%s)"
msgstr "driver ryzen_smu non caricato (%s)"

#: ryzenctl
#, python-format
msgid "unsupported CPU (codename %d; supported: %s)"
msgstr "CPU non supportata (codename %d; supportate: %s)"

#: ryzenctl
msgid "usage: baseline [show]"
msgstr "uso: baseline [show]"

#: ryzenctl
msgid "baseline not captured: CPU state already modified in this boot"
msgstr "baseline non catturata: stato CPU già modificato in questo boot"

#: ryzenctl
msgid "baseline missing: CPU writes refused (did the ryzenctl service run?)"
msgstr "baseline assente: scritture CPU rifiutate (il servizio ryzenctl non ha girato?)"

#: ryzenctl
msgid "baseline not captured in this boot: CPU writes refused"
msgstr "baseline non catturata in questo boot: scritture CPU rifiutate"

#: ryzenctl
#, python-format
msgid "no baseline for %s (PM table missing?): write refused"
msgstr "nessuna baseline per %s (PM table assente?): scrittura rifiutata"

#: ryzenctl
#, python-format
msgid "%s %d%s out of range (allowed %d..%d%s)"
msgstr "%s %d%s fuori dal consentito %d..%d%s"

#: ryzenctl
#, python-format
msgid "%s: '%s' is not an integer"
msgstr "%s: '%s' non è un intero"

#: ryzenctl
#, python-format
msgid "%s: wrote %s but read back %s; restored %s"
msgstr "%s: scritto %s ma riletto %s; ripristinato %s"

#: ryzenctl
#, python-format
msgid "usage: %s <%s>"
msgstr "uso: %s <%s>"

#: ryzenctl
#, python-format
msgid "PM table missing: cannot verify %s, write refused"
msgstr "PM table assente: impossibile verificare %s, scrittura rifiutata"

#: ryzenctl
#, python-format
msgid "usage: co <core|all> <value> | co v0 … v%d"
msgstr "uso: co <core|all> <valore> | co v0 … v%d"

#: ryzenctl
msgid "usage: fmax <MHz>"
msgstr "uso: fmax <MHz>"

#: ryzenctl
msgid "usage: shaper <tier 0-4> <lowT> <midT> <highT> | shaper raw | shaper probe"
msgstr "uso: shaper <tier 0-4> <bassaT> <mediaT> <altaT> | shaper raw | shaper probe"

#: ryzenctl
#, python-format
msgid "usage: power <%s>"
msgstr "uso: power <%s>"

#: ryzenctl
msgid "usage: unlock on|off"
msgstr "uso: unlock on|off"

#: ryzenctl
msgid "Boost is the selected mode and requires unlock: switch to another mode first"
msgstr "Boost è la modalità selezionata e richiede lo sblocco: passare prima a un'altra modalità"

#: ryzenctl
#, python-format
msgid "WARNING: limits beyond the factory values enabled (PPT up to %d W, TDC %d A, EDC %d A, FMax +%d MHz). More heat and power draw; Tjmax stays <= baseline anyway."
msgstr "ATTENZIONE: limiti oltre i valori di fabbrica abilitati (PPT fino a %d W, TDC %d A, EDC %d A, FMax +%d MHz). Più calore e consumo; Tjmax resta comunque <= baseline."

#: ryzenctl
msgid "limits back to the factory caps"
msgstr "limiti riportati ai tetti di fabbrica"

#: ryzenctl
msgid "Boost requires unlock (ryzenctl unlock on; in the GUI: Preferences, \"Allow beyond the stock values\")"
msgstr "Boost richiede lo sblocco (ryzenctl unlock on; nella GUI: Preferenze, \"Consenti oltre i valori di fabbrica\")"

#: ryzenctl
msgid "usage: trust on|off|status"
msgstr "uso: trust on|off|status"

#: ryzenctl
msgid "unknown calling user (pkexec or sudo required)"
msgstr "utente chiamante sconosciuto (serve pkexec o sudo)"

#: ryzenctl
msgid "fake"
msgstr "finto"

#: ryzenctl
msgid "n/a"
msgstr "n/d"

#: ryzenctl
#, python-format
msgid "CPU %s, %d cores, SMU %s, PM table %s"
msgstr "CPU %s, %d core, SMU %s, PM table %s"

#: ryzenctl
msgid "  (experimental, not verified)"
msgstr "  (sperimentale, non verificato)"

#: ryzenctl
#, python-format
msgid "Limits  PPT %s%s  TDC %s%s  EDC %s%s  Tjmax %s%s"
msgstr "Limiti  PPT %s%s  TDC %s%s  EDC %s%s  Tjmax %s%s"

#: ryzenctl
#, python-format
msgid "Now     PPT %s  TDC %s  Tctl %s"
msgstr "Ora     PPT %s  TDC %s  Tctl %s"

#: ryzenctl
#, python-format
msgid "Power   %s%s"
msgstr "Energia %s%s"

#: ryzenctl
#, python-format
msgid "Baseline %s, unlock %s, autostart %s, profile %s"
msgstr "Baseline %s, sblocco %s, avvio automatico %s, profilo %s"

#: ryzenctl
msgid "of this boot"
msgstr "di questo boot"

#: ryzenctl
msgid "stale"
msgstr "vecchia"

#: ryzenctl
msgid "missing"
msgstr "assente"

#: ryzenctl
#, python-format
msgid "invalid profile name '%s' (only a-z 0-9 _ -)"
msgstr "nome profilo non valido '%s' (solo a-z 0-9 _ -)"

#: ryzenctl
#, python-format
msgid "profile '%s' does not exist"
msgstr "profilo '%s' inesistente"

#: ryzenctl
#, python-format
msgid "line %d: '%s' not allowed in a profile"
msgstr "riga %d: '%s' non ammesso in un profilo"

#: ryzenctl
#, python-format
msgid "line %d (%s): %s"
msgstr "riga %d (%s): %s"

#: ryzenctl
msgid "usage: apply <profile|baseline> [cpu|fan]"
msgstr "uso: apply <profilo|baseline> [cpu|fan]"

#: ryzenctl
msgid "'baseline' is reserved"
msgstr "'baseline' è riservato"

#: ryzenctl
#, python-format
msgid "profile '%s' does not exist or is reserved"
msgstr "profilo '%s' inesistente o riservato"

#: ryzenctl
msgid "usage: profile list | show <name> | save <name> <line>… | delete <name>"
msgstr "uso: profile list | show <nome> | save <nome> <riga>… | delete <nome>"

#: ryzenctl
msgid "usage: use <profile>"
msgstr "uso: use <profilo>"

#: ryzenctl
msgid "usage: autostart on|off"
msgstr "uso: autostart on|off"

#: ryzenctl
msgid "no profile selected (use <profile>)"
msgstr "nessun profilo selezionato (use <profilo>)"

#: ryzenctl
msgid "usage: preset quiet|performance|eco|auto|boost [show]"
msgstr "uso: preset quiet|performance|eco|auto|boost [show]"

#: ryzenctl
#, python-format
msgid "stress-ng exit code %d (result verification failed or process terminated)"
msgstr "stress-ng codice %d (verifica dei risultati fallita o processo terminato)"

#: ryzenctl
msgid "MCE error in the kernel log"
msgstr "errore MCE nel log del kernel"

#: ryzenctl
msgid "stress-ng not installed: required for the load tests"
msgstr "stress-ng non installato: serve per i test di carico"

#: ryzenctl
#, python-format
msgid "unknown parameter '%s' (%s)"
msgstr "parametro sconosciuto '%s' (%s)"

#: ryzenctl
#, python-format
msgid "stress-ng %s terminated after %.0f s (exit code %s) during the benchmark"
msgstr "stress-ng %s terminato dopo %.0f s (codice %s) durante il benchmark"

#: ryzenctl
msgid "stress-ng reported no metrics"
msgstr "stress-ng non ha riportato le metriche"

#: ryzenctl
msgid "usage: autotune start eco|auto|boost [target=70 colimit=-40 margin=3 step=90 parallel=1 reuse=1] | step | status | abort | save [apply] | estimate eco|auto|boost […]"
msgstr "uso: autotune start eco|auto|boost [target=70 colimit=-40 margin=3 step=90 parallel=1 reuse=1] | step | status | abort | save [apply] | estimate eco|auto|boost […]"

#: ryzenctl
msgid "usage: autotune estimate eco|auto [key=value…]"
msgstr "uso: autotune estimate eco|auto [chiave=valore…]"

#: ryzenctl
msgid "no completed calibration to save"
msgstr "nessuna calibrazione completata da salvare"

#: ryzenctl
msgid "usage: autotune save [apply]"
msgstr "uso: autotune save [apply]"

#: ryzenctl
msgid "usage: autotune start eco|auto [key=value…]"
msgstr "uso: autotune start eco|auto [chiave=valore…]"

#: ryzenctl
#, python-format
msgid "the combined CO already proved unstable up to margin +%d: raise margin or repeat the search with reuse=0"
msgstr "il CO combinato è già risultato instabile fino al margine +%d: aumenta margin o ripeti la ricerca con reuse=0"

#: ryzenctl
msgid "usage: autotune start|step|status|abort|save|estimate"
msgstr "uso: autotune start|step|status|abort|save|estimate"

#: ryzenctl
msgid "no calibration in progress (autotune start eco|auto|boost)"
msgstr "nessuna calibrazione in corso (autotune start eco|auto|boost)"

#: ryzenctl
#, python-format
msgid "unknown phase: %s"
msgstr "fase sconosciuta: %s"

#: ryzenctl
msgid "final pass unstable even with the increased margin: CO left at baseline"
msgstr "passata finale instabile anche con margine aumentato: CO lasciato a baseline"

#: ryzenctl
msgid "CPU profile not applied: crash in the previous boot"
msgstr "profilo CPU non applicato: crash nel boot precedente"

#: ryzenctl
msgid "usage: crashed [clear]"
msgstr "uso: crashed [clear]"

#: ryzenctl
#, python-format
msgid "Profile '%s' has been disabled: the system crashed (%s). Click to open Ryzen Control and decide."
msgstr "Il profilo '%s' è stato disattivato: il sistema è andato in crash (%s). Clicca per aprire Ryzen Control e decidere."

#: ryzenctl
msgid "Open Ryzen Control"
msgstr "Apri Ryzen Control"

#: ryzenctl
#, python-format
msgid "channel %d not writable: role '%s' (only 'ventola', assigned by `fan autodetect`)"
msgstr "canale %d non scrivibile: ruolo '%s' (solo 'ventola', assegnato da `fan autodetect`)"

#: ryzenctl
msgid "no nct67xx chip in hwmon: `fan enable` (nct6775 module, kernel parameter if needed)"
msgstr "nessun chip nct67xx in hwmon: `fan enable` (modulo nct6775, eventuale parametro kernel)"

#: ryzenctl
msgid "no channel with rpm > 0"
msgstr "nessun canale con giri > 0"

#: ryzenctl
msgid "stress-ng not installed: required for the test load"
msgstr "stress-ng non installato: serve per il carico di prova"

#: ryzenctl
#, python-format
msgid "ΔTctl %.1f °C, rpm %d→%d at %d%%%s"
msgstr "ΔTctl %.1f °C, giri %d→%d al %d%%%s"

#: ryzenctl
msgid ", aborted"
msgstr ", interrotto"

#: ryzenctl
msgid "usage: fan status|autodetect|identify N|role N pompa|sconosciuto|name N <name>|enable|disable|<N> step <up> <down>|<N> curve t:pwm …"
msgstr "uso: fan status|autodetect|identify N|role N pompa|sconosciuto|name N <nome>|enable|disable|<N> step <su> <giù>|<N> curve t:pwm …"

#: ryzenctl
msgid "channel"
msgstr "canale"

#: ryzenctl
msgid "manually you can only demote: role N pompa|sconosciuto ('ventola' only from autodetect)"
msgstr "a mano si può solo declassare: role N pompa|sconosciuto ('ventola' solo da autodetect)"

#: ryzenctl
msgid "set manually"
msgstr "impostato a mano"

#: ryzenctl
#, python-format
msgid "channel %d does not exist (%s)"
msgstr "canale %d inesistente (%s)"

#: ryzenctl
#, python-format
msgid "fan %d %s: wrote %d but read back %d"
msgstr "fan %d %s: scritto %d ma riletto %d"

#: ryzenctl
#, python-format
msgid "channel %d is not a pump (role '%s'; only role 'pompa')"
msgstr "canale %d non è classificato 'pompa' (ruolo '%s')"

#: ryzenctl
#, python-format
msgid "pump max %"
msgstr "tetto pompa %"

#: ryzenctl
msgid "pump max"
msgstr "tetto pompa"

#: ryzenctl
msgid "usage: fan <N> pump auto | fan <N> pump max <50-100> | fan <N> pump <50-100>"
msgstr "uso: fan <N> pump auto | fan <N> pump max <50-100> | fan <N> pump <50-100>"

#: ryzenctl
#, python-format
msgid "pump %"
msgstr "pompa %"

#: ryzenctl
msgid "pump"
msgstr "pompa"

#: ryzenctl
#, python-format
msgid "pump %d: wrote pwm %d but read back %d"
msgstr "pompa %d: scritto pwm %d ma riletto %d"

#: ryzenctl
#, python-format
msgid "curve point '%s': expected temperature:pwm (e.g. 60:150)"
msgstr "punto curva '%s': atteso temperatura:pwm (es. 60:150)"

#: ryzenctl
#, python-format
msgid "curve: 1 to %d points for channel %d"
msgstr "curva: da 1 a %d punti per il canale %d"

#: ryzenctl
msgid "curve: temperatures must increase and pwm must not decrease"
msgstr "curva: temperature crescenti e pwm non decrescenti"

#: ryzenctl
#, python-format
msgid "curve: the last point must be pwm 255 at <= %d °C"
msgstr "curva: l'ultimo punto deve essere pwm 255 a <= %d °C"

#: ryzenctl
msgid "usage: fan <N> step <up_ms> <down_ms> | fan <N> curve t:pwm … | fan <N> pump auto|max <50-100>|<50-100>"
msgstr "uso: fan <N> step <su_ms> <giù_ms> | fan <N> curve t:pwm … | fan <N> pump auto|max <50-100>|<50-100>"

#: ryzenctl
msgid "nct6775 loaded but no nct67xx chip in hwmon: Super I/O not reachable via LPC"
msgstr "nct6775 caricato ma nessun chip nct67xx in hwmon: Super I/O non raggiungibile via LPC"

#: ryzenctl
msgid "ACPI conflict: add acpi_enforce_resources=lax to the kernel command line (GRUB_CMDLINE_LINUX_DEFAULT) and reboot"
msgstr "conflitto ACPI: aggiungere acpi_enforce_resources=lax alla riga del kernel (GRUB_CMDLINE_LINUX_DEFAULT) e riavviare"

#: ryzenctl
#, python-format
msgid "Chip %s"
msgstr "Chip %s"

#: ryzenctl
#, python-format
msgid "pwm%-2d %-17s %5d rpm  pwm %3d  mode %d  step %d/%d ms  curve %s%s"
msgstr "pwm%-2d %-17s %5d giri  pwm %3d  modo %d  step %d/%d ms  curva %s%s"

#: ryzenctl
msgid "skipped: no baseline (PM table missing)"
msgstr "saltato: nessuna baseline (PM table assente)"

#: ryzenctl
#, python-format
msgid "error: %s"
msgstr "errore: %s"

#: ryzenctl
msgid "restored"
msgstr "ripristinata"

#: ryzenctl
#, python-format
msgid "error restoring the baseline: %s"
msgstr "errore nel ripristino: %s"

#: ryzenctl
msgid "FAILED"
msgstr "FALLITO"

#: ryzenctl
msgid "invalid request: expected a JSON array of strings"
msgstr "richiesta non valida: atteso un array JSON di stringhe"

#: ryzenctl
#, python-format
msgid "command '%s' not available via serve"
msgstr "comando '%s' non disponibile via serve"

#: ryzenctl
#, python-format
msgid "internal: %r"
msgstr "interno: %r"

#: ryzenctl
#, python-format
msgid "unknown command: %s (available: %s)"
msgstr "comando sconosciuto: %s (disponibili: %s)"

msgid "CPU topology not readable (/sys/devices/system/cpu)"
msgstr "topologia della CPU non leggibile (/sys/devices/system/cpu)"

msgid "%s is not available on this CPU"
msgstr "%s non è disponibile su questa CPU"

msgid "no verified Curve Optimizer commands for this CPU family"
msgstr "nessun comando Curve Optimizer verificato per questa famiglia di CPU"

msgid "Curve Optimizer not available on this CPU: %s"
msgstr "Curve Optimizer non disponibile su questa CPU: %s"

msgid "skipped: %s"
msgstr "saltato: %s"

msgid "  (family not verified on hardware yet: run hwtest)"
msgstr "  (famiglia non ancora verificata sull'hardware: esegui hwtest)"

msgid "CO      n/a: %s"
msgstr "CO      n/d: %s"

msgid "Shaper  n/a on this CPU"
msgstr "Shaper  n/d su questa CPU"

msgid "the physical position of the cores is unknown (core fuses unreadable or not matching the topology)"
msgstr "la posizione fisica dei core è sconosciuta (fusibili dei core illeggibili o non coerenti con la topologia)"

msgid "SMN read of 0x%08X not allowed"
msgstr "lettura SMN di 0x%08X non consentita"
