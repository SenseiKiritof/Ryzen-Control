msgstr "core %s a CO %d (%s)"

#, python-format
msgid "No core failed (iterations completed: %d of %d; every core alone, then all together)."
msgstr "Nessun core è fallito (iterazioni completate: %d di %d; ogni core da solo, poi tutti insieme)."

#, python-format
msgid "%s profile: stock → proposed"
msgstr "Profilo %s: fabbrica → proposto"

msgid "Verification complete: discard the proposal, save it, or save and apply?"
msgstr "Verifica completata: annullare la proposta, salvarla o salvarla e applicarla?"

msgid "Verification passed: nothing to change"
msgstr "Verifica superata: niente da cambiare"

msgid "Apply the profile"
msgstr "Applica il profilo"

msgid "Ends the verification now: result and proposal from the tests done so far"
msgstr "Termina subito la verifica: risultato e proposta dalle prove fatte finora"

msgid "Verification discarded, CPU at baseline"
msgstr "Verifica annullata, CPU a baseline"

msgid "Verify…: long stability test of the saved profile (each core alone, then all together)"
msgstr "Verifica…: lunga prova di stabilità del profilo salvato (ogni core da solo, poi tutti insieme)"

