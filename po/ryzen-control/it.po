msgid "Off: one core at a time, slower (%s) but attributes even a reboot with certainty"
msgstr "Spento: un core alla volta, più lento (%s) ma attribuisce con certezza anche un riavvio"

#, python-format
msgid "Off: reuses the measurement of %s; on: measures the limit again (longer)"
