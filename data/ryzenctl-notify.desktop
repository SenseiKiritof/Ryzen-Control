[Desktop Entry]
Type=Application
Name=Ryzen Control: crash check
Name[it]=Ryzen Control: controllo crash
Comment=Warns at login if the CPU profile was disabled after a crash
Comment[it]=Avvisa al login se il profilo CPU è stato disattivato dopo un crash
Exec=ryzenctl notify
Icon=org.ryzencontrol.RyzenControl
Terminal=false
NoDisplay=true
